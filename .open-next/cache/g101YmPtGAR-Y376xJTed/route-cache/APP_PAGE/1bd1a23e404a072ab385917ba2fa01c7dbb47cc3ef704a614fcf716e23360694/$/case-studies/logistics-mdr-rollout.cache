-line\">1 Fore Street Avenue, London EC2Y 9DT</address></div><div><p class=\"foot__office-city\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Dhaka<!-- -->, <!-- -->Bangladesh</p><address class=\"foot__office-line\">Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212</address></div><div><p class=\"foot__office-city\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>General enquiries</p><p class=\"foot__office-line\"><a class=\"foot__link u-link\" href=\"mailto:hello@envenox.com\">hello@envenox.com</a></p></div><div><p class=\"foot__office-city\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>Security reports</p><p class=\"foot__office-line\"><a class=\"foot__link u-link\" href=\"mailto:security@envenox.com\">security@envenox.com</a></p></div></div></div><div><h2 class=\"foot__col-heading\">Research notes</h2><form class=\"foot__form\" action=\"/api/newsletter\" method=\"post\"><label class=\"foot__form-label\" for=\"footer-newsletter-email\">Email address</label><div class=\"foot__form-row\"><input class=\"foot__input\" id=\"footer-newsletter-email\" type=\"email\" autoComplete=\"email\" required=\"\" aria-describedby=\"footer-newsletter-hint\" name=\"email\"/><button class=\"foot__submit\" type=\"submit\">Subscribe</button></div><input type=\"hidden\" name=\"source\" value=\"footer\"/><p class=\"foot__form-hint\" id=\"footer-newsletter-hint\">Advisories, teardowns and methodology notes. Roughly monthly. No sales sequence, one-click unsubscribe.</p></form></div></div><div class=\"foot__bottom\"><div class=\"foot__legal\"><p class=\"foot__legal-line\">© <!-- -->2026<!-- --> <!-- -->Envenox Ltd<!-- -->. Registered in England and Wales. Registered office:<!-- --> <!-- -->1 Fore Street Avenue, London EC2Y 9DT<!-- -->.</p><ul class=\"foot__legal-nav\"><li><a class=\"foot__legal-link\" href=\"/legal/privacy\">Privacy</a></li><li><a class=\"foot__legal-link\" href=\"/legal/cookies\">Cookies</a></li><li><a class=\"foot__legal-link\" href=\"/legal/terms\">Terms</a></li><li><a class=\"foot__legal-link\" href=\"/legal/accessibility\">Accessibility</a></li><li><a class=\"foot__legal-link\" href=\"/legal/vulnerability-disclosure\">Vulnerability disclosure</a></li><li><a class=\"foot__legal-link\" href=\"/sitemap\">Sitemap</a></li></ul></div><ul class=\"foot__social\"><li><a class=\"foot__social-link\" href=\"https://www.linkedin.com/company/envenox\" rel=\"me noopener noreferrer\" target=\"_blank\"><span>LinkedIn</span><span class=\"foot__vh\"> (opens in a new tab)</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></li><li><a class=\"foot__social-link\" href=\"https://github.com/envenox\" rel=\"me noopener noreferrer\" target=\"_bl