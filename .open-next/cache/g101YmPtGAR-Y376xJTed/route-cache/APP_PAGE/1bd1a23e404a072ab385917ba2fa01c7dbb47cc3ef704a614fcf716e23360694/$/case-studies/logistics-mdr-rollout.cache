system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  line-height: 1.05;\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n@media (min-width: 768px) {\\n  .metric__value { font-size: var(--text-3xl); }\\n}\\n.metric__label {\\n  margin: 0;\\n  color: var(--muted-strong);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n  max-width: 34ch;\\n}\\n.metric__note {\\n  margin: var(--s2) 0 0;\\n  padding-top: var(--s2);\\n  border-top: 1px solid var(--border);\\n  font-size: var(--text-xs);\\n  line-height: 1.5;\\n  color: var(--muted);\\n  max-width: 36ch;\\n}\\n.metric__note-key {\\n  display: block;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n  margin-bottom: 2px;\\n}\\n\\n/* ---------------- NDA block ---------------- */\\n.nda {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: var(--s3);\\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\\n  border-radius: var(--radius-md);\\n  padding: var(--s3) var(--s4);\\n}\\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.nda__kicker {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.nda__name {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n}\\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\\n\\n/* ---------------- dual-pillar marker ---------------- */\\n.dual {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-md);\\n  padding: var(--s2) var(--s3);\\n  color: var(--fg);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\\n.dual__icon { color: var(--accent); flex: none; }\\n\\n/* ---------------- case study card ---------------- */\\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\\n.cs-card__client {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n}\\n.cs-card__headline {\\n  margin: 0;\\n  font-size: var(--text-lg);\\n  font-weight: 500;\\n  line-height: var(--leading-snug);\\n  color: var(--fg);\\n}\\n.cs-card__headline a { color: inherit; text-decoration: none; }\\n.cs-card__meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s2) var(--s4);\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  margin: 0;\\n}\\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-card__metric {\\n  margin-top: auto;\\n  padding-top: var(--s4);\\n  border-top: 1px solid var(--border);\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s1);\\n}\\n.cs-card__metric-value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-xl);\\n  font-weight: 600;\\n  letter-spacing: var(--tracking-tight);\\n  line-height: 1.1;\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\\n\\n/* ---------------- testimonial rail ---------------- */\\n.trail {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\\n  gap: var(--s4);\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  scroll-snap-type: x mandatory;\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 var(--s4);\\n  scrollbar-width: thin;\\n}\\n@media (min-width: 768px) {\\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\\n}\\n.trail \\u003e li { scroll-snap-align: start; min-width: 0; }\\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.trail__quote {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-base);\\n  line-height: var(--leading-normal);\\n}\\n@media (min-width: 768px) {\\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\\n}\\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\\n\\n/* ---------------- named-humans CTA ---------------- */\\n.humans { display: grid; gap: var(--s8); }\\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\\n.human { display: flex; align-items: center; gap: var(--s4); }\\n.human__name {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-base);\\n  font-weight: 500;\\n  color: var(--fg);\\n}\\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\\n\"])</script><script>self.__next_f.push([1,\"27:[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-proof-surfaces\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$32\\\"}]\\n33:T71d,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"Article\\\",\\\"@id\\\":\\\"https://envenox.com/case-studies/logistics-mdr-rollout#article\\\",\\\"headline\\\":\\\"Onboarding found that 31% of configured log sources had never delivered an event — before a single detection was written.\\\",\\\"description\\\":\\\"The client had a SIEM, a vendor rule pack, an alert queue nobody read, and a managed service whose contractual commitment was measured on how fast an alert was forwarded. That service level rewards forwarding, so that is what it produced: 60 to 90 notifications a week, each requiring the client’s tw\\\",\\\"articleSection\\\":\\\"Case study\\\",\\\"inLanguage\\\":\\\"en-GB\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://envenox.com/case-studies/logistics-mdr-rollout\\\"},\\\"about\\\":{\\\"@type\\\":\\\"Thing\\\",\\\"name\\\":\\\"Logistics\\\"},\\\"keywords\\\":\\\"Managed Detection \\u0026 Response, Cloud Security, Incident Response\\\",\\\"isAccessibleForFree\\\":true,\\\"publisher\\\":{\\\"@id\\\":\\\"https://envenox.com/#organization\\\"},\\\"author\\\":{\\\"@id\\\":\\\"https://envenox.com/#organization\\\"},\\\"citation\\\":[\\\"31% — of configured log sources were silently not arriving (Found in week 3, before go-live)\\\",\\\"4 min — median analyst contact on critical detections (Against a 15-minute contractual commitment)\\\",\\\"11 → 3 — escalations per week after tuning (Conclusions, not raw alerts)\\\"]},{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@id\\\":\\\"https://envenox.com/case-studies/logistics-mdr-rollout#breadcrumb\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://envenox.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Case studies\\\",\\\"item\\\":\\\"https://envenox.com/case-studies\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Onboarding found that 31% of configured log sources had never delivered an event — before a single detection was written.\\\",\\\"item\\\":\\\"https://envenox.com/case-studies/logistics-mdr-rollout\\\"}]}]}\"])</script><script>self.__next_f.push([1,\"28:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$33\\\"}}]\\n34:T859,\"])</script><script>self.__next_f.push([1,\"\\n.badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--badge-border, var(--border));\\n  border-radius: var(--radius-sm);\\n  background-color: var(--badge-bg, transparent);\\n  color: var(--badge-fg, var(--muted-strong));\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.04em;\\n  line-height: 1;\\n  padding: var(--s1) var(--s2);\\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\\n     a badge held arbitrary data — \\\"3 weeks review, 14 weeks remediation\\\",\\n     \\\"AWS Solutions Architect Professional\\\", a credibility sentence — and an\\n     unbreakable chip wider than its card pushes the whole grid track past the\\n     viewport. A badge is a label primitive, but callers legitimately put\\n     variable-length data in one, and the component should survive that rather\\n     than require every caller to override it. Severity badges keep nowrap\\n     below: \\\"Critical\\\" is two syllables and must never break. */\\n  white-space: normal;\\n  text-wrap: balance;\\n}\\n.badge--severity {\\n  white-space