rder: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 1px var(--s1);\n}\n.prose pre {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  overflow-x: auto;\n}\n.prose pre code { background: none; border: 0; padding: 0; font-size: inherit; }\n\n.prose hr { border: 0; height: 1px; background-color: var(--border); margin-block: var(--s8); }\n\n.prose table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-sm);\n  font-variant-numeric: tabular-nums;\n}\n.prose th,\n.prose td { text-align: left; padding: var(--s3) var(--s4); border-bottom: 1px solid var(--border); }\n.prose th { color: var(--fg); font-weight: 500; }\n.prose td { color: var(--muted-strong); }\n\n.prose figure figcaption {\n  margin-top: var(--s3);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n.prose dt { color: var(--fg); font-weight: 500; }\n.prose dd { color: var(--muted-strong); margin-top: var(--s1); }\n.prose dd + dt { margin-top: var(--s4); }\n2c:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"cs-technical\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-band\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-band__head\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"cs-technical\",\"className\":\"cs-b