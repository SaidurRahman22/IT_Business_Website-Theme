{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/case-studies/layout,_N_T_/case-studies/[slug]/layout,_N_T_/case-studies/[slug]/page,_N_T_/case-studies/logistics-mdr-rollout"},"routeCache":{"key":"/route-cache/APP_PAGE/1bd1a23e404a072ab385917ba2fa01c7dbb47cc3ef704a614fcf716e23360694/$/case-studies/logistics-mdr-rollout","owner":{"kind":"APP_PAGE","sourceRoute":"/case-studies/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c03e25c6a7b6c11d.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-case-study-page envenox-proof-surfaces envenox-section envenox-badge envenox-prose envenox-avatar-placeholder envenox-case-charts envenox-reveal-group envenox-card\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.cs-breadcrumb { font-size: var(--text-xs); color: var(--muted); }\n.cs-breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-breadcrumb li { display: inline-flex; align-items: center; gap: var(--s2); }\n.cs-breadcrumb li + li::before { content: '/'; color: var(--border-strong); }\n.cs-breadcrumb a { color: var(--muted); text-decoration: none; }\n.cs-breadcrumb a:hover { color: var(--fg); }\n.cs-breadcrumb [aria-current='page'] { color: var(--muted-strong); }\n\n/* ---------------- metadata bar ---------------- */\n.cs-meta {\n  display: grid;\n  gap: var(--s6);\n  margin-top: var(--s6);\n  padding-block: var(--s4);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n}\n@media (min-width: 480px) {\n  .cs-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s8); }\n}\n@media (min-width: 768px) {\n  .cs-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s12); }\n}\n@media (min-width: 1100px) {\n  .cs-meta { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n}\n.cs-meta__cell { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }\n.cs-meta__key {\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.cs-meta__value { margin: 0; color: var(--fg); font-size: var(--text-sm); line-height: 1.45; }\n.cs-meta__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-meta__tag-link { text-decoration: none; }\n.cs-meta__nda { max-width: 46ch; flex: 1 1 24rem; min-width: 0; }\n.cs-meta__markers {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--s4);\n  margin-bottom: var(--s6);\n}\n\n/* THE ABOVE-THE-FOLD CONTRACT.\n   The three metrics sit beside the headline from 1024px up rather than under\n   it, so they are on the first screen without shrinking the h1. DOM order is\n   unchanged — metadata bar, headline, metrics — because that order is the\n   template and a screen reader follows the DOM, not the grid. */\n.cs-hero { display: grid; gap: var(--s12); margin-top: var(--s8); }\n@media (min-width: 1024px) {\n  .cs-hero {\n    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);\n    gap: var(--s16);\n    align-items: start;\n  }\n}\n.cs-hero__main { min-width: 0; }\n.cs-hero__results { min-width: 0; }\n\n/* ---------------- headline ---------------- */\n.cs-headline {\n  margin: 0;\n  font-size: var(--text-2xl);\n  line-height: var(--leading-snug);\n  max-width: 24ch;\n}\n@media (min-width: 768px) { .cs-headline { font-size: var(--text-3xl); max-width: 20ch; } }\n@media (min-width: 1024px) { .cs-headline { font-size: var(--text-4xl); max-width: 16ch; } }\n\n.cs-results__key { margin: 0 0 var(--s4); }\n\n/* ---------------- two-column band ---------------- */\n.cs-band { display: grid; gap: var(--s8); }\n@media (min-width: 1024px) {\n  .cs-band { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: var(--s16); align-items: start; }\n}\n.cs-band__head { display: flex; flex-direction: column; gap: var(--s3); }\n.cs-band__title { margin: 0; font-size: var(--text-2xl); }\n.cs-band__hint { margin: 0; font-size: var(--text-sm); color: var(--muted); max-width: 34ch; }\n\n/* ---------------- approach ---------------- */\n.cs-phases { list-style: none; margin: 0; padding: 0; }\n.cs-phases > li { border-top: 1px solid var(--border); padding-block: var(--s6); }\n.cs-phases > li:last-child { border-bottom: 1px solid var(--border); }\n.cs-phase { display: grid; gap: var(--s3); }\n@media (min-width: 640px) { .cs-phase { grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s4); } }\n.cs-phase__n {\n  font-size: var(--text-sm);\n  color: var(--accent);\n  letter-spacing: 0.06em;\n  line-height: 1.6;\n}\n.cs-phase__name { margin: 0; font-size: var(--text-lg); font-weight: 500; line-height: var(--leading-snug); color: var(--fg); }\n.cs-phase__body { margin: var(--s2) 0 0; color: var(--muted-strong); max-width: 68ch; }\n\n/* ---------------- quote ---------------- */\n.cs-quote { display: grid; gap: var(--s8); }\n@media (min-width: 900px) { .cs-quote { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--s8); align-items: start; } }\n.cs-quote__mark { color: var(--border-strong); }\n.cs-quote__text {\n  margin: 0;\n  font-size: var(--text-xl);\n  line-height: var(--leading-snug);\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  max-width: 28ch;\n}\n@media (min-width: 768px) { .cs-quote__text { font-size: var(--text-2xl); max-width: 26ch; } }\n.cs-quote__attr { display: flex; align-items: center; gap: var(--s4); margin-top: var(--s8); }\n.cs-quote__name { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--fg); }\n.cs-quote__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n\n/* ---------------- engagement facts ---------------- */\n.cs-facts { display: grid; gap: var(--s8); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 900px) { .cs-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s12); } }\n.cs-fact { display: flex; flex-direction: column; gap: var(--s3); min-width: 0; }\n.cs-fact__key { display: inline-flex; align-items: center; gap: var(--s2); }\n.cs-fact__body { margin: 0; color: var(--muted-strong); font-size: var(--text-sm); line-height: 1.55; }\n.cs-fact__chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-fact__timeline { margin: 0; font-size: var(--text-sm); line-height: 1.7; color: var(--muted-strong); overflow-wrap: break-word; }\n\n/* ---------------- console exhibits ----------------\n   One stacked band per placement, with the argument on the left and the drawn\n   console on the right from 1000px. The gap between placements is large on\n   purpose: two dense consoles 24px apart read as one confused screenshot. */\n.cs-consoles { display: grid; gap: var(--s24); }\n.cs-console { display: grid; gap: var(--s8); align-items: start; }\n@media (min-width: 1000px) {\n  .cs-console { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s12); }\n}\n.cs-console__say { min-width: 0; }\n.cs-console__title { margin: var(--s3) 0 0; font-size: var(--text-xl); }\n.cs-console__body { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 48ch; }\n.cs-console__art { min-width: 0; }\n\n/* ---------------- related ---------------- */\n.cs-related { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 768px) { .cs-related { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1100px) { .cs-related { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n\n@media print {\n  .cs-meta, .cs-phases > li { break-inside: avoid; }\n}\n\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\n.metrics {\n  display: grid;\n  gap: var(--s8);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n@media (min-width: 768px) {\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\n}\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\n   headline rather than in a full-width row under it. */\n.metrics--stack { gap: var(--s4); }\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\n/* The key runs inline with its note in the stacked variant — one line saved per\n   metric is what keeps all three on the first screen. */\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\n.metrics--stack .metric__note-key::after { content: ' — '; }\n.metric {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  min-width: 0;\n  border-top: 1px solid var(--border-strong);\n  padding-top: var(--s4);\n}\n.metric__value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n@media (min-width: 768px) {\n  .metric__value { font-size: var(--text-3xl); }\n}\n.metric__label {\n  margin: 0;\n  color: var(--muted-strong);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n  max-width: 34ch;\n}\n.metric__note {\n  margin: var(--s2) 0 0;\n  padding-top: var(--s2);\n  border-top: 1px solid var(--border);\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 36ch;\n}\n.metric__note-key {\n  display: block;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 2px;\n}\n\n/* ---------------- NDA block ---------------- */\n.nda {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--s3);\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\n  border-radius: var(--radius-md);\n  padding: var(--s3) var(--s4);\n}\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.nda__kicker {\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.nda__name {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n}\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\n\n/* ---------------- dual-pillar marker ---------------- */\n.dual {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s2) var(--s3);\n  color: var(--fg);\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  text-decoration: none;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\n.dual__icon { color: var(--accent); flex: none; }\n\n/* ---------------- case study card ---------------- */\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\n.cs-card__client {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  color: var(--muted-strong);\n}\n.cs-card__headline {\n  margin: 0;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.cs-card__headline a { color: inherit; text-decoration: none; }\n.cs-card__meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--s2) var(--s4);\n  font-size: var(--text-xs);\n  color: var(--muted);\n  margin: 0;\n}\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-card__metric {\n  margin-top: auto;\n  padding-top: var(--s4);\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n}\n.cs-card__metric-value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.1;\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\n\n/* ---------------- testimonial rail ---------------- */\n.trail {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\n  gap: var(--s4);\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  scroll-snap-type: x mandatory;\n  list-style: none;\n  margin: 0;\n  padding: 0 0 var(--s4);\n  scrollbar-width: thin;\n}\n@media (min-width: 768px) {\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\n}\n.trail > li { scroll-snap-align: start; min-width: 0; }\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.trail__quote {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n@media (min-width: 768px) {\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\n}\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------------- named-humans CTA ---------------- */\n.humans { display: grid; gap: var(--s8); }\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n.human { display: flex; align-items: center; gap: var(--s4); }\n.human__name {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-base);\n  font-weight: 500;\n  color: var(--fg);\n}\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n\n.prose {\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n.prose > * + * { margin-top: var(--s4); }\n\n.prose h2,\n.prose h3,\n.prose h4 { color: var(--fg); text-wrap: balance; }\n.prose h2 { font-size: var(--text-2xl); margin-top: var(--s12); }\n.prose h3 { font-size: var(--text-xl); margin-top: var(--s8); }\n.prose h4 { font-size: var(--text-lg); font-weight: 500; margin-top: var(--s6); }\n.prose > h2:first-child,\n.prose > h3:first-child,\n.prose > h4:first-child { margin-top: 0; }\n.prose h2 + *,\n.prose h3 + *,\n.prose h4 + * { margin-top: var(--s3); }\n\n.prose p { color: var(--muted-strong); }\n.prose .prose__lead,\n.prose > p:first-child { color: var(--fg); font-size: var(--text-lg); }\n\n.prose a {\n  color: var(--fg);\n  text-decoration: underline;\n  text-decoration-color: color-mix(in oklab, var(--fg) 40%, transparent);\n  text-underline-offset: 3px;\n  transition: text-decoration-color var(--dur-micro) var(--ease-out);\n}\n.prose a:hover { text-decoration-color: var(--fg); }\n\n.prose strong { color: var(--fg); font-weight: 600; }\n.prose em { font-style: italic; }\n.prose small { font-size: var(--text-sm); color: var(--muted); }\n\n.prose ul,\n.prose ol { padding-left: var(--s6); color: var(--muted-strong); }\n.prose ul { list-style: none; padding-left: var(--s4); }\n.prose ul > li { position: relative; padding-left: var(--s4); }\n.prose ul > li::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0.68em;\n  width: 6px;\n  height: 1px;\n  background-color: var(--border-strong);\n}\n.prose ol { list-style: decimal; }\n.prose ol > li::marker { color: var(--muted); font-variant-numeric: tabular-nums; }\n.prose li + li { margin-top: var(--s2); }\n.prose li > ul,\n.prose li > ol { margin-top: var(--s2); }\n\n.prose blockquote {\n  border-left: 1px solid var(--border-strong);\n  padding-left: var(--s6);\n  color: var(--fg);\n  font-size: var(--text-lg);\n  line-height: var(--leading-snug);\n}\n.prose blockquote cite {\n  display: block;\n  margin-top: var(--s3);\n  font-size: var(--text-sm);\n  font-style: normal;\n  color: var(--muted);\n}\n\n.prose code {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: 0.875em;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 1px var(--s1);\n}\n.prose pre {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  overflow-x: auto;\n}\n.prose pre code { background: none; border: 0; padding: 0; font-size: inherit; }\n\n.prose hr { border: 0; height: 1px; background-color: var(--border); margin-block: var(--s8); }\n\n.prose table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-sm);\n  font-variant-numeric: tabular-nums;\n}\n.prose th,\n.prose td { text-align: left; padding: var(--s3) var(--s4); border-bottom: 1px solid var(--border); }\n.prose th { color: var(--fg); font-weight: 500; }\n.prose td { color: var(--muted-strong); }\n\n.prose figure figcaption {\n  margin-top: var(--s3);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n.prose dt { color: var(--fg); font-weight: 500; }\n.prose dd { color: var(--muted-strong); margin-top: var(--s1); }\n.prose dd + dt { margin-top: var(--s4); }\n\n.avatar-ph {\n  display: grid;\n  place-items: center;\n  flex: none;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border);\n  color: var(--paper-50);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  line-height: 1;\n  user-select: none;\n  overflow: hidden;\n}\n.avatar-ph--round { border-radius: 50%; }\n\n/* ---------------- metric chart ---------------- */\n.mc { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .mc { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s12); }\n  /* The results column beside the headline is roughly 40% of the viewport, and\n     a media query measures the viewport rather than that column — so the stack\n     variant opts out of the three-up grid explicitly. */\n  .mc--stack { grid-template-columns: minmax(0, 1fr); gap: var(--s8); }\n}\n.mc-row {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  padding-top: var(--s4);\n  border-top: 1px solid var(--border-strong);\n}\n.mc-value {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n  overflow-wrap: anywhere;\n}\n.mc-label { margin: 0; color: var(--muted-strong); font-size: var(--text-sm); line-height: 1.5; }\n.mc-art { margin-top: var(--s3); min-width: 0; }\n.mc-svg { width: 100%; height: auto; max-width: 22rem; overflow: visible; }\n.mc-note { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.55; }\n.mc-noteKey {\n  display: block;\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  /* --muted, not --border-strong: in .theme-dark --border-strong is #3d342c\n     against a #1f1a16 surface, which is a hairline value and not a text value.\n     This matches .metric__note-key in proof.tsx, which is the same label. */\n  color: var(--muted);\n  margin-bottom: var(--s1);\n}\n.mc-nochart { margin: 0; font-size: var(--text-xs); color: var(--muted); max-width: 34ch; line-height: 1.55; }\n\n/* The \"before\" bar is DATA, so it takes a text-weight neutral rather than a\n   hairline one — --border-strong is a 1px value and disappears as a 13px bar\n   in .theme-dark. The track behind a share is FRAME, so it takes a diluted\n   version of the same neutral and stays quiet under the accent fill. */\n.mc-barFrom { fill: var(--muted); }\n.mc-barTo { fill: var(--accent); }\n.mc-track { fill: color-mix(in oklab, var(--muted) 42%, transparent); }\n.mc-track--open {\n  fill: none;\n  stroke: var(--muted);\n  stroke-width: 1;\n  stroke-dasharray: 3 3;\n}\n.mc-fill { fill: var(--accent); }\n.mc-limit { stroke: var(--muted); stroke-width: 1.5; }\n.mc-rule { stroke: var(--border-strong); stroke-width: 1; }\n.mc-barText {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  fill: var(--muted-strong);\n}\n.mc-barText--to { fill: var(--fg); }\n/* Printed ON a filled bar rather than after it. --bg, because every bar fill\n   here (--muted, --accent) is light in the dark palettes and dark in the light\n   one, exactly inverse to the ground. */\n.mc-barText--on { fill: var(--bg); }\n.mc-axis {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n\n/* Severity: colour is the third cue, after the count and the word. */\n.mc-sev { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }\n.mc-sevChip {\n  display: inline-flex;\n  align-items: baseline;\n  gap: var(--s2);\n  padding: var(--s1) var(--s3);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-xs);\n  color: var(--muted-strong);\n}\n.mc-sevDot { width: 8px; height: 8px; border-radius: 50%; flex: none; align-self: center; background-color: var(--muted); }\n.mc-sevChip[data-sev='critical'] .mc-sevDot { background-color: var(--signal-critical); }\n.mc-sevChip[data-sev='high'] .mc-sevDot { background-color: var(--signal-high); }\n.mc-sevChip[data-sev='medium'] .mc-sevDot { background-color: var(--signal-medium); }\n.mc-sevChip[data-sev='low'] .mc-sevDot { background-color: var(--signal-low); }\n.mc-sevN { font-family: var(--font-jetbrains-mono), ui-monospace, monospace; color: var(--fg); font-size: var(--text-sm); }\n.mc-sevWord { text-transform: capitalize; }\n\n/* ---------------- engagement band ---------------- */\n.eb { position: relative; margin: 0; min-width: 0; }\n.eb-svg { display: none; width: 100%; height: auto; overflow: visible; }\n@media (min-width: 760px) {\n  .eb-svg { display: block; }\n}\n.eb-seg { fill: var(--accent); }\n.eb-seg--alt { fill: var(--muted-strong); }\n.eb-segLabel { font-size: 12px; fill: var(--accent-fg); }\n.eb-seg--alt + .eb-segLabel { fill: var(--bg); }\n.eb-markLine { stroke: var(--border-strong); stroke-width: 1; stroke-dasharray: 2 3; }\n.eb-markDot { fill: var(--fg); }\n.eb-markLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  fill: var(--muted-strong);\n}\n.eb-axis { stroke: var(--border-strong); stroke-width: 1; }\n.eb-axisLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n\n.eb-list {\n  list-style: none;\n  margin: var(--s6) 0 0;\n  padding: 0;\n  display: grid;\n  gap: 0;\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 760px) {\n  .eb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s12); }\n}\n.eb-item {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--s3);\n  padding: var(--s3) 0;\n  border-bottom: 1px solid var(--border);\n  min-width: 0;\n  font-size: var(--text-sm);\n}\n.eb-itemName { color: var(--fg); min-width: 0; }\n.eb-itemWhen { color: var(--muted); font-size: var(--text-xs); }\n.eb-item[data-kind='mark'] .eb-itemName::before {\n  content: '';\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--fg);\n  margin-right: var(--s2);\n  vertical-align: 1px;\n}\n.eb-cap { margin: var(--s4) 0 0; font-size: var(--text-xs); color: var(--muted); max-width: 74ch; line-height: 1.6; }\n\n.reveal-group > * { --reveal-delay: calc(var(--reveal-base, 0ms) + 0ms); }\n.reveal-group > *:nth-child(2) { --reveal-delay: calc(var(--reveal-base, 0ms) + 60ms); }\n.reveal-group > *:nth-child(3) { --reveal-delay: calc(var(--reveal-base, 0ms) + 120ms); }\n.reveal-group > *:nth-child(4) { --reveal-delay: calc(var(--reveal-base, 0ms) + 180ms); }\n.reveal-group > *:nth-child(n + 5) { --reveal-delay: calc(var(--reveal-base, 0ms) + 240ms); }\n\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/4553-42d73557a9dc5e67.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/case-studies/%5Bslug%5D/page-f70c62bf7549d6f0.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>Onboarding found that 31% of configured log sources had never delivered an event — before a single detection was written. · Envenox</title><meta name=\"description\" content=\"The client had a SIEM, a vendor rule pack, an alert queue nobody read, and a managed service whose contractual commitment was measured on how fast an alert was forwarded. That service level rewards forwarding, so that is what it produced: 60 to 90 notifications a week, each requiring the client’s tw\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com/case-studies/logistics-mdr-rollout\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"Onboarding found that 31% of configured log sources had never delivered an event — before a single detection was written.\"/><meta property=\"og:description\" content=\"The client had a SIEM, a vendor rule pack, an alert queue nobody read, and a managed service whose contractual commitment was measured on how fast an alert was forwarded. That service level rewards forwarding, so that is what it produced: 60 to 90 notifications a week, each requiring the client’s tw\"/><meta property=\"og:url\" content=\"https://envenox.com/case-studies/logistics-mdr-rollout\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Onboarding found that 31% of configured log sources had never delivered an event — before a single detection was written.\"/><meta name=\"twitter:description\" content=\"The client had a SIEM, a vendor rule pack, an alert queue nobody read, and a managed service whose contractual commitment was measured on how fast an alert was forwarded. That service level rewards forwarding, so that is what it produced: 60 to 90 notifications a week, each requiring the client’s tw\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav them