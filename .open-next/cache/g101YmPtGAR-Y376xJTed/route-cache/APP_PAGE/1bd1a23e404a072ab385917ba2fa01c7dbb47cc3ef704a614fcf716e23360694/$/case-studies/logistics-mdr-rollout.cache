\",null,{\"children\":[[\"$\",\"blockquote\",null,{\"className\":\"cs-quote__text\",\"children\":\"The thing I had not understood is that we were paying for alert forwarding and calling it detection. Twenty-two log sources had been dead for years and our previous provider’s dashboard showed them green, because it showed configuration, not delivery.\"}],[\"$\",\"figcaption\",null,{\"className\":\"cs-quote__attr\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-avatar-placeholder\",\"precedence\":\"default\",\"children\":\"\\n.avatar-ph {\\n  display: grid;\\n  place-items: center;\\n  flex: none;\\n  border-radius: var(--radius-md);\\n  border: 1px solid var(--border);\\n  color: var(--paper-50);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 600;\\n  letter-spacing: 0.02em;\\n  line-height: 1;\\n  user-select: none;\\n  overflow: hidden;\\n}\\n.avatar-ph--round { border-radius: 50%; }\\n\"}],[\"$\",\"div\",null,{\"role\":\"img\",\"aria-label\":\"Placeholder portrait for Information Security Manager\",\"className\":\"avatar-ph\",\"style\":{\"width\":56,\"height\":56,\"fontSize\":19,\"backgroundImage\":\"linear-gradient(135deg, hsl(257 18% 22%), hsl(257 22% 14%))\"},\"children\":[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"IM\"}]}]],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-quote__name\",\"children\":\"Information Security Manager\"}],[\"$\",\"p\",null,{\"className\":\"cs-quote__role\",\"children\":[\"Information Security Manager\",\" · \",\"Freight and customs broker\"]}]]}]]}]]}]]}]}]}]]\n3d:Td60,\n.prose {\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n.prose > * + * { margin-top: var(--s4); }\n\n.prose h2,\n.prose h3,\n.prose h4 { color: var(--fg); text-wrap: balance; }\n.prose h2 { font-size: var(--text-2xl); margin-top: var(--s12); }\n.prose h3 { font-size: var(--text-xl); margin-top: var(-