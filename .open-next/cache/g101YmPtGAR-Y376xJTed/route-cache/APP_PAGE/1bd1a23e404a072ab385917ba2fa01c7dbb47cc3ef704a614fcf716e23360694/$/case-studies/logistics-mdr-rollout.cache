x-direction: column;\n  gap: var(--s2);\n  min-width: 0;\n  border-top: 1px solid var(--border-strong);\n  padding-top: var(--s4);\n}\n.metric__value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n@media (min-width: 768px) {\n  .metric__value { font-size: var(--text-3xl); }\n}\n.metric__label {\n  margin: 0;\n  color: var(--muted-strong);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n  max-width: 34ch;\n}\n.metric__note {\n  margin: var(--s2) 0 0;\n  padding-top: var(--s2);\n  border-top: 1px solid var(--border);\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 36ch;\n}\n.metric__note-key {\n  display: block;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 2px;\n}\n\n/* ---------------- NDA block ---------------- */\n.nda {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--s3);\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\n  border-radius: var(--radius-md);\n  padding: var(--s3) var(--s4);\n}\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.nda__kicker {\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.nda__name {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n}\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\n\n/* ---------------- dual-pillar marker ---------------- */\n.dual {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s2) var(--s3);\n  color: var(--fg);\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  text-decoration: none;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\n.dual__icon { color: var(--accent); flex: none; }\n\n/* ---------------- case study card ---------------- */\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\n.cs-card__client {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  color: var(--muted-strong);\n}\n.cs-card__headline {\n  margin: 0;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.cs-card__headline a { color: inherit; text-decoration: none; }\n.cs-card__meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--s2) var(--s4);\n  font-size: var(--text-xs);\n  color: var(--muted);\n  margin: 0;\n}\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-card__metric {\n  margin-top: auto;\n  padding-top: var(--s4);\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n}\n.cs-card__metric-value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.1;\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\n\n/* ---------------- testimonial rail ---------------- */\n.trail {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\n  gap: var(--s4);\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  scroll-snap-type: x mandatory;\n  list-style: none;\n  margin: 0;\n  padding: 0 0 var(--s4);\n  scrollbar-width: thin;\n}\n@media (min-width: 768px) {\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\n}\n.trail > li { scroll-snap-align: start; min-width: 0; }\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.trail__quote {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n@media (min-width: 768px) {\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\n}\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------------- named-humans CTA ---------------- */\n.humans { display: grid; gap: var(--s8); }\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n.human { display: flex; align-items: center; gap: var(--s4); }\n.human__name {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-base);\n  font-weight: 500;\n  color: var(--fg);\n}\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\n54:[\"$\",\"$L3f\",\"fintech-payment-platform\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-proof-surfaces\",\"precedence\":\"default\",\"children\":\"$86\"}],\"$L87\"]}]\n55:[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s8)\"},\"children\":[[\"$\",\"$Le\",null,{\"href\":\"/case-studies\",\"className\":\"u-link\",\"children\":\"All case studies\"}],\" · \",[\"$\",\"$Le\",null,{\"href\":\"/sample-report\",\"className\":\"u-link\",\"children\":\"Walk a sample report\"}]]}]\n88:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n57:[\"$\",\"div\",null,{\"className\":\"humans\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"cs-cta\",\"style\":{\"fontSize\":\"var(--text-3xl)\",\"margin\":\"var(--s3) 0 0\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"style\":{\"color\":\"var(--muted-strong)\",\"maxWidth\":\"52ch\",\"marginTop\":\"var(--s4)\"},\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"div\",null,{\"className\":\"humans__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$88\"}],\"$L89\"],[\"$L8a\",\"$L8b\"]]}],\"$L8c\"]}],\"$L8d\"]}]\n5b:[\"$\",\"div\",null,{\"className\":\"nda\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":18,\"height\":18,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.3333333333333335,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lock nda__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"1w4ew1\",{\"width\":\"18\",\"height\":\"11\",\"x\":\"3\",\"y\":\"11\",\"rx\":\"2\",\"ry\":\"2\"}],[\"$\",\"path\",\"fwvmzm\",{\"d\":\"M7 11V7a5 5 0 0 1 10 0v4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"nda__body\",\"children\":[[\"$\",\"span\",null,{\"className\":\"nda__kicker u-mono\",\"children\":\"Named under NDA\"}],[\"$\",\"p\",null,{\"className\":\"nda__name\",\"children\":\"Freight and customs broker, 1,200 employees\"}],[\"$\",\"p\",null,{\"className\":\"nda__note\",\"children\":\"Metrics, technical detail and the attributed quote are published with written client approval. The name is not.\"}]]}]]}]\n5c:[\"$\",\"h1\",null,{\"id\":\"cs-headline\",\"className\":\"cs-headline\",\"children\":\"Onboarding found that 31% of configured log sources had never delivered an event — before a single detection was written.\"}]\n8e:T172f,\n/* ---------------- metric chart ---------------- */\n.mc { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .mc { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s12); }\n  /* The results column beside the headline is roughly 40% of the viewport, and\n     a media query measures the viewport rather than that column — so the stack\n     variant opts out of the three-up grid explicitly. */\n  .mc--stack { grid-template-columns: minmax(0, 1fr); gap: var(--s8); }\n}\n.mc-row {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  padding-top: var(--s4);\n  border-top: 1px solid var(--border-strong);\n}\n.mc-value {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n  overflow-wrap: anywhere;\n}\n.mc-label { margin: 0; color: var(--muted-strong); font-size: var(--text-sm); line-height: 1.5; }\n.mc-art { margin-top: var(--s3); min-width: 0; }\n.mc-svg { width: 100%; height: auto; max-width: 22rem; overflow: visible; }\n.mc-note { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.55; }\n.mc-noteKey {\n  display: block;\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  /* --muted, not --border-strong: in .theme-dark --border-strong is #3d342c\n     against a #1f1a16 surface, which is a hairline value and not a text value.\n     This matches .metric__note-key in proof.tsx, which is the same label. */\n  color: var(--muted);\n  margin-bottom: var(--s1);\n}\n.mc-nochart { margin: 0; font-size: var(--text-xs); color: var(--muted); max-width: 34ch; line-height: 1.55; }\n\n/* The \"before\" bar is DATA, so it takes a text-weight neutral rather than a\n   hairline one — --border-strong is a 1px value and disappears as a 13px bar\n   in .theme-dark. The track behind a share is FRAME, so it takes a diluted\n   version of the same neutral and stays quiet under the accent fill. */\n.mc-barFrom { fill: var(--muted); }\n.mc-barTo { fill: var(--accent); }\n.mc-track { fill: color-mix(in oklab, var(--muted) 42%, transparent); }\n.mc-track--open {\n  fill: none;\n  stroke: var(--muted);\n  stroke-width: 1;\n  stroke-dasharray: 3 3;\n}\n.mc-fill { fill: var(--accent); }\n.mc-limit { stroke: var(--muted); stroke-width: 1.5; }\n.mc-rule { stroke: var(--border-strong); stroke-width: 1; }\n.mc-barText {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  fill: var(--muted-strong);\n}\n.mc-barText--to { fill: var(--fg); }\n/* Printed ON a filled bar rather than after it. --bg, because every bar fill\n   here (--muted, --accent) is light in the dark palettes and dark in the light\n   one, exactly inverse to the ground. */\n.mc-barText--on { fill: var(--bg); }\n.mc-axis {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n\n/* Severity: colour is the third cue, after the count and the word. */\n.mc-sev { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }\n.mc-sevChip {\n  display: inline-flex;\n  align-items: baseline;\n  gap: var(--s2);\n  padding: var(--s1) var(--s3);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-xs);\n  color: var(--muted-strong);\n}\n.mc-sevDot { width: 8px; height: 8px; border-radius: 50%; flex: none; align-self: center; background-color: var(--muted); }\n.mc-sevChip[data-sev='critical'] .mc-sevDot { background-color: var(--signal-critical); }\n.mc-sevChip[data-sev='high'] .mc-sevDot { background-color: var(--signal-high); }\n.mc-sevChip[data-sev='medium'] .mc-sevDot { background-color: var(--signal-medium); }\n.mc-sevChip[data-sev='low'] .mc-sevDot { background-color: var(--signal-low); }\n.mc-sevN { font-family: var(--font-jetbrains-mono), ui-monospace, monospace; color: var(--fg); font-size: var(--text-sm); }\n.mc-sevWord { text-transform: capitalize; }\n\n/* ---------------- engagement band ---------------- */\n.eb { position: relative; margin: 0; min-width: 0; }\n.eb-svg { display: none; width: 100%; height: auto; overflow: visible; }\n@media (min-width: 760px) {\n  .eb-svg { display: block; }\n}\n.eb-seg { fill: var(--accent); }\n.eb-seg--alt { fill: var(--muted-strong); }\n.eb-segLabel { font-size: 12px; fill: var(--accent-fg); }\n.eb-seg--alt + .eb-segLabel { fill: var(--bg); }\n.eb-markLine { stroke: var(--border-strong); stroke-width: 1; stroke-dasharray: 2 3; }\n.eb-markDot { fill: var(--fg); }\n.eb-markLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  fill: var(--muted-strong);\n}\n.eb-axis { stroke: var(--border-strong); stroke-width: 1; }\n.eb-axisLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n\n.eb-list {\n  list-style: none;\n  margin: var(--s6) 0 0;\n  padding: 0;\n  display: grid;\n  gap: 0;\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 760px) {\n  .eb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s12); }\n}\n.eb-item {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--s3);\n  padding: var(--s3) 0;\n  border-bottom: 1px solid var(--border);\n  min-width: 0;\n  font-size: var(--text-sm);\n}\n.eb-itemName { color: var(--fg); min-width: 0; }\n.eb-itemWhen { color: var(--muted); font-size: var(--text-xs); }\n.eb-item[data-kind='mark'] .eb-itemName::before {\n  content: '';\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--fg);\n  margin-right: var(--s2);\n  vertical-align: 1px;\n}\n.eb-cap { margin: var(--s4) 0 0; font-size: var(--text-xs); color: var(--muted); max-width: 74ch; line-height: 1.6; }\n5d:[\"$\",\"div\",null,{\"className\":\"cs-hero__results\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow cs-results__key\",\"children\":\"Results\"}],[[\"$\",\"style\",null,{\"href\":\"envenox-case-charts\",\"precedence\":\"default\",\"children\":\"$8e\"}],\"$L8f\"]]}]\n5e:[\"$\",\"span\",null,{\"className\":\"product_cell__AfUwO\",\"role\":\"cell\",\"children\":[\"$\",\"span\",null,{\"className\":\"product_state__cr6xI\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_stateDot__YKybR \",\"aria-hidden\":\"true\"}],\"Contained\",[\"$\",\"span\",null,{\"className\":\"product_srOnly__1a3B7\",\"children\":\" — shown in the detail pane below\"}]]}]}]\n5f:[\"$\",\"div\",\"ENX-88209\",{\"className\":\"product_row__geDuE product_rowHover__qWq3Y\",\"role\":\"row\",\"style\":{\"--enter-delay\":\"120ms\"},\"children\":[[\"$\",\"span\",null,{\"className\":\"product_cell__AfUwO product_railCell__vgygh product_sevCritical__qnAYH\",\"role\":\"cell\",\"children\":[\"$\",\"span\",null,{\"className\":\"product_sevBadge__tIWHP product_sevCritical__qnAYH\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevMark__N39VN\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"className\":\"product_srOnly__1a3B7\",\"children\":[\"Severity\",\": \"]}],\"Critical\"]}]}],[\"$\",\"span\",n