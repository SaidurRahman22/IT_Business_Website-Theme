g) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"2f:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section-tight\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"cs-engagement\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"cs-engagement\\\",\\\"className\\\":\\\"u-eyebrow\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s8)\\\"},\\\"children\\\":\\\"The engagement\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"cs-facts\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"cs-fact\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-fact__key u-eyebrow\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":14,\\\"height\\\":14,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":3,\\\"strokeLinecap\\\":\\\"round\\\",\\\"s