var(--text-xs); color: var(--muted); }\n\n/* ---------------- named-humans CTA ---------------- */\n.humans { display: grid; gap: var(--s8); }\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n.human { display: flex; align-items: center; gap: var(--s4); }\n.human__name {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-base);\n  font-weight: 500;\n  color: var(--fg);\n}\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\n39:[\"$\",\"div\",null,{\"className\":\"cs-hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-hero__main\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-meta__markers\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-meta__nda\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-proof-surfaces\",\"precedence\":\"default\",\"children\":\"$54\"}],\"$L55\"]}],\"$L56\"]}],\"$L57\"]}],\"$L58\"]}]\n3b:[\"$\",\"div\",null,{\"className\":\"prose u-measure\",\"children\":[\"$\",\"p\",null,{\"children\":\"A SOC 2 Type II commitment to a large customer, a CSPM tool producing 1,840 findings, and an engineering team of nineteen with no security specialist. The findings list had been triaged twice and abandoned twice, because a list ranked by vendor severity and filtered by nothing gives a team no way to decide what to do on Monday. Separately, deploying to production depended on one engineer and a laptop.\"}]}]\n3c:[\"$\",\"div\",null,{\"className\":\"cs-band\",\"style\":{\"marginTop\":\"var(--s24)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-band__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":[\"In \",6,\" phases\"]}],[\"$\",\"h2\",null,{\"id\":\"cs-approach\",\"className\":\"cs-band__title\",\"children\":\"The approach\"}]]}],[\"$\",\"$L4a\",null,{\"as\":\"ol\",\"className\":\"cs-phases\",\"aria-labelledby\":\"cs-approach\",\"children\":[[\"$\",\"$L4b\",\"1\",{\"as\":\"li\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-phase\",\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-phase__n u-mono u-tnum\",\"children\":\"01\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"cs-phase__name\",\"children\":\"Build the identity graph\"}],[\"$\",\"p\",null,{\"className\":\"cs-phase__body\",\"children\":\"Every human user, service principal, CI role, instance profile, cross-account trust and OIDC federation, read from the actual policy documents rather than the console summary. Enumeration took hours; the analysis took three weeks.\"}]]}]]}]}],[\"$\",\"$L4b\",\"2\",{\"as\":\"li\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-phase\",\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-phase__n u-mono u-tnum\",\"children\":\"02\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"cs-phase__name\",\"children\":\"Filter the findings by reachability\"}],[\"$\",\"p\",null,{\"className\":\"cs-phase__body\",\"children\":\"We ingested the CSPM output and filtered to what is exploitable in this topology. 1,840 became 210, and 210 is a list a team of nineteen can act on.\"}]]}]]}]}],[\"$\",\"$L4b\",\"3\",{\"as\":\"li\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-phase\",\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-phase__n u-mono u-tnum\",\"children\":\"03\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"cs-phase__name\",\"children\":\"Fix the paths, as pull requests\"}],[\"$\",\"p\",null,{\"className\":\"cs-phase__body\",\"children\":\"Terraform for every recommended change, raised against their infrastructure repository and reviewed by their engineers like any other change. A diff beats a recommendation.\"}]]}]]}]}],[\"$\",\"$L4b\",\"4\",{\"as\":\"li\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-phase\",\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-phase__n u-mono u-tnum\",\"children\":\"04\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"cs-phase__name\",\"children\":\"Move the pipeline identity\"}],[\"$\",\"p\",null,{\"className\":\"cs-phase__body\",\"children\":\"Long-lived access keys in CI replaced with short-lived OIDC federation scoped per environment. This was the root of the four-step path and it is the most common cloud finding we report.\"}]]}]]}]}],[\"$\",\"$L4b\",\"5\",{\"as\":\"li\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-phase\",\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-phase__n u-mono u-tnum\",\"children\":\"05\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"cs-phase__name\",\"children\":\"Make deployment boring\"}],[\"$\",\"p\",null,{\"className\":\"cs-phase__body\",\"children\":\"Build-once-promote pipeline, preview environments per pull request, automated rollback on signal. The dependency on one engineer and one laptop was removed in week six.\"}]]}]]}]}],[\"$\",\"$L4b\",\"6\",{\"as\":\"li\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-phase\",\"children\":[[\"$\",\"p\",null,{\"className\":\"cs-phase__n u-mono u-tnum\",\"children\":\"06\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"cs-phase__name\",\"children\":\"Re-run the graph\"}],[\"$\",\"p\",null,{\"className\":\"cs-phase__body\",\"children\":\"After remediation, to confirm the paths were closed rather than relocated — which is a real failure mode when fixes are applied individually.\"}]]}]]}]}]]}]]}]\n3e:[\"$\",\"div\",null,{\"className\":\"prose u-measure\",\"children\":[\"$\",\"p\",null,{\"children\":\"The path: any contributor could open a pull request; the pull-request workflow ran with the same long-lived AWS access key as the deploy workflow, because both used the repository-level secret; that key’s role could assume the production deployment role via a trust policy with no external ID and no condition on the source workflow; the deployment role carried `kms:Decrypt` on the key protecting the customer database snapshot bucket, because a restore script had needed it once in 2023 and the permission had never been removed. Four steps, no exploit, no vulnerability in any software — four configuration decisions each of which was locally reasonable. No CSPM tool ranked any of them above medium, because individually none of them is above medium. The fix was OIDC federation with a condition on both the repository and the branch, a scoped deployment role per environment, and the removal of the 2023 permission.\"}]}]\n40:[\"$\",\"figure\",null,{\"className\":\"eb\",\"id\":\"$undefined\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"eb-svg\",\"viewBox\":\"0 0 1000 146\",\"preserveAspectRatio\":\"xMidYMid meet\",\"role\":\"img\",\"aria-label\":\"Engagement timeline for this study, 48 weeks end to end. Identity graph, 3 weeks. remediation, 14 weeks. verification at 17 weeks. SOC 2 Type II achieved at 48 weeks.\",\"children\":[[[\"$\",\"g\",\"Identity graph 3 weeks-0\",{\"children\":[[\"$\",\"rect\",null,{\"className\":\"eb-seg\",\"x\":0,\"y\":74,\"width\":62.76807197405587,\"height\":26}],null]}],[\"$\",\"g\",\"remediation 14 weeks-1\",{\"children\":[[\"$\",\"rect\",null,{\"className\":\"eb-seg eb-seg--alt\",\"x\":62.76807197405587,\"y\":74,\"width\":292.91766921226076,\"height\":26}],[\"$\",\"text\",null,{\"className\":\"eb-segLabel\",\"x\":70.76807197405587,\"y\":91,\"children\":\"remediation\"}]]}]],[[\"$\",\"g\",\"verification week 17-0\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"eb-markLine\",\"x1\":355.6857411863166,\"y1\":24,\"x2\":355.6857411863166,\"y2\":100}],[\"$\",\"circle\",null,{\"className\":\"eb-markDot\",\"cx\":355.6857411863166,\"cy\":100,\"r\":3.5}],[\"$\",\"text\",null,{\"className\":\"eb-markLabel\",\"x\":361.6857411863166,\"y\":20,\"textAnchor\":\"start\",\"children\":\"verification\"}]]}],[\"$\",\"g\",\"SOC 2 Type II achieved month 11-1\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"eb-markLine\",\"x1\":999,\"y1\":44,\"x2\":999,\"y2\":100}],[\"$\",\"circle\",null,{\"className\":\"eb-markDot\",\"cx\":999,\"cy\":100,\"r\":3.5}],[\"$\",\"text\",null,{\"className\":\"eb-markLabel\",\"x\":993,\"y\":40,\"textAnchor\":\"end\",\"children\":\"SOC 2 Type II achieved\"}]]}]],[\"$\",\"line\",null,{\"className\":\"eb-axis\",\"x1\":0,\"y1\":112,\"x2\":1000,\"y2\":112}],[\"$\",\"text\",null,{\"className\":\"eb-axisLabel\",\"x\":0,\"y\":128,\"children\":\"week 0\"}],[\"$\",\"text\",null,{\"className\":\"eb-axisLabel\",\"x\":1000,\"y\":128,\"textAnchor\":\"end\",\"children\":\"week 48\"}]]}],[\"$\",\"ol\",null,{\"className\":\"eb-list\",\"children\":[[\"$\",\"li\",\"Identity graph 3 weeks-0\",{\"className\":\"eb-item\",\"data-kind\":\"span\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eb-itemName\",\"children\":\"Identity graph\"}],[\"$\",\"span\",null,{\"className\":\"eb-itemWhen u-mono\",\"children\":\"3 weeks\"}]]}],[\"$\",\"li\",\"remediation 14 weeks-1\",{\"className\":\"eb-item\",\"data-kind\":\"span\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eb-itemName\",\"children\":\"remediation\"}],[\"$\",\"span\",null,{\"className\":\"eb-itemWhen u-mono\",\"children\":\"14 weeks\"}]]}],[\"$\",\"li\",\"verification week 17-2\",{\"className\":\"eb-item\",\"data-kind\":\"mark\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eb-itemName\",\"children\":\"verification\"}],[\"$\",\"span\",null,{\"className\":\"eb-itemWhen u-mono\",\"children\":\"week 17\"}]]}],[\"$\",\"li\",\"SOC 2 Type II achieved month 11-3\",{\"className\":\"eb-item\",\"data-kind\":\"mark\",\"children\":[[\"$\",\"span\",null,{\"className\":\"eb-itemName\",\"children\":\"SOC 2 Type II achieved\"}],[\"$\",\"span\",null,{\"className\":\"eb-itemWhen u-mono\",\"children\":\"month 11\"}]]}]]}],[\"$\",\"figcaption\",null,{\"className\":\"eb-cap\",\"children\":\"Segment length is this engagement’s own stated duration, converted to weeks and drawn to one scale. A stage stated as a date rather than a length — “month 11” — is drawn as a milestone on the same axis instead of being given a width it never had, and a stage with no stated end is listed below rather than drawn, because an open commitment has no length to draw.\"}]]}]\n42:[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--neutral\",\"children\":[null,\"AWS\"]}]\n59:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n43:[\"$\",\"li\",\"Terraform\",{\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$59\"}],[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--neutral\",\"children\":[null,\"Terraform\"]}]]}]\n5a:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component shou