;\\n}\\n\\n/* --- the only --signal-* usage in the codebase --- */\\n.badge--severity {\\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\\n  --badge-fg: var(--sig);\\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"37:[\\\"$\\\",\\\"li\\\",\\\"grc-compliance\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/services/grc-compliance\\\",\\\"className\\\":\\\"cs-meta__tag-link\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-badge\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$53\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"badge badge--sm badge--neutral\\\",\\\"children\\\":[null,\\\"GRC \\u0026 Compliance\\\"]}]]}]}]\\n38:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-meta__cell\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"cs-meta__key u-mono\\\",\\\"children\\\":\\\"Engagement\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-meta__value\\\",\\\"children\\\":[\\\"3 weeks review, 14 weeks remediation\\\",\\\" · \\\",\\\"Project\\\"]}]]}]\\n54:T1b85,\"])</script><script>self.__next_f.push([1,\"\\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\\n.metrics {\\n  display: grid;\\n  gap: var(--s8);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n@media (min-width: 768px) {\\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\\n}\\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\\n   headline rather than in a full-width row under it. */\\n.metrics--stack { gap: var(--s4); }\\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\\n/* The key runs inline with its note in the stacked variant — one line saved per\\n   metric is what keeps all three on the first screen. */\\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\\n.metrics--stack .metric__note-key::after { content: ' — '; }\\n.metric {\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s2);\\n  min-width: 0;\\n  border-top: 1px solid var(--border-strong);\\n  padding-top: var(--s4);\\n}\\n.metric__value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  line-height: 1.05;\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n@media (min-width: 768px) {\\n  .metric__value { font-size: var(--text-3xl); }\\n}\\n.metric__label {\\n  margin: 0;\\n  color: var(--muted-strong);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n  max-width: 34ch;\\n}\\n.metric__note {\\n  margin: var(--s2) 0 0;\\n  padding-top: var(--s2);\\n  border-top: 1px solid var(--border);\\n  font-size: var(--text-xs);\\n  line-height: 1.5;\\n  color: var(--muted);\\n  max-width: 36ch;\\n}\\n.metric__note-key {\\n  display: block;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n  margin-bottom: 2px;\\n}\\n\\n/* ---------------- NDA block ---------------- */\\n.nda {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: var(--s3);\\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\\n  border-radius: var(--radius-md);\\n  padding: var(--s3) var(--s4);\\n}\\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.nda__kicker {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.nda__name {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n}\\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\\n\\n/* ---------------- dual-pillar marker ---------------- */\\n.dual {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-md);\\n  padding: var(--s2) var(--s3);\\n  color: var(--fg);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\\n.dual__icon { color: var(--accent); flex: none; }\\n\\n/* ---------------- case study card ---------------- */\\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\\n.cs-card__client {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n}\\n.cs-card__headline {\\n  margin: 0;\\n  font-size: var(--text-lg);\\n  font-weight: 500;\\n  line-height: var(--leading-snug);\\n  color: var(--fg);\\n}\\n.cs-card__headline a { color: inherit; text-decoration: none; }\\n.cs-card__meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s2) var(--s4);\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  margin: 0;\\n}\\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-card__metric {\\n  margin-top: auto;\\n  padding-top: var(--s4);\\n  border-top: 1px solid var(--border);\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s1);\\n}\\n.cs-card__metric-value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-xl);\\n  font-weight: 600;\\n  letter-spacing: var(--tracking-tight);\\n  line-height: 1.1;\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\\n\\n/* ---------------- testimonial rail ---------------- */\\n.trail {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\\n  gap: var(--s4);\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  scroll-snap-type: x mandatory;\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 var(--s4);\\n  scrollbar-width: thin;\\n}\\n@media (min-width: 768px) {\\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\\n}\\n.trail \\u003e li { scroll-snap-align: start; min-width: 0; }\\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.trail__quote {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-base);\\n  line-height: var(--leading-normal);\\n}\\n@media (min-width: 768px) {\\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\\n}\\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\\n\\n/* ---------------- named-humans CTA ---------------- */\\n.humans { display: grid; gap: var(--s8); }\\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\\n.human { display: flex; align-items: center; gap: var(--s4); }\\n.human__name {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-base);\\n  font-weight: 500;\\n  color: var(--fg);\\n}\\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\\n\"])</script><script>self.__next_f.push([1,\"39:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-hero\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-hero__main\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-meta__markers\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-meta__nda\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-proof-surfaces\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$54\\\"}],\\\"$L55\\\"]}],\\\"$L56\\\"]}],\\\"$L57\\\"]}],\\\"$L58\\\"]}]\\n3b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose u-measure\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"A SOC 2 Type II commitment to a large customer, a CSPM tool producing 1,840 findings, and an engineering team of nineteen with no security specialist. The findings list had been triaged twice and abandoned twice, because a list ranked by vendor severity and filtered by nothing gives a team no way to decide what to do on Monday. Separately, deploying to production depended on one engineer and a laptop.\\\"}]}]\\n\"])</script><script>self.__next_f.push([1,\"3c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-band\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s24)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-band__head\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":[\\\"In \\\",6,\\\" phases\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"cs-approach\\\",\\\"className\\\":\\\"cs-band__title\\\",\\\"children\\\":\\\"The approach\\\"}]]}],[\\\"$\\\",\\\"$L4a\\\",null,{\\\"as\\\":\\\"ol\\\",\\\"className\\\":\\\"cs-phases\\\",\\\"aria-labelledby\\\":\\\"cs-approach\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L4b\\\",\\\"1\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-phase\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__n u-mono u-tnum\\\",\\\"children\\\":\\\"01\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-phase__name\\\",\\\"children\\\":\\\"Build the identity graph\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__body\\\",\\\"children\\\":\\\"Every human user, service principal, CI role, instance profile, cross-account trust and OIDC federation, read from the actual policy documents rather than the console summary. Enumeration took hours; the analysis took three weeks.\\\"}]]}]]}]}],[\\\"$\\\",\\\"$L4b\\\",\\\"2\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-phase\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__n u-mono u-tnum\\\",\\\"children\\\":\\\"02\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-phase__name\\\",\\\"children\\\":\\\"Filter the findings by reachability\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__body\\\",\\\"children\\\":\\\"We ingested the CSPM output and filtered to what is exploitable in this topology. 1,840 became 210, and 210 is a list a team of nineteen can act on.\\\"}]]}]]}]}],[\\\"$\\\",\\\"$L4b\\\",\\\"3\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-phase\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__n u-mono u-tnum\\\",\\\"children\\\":\\\"03\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-phase__name\\\",\\\"children\\\":\\\"Fix the paths, as pull requests\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__body\\\",\\\"children\\\":\\\"Terraform for every recommended change, raised against their infrastructure repository and reviewed by their engineers like any other change. A diff beats a recommendation.\\\"}]]}]]}]}],[\\\"$\\\",\\\"$L4b\\\",\\\"4\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-phase\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__n u-mono u-tnum\\\",\\\"children\\\":\\\"04\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-phase__name\\\",\\\"children\\\":\\\"Move the pipeline identity\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__body\\\",\\\"children\\\":\\\"Long-lived access keys in CI replaced with short-lived OIDC federation scoped per environment. This was the root of the four-step path and it is the most common cloud finding we report.\\\"}]]}]]}]}],[\\\"$\\\",\\\"$L4b\\\",\\\"5\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-phase\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__n u-mono u-tnum\\\",\\\"children\\\":\\\"05\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-phase__name\\\",\\\"children\\\":\\\"Make deployment boring\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__body\\\",\\\"children\\\":\\\"Build-once-promote pipeline, preview environments per pull request, automated rollback on signal. The dependency on one engineer and one laptop was removed in week six.\\\"}]]}]]}]}],[\\\"$\\\",\\\"$L4b\\\",\\\"6\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-phase\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__n u-mono u-tnum\\\",\\\"children\\\":\\\"06\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-phase__name\\\",\\\"children\\\":\\\"Re-run the graph\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-phase__body\\\",\\\"children\\\":\\\"After remediation, to confirm the paths were closed rather than relocated — which is a real failure mode when fixes are applied individually.\\\"}]]}]]}]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"3e:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose u-measure\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The path: any contributor could open a pull request; the pull-request workflow ran with the same long-lived AWS access key as the deploy workflow, because both used the repository-level secret; that key’s role could assume the production deployment role via a trust policy with no external ID and no condition on the source workflow; the deployment role carried `kms:Decrypt` on the key protecting the customer database snapshot bucket, because a restore script had needed it once in 2023 and the permission had never been removed. Four steps, no exploit, no vulnerability in any software — four configuration decisions each of which was locally reasonable. No CSPM tool ranked any of them above medium, because individually none of them is above medium. The fix was OIDC federation with a condition on both the repository and the branch, a scoped deployment role per environment, and the removal of the 2023 permission.\\\"}]}]\\n\"])</script><script>self.__next_f.push([1,\"40:[\\\"$\\\",\\\"figure\\\",null,{\\\"className\\\":\\\"eb\\\",\\\"id\\\":\\\"$undefined\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"eb-svg\\\",\\\"viewBox\\\":\\\"0 0 1000 146\\\",\\\"preserveAspectRatio\\\":\\\"xMidYMid meet\\\",\\\"role\\\":\\\"img\\\",\\\"aria-label\\\":\\\"Engagement timeline for this study, 48 weeks end to end. Identity graph, 3 weeks. remediation, 14 weeks. verification at 17 weeks. SOC 2 Type II achieved at 48 weeks.\\\",\\\"children\\\":[[[\\\"$\\\",\\\"g\\\",\\\"Identity graph 3 weeks-0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"eb-seg\\\",\\\"x\\\":0,\\\"y\\\":74,\\\"width\\\":62.76807197405587,\\\"height\\\":26}],null]}],[\\\"$\\\",\\\"g\\\",\\\"remediation 14 weeks-1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"eb-seg eb-seg--alt\\\",\\\"x\\\":62.76807197405587,\\\"y\\\":74,\\\"width\\\":292.91766921226076,\\\"height\\\":26}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"eb-segLabel\\\",\\\"x\\\":70.76807197405587,\\\"y\\\":91,\\\"children\\\":\\\"remediation\\\"}]]}]],[[\\\"$\\\",\\\"g\\\",\\\"verification week 17-0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"line\\\",null,{\\\"className\\\":\\\"eb-markLine\\\",\\\"x1\\\":355.6857411863166,\\\"y1\\\":24,\\\"x2\\\":355.6857411863166,\\\"y2\\\":100}],[\\\"$\\\",\\\"circle\\\",null,{\\\"className\\\":\\\"eb-markDot\\\",\\\"cx\\\":355.6857411863166,\\\"cy\\\":100,\\\"r\\\":3.5}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"eb-markLabel\\\",\\\"x\\\":361.6857411863166,\\\"y\\\":20,\\\"textAnchor\\\":\\\"start\\\",\\\"chi