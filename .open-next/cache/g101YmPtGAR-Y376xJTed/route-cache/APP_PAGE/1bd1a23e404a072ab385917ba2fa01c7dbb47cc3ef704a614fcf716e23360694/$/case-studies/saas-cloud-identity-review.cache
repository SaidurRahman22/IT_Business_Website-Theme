rumb { font-size: var(--text-xs); color: var(--muted); }\\n.cs-breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-breadcrumb li { display: inline-flex; align-items: center; gap: var(--s2); }\\n.cs-breadcrumb li + li::before { content: '/'; color: var(--border-strong); }\\n.cs-breadcrumb a { color: var(--muted); text-decoration: none; }\\n.cs-breadcrumb a:hover { color: var(--fg); }\\n.cs-breadcrumb [aria-current='page'] { color: var(--muted-strong); }\\n\\n/* ---------------- metadata bar ---------------- */\\n.cs-meta {\\n  display: grid;\\n  gap: var(--s6);\\n  margin-top: var(--s6);\\n  padding-block: var(--s4);\\n  border-top: 1px solid var(--border);\\n  border-bottom: 1px solid var(--border);\\n}\\n@media (min-width: 480px) {\\n  .cs-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s8); }\\n}\\n@media (min-width: 768px) {\\n  .cs-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s12); }\\n}\\n@media (min-width: 1100px) {\\n  .cs-meta { grid-template-columns: repeat(4, minmax(0, 1fr)); }\\n}\\n.cs-meta__cell { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }\\n.cs-meta__key {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n.cs-meta__value { margin: 0; color: var(--fg); font-size: var(--text-sm); line-height: 1.45; }\\n.cs-meta__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-meta__tag-link { text-decoration: none; }\\n.cs-meta__nda { max-width: 46ch; flex: 1 1 24rem; min-width: 0; }\\n.cs-meta__markers {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s4);\\n  margin-bottom: var(--s6);\\n}\\n\\n/* THE ABOVE-THE-FOLD CONTRACT.\\n   The three metrics sit beside the headline from 1024px up rather than under\\n   it, so they are on the first screen without shrinking the h1. DOM order is\\n   unchanged — metadata bar, headline, metrics — because that order is the\\n   template and a screen reader follows the DOM, not the grid. */\\n.cs-hero { display: grid; gap: var(--s12); margin-top: var(--s8); }\\n@media (min-width: 1024px) {\\n  .cs-hero {\\n    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);\\n    gap: var(--s16);\\n    align-items: start;\\n  }\\n}\\n.cs-hero__main { min-width: 0; }\\n.cs-hero__results { min-width: 0; }\\n\\n/* ---------------- headline ---------------- */\\n.cs-headline {\\n  margin: 0;\\n  font-size: var(--text-2xl);\\n  line-height: var(--leading-snug);\\n  max-width: 24ch;\\n}\\n@media (min-width: 768px) { .cs-headline { font-size: var(--text-3xl); max-width: 20ch; } }\\n@media (min-width: 1024px) { .cs-headline { font-size: var(--text-4xl); max-width: 16ch; } }\\n\\n.cs-results__key { margin: 0 0 var(--s4); }\\n\\n/* ---------------- two-column band ---------------- */\\n.cs-band { display: grid; gap: var(--s8); }\\n@media (min-width: 1024px) {\\n  .cs-band { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: var(--s16); align-items: start; }\\n}\\n.cs-band__head { display: flex; flex-direction: column; gap: var(--s3); }\\n.cs-band__title { margin: 0; font-size: var(--text-2xl); }\\n.cs-band__hint { margin: 0; font-size: var(--text-sm); color: var(--muted); max-width: 34ch; }\\n\\n/* ---------------- approach ---------------- */\\n.cs-phases { list-style: none; margin: 0; padding: 0; }\\n.cs-phases \\u003e li { border-top: 1px solid var(--border); padding-block: var(--s6); }\\n.cs-phases \\u003e li:last-child { border-bottom: 1px solid var(--border); }\\n.cs-phase { display: grid; gap: var(--s3); }\\n@media (min-width: 640px) { .cs-phase { grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s4); } }\\n.cs-phase__n {\\n  font-size: var(--text-sm);\\n  color: var(--accent);\\n  letter-spacing: 0.06em;\\n  line-height: 1.6;\\n}\\n.cs-phase__name { margin: 0; font-size: var(--text-lg); font-weight: 500; line-height: var(--leading-snug); color: var(--fg); }\\n.cs-phase__body { margin: var(--s2) 0 0; color: var(--muted-strong); max-width: 68ch; }\\n\\n/* ---------------- quote ---------------- */\\n.cs-quote { display: grid; gap: var(--s8); }\\n@media (min-width: 900px) { .cs-quote { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--s8); align-items: start; } }\\n.cs-quote__mark { color: var(--border-strong); }\\n.cs-quote__text {\\n  margin: 0;\\n  font-size: var(--text-xl);\\n  line-height: var(--leading-snug);\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  max-width: 28ch;\\n}\\n@media (min-width: 768px) { .cs-quote__text { font-size: var(--text-2xl); max-width: 26ch; } }\\n.cs-quote__attr { display: flex; align-items: center; gap: var(--s4); margin-top: var(--s8); }\\n.cs-quote__name { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--fg); }\\n.cs-quote__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\\n\\n/* ---------------- engagement facts ---------------- */\\n.cs-facts { display: grid; gap: var(--s8); list-style: none; margin: 0; padding: 0; }\\n@media (min-width: 900px) { .cs-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s12); } }\\n.cs-fact { display: flex; flex-direction: column; gap: var(--s3); min-width: 0; }\\n.cs-fact__key { display: inline-flex; align-items: center; gap: var(--s2); }\\n.cs-fact__body { margin: 0; color: var(--muted-strong); font-size: var(--text-sm); line-height: 1.55; }\\n.cs-fact__chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-fact__timeline { margin: 0; font-size: var(--text-sm); line-height: 1.7; color: var(--muted-strong); overflow-wrap: break-word; }\\n\\n/* ---------------- console exhibits ----------------\\n   One stacked band per placement, with the argument on the left and the drawn\\n   console on the right from 1000px. The gap between placements is large on\\n   purpose: two dense consoles 24px apart read as one confused screenshot. */\\n.cs-consoles { display: grid; gap: var(--s24); }\\n.cs-console { display: grid; gap: var(--s8); align-items: start; }\\n@media (min-width: 1000px) {\\n  .cs-console { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s12); }\\n}\\n.cs-console__say { min-width: 0; }\\n.cs-console__title { margin: var(--s3) 0 0; font-size: var(--text-xl); }\\n.cs-console__body { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 48ch; }\\n.cs-console__art { min-width: 0; }\\n\\n/* ---------------- related ---------------- */\\n.cs-related { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\\n@media (min-width: 768px) { .cs-related { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\\n@media (min-width: 1100px) { .cs-related { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\\n\\n@media print {\\n  .cs-meta, .cs-phases \\u003e li { break-inside: avoid; }\\n}\\n\"])</script><script>self.__next_f.push([1,\"15:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-case-study-page\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$27\\\"}],\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",null,\\\"$L2e\\\",\\\"$L2f\\\",\\\"$L30\\\",\\\"$L31\\\"]\\n\"])</script><script>self.__next_f.push([1,\"4a:I[7664,[\\\"2619\\\",\\\"static/chunks/2619-3c9e02e22d10480a.js\\\",\\\"4553\\\",\\\"static/chunks/4553-42d73557a9dc5e67.js\\\",\\\"621\\\",\\\"static/chunks/app/case-studies/%5Bslug%5D/page-f70c62bf7549d6f0.js\\\"],\\\"RevealGroup\\\"]\\n4b:I[7664,[\\\"2619\\\",\\\"static/chunks/2619-3c9e02e22d10480a.js\\\",\\\"4553\\\",\\\"static/chunks/4553-42d73557a9dc5e67.js\\\",\\\"621\\\",\\\"static/chunks/app/case-studies/%5Bslug%5D/page-f70c62bf7549d6f0.js\\\"],\\\"Reveal\\\"]\\n32:T1b85,\"])</script><script>self.__next_f.push([1,\"\\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\\n.metrics {\\n  display: grid;\\n  gap: var(--s8);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n@media (min-width: 768px) {\\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\\n}\\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\\n   headline rather than in a full-width row under it. */\\n.metrics--stack { gap: var(--s4); }\\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\\n/* The key runs inline with its note in the stacked variant — one line saved per\\n   metric is what keeps all three on the first screen. */\\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\\n.metrics--stack .metric__note-key::after { content: ' — '; }\\n.metric {\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s2);\\n  min-width: 0;\\n  border-top: 1px solid var(--border-strong);\\n  padding-top: var(--s4);\\n}\\n.metric__value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  line-height: 1.05;\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n@media (min-width: 768px) {\\n  .metric__value { font-size: var(--text-3xl); }\\n}\\n.metric__label {\\n  margin: 0;\\n  color: var(--muted-strong);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n  max-width: 34ch;\\n}\\n.metric__note {\\n  margin: var(--s2) 0 0;\\n  padding-top: var(--s2);\\n  border-top: 1px solid var(--border);\\n  font-size: var(--text-xs);\\n  line-height: 1.5;\\n  color: var(--muted);\\n  max-width: 36ch;\\n}\\n.metric__note-key {\\n  display: block;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n  margin-bottom: 2px;\\n}\\n\\n/* ---------------- NDA block ---------------- */\\n.nda {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: var(--s3);\\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\\n  border-radius: var(--radius-md);\\n  padding: var(--s3) var(--s4);\\n}\\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.nda__kicker {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.nda__name {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n}\\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\\n\\n/* ---------------- dual-pillar marker ---------------- */\\n.dual {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-md);\\n  padding: var(--s2) var(--s3);\\n  color: var(--fg);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\\n.dual__icon { color: var(--accent); flex: none; }\\n\\n/* ---------------- case study card ---------------- */\\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\\n.cs-card__client {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n}\\n.cs-card__headline {\\n  margin: 0;\\n  font-size: var(--text-lg);\\n  font-weight: 500;\\n  line-height: var(--leading-snug);\\n  color: var(--fg);\\n}\\n.cs-card__headline a { color: inherit; text-decoration: none; }\\n.cs-card__meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s2) var(--s4);\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  margin: 0;\\n}\\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-card__metric {\\n  margin-top: auto;\\n  padding-top: var(--s4);\\n  border-top: 1px solid var(--border);\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s1);\\n}\\n.cs-card__metric-value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-xl);\\n  font-weight: 600;\\n  letter-spacing: var(--tracking-tight);\\n  line-height: 1.1;\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\\n\\n/* ---------------- testimonial rail ---------------- */\\n.trail {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\\n  gap: var(--s4);\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  scroll-snap-type: x mandatory;\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 var(--s4);\\n  scrollbar-width: thin;\\n}\\n@media (min-width: 768px) {\\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\\n}\\n.trail \\u003e li { scroll-snap-align: start; min-width: 0; }\\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.trail__quote {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-base);\\n  line-height: var(--leading-normal);\\n}\\n@media (min-width: 768px) {\\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\\n}\\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\\n\\n/* ---------------- named-humans CTA ---------------- */\\n.humans { display: grid; gap: var(--s8); }\\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\\n.human { display: flex; align-items: center; gap: var(--s4); }\\n.human__name {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-base);\\n  font-weight: 500;\\n  color: var(--fg);\\n}\\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\\n\"])</script><script>self.__next_f.push([1,\"28:[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-proof-surfaces\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$32\\\"}]\\n33:T71a,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"Article\\\",\\\"@id\\\":\\\"https://envenox.com/case-studies/saas-cloud-identity-review#article\\\",\\\"headline\\\":\\\"Three weeks of identity-graph analysis found a four-step path from any repository contributor to the customer database.\\\",\\\"description\\\":\\\"A SOC 2 Type II commitment to a large customer, a CSPM tool producing 1,840 findings, and an engineering team of nineteen with no security specialist. The findings list had been triaged twice and abandoned twice, because a list ranked by vendor severity and filtered by nothing gives a team no way to\\\",\\\"articleSection\\\":\\\"Case study\\\",\\\"inLanguage\\\":\\\"en-GB\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://envenox.com/case-studies/saas-cloud-identity-review\\\"},\\\"about\\\":{\\\"@type\\\":\\\"Thing\\\",\\\"name\\\":\\\"SaaS \\u0026 Technology\\\"},\\\"keywords\\\":\\\"Cloud Security, Platform \\u0026 DevOps, GRC \\u0026 Compliance\\\",\\\"isAccessibleForFree\\\":true,\\\"publisher\\\":{\\\"@id\\\":\\\"https://envenox.com/#organization\\\"},\\\"author\\\":{\\\"@id\\\":\\\"https://envenox.com/#organization\\\"},\\\"citation\\\":[\\\"4 steps — from repository contributor to customer data (Closed in 11 days)\\\",\\\"1,840 → 210 — CSPM findings after reachability filtering (Same estate, same day)\\\",\\\"11 days → 40 min — median lead time for change (After the platform work, measured over 14 months)\\\"]},{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@id\\\":\\\"https://envenox.com/case-studies/saas-cloud-identity-review#breadcrumb\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://envenox.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Case studies\\\",\\\"item\\\":\\\"https://envenox.com/case-studies\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Three weeks of identity-graph analysis found a four-step path from any repository contributor to the customer database.\\\",\\\"item\\\":\\\"https://envenox.com/case-studies/saas-cloud-identity-review\\\"}]}]}\"])</script><script>self.__next_f.push([1,\"29:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$33\\\"}}]\\n34:T859,\"])</script><script>self.__next_f.push([1,\"\\n.badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--badge-border, var(--border));\\n  border-radius: var(--radius-sm);\\n  background-color: var(--badge-bg, transparent);\\n  color: var(--badge-fg, var(--muted-strong));\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.04em;\\n  line-height: 1;\\n  padding: var(--s1) var(--s2);\\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\\n     a badge held arbitrary data — \\\"3 weeks review, 14 weeks remediation\\\",\\n     \\\"AWS Solutions Architect Professional\\\", a credibility sentence — and an\\n     unbreakable chip wider than its card pushes the whole grid track past the\\n     viewport. A badge is a label primitive, but callers legitimately put\\n     variable-length data in one, and the component should survive that rather\\n     than require every caller to override it. Severity badges keep nowrap\\n     below: \\\"Critical\\\" is two syllables and must never break. */\\n  white-space: normal;\\n  text-wrap: balance;\\n}\\n.badge--severity {\\n  white-space: nowrap;\\n}\\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\\n.badge--md { padding: var(--s1) var(--s3); }\\n\\n.badge--neutral {\\n  --badge-bg: var(--surface);\\n  --badge-fg: var(--muted-strong);\\n  --badge-border: var(--border);\\n}\\n.badge--brand {\\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\\n  --badge-fg: var(--accent);\\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\\n}\\n\\n/* --- the only --signal-* usage in the codebase --- */\\n.badge--severity {\\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\\n  --badge-fg: var(--sig);\\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"2a:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":{\\\"paddingTop\\\":\\\"calc(var(--nav-h) + var(--s16))\\\"},\\\"aria-labelledby\\\":\\\"cs-headline\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"cs-breadcrumb u-mono\\\",\\\"aria-label\\\":\\\"Breadcrumb\\\",\\\"children\\\":[\\\"$\\\",\\\"ol\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/\\\",\\\"children\\\":\\\"Envenox\\\"}]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/case-studies\\\",\\\"children\\\":\\\"Case studies\\\"}]}],[\\\"$\\\",\\\"li\\\",null,{\\\"aria-current\\\":\\\"page\\\",\\\"children\\\":\\\"SaaS \\u0026 Technology\\\"}]]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-meta\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-meta__cell\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"cs-meta__key u-mono\\\",\