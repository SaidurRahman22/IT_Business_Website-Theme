(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  letter-spacing: var(--tracking-tight);\\n  line-height: var(--leading-snug);\\n  color: var(--fg);\\n  overflow-wrap: anywhere;\\n}\\n.mc-label { margin: 0; color: var(--muted-strong); font-size: var(--text-sm); line-height: 1.5; }\\n.mc-art { margin-top: var(--s3); min-width: 0; }\\n.mc-svg { width: 100%; height: auto; max-width: 22rem; overflow: visible; }\\n.mc-note { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.55; }\\n.mc-noteKey {\\n  display: block;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  /* --muted, not --border-strong: in .theme-dark --border-strong is #3d342c\\n     against a #1f1a16 surface, which is a hairline value and not a text value.\\n     This matches .metric__note-key in proof.tsx, which is the same label. */\\n  color: var(--muted);\\n  margin-bottom: var(--s1);\\n}\\n.mc-nochart { margin: 0; font-size: var(--text-xs); color: var(--muted); max-width: 34ch; line-height: 1.55; }\\n\\n/* The \\\"before\\\" bar is DATA, so it takes a text-weight neutral rather than a\\n   hairline one — --border-strong is a 1px value and disappears as a 13px bar\\n   in .theme-dark. The track behind a share is FRAME, so it takes a diluted\\n   version of the same neutral and stays quiet under the accent fill. */\\n.mc-barFrom { fill: var(--muted); }\\n.mc-barTo { fill: var(--accent); }\\n.mc-track { fill: color-mix(in oklab, var(--muted) 42%, transparent); }\\n.mc-track--open {\\n  fill: none;\\n  stroke: var(--muted);\\n  stroke-width: 1;\\n  stroke-dasharray: 3 3;\\n}\\n.mc-fill { fill: var(--accent); }\\n.mc-limit { stroke: var(--muted); stroke-width: 1.5; }\\n.mc-rule { stroke: var(--border-strong); stroke-width: 1; }\\n.mc-barText {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 11px;\\n  fill: var(--muted-strong);\\n}\\n.mc-barText--to { fill: var(--fg); }\\n/* Printed ON a filled bar rather than after it. --bg, because every bar fill\\n   here (--muted, --accent) is light in the dark palettes and dark in the light\\n   one, exactly inverse to the ground. */\\n.mc-barText--on { fill: var(--bg); }\\n.mc-axis {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  fill: var(--muted);\\n}\\n\\n/* Severity: colour is the third cue, after the count and the word. */\\n.mc-sev { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }\\n.mc-sevChip {\\n  display: inline-flex;\\n  align-items: baseline;\\n  gap: var(--s2);\\n  padding: var(--s1) var(--s3);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-sm);\\n  font-size: var(--text-xs);\\n  color: var(--muted-strong);\\n}\\n.mc-sevDot { width: 8px; height: 8px; border-radius: 50%; flex: none; align-self: center; background-color: var(--muted); }\\n.mc-sevChip[data-sev='critical'] .mc-sevDot { background-color: var(--signal-critical); }\\n.mc-sevChip[data-sev='high'] .mc-sevDot { background-color: var(--signal-high); }\\n.mc-sevChip[data-sev='medium'] .mc-sevDot { background-color: var(--signal-medium); }\\n.mc-sevChip[data-sev='low'] .mc-sevDot { background-color: var(--signal-low); }\\n.mc-sevN { font-family: var(--font-jetbrains-mono), ui-monospace, monospace; color: var(--fg); font-size: var(--text-sm); }\\n.mc-sevWord { text-transform: capitalize; }\\n\\n/* ---------------- engagement band ---------------- */\\n.eb { position: relative; margin: 0; min-width: 0; }\\n.eb-svg { display: none; width: 100%; height: auto; overflow: visible; }\\n@media (min-width: 760px) {\\n  .eb-svg { display: block; }\\n}\\n.eb-seg { fill: var(--accent); }\\n.eb-seg--alt { fill: var(--muted-strong); }\\n.eb-segLabel { font-size: 12px; fill: var(--accent-fg); }\\n.eb-seg--alt + .eb-segLabel { fill: var(--bg); }\\n.eb-markLine { stroke: var(--border-strong); stroke-width: 1; stroke-dasharray: 2 3; }\\n.eb-markDot { fill: var(--fg); }\\n.eb-markLabel {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 11px;\\n  fill: var(--muted-strong);\\n}\\n.eb-axis { stroke: var(--border-strong); stroke-width: 1; }\\n.eb-axisLabel {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  fill: var(--muted);\\n}\\n\\n.eb-list {\\n  list-style: none;\\n  margin: var(--s6) 0 0;\\n  padding: 0;\\n  display: grid;\\n  gap: 0;\\n  border-top: 1px solid var(--border);\\n}\\n@media (min-width: 760px) {\\n  .eb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s12); }\\n}\\n.eb-item {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: baseline;\\n  justify-content: space-between;\\n  gap: var(--s3);\\n  padding: var(--s3) 0;\\n  border-bottom: 1px solid var(--border);\\n  min-width: 0;\\n  font-size: var(--text-sm);\\n}\\n.eb-itemName { color: var(--fg); min-width: 0; }\\n.eb-itemWhen { color: var(--muted); font-size: var(--text-xs); }\\n.eb-item[data-kind='mark'] .eb-itemName::before {\\n  content: '';\\n  display: inline-block;\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--fg);\\n  margin-right: var(--s2);\\n  vertical-align: 1px;\\n}\\n.eb-cap { margin: var(--s4) 0 0; font-size: var(--text-xs); color: var(--muted); max-width: 74ch; line-height: 1.6; }\\n\"])</script><script>self.__next_f.push([1,\"2e:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"cs-timeline\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-band\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"cs-band__head\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"cs-timeline\\\",\\\"className\\\":\\\"cs-band__title\\\",\\\"children\\\":\\\"The engagement in time\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"cs-band__hint\\\",\\\"children\\\":\\\"3 weeks review, 14 weeks remediation · Project\\\"}]]}],[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-case-charts\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$3f\\\"}],\\\"$L40\\\"]]}]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"41:T859,\"])</script><script>self.__next_f.push([1,\"\\n.badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--badge-border, var(--border));\\n  border-radius: var(--radius-sm);\\n  background-color: var(--badge-bg, transparent);\\n  color: var(--badge-fg, var(--muted-strong));\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.04em;\\n  line-height: 1;\\n  padding: var(--s1) var(--s2);\\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\\n     a badge held arbitrary data — \\\"3 weeks review, 14 weeks remediation\\\",\\n     \\\"AWS Solutions Architect Professional\\\", a credibility sentence — and an\\n     unbreakable chip wider than its card pushes the whole grid track past the\\n     viewport. A badge is a label primitive, but callers legitimately put\\n     variable-length data in one, and the component should survive that rather\\n     than require every caller to override it. Severity badges keep nowrap\\n     below: \\\"Critical\\\" is two syllables and must never break. */\\n  white-space: normal;\\n  text-wrap: balance;\\n}\\n.badge--severity {\\n  white-space: nowrap;\\n}\\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\\n.badge--md { padding: var(--s1) var(--s3); }\\n\\n.badge--neutral {\\n  --badge-bg: var(--surface);\\n  --badge-fg: var(--muted-strong);\\n  --badge-border: var(--border);\\n}\\n.badge--brand {\\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\\n  --badge-fg: var(--accent);\\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\\n}\\n\\n/* --- the only --signal-* usage in the codebase --- */\\n.badge--severity {\\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\\n  --badge-fg: var(--sig);\\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"2f:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section-tight\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"cs-engagement\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"cs-engagement\\\",\\\"className\\\":\\\"u-eyebrow\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s8)\\\"},\\\"children\\\":\\\"The engagement\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"cs-facts\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"cs-fact\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"cs-fact__key u-eyebrow\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":14,\\\"height\\\":14,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":3,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-layers\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"zw3jo\\\",{\\\"d\\\":\\\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1wduqc\\\",{\\\"d\\\":\\\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\\\"}],[\\\"$\\\",\\\"path\\\",\\\"kqbvx6\\\",{\\\"d\\\":\\\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\\\"}],\\\"$undefined\\\"]}],\\\"Tech and tools\\\"]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"cs-fact__chips\\\",\\\"aria-label\\\":\\\"Stack and tooling\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"AWS\\\",{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-badge\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$41\\\"}],\\\"$L42\\\"]}],\\\"$L43\\\",\\\"$L44\\\",\\\"$L45\\\",\\\"$L46\\\",\\\"$L47\\\"]}]]}],\\\"$L48\\\",\\\"$L49\\\"]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"4c:T1b85,\"])</script><script>self.__next_f.push([1,\"\\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\\n.metrics {\\n  display: grid;\\n  gap: var(--s8);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n@media (min-width: 768px) {\\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\\n}\\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\\n   headline rather than in a full-width row under it. */\\n.metrics--stack { gap: var(--s4); }\\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\\n/* The key runs inline with its note in the stacked variant — one line saved per\\n   metric is what keeps all three on the first screen. */\\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\\n.metrics--stack .metric__note-key::after { content: ' — '; }\\n.metric {\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s2);\\n  min-width: 0;\\n  border-top: 1px solid var(--border-strong);\\n  padding-top: var(--s4);\\n}\\n.metric__value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  line-height: 1.05;\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n@media (min-width: 768px) {\\n  .metric__value { font-size: var(--text-3xl); }\\n}\\n.metric__label {\\n  margin: 0;\\n  color: var(--muted-strong);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n  max-width: 34ch;\\n}\\n.metric__note {\\n  margin: var(--s2) 0 0;\\n  padding-top: var(--s2);\\n  border-top: 1px solid var(--border);\\n  font-size: var(--text-xs);\\n  line-height: 1.5;\\n  color: var(--muted);\\n  max-width: 36ch;\\n}\\n.metric__note-key {\\n  display: block;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n  margin-bottom: 2px;\\n}\\n\\n/* ---------------- NDA block ---------------- */\\n.nda {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: var(--s3);\\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\\n  border-radius: var(--radius-md);\\n  padding: var(--s3) var(--s4);\\n}\\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.nda__kicker {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.nda__name {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n}\\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\\n\\n/* ---------------- dual-pillar marker ---------------- */\\n.dual {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-md);\\n  padding: var(--s2) var(--s3);\\n  color: var(--fg);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\\n.dual__icon { color: var(--accent); flex: none; }\\n\\n/* ---------------- case study card ---------------- */\\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\\n.cs-card__client {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n