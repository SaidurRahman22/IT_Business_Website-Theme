s ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n1d:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section-tight\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-cta-band\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"sv-h2\",\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}]]}],[\"$\",\"div\",null,{\"className\":