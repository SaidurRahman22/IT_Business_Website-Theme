: 1.2;\n  color: var(--muted);\n  white-space: nowrap;\n}\n.mq__link { color: inherit; text-decoration: none; }\n.mq__link:hover .mq__label { color: var(--fg); }\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\n\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\n@media (prefers-reduced-motion: reduce) {\n  .marquee__track.mq-track { padding-right: var(--gap); }\n}\n1b:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section-tight\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"pillar-proof\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Capacity\"}],[\"$\",\"h2\",null,{\"id\":\"pillar-proof\",\"className\":\"sv-h2\",\"children\":\"Envenox at a glance\"}],null]}],[[\"$\",\"style\",null,{\"href\":\"envenox-statbar\",\"precedence\":\"default\",\"children\":\"\\n.statbar {\\n  display: grid;\\n  gap: var(--s8);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n.statbar > li { min-width: 0; }\\n\\n@media (min-width: 640px) {\\n  .statbar { gap: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }\\n  .statbar > li { padding: var(--s6) var(--s6) var(--s6) 0; border-top: 1px solid var(--border); }\\n  .statbar > li + li { border-left: 1px solid var(--border); padding-left: var(--s6); }\\n  /* The second cell of each pair starts a new row edge, not a mid-row border. */\\n  .statbar--2 > li:nth-child(2n + 1) { border-left: 0; padding-left: 0; }\\n}\\n@media (min-width: 1024px) {\\n  .statbar--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\\n  .statbar--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\\n  .statbar--3 > li:nth-child(2n + 1),\\n  .statbar--4 > li:nth-child(2n + 1) { border-left: 1px solid var(--border); padding-left: var(--s6); }\\n  .statbar--3 > li:first-child,\\n  .statbar--4 > li:first-child { border-left: 0; padding-left: 0; }\\n}\\n\"}],[\"$\",\"ul\",null,{\"className\":\"statbar statbar--4\",\"aria-label\":\"Envenox at a glance\",\"style\":\"$undefined\",\"children\":[[\"$\",\"$L42\",\"engineers and testers on staff\",{\"as\":\"li\",\"value\":\"38\",\"suffix\":\"$undefined\",\"label\":\"engineers and testers on staff\",\"source\":\"Internal headcount register\",\"asOf\":\"2026-10-01\",\"size\":\"md\",\"provenance\":\"details\"}],[\"$\",\"$L42\",\"years operating\",{\"as\":\"li\",\"value\":\"11\",\"suffix\":\"$undefined\",\"label\":\"years operating\",\"source\":\"Companies House incorporation record\",\"asOf\":\"2026-01-01\",\"size\":\"md\",\"provenance\":\"details\"}],[\"$\",\"$L42\",\"engagements delivered\",{\"as\":\"li\",\"value\":\"240\",\"suffix\":\"+\",\"label\":\"engagements delivered\",\"source\":\"Delivery system export\",\"asOf\":\"2026-10-01\",\"size\":\"md\",\"provenance\":\"details\"}],[\"$\",\"$L42\",\"net promoter score\",{\"as\":\"li\",\"value\":\"71\",\"suffix\":\"$undefined\",\"label\":\"net promoter score\",\"source\":\"Post-engagement survey, 94 responses\",\"asOf\":\"2026-09-30\",\"size\":\"md\",\"provenance\":\"details\"}]]}]],[\"$\",\"div\",null,{\"style\":{\"marginTop\":\"var(--s16)\"},\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"style\":{\"marginBottom\":\"var(--s6)\"},\"children\":\"Selected clients\"}],[[\"$\",\"style\",null,{\"href\":\"envenox-marquee\",\"precedence\":\"default\",\"children\":\"$43\"}],\"$L44\"]]}]]}]}]]\n45:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n1c:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{