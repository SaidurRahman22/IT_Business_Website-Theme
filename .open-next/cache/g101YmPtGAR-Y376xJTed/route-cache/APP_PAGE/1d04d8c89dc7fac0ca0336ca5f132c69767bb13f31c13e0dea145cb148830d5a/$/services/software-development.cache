":\"https://envenox.com/#website\"},\"about\":{\"@id\":\"https://envenox.com/#organization\"},\"mainEntity\":{\"@type\":\"ItemList\",\"numberOfItems\":8,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Custom Software\",\"description\":\"Production systems with authorisation, audit and secrets handled properly from the first commit.\",\"url\":\"https://envenox.com/services/custom-software\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Web Application Development\",\"description\":\"Server-rendered, budget-enforced front ends that work before JavaScript arrives.\",\"url\":\"https://envenox.com/services/web-application-development\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Platform & DevOps\",\"description\":\"Reproducible infrastructure, short-lived pipeline identity, and a rehearsed rollback.\",\"url\":\"https://envenox.com/services/platform-engineering\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"ERP\",\"description\":\"Finance, inventory and procurement modelled on your exceptions, with history reconciled.\",\"url\":\"https://envenox.com/services/erp\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"CRM\",\"description\":\"Pipeline, activity and forecasting designed so sellers get something back from every field.\",\"url\":\"https://envenox.com/services/crm\"},{\"@type\":\"ListItem\",\"position\":6,\"name\":\"HRM\",\"description\":\"Field-level access control, read-auditing, and joiner-mover-leaver flows that complete.\",\"url\":\"https://envenox.com/services/hrm\"},{\"@type\":\"ListItem\",\"position\":7,\"name\":\"LMS\",\"description\":\"Audit-grade completion evidence with content people finish inside the window.\",\"url\":\"https://envenox.com/services/lms\"},{\"@type\":\"ListItem\",\"position\":8,\"name\":\"QA & Test Automation\",\"description\":\"Deterministic end-to-end suites with a flake budget and a quarantine process.\",\"url\":\"https://envenox.com/services/qa-automation\"}]}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Envenox\",\"item\":\"https://envenox.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://envenox.com/services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Software Development\",\"item\":\"https://envenox.com/services/software-development\"}]}</script><section class=\"sec theme-light transition-theme u-section grain\" data-theme-section=\"light\" style=\"padding-top:calc(var(--nav-h) + var(--s16))\" aria-labelledby=\"pillar-h1\"><div class=\"u-container\"><p class=\"u-eyebrow sv-hero__eyebrow\"><a class=\"u-link\" href=\"/services\">Services</a></p><h1 id=\"pillar-h1\" class=\"sv-h1\">Software Development</h1><p class=\"sv-sub\">Products, platforms and business systems built to survive an audit and a handover.</p><p class=\"sv-lede\">Our engineers work next to a security practice that will attack what they build. That changes how authorisation, audit logging and secrets get designed — before the first commit rather than after the first report.</p><div class=\"sv-hero__actions\"><a class=\"btn btn--primary btn--lg\" href=\"/contact\"><span>Start a conversation</span></a><a class=\"btn btn--secondary btn--lg\" href=\"/services/devsecops\"><span>Secure SDLC</span></a></div><ul class=\"sv-hero__meta\"><li>8 services</li><li>A named engineer replies within one business day. Scoping call within three.</li></ul></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"pillar-services\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">What you can buy</p><h2 id=\"pillar-services\" class=\"sv-h2\">Software Development services</h2><p class=\"sv-head__lede\">Products, platforms and business systems built to survive an audit and a handover.</p></div><ul class=\"reveal-group sv-grid sv-grid--3\"><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-boxes sv-card__icon\" aria-hidden=\"true\"><path d=\"M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z\"></path><path d=\"m7 16.5-4.74-2.85\"></path><path d=\"m7 16.5 5-3\"></path><path d=\"M7 16.5v5.17\"></path><path d=\"M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z\"></path><path d=\"m17 16.5-5-3\"></path><path d=\"m17 16.5 4.74-2.85\"></path><path d=\"M17 16.5v5.17\"></path><path d=\"M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z\"></path><path d=\"M12 8 7.26 5.15\"></path><path d=\"m12 8 4.74-2.85\"></path><path d=\"M12 13.5V8\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/custom-software\">Custom Software</a></h3></div><p class=\"sv-card__line\">Production systems with authorisation, audit and secrets handled properly from the first commit.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Working software in production, with the source in your repository under your licence</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Architecture decision records explaining why, not just what</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Threat model and a clean penetration test report at go-live</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View Custom Software<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe sv-card__icon\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/web-application-development\">Web Application Development</a></h3></div><p class=\"sv-card__line\">Server-rendered, budget-enforced front ends that work before JavaScript arrives.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Production application with the source in your repository</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Styleguide route rendering every component in every theme and state</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Performance budgets wired into CI with the rationale documented</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View Web Applications<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-server sv-card__icon\" aria-hidden=\"true\"><rect width=\"20\" height=\"8\" x=\"2\" y=\"2\" rx=\"2\" ry=\"2\"></rect><rect width=\"20\" height=\"8\" x=\"2\" y=\"14\" rx=\"2\" ry=\"2\"></rect><line x1=\"6\" x2=\"6.01\" y1=\"6\" y2=\"6\"></line><line x1=\"6\" x2=\"6.01\" y1=\"18\" y2=\"18\"></line></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/platform-engineering\">Platform &amp; DevOps</a></h3></div><p class=\"sv-card__line\">Reproducible infrastructure, short-lived pipeline identity, and a rehearsed rollback.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Infrastructure as code, reproducible from an empty account, in your repository</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>CI/CD pipeline with short-lived identity and automated rollback</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Service level objectives with error budgets and alerting that requires action</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View Platform &amp; DevOps<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 sv-card__icon\" aria-hidden=\"true\"><path d=\"M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z\"></path><path d=\"M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2\"></path><path d=\"M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2\"></path><path d=\"M10 6h4\"></path><path d=\"M10 10h4\"></path><path d=\"M10 14h4\"></path><path d=\"M10 18h4\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/erp\">ERP</a></h3></div><p class=\"sv-card__line\">Finance, inventory and procurement modelled on your exceptions, with history reconciled.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Process documentation as implemented, including exception handling</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Configured and tested system with role-based access and segregation of duties</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Migration reconciliation reports signed off by finance</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View ERP<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users sv-card__icon\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/crm\">CRM</a></h3></div><p class=\"sv-card__line\">Pipeline, activity and forecasting designed so sellers get something back from every field.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Configured CRM with the agreed data model and stage definitions</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Automatic activity capture from email, calendar and telephony</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Forecast model with visible assumptions</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View CRM<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-handshake sv-card__icon\" aria-hidden=\"true\"><path d=\"m11 17 2 2a1 1 0 1 0 3-3\"></path><path d=\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"></path><path d=\"m21 3 1 11h-2\"></path><path d=\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"></path><path d=\"M3 4h8\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/hrm\">HRM</a></h3></div><p class=\"sv-card__line\">Field-level access control, read-auditing, and joiner-mover-leaver flows that complete.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Configured system with field-level access control and read-auditing</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Data protection impact assessment and a records-of-processing entry</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Joiner-mover-leaver orchestration with completion tracking</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View HRM<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-graduation-cap sv-card__icon\" aria-hidden=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"></path><path d=\"M22 10v6\"></path><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/lms\">LMS</a></h3></div><p class=\"sv-card__line\">Audit-grade completion evidence with content people finish inside the window.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Learning platform with authoring, versioning and SCORM/xAPI support</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Rule-based assignment engine with recurrence and escalation</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Audit-grade completion evidence, exportable</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View LMS<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-test-tube-diagonal sv-card__icon\" aria-hidden=\"true\"><path d=\"M21 7 6.82 21.18a2.83 2.83 0 0 1-3.99-.01a2.83 2.83 0 0 1 0-4L17 3\"></path><path d=\"m16 2 6 6\"></path><path d=\"M12 16H4\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/qa-automation\">QA &amp; Test Automation</a></h3></div><p class=\"sv-card__line\">Deterministic end-to-end suites with a flake budget and a quarantine process.</p><ul class=\"sv-card__list\"><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Written test strategy including what is deliberately not automated</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>End-to-end suite covering the critical journeys, with isolated test data</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-card__tick\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>CI configuration with parallelisation, sharding and failure artefacts</span></li></ul><p class=\"sv-card__cta\" aria-hidden=\"true\">View QA &amp; Test Automation<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></p></div></li></ul></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"pillar-join\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Where this pillar meets the other one</p><h2 id=\"pillar-join\" class=\"sv-h2\">Secure SDLC</h2><p class=\"sv-head__lede\">We build it and we break it. The findings land in our own sprint backlog.</p></div><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-git-branch\" aria-hidden=\"true\" style=\"color:var(--accent)\"><line x1=\"6\" x2=\"6\" y1=\"3\" y2=\"15\"></line><circle cx=\"18\" cy=\"6\" r=\"3\"></circle><circle cx=\"6\" cy=\"18\" r=\"3\"></circle><path d=\"M18 9a9 9 0 0 1-9 9\"></path></svg><p class=\"sv-lede\" style=\"margin-top:var(--s4)\">One firm, two practices, one backlog. The seam between build and break, removed.</p><p style=\"margin-top:var(--s6)\"><span class=\"badge badge--md badge--brand\">9 days median</span></p></div><div class=\"sv-rail__body\"><p class=\"sv-prose-measure\" style=\"margin:0;color:var(--muted-strong)\">The standard arrangement is that a development firm builds your software for forty weeks and a security firm tests it in week forty-one. Everything that test finds is now expensive, because the architecture is set, the team is rolling off, and a finding that requires a design change arrives after the design is load-bearing. Both firms behaved correctly and the outcome is still bad. Our two practices run against each other continuously instead: our testers review the design before it is built, read the code as it is written, and raise findings into the same backlog our engineers work from. The number that matters is the nine days between a finding being confirmed and the fix being live, and it is only possible because there is no handover in the middle.</p><p style=\"margin-top:var(--s6)\"><a class=\"btn btn--primary btn--md\" href=\"/services/devsecops\"><span>Read Secure SDLC</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></p></div></div></div></section><section class=\"sec theme-light transition-theme u-section-tight\" data-theme-section=\"light\" aria-labelledby=\"pillar-accred\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Accreditation</p><h2 id=\"pillar-accred\" class=\"sv-h2\">Certifications</h2></div><ul class=\"sv-accred\"><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">ISO/IEC 27001:2022 — Information Security Management</span><span class=\"sv-accred__issuer\">UKAS-accredited certification body</span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">ISO 9001:2015 — Quality Management</span><span class=\"sv-accred__issuer\">UKAS-accredited certification body</span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">SOC 2 Type II — Security, Availability, Confidentiality</span><span class=\"sv-accred__issuer\">Independent CPA firm</span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">Cyber Essentials Plus — audited technical controls</span><span class=\"sv-accred__issuer\">IASME, on behalf of the NCSC</span></span></li></ul><p class=\"sv-note\"><a class=\"u-link\" href=\"/certifications\">Every certificate number and expiry date is published</a> · <a class=\"u-link\" href=\"/trust\">Our own security posture</a></p><div style=\"margin-top:var(--s12)\"><p class=\"u-eyebrow\" style=\"margin-bottom:var(--s4)\">Third-party reviews</p><ul class=\"sv-accred\" aria-label=\"Third-party reviews\"><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">Clutch — 4.9 from 31 reviews</span><span class=\"sv-accred__issuer\"><a class=\"u-link\" href=\"https://clutch.co/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Read the reviews on Clutch</a></span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">G2 — 4.7 from 44 reviews</span><span class=\"sv-accred__issuer\"><a class=\"u-link\" href=\"https://www.g2.com/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Read the reviews on G2</a></span></span></li></ul></div></div></section><section class=\"sec theme-light transition-theme u-section-tight\" data-theme-section=\"light\" aria-labelledby=\"pillar-proof\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Capacity</p><h2 id=\"pillar-proof\" class=\"sv-h2\">Envenox at a glance</h2></div><ul class=\"statbar statbar--4\" aria-label=\"Envenox at a glance\"><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">38</span></span></p><p class=\"stat__label\">engineers and testers on staff</p><details class=\"stat__prov\"><summary>Source</summary><p>Internal headcount register · as of 2026-10-01</p></details></li><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">11</span></span></p><p class=\"stat__label\">years operating</p><details class=\"stat__prov\"><summary>Source</summary><p>Companies House incorporation record · as of 2026-01-01</p></details></li><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">240</span></span><span class=\"stat__suffix\">+</span></p><p class=\"stat__label\">engagements delivered</p><details class=\"stat__prov\"><summary>Source</summary><p>Delivery system export · as of 2026-10-01</p></details></li><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">71</span></span></p><p class=\"stat__label\">net promoter score</p><details class=\"stat__prov\"><summary>Source</summary><p>Post-engagement survey, 94 responses · as of 2026-09-30</p></details></li></ul><div style=\"margin-top:var(--s16)\"><p class=\"u-eyebrow\" style=\"margin-bottom:var(--s6)\">Selected clients</p><div class=\"marquee\" style=\"--gap:var(--s12);--marquee-dur:52s\" tabindex=\"0\" role=\"group\" aria-label=\"Selected clients\"><ul class=\"marquee__track mq-track\" aria-label=\"Selected clients\"><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"mq__meta\">Retail &amp; Payments</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Carrick Analytics</span><span class=\"mq__meta\">SaaS &amp; Technology</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Pelham Energy</span><span class=\"mq__meta\">Energy</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Severn Mutual</span><span class=\"mq__meta\">Insurance</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Orbis Education</span><span class=\"mq__meta\">Education</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"mq__meta\">Retail &amp; Payments</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Carrick Analytics</span><span class=\"mq__meta\">SaaS &amp; Technology</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Pelham Energy</span><span class=\"mq__meta\">Energy</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Severn Mutual</span><span class=\"mq__meta\">Insurance</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Orbis Education</span><span class=\"mq__meta\">Education</span></span></li></ul></div></div></div></section><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" aria-labelledby=\"pillar-cross\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">The other pillar</p><h2 id=\"pillar-cross\" class=\"sv-h2\">Cybersecurity</h2><p class=\"sv-head__lede\">Testing, assurance, detection and response — by people who also ship production software.</p></div><p class=\"sv-prose-measure\" style=\"color:var(--muted-strong)\">Our testers are not career report-writers. They have shipped systems, which is why their findings arrive with a fix an engineer will accept rather than a recommendation an engineer has to translate.</p><div class=\"sv-hero__actions\"><a class=\"btn btn--primary btn--lg\" href=\"/services/cybersecurity\"><span>See Cybersecurity</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></div></div></section><section class=\"sec theme-light transition-theme u-section-tight\" data-theme-section=\"light\"><div class=\"u-container\"><div class=\"sv-cta-band\"><div><h2 class=\"sv-h2\">Book a 60-minute scoping call</h2><p class=\"sv-lede\">A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.</p></div><div class=\"sv-cta-band__actions\"><a class=\"btn btn--primary btn--lg\" href=\"/contact\"><span>Start a conversation</span></a><a class=\"btn btn--secondary btn--lg\" href=\"/case-studies\"><span>See the work</span></a></div></div></div></section><!--$--><!--/$--></main><footer class=\"foot theme-dark transition-theme grain\" data-theme-section=\"dark\"><div class=\"u-container\"><div class=\"foot__top\"><div class=\"foot__brand\"><a class=\"foot__wordmark\" href=\"/\">Envenox</a><p class=\"foot__positioning\">Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.</p><a class=\"foot__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"footer\"><span class=\"foot__hotline-row\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"u-eyebrow\">Incident response — 24/7</span></span><span class=\"foot__hotline-number\">+44 20 4525 9100</span><span class=\"foot__hotline-note\">Answered by a responder, 24/7. Median pickup under 4 minutes.</span></a></div><nav class=\"foot__cols\" aria-label=\"Footer\"><div><h2 class=\"foot__col-heading\">Cybersecurity</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"foot__link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"foot__link\" href=\"/services/cloud-security\">Cloud Security</a></li><li><a class=\"foot__link\" href=\"/services/red-teaming\">Red Teaming</a></li><li><a class=\"foot__link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"foot__link\" href=\"/services/incident-response\">Incident Response</a></li><li><a class=\"foot__link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"foot__link\" href=\"/services/vciso\">vCISO</a></li></ul></div><div><h2 class=\"foot__col-heading\">Software Development</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"foot__link\" href=\"/services/web-application-development\">Web Applications</a></li><li><a class=\"foot__link\" href=\"/services/platform-engineering\">Platform &amp; DevOps</a></li><li><a class=\"foot__link\" href=\"/services/erp\">ERP</a></li><li><a class=\"foot__link\" href=\"/services/crm\">CRM</a></li><li><a class=\"foot__link\" href=\"/services/hrm\">HRM</a></li><li><a class=\"foot__link\" href=\"/services/lms\">LMS</a></li><li><a class=\"foot__link\" href=\"/services/qa-automation\