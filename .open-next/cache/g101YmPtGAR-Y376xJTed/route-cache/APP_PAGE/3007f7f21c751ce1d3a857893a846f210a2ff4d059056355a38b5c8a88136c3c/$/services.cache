dent hours, and advisory access. Priced on availability, because availability is what you are buying.\"}]]}]\nb3:T43d,\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\na9:[\"$\",\"$L37\",\"Embedded team\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$b3\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"sv-h3\",\"children\":\"Embedded team\"}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"A standing squad on a quarterly commitment, working in your process, in your repository, in your stand-up.\"}]]}]]}]\naa:[null,[\"$\",\"span\",null,{\"className\":\"mq__text\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mq__label\",\"children\":\"Carrick Analytics\"}],[\"$\",\"span\",null,{\"className\":\"mq__meta\",\"children