se) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.btn:hover {\\n  background-color: var(--btn-bg-hover);\\n  border-color: var(--btn-border-hover);\\n  /* Falls back to the resting label colour, so no existing variant changes.\\n     A variant whose hover fill moves far in lightness needs to move its label\\n     too, or the hover state quietly fails contrast while the resting state\\n     passes — which is the kind of thing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"1c:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"router\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Not sure what you need?\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"router\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Book a 60-minute scoping call\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-head__lede\\\",\\\"children\\\":\\\"Tell us what you are trying to achieve and what constrains it. If what you need is not what you asked for, we will say so on the first call rather than in month three — we have told clients to buy two penetration tests instead of the red team they came for, and to buy a package instead of the custom build.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":1.5,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-handshake\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--accent)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"efffak\\\",{\\\"d\\\":\\\"m11 17 2 2a1 1 0 1 0 3-3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"9pr0kb\\\",{\\\"d\\\":\\\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1tisrp\\\",{\\\"d\\\":\\\"m21 3 1 11h-2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1uvwmv\\\",{\\\"d\\\":\\\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1ep09j\\\",{\\\"d\\\":\\\"M3 4h8\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-lede\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s4)\\\"},\\\"children\\\":\\\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-hero__actions\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$59\\\"}],\\\"$L5a\\\"]}]]}],\\\"$L5b\\\"]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"1d:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"faq\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Before you ask\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"faq\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Questions buyers ask\\\"}],null]}],[\\\"$\\\",\\\"$L5c\\\",null,{\\\"items\\\":[{\\\"q\\\":\\\"Is it a conflict of interest to test your own build?\\\",\\\"a\\\":\\\"It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.\\\"},{\\\"q\\\":\\\"Can we start with one test and expand?\\\",\\\"a\\\":\\\"Most clients do, and it is the sensible order. A single test tells you whether you want to work with us before either side commits to a programme.\\\"},{\\\"q\\\":\\\"Do you work fixed price?\\\",\\\"a\\\":\\\"For bounded work with a knowable scope, yes — tests, reviews, discovery phases. For a build, time and materials against a prioritised backlog with a cap and a monthly review, because a fixed price for an undesigned build is priced for the worst case and then spent defending the scope boundary.\\\"},{\\\"q\\\":\\\"What does an incident retainer actually reserve?\\\",\\\"a\\\":\\\"Hours, a response time, pre-agreed rates, a pre-signed NDA, and a team that has already read your architecture. The last of those is the one that saves the most time in hour one, and it is the one you cannot buy during an incident.\\\"},{\\\"q\\\":\\\"Can we buy security and software on one agreement?\\\",\\\"a\\\":\\\"Yes, and it is the common case. One master services agreement, separate statements of work per engagement, one account team. The pre-release test is still signed by someone independent of the build.\\\"},{\\\"q\\\":\\\"Can you apply this to our in-house team?\\\",\\\"a\\\":\\\"Yes, and it is a common engagement. The security practice embeds with your delivery team, the gates and the backlog are yours, and the goal is that your engineers own the model within two quarters. We bring the testers; you keep the capability.\\\"},{\\\"q\\\":\\\"Does this replace a penetration test?\\\",\\\"a\\\":\\\"No — it contains one, and adds the continuous work around it. If you only want the point-in-time measurement, buy the test on its own; it is a legitimate purchase. This is for building a system that passes it.\\\"}],\\\"headingLevel\\\":3}]]}]}]]\\n\"])</script><script>self.__next_f.pus