\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--btn-border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--btn-bg);\\n  color: var(--btn-fg);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 500;\\n  letter-spacing: -0.01em;\\n  line-height: 1;\\n  text-align: center;\\n  text-decoration: none;\\n  cursor: pointer;\\n  /* ONLY colour transitions. A transform here would break the house rule. */\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.btn:hover {\\n  background-color: var(--btn-bg-hover);\\n  border-color: var(--btn-border-hover);\\n  /* Falls back to the resting label colour, so no existing variant changes.\\n     A variant whose hover fill moves far in lightness needs to move its label\\n     too, or the hover state quietly fails contrast while the resting state\\n     passes — which is the kind of thing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"1a:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"engagement-models\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Commercial shape\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"engagement-models\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Engagement Models\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-head__lede\\\",\\\"children\\\":\\\"How a security retainer and a delivery retainer actually differ, stated plainly.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":1.5,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-workflow\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--accent)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"rect\\\",\\\"by2w9f\\\",{\\\"width\\\":\\\"8\\\",\\\"height\\\":\\\"8\\\",\\\"x\\\":\\\"3\\\",\\\"y\\\":\\\"3\\\",\\\"rx\\\":\\\"2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"xkn7yn\\\",{\\\"d\\\":\\\"M7 11v4a2 2 0 0 0 2 2h4\\\"}],[\\\"$\\\",\\\"rect\\\",\\\"1cgmvn\\\",{\\\"width\\\":\\\"8\\\",\\\"height\\\":\\\"8\\\",\\\"x\\\":\\\"13\\\",\\\"y\\\":\\\"13\\\",\\\"rx\\\":\\\"2\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-lede\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s4)\\\"},\\\"children\\\":\\\"Security retainers and software retainers are both called retainers and they behave nothing alike. A security retainer buys reserved capacity against an unpredictable need — you hope not to use the incident hours. A delivery retainer buys a standing team against a predictable need — if you do not use the capacity, you have wasted it. Blurring the two is how a client ends up paying for a dedicated squad to handle incidents that happen twice a year, or expecting an incident retainer to absorb a six-month build. This page exists so the distinction is clear before the commercial conversation, not during it.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s6)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$53\\\"}],\\\"$L54\\\"]}]]}],\\\"$L55\\\"]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"57:T59b,\"])</script><script>self.__next_f.push([1,\"\\n/* Zero the trailing padding so the globals keyframe lands exactly. */\\n.marquee__track.mq-track { padding-right: 0; list-style: none; margin: 0; padding-left: 0; }\\n\\n.mq__item {\\n  display: flex;\\n  align-items: center;\\n  gap: var(--s3);\\n  flex: none;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--surface);\\n  padding: var(--s3) var(--s4);\\n  min-height: 56px;\\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\\n}\\n.mq__item:hover { border-color: var(--border-strong); }\\n\\n.mq__logo { display: inline-flex; flex: none; color: var(--muted-strong); }\\n\\n.mq__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.mq__label {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  line-height: 1.2;\\n  color: var(--fg);\\n  white-space: nowrap;\\n}\\n.mq__meta {\\n  font-size: var(--text-xs);\\n  line-height: 1.2;\\n  color: var(--muted);\\n  white-space: nowrap;\\n}\\n.mq__link { color: inherit; text-decoration: none; }\\n.mq__link:hover .mq__label { color: var(--fg); }\\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\\n\\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\\n@media (prefers-reduced-motion: reduce) {\\n  .marquee__track.mq-track { padding-right: var(--gap); }\\n}\\n\"])</script><script>self.__next_f.push([1,\"1b:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section-tight\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"proof\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Capacity\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"proof\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"The firm behind the services\\\"}],null]}],[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-statbar\\\",\\\"precedence\\\":\\\"