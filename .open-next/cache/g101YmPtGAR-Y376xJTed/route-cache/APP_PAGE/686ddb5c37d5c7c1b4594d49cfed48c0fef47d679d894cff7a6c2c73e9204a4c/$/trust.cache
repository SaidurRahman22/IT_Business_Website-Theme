ll staff before start date\"}],null]}]]}],[\"$\",\"tr\",\"Basic criminal record check\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Basic criminal record check\"}],[\"$\",\"td\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"trust_value__8TOAJ\",\"children\":\"All staff\"}],[\"$\",\"span\",null,{\"className\":\"trust_rowNote__NReVA\",\"children\":[\"DBS Basic in the UK; local equivalent elsewhere. Renewed every three years.\"]}]]}]]}],[\"$\",\"tr\",\"Enhanced screening\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Enhanced screening\"}],[\"$\",\"td\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"trust_value__8TOAJ\",\"children\":\"BS 7858 for staff on financial services and public sector engagements\"}],[\"$\",\"span\",null,{\"className\":\"trust_rowNote__NReVA\",\"children\":[\"Five-year employment history, two references, credit and sanctions check.\"]}]]}]]}],[\"$\",\"tr\",\"Confidentiality\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Confidentiality\"}],[\"$\",\"td\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"trust_value__8TOAJ\",\"children\":\"Individual NDA signed at onboarding, surviving termination\"}],null]}]]}],[\"$\",\"tr\",\"Subcontractors\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Subcontractors\"}],[\"$\",\"td\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"trust_value__8TOAJ\",\"children\":\"Rare, always disclosed before an engagement starts\"}],[\"$\",\"span\",null,{\"className\":\"trust_rowNote__NReVA\",\"children\":[\"Held to the same screening standard, named in the statement of work. We do not subcontract testing without telling you who to.\"]}]]}]]}],[\"$\",\"tr\",\"Leaver process\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Leaver process\"}],[\"$\",\"td\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"trust_value__8TOAJ\",\"children\":\"Access revoked across id