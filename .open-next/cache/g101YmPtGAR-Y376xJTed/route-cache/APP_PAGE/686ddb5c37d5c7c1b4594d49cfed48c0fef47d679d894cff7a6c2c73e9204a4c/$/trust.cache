ust_rowNote__NReVA\",\"children\":[\"Cloned only into the engagement workspace. We can work in your environment on your hardware where your policy requires it.\"]}]]}]]}],[\"$\",\"tr\",\"Production access\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Production access\"}],[\"$\",\"td\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"trust_value__8TOAJ\",\"children\":\"Time-boxed, logged, and revoked at engagement close\"}],[\"$\",\"span\",null,{\"className\":\"trust_rowNote__NReVA\",\"children\":[\"We ask for the least access that makes the engagement possible and will tell you when a scope reduction would cost you coverage.\"]}]]}]]}]]}]]}]}],null]]}]\n2e:[\"$\",\"$L26\",\"sub-processors\",{\"as\":\"section\",\"id\":\"sub-processors\",\"className\":\"trust_docSection__iQjuL\",\"aria-labelledby\":\"sub-processors-heading\",\"children\":[[\"$\",\"div\",null,{\"className\":\"trust_sectionTop__xp2wT\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono trust_sectionNum__4xRWr\",\"aria-hidden\":\"true\",\"children\":\"04\"}],[\"$\",\"h2\",null,{\"id\":\"sub-processors-heading\",\"className\":\"trust_sectionHeading__amV4K\",\"children\":\"Sub-processors\"}]]}],[[\"$\",\"p\",null,{\"className\":\"trust_summary__xvzO7\",\"children\":\"The full list, with what each one processes and where. Material additions are notified 30 days in advance.\"}],[\"$\",\"div\",null,{\"className\":\"trust_tableWrap__Yf7Hg\",\"role\":\"region\",\"aria-labelledby\":\"sub-processors-heading\",\"tabIndex\":0,\"children\":[\"$\",\"table\",null,{\"className\":\"trust_spec__UPXf1\",\"children\":[[\"$\",\"caption\",null,{\"className\":\"trust_srOnly__PcgD2\",\"children\":\"The full list, with what each one processes and where. Material additions are notified 30 days in advance.\"}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"Amazon Web Services\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"Amazon Web Services\"}],[\"$\",\"td\",