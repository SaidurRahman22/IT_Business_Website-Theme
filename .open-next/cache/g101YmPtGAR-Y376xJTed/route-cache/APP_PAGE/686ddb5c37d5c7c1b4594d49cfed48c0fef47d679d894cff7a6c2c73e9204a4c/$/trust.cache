s/2619-3c9e02e22d10480a.js\\\",\\\"8039\\\",\\\"static/chunks/app/error-77708acc479f8cb3.js\\\"],\\\"default\\\"]\\n6:I[8924,[],\\\"\\\"]\\nc:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/864ef3ae0e55d690.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/1f5bf2002f7c091b.css\\\",\\\"style\\\"]\\n2:T9a6,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"Organization\\\",\\\"@id\\\":\\\"https://envenox.com/#organization\\\",\\\"name\\\":\\\"Envenox\\\",\\\"legalName\\\":\\\"Envenox Ltd\\\",\\\"url\\\":\\\"https://envenox.com\\\",\\\"description\\\":\\\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\\\",\\\"slogan\\\":\\\"We build the software. Then we try to break it.\\\",\\\"email\\\":\\\"hello@envenox.com\\\",\\\"telephone\\\":\\\"+44 20 4525 9101\\\",\\\"sameAs\\\":[\\\"https://www.linkedin.com/company/envenox\\\",\\\"https://github.com/envenox\\\",\\\"https://x.com/envenox\\\"],\\\"address\\\":[{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"1 Fore Street Avenue, London EC2Y 9DT\\\",\\\"addressLocality\\\":\\\"London\\\",\\\"addressCountry\\\":\\\"United Kingdom\\\"},{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\\\",\\\"addressLocality\\\":\\\"Dhaka\\\",\\\"addre