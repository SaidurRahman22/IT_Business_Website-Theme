var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n29:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":{\"paddingTop\":\"calc(var(--nav-h) + var(--s16))\"},\"aria-labelledby\":\"rd-h1\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-crumbs\",\"precedence\":\"default\",\"children\":\"\\n.crumbs { font-size: var(--text-sm); color: var(--muted); }\\n.crumbs ol {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s2);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n.crumbs li { display: flex; align-items: center; gap: var(--s2); min-width: 0; }\\n.crumbs a { color: var(--muted); text-decoration: none; }\\n.crumbs a:hover { color: var(--fg); }\\n.crumbs__sep { color: var(--border-strong); }\\n.crumbs [aria-current='page'] { color: var(--muted-strong); }\\n\"}],[\"$\",\"nav\",null,{\"className\":\"crumbs\",\"aria-label\":\"Breadcrumb\",\"children\":[\"$\",\"ol\",null,{\"children\":[[\"$\",\"li\",\"/\",{\"children\":[null,[\"$\",\"a\",null,{\"class