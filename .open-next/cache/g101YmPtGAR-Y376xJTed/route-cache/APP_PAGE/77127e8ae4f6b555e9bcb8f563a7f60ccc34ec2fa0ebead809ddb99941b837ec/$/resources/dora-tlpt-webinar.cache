n\",null,{\"className\":\"btn__icon\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]}]]}]\n3f:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n36:[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$3f\"}],\"$L40\"]\n39:[\"$\",\"div\",null,{\"className\":\"card card--pad\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"h3\",null,{\"style\":{\"margin\":0,\"fontSize\":\"var(--text-lg)\"},\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/grc-compliance\",\"className\":\"card__link\",\"children\":\"GRC & Compliance\"}]}],[\"$\",\"p\",null,{\"style\":{\"margin\":\"var(--s2) 0 0\",\"color\":\"var(--muted)\",\"fontSize\":\"var(--text-sm)\"},\"children\":\"SOC 2, ISO 27001, PCI DSS, DORA and NIS2, evidenced from systems you already run.\"}]]}]\n3d:[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--neutral\",\"children\":[null,\"Red team\"]}]\n41:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n3e:[\"$\",\"li\",\"Financial services\",{\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$41\"}],[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--neutral\",\"children\":[null,\"Financial services\"]}]]}]\n40:[\"$\",\"$Le\",null,{\"href\":\"/resources\",\"className\":\"btn btn--secondary btn--md\",\"children\":[null,[\"$\",\"span\",null,{\"children\":[\"All \",\"resources\"]}],null]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1, viewport-fit=cover\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#0a0d13\"}]]\n16:null\n42:I[622,[],\"IconMark\"]\n18:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"DORA threat-led penetration testing: what the independence criteria actually mean · Envenox\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Fifty minutes on where the provider independence requirements bite, why some firms can supply the threat intelligence or the testing but not both, and how to avoid discovering that after the exercise. Recording is not gated.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"application-name\",\"content\":\"Envenox\"}],[\"$\",\"link\",\"3\",{\"rel\":\"author\",\"href\":\"https://envenox.com/about/leadership/claire-benoit\"}],[\"$\",\"meta\",\"4\",{\"name\":\"author\",\"content\":\"Claire Benoit\"}],[\"$\",\"meta\",\"5\",{\"name\":\"keywords\",\"content\":\"DORA,Red team,Financial services\"}],[\"$\",\"meta\",\"6\",{\"name\":\"referrer\",\"content\":\"strict-origin-when-cross-origin\"}],[\"$\",\"meta\",\"7\",{\"name\":\"creator\",\"content\":\"Envenox Ltd\"}],[\"$\",\"meta\",\"8\",{\"name\":\"publisher\",\"content\":\"Envenox Ltd\"}],[\"$\",\"meta\",\"9\",{\"name\":\"robots\",\"content\":\"noindex, follow\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://envenox.com/resources/dora-tlpt-webinar\"}],[\"$\",\"meta\",\"11\",{\"name\":\"format-detection\",\"content\":\"telephone=no, address=no, email=no\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"DORA threat-led penetration testing: what the independence criteria actually mean\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Fifty minutes on where the provider independence requirements bite, why some firms can supply the threat intelligence or the testing but not both, and how to avoid discovering that after the exercise. Recording is not gated.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://envenox.com/resources/dora-tlpt-webinar\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"16\",{\"property\":\"article:published_time\",\"content\":\"2026-09-25\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:modified_time\",\"content\":\"