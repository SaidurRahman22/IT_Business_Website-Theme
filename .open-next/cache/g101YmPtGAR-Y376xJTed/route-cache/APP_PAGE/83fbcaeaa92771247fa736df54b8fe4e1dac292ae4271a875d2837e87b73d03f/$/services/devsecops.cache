SO\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",\\\"Software Development\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"foot__col-heading\\\",\\\"children\\\":\\\"Software Development\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"foot__list\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/services/custom-software\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/custom-software\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"Custom Software\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/web-application-development\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/web-application-development\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"Web Applications\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/platform-engineering\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/platform-engineering\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"Platform \\u0026 DevOps\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/erp\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/erp\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"ERP\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/crm\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/crm\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"CRM\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/hrm\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/hrm\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"HRM\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/lms\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/services/lms\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"LMS\\\"}]}],\\\"$L2f\\\"]}]]}],\\\"$L30\\\",\\\"$L31\\\"]}]]}],\\\"$L32\\\",\\\"$L33\\\"]}]}]\\n\"])</script><script>self.__next_f.push([1,\"34:T876,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Service\\\",\\\"@id\\\":\\\"https://envenox.com/services/devsecops#service\\\",\\\"name\\\":\\\"Secure SDLC\\\",\\\"serviceType\\\":\\\"Secure SDLC\\\",\\\"alternateName\\\":\\\"Secure SDLC\\\",\\\"description\\\":\\\"We build it and we break it. The findings land in our own sprint backlog.\\\",\\\"disambiguatingDescription\\\":\\\"One firm, two practices, one backlog. The seam between build and break, removed.\\\",\\\"url\\\":\\\"https://envenox.com/services/devsecops\\\",\\\"provider\\\":{\\\"@id\\\":\\\"https://envenox.com/#organization\\\"},\\\"areaServed\\\":[{\\\"@type\\\":\\\"Country\\\",\\\"name\\\":\\\"United Kingdom\\\"},{\\\"@type\\\":\\\"Country\\\",\\\"name\\\":\\\"Bangladesh\\\"}],\\\"audience\\\":{\\\"@type\\\":\\\"BusinessAudience\\\",\\\"name\\\":\\\"Regulated organisations\\\"},\\\"category\\\":\\\"Secure software development lifecycle\\\",\\\"hasOfferCatalog\\\":{\\\"@type\\\":\\\"OfferCatalog\\\",\\\"name\\\":\\\"Secure SDLC — what is included\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Threat model at design time\\\",\\\"description\\\":\\\"Before the first sprint. The cheapest security finding is an architecture decision, and the most expensive one is the same decision discovered in week forty.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Secure design review at each decision\\\",\\\"description\\\":\\\"Our testers review architectural decision records as they are written, not the finished system.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Security in the pipeline\\\",\\\"description\\\":\\\"SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":4,\\\"name\\\":\\\"Continuous testing during the build\\\",\\\"description\\\":\\\"Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":5,\\\"name\\\":\\\"Pre-release penetration test\\\",\\\"description\\\":\\\"A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":6,\\\"name\\\":\\\"Monitoring and retest\\\",\\\"description\\\":\\\"Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.\\\"}]},\\\"termsOfService\\\":\\\"https://envenox.com/legal/terms\\\"}\"])</script><script>self.__next_f.push([1,\"15:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$34\\\"}}]\\n16:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"BreadcrumbList\\\\\\\",\\\\\\\"itemListElement\\\\\\\":[{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":1,\\\\\\\"name\\\\\\\":\\\\\\\"Envenox\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":2,\\\\\\\"name\\\\\\\":\\\\\\\"Services\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/services\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":3,\\\\\\\"name\\\\\\\":\\\\\\\"Secure SDLC\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/services/devsecops\\\\\\\"}]}\\\"}}]\\n35:Tbc3,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is it a conflict of interest to test your own build?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"What does this cost compared with building then testing?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"The security allocation is roughly 8 to 12% of the build cost. Against it: the findings arrive when they cost a sprint rather than a redesign, there is no handover and re-learning period, and compliance evidence comes out of the process rather than out of a separate exercise. On the engagements where we have both numbers, integrated has been cheaper in total — but we would rather show you the two case studies than assert it.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can you apply this to our in-house team?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes, and it is a common engagement. The security practice embeds with your delivery team, the gates and the backlog are yours, and the goal is that your engineers own the model within two quarters. We bring the testers; you keep the capability.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"What if a critical finding appears a week before launch?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It blocks the launch, and that is agreed in writing before the engagement starts, so the conversation happens when nobody is under pressure. In practice continuous review means late criticals are rare — the point of the model is to move findings earlier, and the cycle-time number is how you check that it is working.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Does this replace a penetration test?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"No — it contains one, and adds the continuous work around it. If you only want the point-in-time measurement, buy the test on its own; it is a legitimate purchase. This is for building a system that passes it.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How do you prove the cycle-time claim?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Every finding is timestamped at confirmation and at the deploy that fixed it, both drawn from your own tracker and your own pipeline rather than from ours. The monthly report shows the distribution, not just the median, because the tail is where the interesting cases are.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"What compliance evidence does this generate?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Secure development policy evidence for SOC 2 CC8.1, ISO 27001 Annex A 8.25 to 8.31, and PCI DSS Requirement 6. Because the evidence is generated by the process rather than assembled for the audit, it tends to survive sampling.\\\"}}]}\"])</script><script>self.__next_f.push([1,\"17:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$35\\\"}}]\\n36:Tdb3,\"])</script><script>self.__next_f.push([1,\"\\n.btn {\\n  --btn-bg: transparent;\\n  --btn-bg-hover: transparent;\\n  --btn-fg: var(--fg);\\n  --btn-border: transparent;\\n  --btn-border-hover: transparent;\\n\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--btn-border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--btn-bg);\\n  color: var(--btn-fg);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 500;\\n  letter-spacing: -0.01em;\\n  line-height: 1;\\n  text-align: center;\\n  text-decoration: none;\\n  cursor: pointer;\\n  /* ONLY colour transitions. A transform here would break the house rule. */\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.btn:hover {\\n  background-color: var(--btn-bg-hover);\\n  border-color: var(--btn-border-hover);\\n  /* Falls back to the resting label colour, so no existing variant changes.\\n     A variant whose hover fill moves far in lightness needs to move its label\\n     too, or the hover state quietly fails contrast while the resting state\\n     passes — which is the kind of thing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"18:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":{\\\"paddingTop\\\":\\\"calc(var(--nav-h) + var(--s16))\\\"},\\\"aria-labelledby\\\":\\\"devsecops-h1\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-hero__eyebrow\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Le\\\",null,{\\\"className\\\":\\\"u-link\\\",\\\"href\\\":\\\"/services\\\",\\\"children\\\":\\\"Services\\\"}],\\\" · \\\",\\\"Secure SDLC\\\"]}],[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-chapter-opener\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.chapter {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  gap: var(--s6);\\\\n}\\\\n.chapter__line {\\\\n  font-family: var(--font-instrument-serif), ui-serif, Georgia, serif;\\\\n  font-weight: 400;\\\\n  font-size: var(--text-3xl);\\\\n  line-height: 1.08;\\\\n  letter-spacing: 0;\\\\n  color: var(--fg);\\\\n  max-width: 22ch;\\\\n  text-wrap: balance;\\\\n  margin: 0;\\\\n}\\\\n@media (min-width: 768px) {\\\\n  .chapter__line { font-size: var(--text-4xl); max-width: 20ch; }\\\\n}\\\\n@media (min-width: 1024px) {\\\\n  .chapter__line { font-size: var(--text-5xl); }\\\\n}\\\\n.chapter__line em { font-style: italic; }\\\\n.chapter__note {\\\\n  color: var(--muted);\\\\n  font-size: var(--text-base);\\\\n  max-width: 48ch;\\\\n  margin: 0;\\\\n}\\\\n.chapter__rule { height: 1px; background-color: var(--border); width: 100%; }\\\\n\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"chapter\\\",\\\"children\\\":[null,null,[\\\"$\\\",\\\"h1\\\",null,{\\\"id\\\":\\\"devsecops-h1\\\",\\\"className\\\":\\\"chapter__line\\\",\\\"children\\\":\\\"We build it and we break it.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"chapter__note\\\",\\\"children\\\":\\\"One firm, two practices, one backlog. The seam between build and break, removed.\\\"}]]}]],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-cred\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"sv-cred__figure\\\",\\\"children\\\":\\\"9 days median\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-cred__context\\\",\\\"children\\\":\\\"from a security finding being confirmed to the fix being in production, on joint engagements\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-hero__actions\\\",\\\"children\\\":[[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$36\\\"}],\\\"$L37\\\"],\\\"$L38\\\"]}],\\\"$L39\\\"]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"19:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"the-gap\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"The gap\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"the-gap\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Week forty-one is the expensive way\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-head__lede\\\",\\\"children\\\":\\\"We build it and we break it. The findings land in our own sprint backlog.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":1.5,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-shield-alert\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--accent)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"oel41y\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1got3b\\\",{\\\"d\\\":\\\"M12 8v4\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1drbdi\\\",{\\\"d\\\":\\\"M12 16h.01\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-lede\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s4)\\\"},\\\"children\\\":\\\"The client had to replace a clinical workflow system their customers depended on, carry NHS Data Security and Protection Toolkit obligations plus a SOC 2 Type II commitment made to a US customer, and do it in under a year. Their previous build, with a different vendor, had been tested in its final month: the test returned four criticals, two of which required an architectural change, and the launch slipped by five months. The brief was explicit — never again — but the proposed remedy, buying a second security vendor to test earlier, reproduces the handover rather than removing it.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__body\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-prose-measure\\\",\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"var(--text-lg)\\\",\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"The standard arrangement is that a development firm builds your software for forty weeks and a security firm tests it in week forty-one. Everything that test finds is now expensive, because the architecture is set, the team is rolling off, and a finding that requires a design change arrives after the design is load-bearing. Both firms behaved correctly and the outcome is still bad. Our two practices run against each other continuously instead: our testers review the design before it is built, read the code as it is written, and raise findings into the same backlog our engineers work from. The number that matters is the nine days between a finding being confirmed and the fix being live, and it is only possible because there is no handover in the middle.\\\"}]}]]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"1a:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"objection\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s6)\\\"}}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The obvious objection\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"objection\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s3)\\\"},\\\"children\\\":\\\"Is it a conflict of interest to test your own build?\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__body\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-prose-measure\\\",\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"var(--text-lg)\\\",\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.\\\"}],[\\\"$\\\",\\\"figure\\\",null,{\\\"className\\\":\\\"sv-quote\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s12)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"blockquote\\\",null,{\\\"className\\\":\\\"sv-quote__text\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0},\\\"children\\\":\\\"The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.\\\"}]}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"sv-quote__by\\\",\\\"children\\\":\\\"Chief Technology Officer, Clinical workflow vendor\\\"}]]}]]}]]}]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"1b:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\