\\\"p\\\",null,{\\\"className\\\":\\\"foot__positioning\\\",\\\"children\\\":\\\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"className\\\":\\\"foot__hotline\\\",\\\"href\\\":\\\"tel:+442045259100\\\",\\\"data-ir-hotline\\\":\\\"footer\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"foot__hotline-row\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":20,\\\"height\\\":20,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2.1,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-phone\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"9njp5v\\\",{\\\"d\\\":\\\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"Incident response — 24/7\\\"}]]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"foot__hotline-number\\\",\\\"children\\\":\\\"+44 20 4525 9100\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"foot__hotline-note\\\",\\\"children\\\":\\\"Answered by a responder, 24/7. Median pickup under 4 minutes.\\\"}]]}]]}],[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"foot__cols\\\",\\\"aria-label\\\":\\\"Footer\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"Cybersecurity\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"foot__col-heading\\\",\\\