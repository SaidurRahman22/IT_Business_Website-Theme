data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n24:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"related\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Related\"}],[\"$\",\"h2\",null,{\"id\":\"related\",\"className\":\"sv-h2\",\"children\":\"What this overlays\"}],null]}],[[\"$\",\"$L3b\",null,{\"as\":\"ul\",\"className\":\"sv-grid sv-grid--2\",\"children\":[[\"$\",\"$L3c\",\"application-security\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$71\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-card__top\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-file-code2 lucide-file-code-2 sv-card__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1pf5j1\",{\"d\":\"M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4\"}],[\"$\",\"path\",\"tnqrlb\",{\"d\":\"M14 2v4a2 2 0 0 0 2 2h4\"}],[\"$\",\"path\",\"oke12k\",{\"d\":\"m5 12-3 3 3 3\"}],[\"$\",\"path\",\"112psh\",{\"d\":\"m9 18 3-3-3-3\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"sv-card__name\",\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/application-security\",\"className\":\"card__link\",\"children\":\"Application Security\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"Secure code review, CI gates and threat models that engineers will actually maintain.\"}],[\"$\",\"p\",null,{\"style\":{\"margin\":0},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$72\"}],\"$L73\"]}]]}]]}],\"$L74\",\"$L75\",\"$L76\"]}],\"$L77\"]]}]}]]\n25:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"engagement\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Commercials\"}],[\"$\",\"h2\",null,{\"id\":\"engagement\",\"className\":\"sv-h2\",\"children\":\"Shape, timeline and scoping\"}],null]}],[\"$\",\"dl\",null,{\"className\":\"sv-defs\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Timeline\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Runs for the life of the build. The threat model happens before sprint one.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Team shape\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Your delivery squad plus a named security engineer at 20–30% allocation, and an independent lead tester for the pre-release test.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Engagement\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"An overlay on any build engagement, or a programme applied to an existing in-house delivery team.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Scoping\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":[\"A named engineer replies within one business day. Scoping call within three.\",\" \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services/engagement-models\",\"children\":\"How the four engagement models differ\"}],\".\"]}]]}]]}]]}]}]]\n26:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"The rest of what buyers ask\"}],[\"$\",\"p\",null,{\"className\":\"sv-head__lede\",\"children\":\"The conflict-of-interest question is answered in full further up this page.\"}]]}],[\"$\",\"$L78\",null,{\"items\":[{\"q\":\"What does this cost compared with building then testing?\",\"a\":\"The security allocation is roughly 8 to 12% of the build cost. Against it: the findings arrive when they cost a sprint rather than a redesign, there is no handover and re-learning period, and compliance evidence comes out of the process rather than out of a separate exercise. On the engagements where we have both numbers, integrated has been cheaper in total — but we would rather show you the two case studies than assert it.\"},{\"q\":\"Can you apply this to our in-house team?\",\"a\":\"Yes, and it is a common engagement. The security practice embeds with your delivery team, the gates and the backlog are yours, and the goal is that your engineers own the model within two quarters. We bring the testers; you keep the capability.\"},{\"q\":\"What if a critical finding appears a week before launch?\",\"a\":\"It blocks the launch, and that is agreed in writing before the engagement starts, so the conversation happens when nobody is under pressure. In practice continuous review means late criticals are rare — the point of the model is to move findings earlier, and the cycle-time number is how you check that it is working.\"},{\"q\":\"Does this replace a penetration test?\",\"a\":\"No — it contains one, and adds the continuous work around it. If you only want the point-in-time measurement, buy the test on its own; it is a legitimate purchase. This is for building a system that passes it.\"},{\"q\":\"How do you prove the cycle-time claim?\",\"a\":\"Every finding is timestamped at confirmation and at the deploy that fixed it, both drawn from your own tracker and your own pipeline rather than from ours. The monthly report shows the distribution, not just the median, because the tail is where the interesting cases are.\"},{\"q\":\"What compliance evidence does this generate?\",\"a\":\"Secure development policy evidence for SOC 2 CC8.1, ISO 27001 Annex A 8.25 to 8.31, and PCI DSS Requirement 6. Because the evidence is generated by the process rather than assembled for the audit, it tends to survive sampling.\"}],\"headingLevel\":3,\"jsonLd\":false}]]}]}]]\n79:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n27:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section grain\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a secure-SDLC assessment\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":\"A named engineer replies within one business day. Scoping call within three.\"}],[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s6)\"},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$79\"}],\"$L7a\"]}]]}],\"$L7b\"]}]}]}]]\n28:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/9ace18a20ce1574a.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n29:[\"$\",\"$L7c\",null,{\"children\":[\"$L7d\",[\"$\",\"$L7e\",null,{\"promise\":\"$@7f\"}]]}]\n2f:[\"$\",\"li\",\"/services/qa-automation\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/qa-automation\",\"className\":\"foot__link\",\"children\":\"QA & Test Automation\"}]}]\n30:[\"$\",\"div\",\"Company\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"foot__col-heading\",\"children\":\"Company\"}],[\"$\",\"ul\",null,{\"className\":\"foot__list\",\"children\":[[\"$\",\"li\",\"/about\",{\"children\":[