gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n8:[[\"$\",\"style\",null,{\"href\":\"envenox-footer\",\"precedence\":\"default\",\"children\":\"$12\"}],\"$L13\"]\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n14:T43db,\n/* ---------- page-level type ---------- */\n.sv-h1 {\n  font-size: clamp(2rem, 6.4vw, 3.75rem);\n  margin: 0;\n  max-width: 20ch;\n}\n.sv-h1--long { max-width: 24ch; font-size: clamp(1.875rem, 5.6vw, 3rem); }\n.sv-sub {\n  margin: var(--s4) 0 0;\n  font-size: var(--text-lg);\n  color: var(--muted-strong);\n  max-width: 54ch;\n}\n.sv-lede {\n  margin: var(--s6) 0 0;\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n.sv-h2 {\n  font-size: clamp(1.5rem, 3.6vw, 2.25rem);\n  margin: 0;\n  max-width: 24ch;\n}\n.sv-h3 {\n  font-size: var(--text-xl);\n  margin: 0;\n}\n.sv-note {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-sm);\n  color: var(--muted);\n  max-width: 68ch;\n}\n\n/* ---------- section head ---------- */\n.sv-head { margin-bottom: var(--s12); }\n.sv-head__rule { height: 1px; background-color: var(--border); margin-bottom: var(--s6); }\n.sv-head__eyebrow { margin: 0 0 var(--s3); }\n.sv-head__lede { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 68ch; }\n\n/* ---------- hero ---------- */\n.sv-hero__eyebrow { margin: 0 0 var(--s4); }\n.sv-hero__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s3);\n  margin-top: var(--s8);\n}\n.sv-hero__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s2) var(--s6);\n  margin: var(--s6) 0 0;\n  padding: 0;\n  list-style: none;\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n/* ---------- credibility stat (first paragraph, PART 8.3) ---------- */\n.sv-cred {\n  margin: var(--s8) 0 0;\n  padding: var(--s6);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  max-width: 68ch;\n}\n.sv-cred__figure {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.sv-cred__context { display: block; margin-top: var(--s2); color: var(--muted-strong); }\n\n/* ---------- grids ---------- */\n.sv-grid { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 680px) { .sv-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-grid > li { min-width: 0; }\n\n/* Two columns of prose: the heading rail and the body. */\n.sv-rail { display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .sv-rail { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s16); }\n}\n.sv-rail__aside { min-width: 0; }\n.sv-rail__body { min-width: 0; }\n\n/* ---------- jump nav ---------- */\n.sv-jump {\n  position: sticky;\n  top: var(--nav-h);\n  z-index: 20;\n  background-color: color-mix(in oklab, var(--bg) 94%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--border);\n}\n.sv-jump__inner {\n  display: flex;\n  gap: var(--s1);\n  overflow-x: auto;\n  scrollbar-width: thin;\n  padding-block: var(--s2);\n  -webkit-overflow-scrolling: touch;\n}\n.sv-jump__link {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  min-height: 40px;\n  padding-inline: var(--s3);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-jump__link:hover { color: var(--fg); background-color: var(--surface); }\n\n/* ---------- service card ---------- */\n.sv-card { display: flex; flex-direction: column; height: 100%; gap: var(--s4); }\n.sv-card__top { display: flex; align-items: flex-start; gap: var(--s3); }\n.sv-card__icon { flex: none; color: var(--accent); margin-top: 2px; }\n.sv-card__name { font-size: var(--text-lg); margin: 0; }\n.sv-card__line { margin: 0; color: var(--muted-strong); }\n.sv-card__list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  display: grid;\n  gap: var(--s2);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n.sv-card__list li { display: flex; gap: var(--s2); }\n.sv-card__tick { flex: none; margin-top: 3px; color: var(--accent); }\n.sv-card__cta {\n  margin: auto 0 0;\n  padding-top: var(--s4);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n}\n\n/* ---------- plain link list ---------- */\n.sv-links { display: grid; gap: 0; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }\n.sv-links > li { border-bottom: 1px solid var(--border); }\n.sv-links__a {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: baseline;\n  gap: var(--s4);\n  padding: var(--s4) 0;\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-links__a:hover { color: var(--accent); }\n.sv-links__label { font-weight: 500; }\n.sv-links__blurb { display: block; margin-top: var(--s1); font-size: var(--text-sm); color: var(--muted); font-weight: 400; }\n.sv-links__arrow { flex: none; color: var(--muted); align-self: center; }\n\n/* ---------- numbered methodology ---------- */\n.sv-phases { list-style: none; margin: 0; padding: 0; counter-reset: none; }\n.sv-phase {\n  display: grid;\n  gap: var(--s2);\n  padding: var(--s6) 0;\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 760px) {\n  .sv-phase { grid-template-columns: 3.5rem minmax(0, 14rem) minmax(0, 1fr); gap: var(--s6); align-items: start; }\n}\n.sv-phase__n { font-size: var(--text-sm); color: var(--muted); }\n.sv-phase__name { font-size: var(--text-lg); margin: 0; font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif; font-weight: 500; }\n.sv-phase__when { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-phase__body { margin: 0; color: var(--muted-strong); }\n\n/* ---------- console exhibits ----------\n   One stacked band per placement. The gap is large on purpose: two dense\n   consoles with 24px between them read as one confused screenshot. */\n.sv-consoles { display: grid; gap: var(--s24); }\n\n/* ---------- phase card stack ----------\n   The stack primitive manages the sticky behaviour; this only sets the rhythm\n   above it and the two type roles inside a card. */\n.sv-phaseStack { margin-top: var(--s16); }\n.sv-phaseWhen {\n  margin: 0 0 var(--s3);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.sv-phaseBody { margin: 0; color: var(--muted-strong); line-height: var(--leading-normal); }\n\n/* The artefact stack sits under the deliverables heading in the rail aside.\n   Capped so it never outgrows a 7fr column on a wide viewport. */\n.sv-deliverableArt { margin-top: var(--s8); max-width: 30rem; }\n\n/* ---------- deliverables / outcomes ---------- */\n.sv-ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n.sv-ticks > li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s3); color: var(--muted-strong); }\n.sv-ticks__mark { flex: none; margin-top: 4px; color: var(--accent); }\n\n/* ---------- chips (frameworks, stack, certifications) ---------- */\n.sv-chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n/*\n * Local override, not an edit to Badge.tsx. Badge sets white-space: nowrap,\n * which is right for a severity word (\"Critical\") and wrong for \"AWS\n * Well-Architected Security Pillar\" inside a 288px content box: a nowrap item\n * cannot shrink, so flex-wrap does not save it and the layout blows out at\n * 320px. Measured in headless Chromium at 320px, which is how the two real\n * offenders on this tree were found.\n *\n * Scoped to the five containers in which these routes render a Badge, so it\n * can never reach a severity badge elsewhere on the site — those live in the\n * product UI and must stay on one line.\n */\n.sv-chips .badge,\n.sv-card .badge,\n.sv-note .badge,\n.sv-seam__cta .badge,\n.sv-hero__meta .badge { white-space: normal; text-align: left; }\n\n/* ---------- accreditation strip ---------- */\n.sv-accred { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-accred { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-accred { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-accred__item {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: var(--s3);\n  padding: var(--s4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  min-width: 0;\n}\n.sv-accred__icon { flex: none; margin-top: 2px; color: var(--accent); }\n.sv-accred__label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); overflow-wrap: anywhere; }\n.sv-accred__issuer { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------- expert ---------- */\n.sv-expert { display: grid; gap: var(--s6); }\n@media (min-width: 760px) { .sv-expert { grid-template-columns: auto minmax(0, 1fr); gap: var(--s8); } }\n.sv-expert__name { margin: 0; font-size: var(--text-xl); }\n.sv-expert__role { margin: var(--s1) 0 0; color: var(--accent); font-size: var(--text-sm); }\n.sv-expert__bio { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 60ch; }\n.sv-expert__certs-label { margin: var(--s6) 0 var(--s2); }\n\n/* ---------- case study ---------- */\n.sv-metrics { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-metric__value {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  overflow-wrap: anywhere;\n}\n.sv-metric__label { display: block; margin-top: var(--s2); color: var(--muted-strong); font-size: var(--text-sm); }\n.sv-metric__note { display: block; margin-top: var(--s1); color: var(--muted); font-size: var(--text-xs); }\n\n.sv-quote { margin: 0; }\n.sv-quote__text {\n  margin: 0;\n  font-size: var(--text-lg);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n  max-width: 52ch;\n}\n.sv-quote__by { display: block; margin-top: var(--s4); font-size: var(--text-sm); color: var(--muted); font-style: normal; }\n.sv-quote__mark { color: var(--muted); margin-bottom: var(--s3); }\n\n/* ---------- definition grid (timeline / team / engagement) ---------- */\n.sv-defs { margin: 0; display: grid; gap: 0; }\n.sv-def { padding: var(--s6) 0; border-top: 1px solid var(--border); display: grid; gap: var(--s2); }\n@media (min-width: 760px) { .sv-def { grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: var(--s6); } }\n.sv-def__term { font-size: var(--text-sm); color: var(--muted); margin: 0; letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-def__desc { margin: 0; color: var(--muted-strong); }\n\n/* ---------- the seam ---------- */\n.sv-seam { display: grid; gap: var(--s6); align-items: stretch; }\n@media (min-width: 980px) {\n  .sv-seam { grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, 1fr); gap: var(--s4); align-items: stretch; }\n}\n.sv-seam__col { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.sv-seam__centre { border-color: var(--accent); }\n.sv-seam__kicker { margin: 0 0 var(--s3); }\n.sv-seam__name { margin: 0; font-size: var(--text-xl); }\n.sv-seam__line { margin: var(--s3) 0 0; color: var(--muted-strong); }\n.sv-seam__body { margin: var(--s4) 0 0; color: var(--muted); font-size: var(--text-sm); }\n.sv-seam__cta { margin: auto 0 0; padding-top: var(--s6); }\n\n/* ---------- contrast pair (engagement models) ---------- */\n.sv-contrast { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-contrast { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-contrast__head { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s4); }\n.sv-contrast__icon { flex: none; color: var(--accent); }\n.sv-contrast__h { margin: 0; font-size: var(--text-lg); }\n.sv-contrast__rows { margin: 0; display: grid; }\n.sv-contrast__row { padding: var(--s4) 0; border-top: 1px solid var(--border); }\n.sv-contrast__term { margin: 0; font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }\n.sv-contrast__desc { margin: var(--s2) 0 0; color: var(--muted-strong); }\n\n/* ---------- form ---------- */\n.sv-form { display: grid; gap: var(--s6); max-width: 44rem; }\n.sv-field { display: grid; gap: var(--s2); min-width: 0; }\n.sv-field--check { grid-template-columns: auto minmax(0, 1fr); align-items: start; column-gap: var(--s3); }\n.sv-label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.sv-req { color: var(--accent); margin-left: 2px; }\n.sv-help { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.sv-input,\n.sv-select,\n.sv-textarea {\n  width: 100%;\n  min-width: 0;\n  min-height: 44px;\n  padding: var(--s3) var(--s4);\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  font: inherit;\n  font-size: var(--text-base);\n  transition: border-color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-textarea { min-height: 7.5rem; resize: vertical; line-height: var(--leading-normal); }\n.sv-input:hover, .sv-select:hover, .sv-textarea:hover { border-color: var(--fg); }\n.sv-input::placeholder, .sv-textarea::placeholder { color: var(--muted); }\n.sv-check { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--accent); flex: none; }\n.sv-form__actions { display: flex; flex-wrap: wrap; gap: var(--s4); align-items: center; }\n.sv-form__sla { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n/*\n * VALIDATION SUMMARY — revealed by :target, so it needs neither JavaScript nor\n * a searchParams read on the page.\n *\n * Reading ?enquiry= would have been the obvious way to show this, and it was\n * the first implementation. It is wrong: a page that reads searchParams opts\n * out of static generation, which would have made all sixteen service pages\n * dynamically rendered to display a message a visitor almost never sees. The\n * server action redirects to #enquiry-incomplete or #enquiry-email instead;\n * the browser scrolls to the matching block and :target reveals it. Static\n * generation survives, and so does the message.\n *\n * The common case never reaches here at all: the \"required\" attribute is\n * native constraint validation, which browsers enforce with scripting off.\n * The server check exists for a crafted POST, not a forgotten field.\n *\n * No --signal-* colour: Badge.tsx states severity colour is the one place in\n * the codebase those tokens appear, and a form error is not a severity rating.\n */\n.sv-form__error {\n  display: none;\n  padding: var(--s4);\n  border: 1px solid var(--border-strong);\n  border-left: 2px solid var(--fg);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  scroll-margin-top: calc(var(--nav-h) + var(--s8));\n}\n.sv-form__error:target { display: block; }\n.sv-form__error p { margin: 0; color: var(--fg); font-size: var(--text-sm); }\n\n/*\n * A box that declares its own palette inside a band of another palette.\n * <Card> sets `color: inherit`, so a bare theme-* class on it would re-colour\n * the surface and leave the text behind; this sets both. Used on\n * /services/engagement-models, where the security retainer and the delivery\n * retainer sit side by side in the palette of their own act — the commercial\n * contrast made visible rather than described.\n */\n.sv-theme-box {\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  min-width: 0;\n}\n\n/* ---------- misc ---------- */\n.sv-cta-band { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-cta-band { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s12); } }\n.sv-cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--s3); }\n\n.sv-hotline {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n}\n.sv-hotline__num {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: clamp(1.375rem, 4.5vw, 1.75rem);\n  font-weight: 500;\n  color: var(--fg);\n  text-decoration: none;\n  overflow-wrap: anywhere;\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-hotline__num:hover { color: var(--accent); }\n\n.sv-stub {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n  max-width: 44rem;\n}\n.sv-prose-measure { max-width: 68ch; }\n.sv-sr {\n  position: absolute;\n  width: 1px; height: 1px;\n  padding: 0; margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\nb:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-services\",\"precedence\":\"default\",\"children\":\"$14\"}],\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\"],[\"$L28\"],\"$L29\"]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L2a\",null,{\"children\":\"$L2b\"}],null],[\"$\",\"$L2c\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$2d\",null,{\"fallback\":null,\"children\":\"$L2e\"}]}]}]]}]\n3a:I[4835,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"5058\",\"static/chunks/5058-a83b96337b222573.js\",\"4200\",\"static/chunks/app/services/devsecops/page-bce8ab80695c250e.js\"],\"SecureSdlcPipeline\"]\n3b:I[7664,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"5058\",\"static/chunks/5058-a83b96337b222573.js\",\"4200\",\"static/chunks/app/services/devsecops/page-bce8ab80695c250e.js\"],\"RevealGroup\"]\n3c:I[7664,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"5058\",\"static/chunks/5058-a83b96337b222573.js\",\"4200\",\"static/chunks/app/services/devsecops/page-bce8ab80695c250e.js\"],\"Reveal\"]\n78:I[4349,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"5058\",\"static/chunks/5058-a83b96337b222573.js\",\"4200\",\"static/chunks/app/services/devsecops/page-bce8ab80695c250e.js\"],\"Faq\"]\n7c:I[4431,[],\"OutletBoundary\"]\n7e:I[5278,[],\"AsyncMetadataOutlet\"]\nf:[\"$\",\"span\",null,{\"style\":{\"display\":\"block\",\"fontWeight\":500},\"children\":\"Contact\"}]\n10:[\"$\",\"span\",null,{\"style\":{\"display\":\"block\",\"color\":\"var(--muted)\",\"fontSize\":\"var(--text-sm)\",\"marginTop\":\"var(--s1)\"},\"children\":\"Book a 60-minute scoping call\"}]\n11:[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s12)\",\"color\":\"var(--muted)\",\"fontSize\":\"var(--text-sm)\"},\"children\":[\"Everything in one list: \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/sitemap\",\"style\":{\"color\":\"var(--fg)\"},\"children\":\"site map\"}],\".\",\" \",\"In an active incident?\",\" \",[\"$\",\"a\",null,{\"className\":\"u-link u-mono\",\"href\":\"tel:+442045259100\",\"style\":{\"color\":\"var(--fg)\"},\"children\":\"+44 20 4525 9100\"}],\" \",\"— answered by a responder, 24/7.\"]}]\n13:[\"$\",\"footer\",null,{\"className\":\"foot theme-dark transition-theme grain\",\"data-theme-section\":\"dark\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"foot__top\",\"children\":[[\"$\",\"div\",null,{\"className\":\"foot__brand\",\"children\":[[\"$\",\"$Le\",null,{\"href\":\"/\",\"className\":\"foot__wordmark\",\"children\":\"Envenox\"}],[\"$\",\"p\",null,{\"className\":\"foot__positioning\",\"children\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"}],[\"$\",\"a\",null,{\"className\":\"foot__hotline\",\"href\":\"tel:+442045259100\",\"data-ir-hotline\":\"footer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"foot__hotline-row\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.1,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-phone\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"9njp5v\",{\"d\":\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"u-eyebrow\",\"children\":\"Incident response — 24/7\"}]]}],[\"$\",\"span\",null,{\"className\":\"foot__hotline-number\",\"children\":\"+44 20 4525 9100\"}],[\"$\",\"span\",null,{\"className\":\"foot__hotline-note\",\"children\":\"Answered by a responder, 24/7. Median pickup under 4 minutes.\"}]]}]]}],[\"$\",\"nav\",null,{\"className\":\"foot__cols\",\"aria-label\":\"Footer\",\"children\":[[\"$\",\"div\",\"Cybersecurity\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"foot__col-heading\",\"children\":\"Cybersecurity\"}],[\"$\",\"ul\",null,{\"className\":\"foot__list\",\"children\":[[\"$\",\"li\",\"/services/penetration-testing\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/penetration-testing\",\"className\":\"foot__link\",\"children\":\"Penetration Testing\"}]}],[\"$\",\"li\",\"/services/application-security\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/application-security\",\"className\":\"foot__link\",\"children\":\"Application Security\"}]}],[\"$\",\"li\",\"/services/cloud-security\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/cloud-security\",\"className\":\"foot__link\",\"children\":\"Cloud Security\"}]}],[\"$\",\"li\",\"/services/red-teaming\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/red-teaming\",\"className\":\"foot__link\",\"children\":\"Red Teaming\"}]}],[\"$\",\"li\",\"/services/managed-detection-response\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/managed-detection-response\",\"className\":\"foot__link\",\"children\":\"Managed Detection & Response\"}]}],[\"$\",\"li\",\"/services/incident-response\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/incident-response\",\"className\":\"foot__link\",\"children\":\"Incident Response\"}]}],[\"$\",\"li\",\"/services/grc-compliance\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/grc-compliance\",\"className\":\"foot__link\",\"children\":\"GRC & Compliance\"}]}],[\"$\",\"li\",\"/services/vciso\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/vciso\",\"className\":\"foot__link\",\"children\":\"vCISO\"}]}]]}]]}],[\"$\",\"div\",\"Software Development\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"foot__col-heading\",\"children\":\"Software Development\"}],[\"$\",\"ul\",null,{\"className\":\"foot__list\",\"children\":[[\"$\",\"li\",\"/services/custom-software\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/custom-software\",\"className\":\"foot__link\",\"children\":\"Custom Software\"}]}],[\"$\",\"li\",\"/services/web-application-development\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/web-application-development\",\"className\":\"foot__link\",\"children\":\"Web Applications\"}]}],[\"$\",\"li\",\"/services/platform-engineering\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/platform-engineering\",\"className\":\"foot__link\",\"children\":\"Platform & DevOps\"}]}],[\"$\",\"li\",\"/services/erp\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/erp\",\"className\":\"foot__link\",\"children\":\"ERP\"}]}],[\"$\",\"li\",\"/services/crm\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/crm\",\"className\":\"foot__link\",\"children\":\"CRM\"}]}],[\"$\",\"li\",\"/services/hrm\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/hrm\",\"className\":\"foot__link\",\"children\":\"HRM\"}]}],[\"$\",\"li\",\"/services/lms\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/lms\",\"className\":\"foot__link\",\"children\":\"LMS\"}]}],\"$L2f\"]}]]}],\"$L30\",\"$L31\"]}]]}],\"$L32\",\"$L33\"]}]}]\n34:T876,{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://envenox.com/services/devsecops#service\",\"name\":\"Secure SDLC\",\"serviceType\":\"Secure SDLC\",\"alternateName\":\"Secure SDLC\",\"description\":\"We build it and we break it. The findings land in our own sprint backlog.\",\"disambiguatingDescription\":\"One firm, two practices, one backlog. The seam between build and break, removed.\",\"url\":\"https://envenox.com/services/devsecops\",\"provider\":{\"@id\":\"https://envenox.com/#organization\"},\"areaServed\":[{\"@type\":\"Country\",\"name\":\"United Kingdom\"},{\"@type\":\"Country\",\"name\":\"Bangladesh\"}],\"audience\":{\"@type\":\"BusinessAudience\",\"name\":\"Regulated organisations\"},\"category\":\"Secure software development lifecycle\",\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Secure SDLC — what is included\",\"itemListElement\":[{\"@type\":\"OfferCatalogItem\",\"position\":1,\"name\":\"Threat model at design time\",\"description\":\"Before the first sprint. The cheapest security finding is an architecture decision, and the most expensive one is the same decision discovered in week forty.\"},{\"@type\":\"OfferCatalogItem\",\"position\":2,\"name\":\"Secure design review at each decision\",\"description\":\"Our testers review architectural decision records as they are written, not the finished system.\"},{\"@type\":\"OfferCatalogItem\",\"position\":3,\"name\":\"Security in the pipeline\",\"description\":\"SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.\"},{\"@type\":\"OfferCatalogItem\",\"position\":4,\"name\":\"Continuous testing during the build\",\"description\":\"Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.\"},{\"@type\":\"OfferCatalogItem\",\"position\":5,\"name\":\"Pre-release penetration test\",\"description\":\"A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.\"},{\"@type\":\"OfferCatalogItem\",\"position\":6,\"name\":\"Monitoring and retest\",\"description\":\"Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.\"}]},\"termsOfService\":\"https://envenox.com/legal/terms\"}15:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$34\"}}]\n16:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Envenox\\\",\\\"item\\\":\\\"https://envenox.com/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Services\\\",\\\"item\\\":\\\"https://envenox.com/services\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Secure SDLC\\\",\\\"item\\\":\\\"https://envenox.com/services/devsecops\\\"}]}\"}}]\n35:Tbc3,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is it a conflict of interest to test your own build?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.\"}},{\"@type\":\"Question\",\"name\":\"What does this cost compared with building then testing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The security allocation is roughly 8 to 12% of the build cost. Against it: the findings arrive when they cost a sprint rather than a redesign, there is no handover and re-learning period, and compliance evidence comes out of the process rather than out of a separate exercise. On the engagements where we have both numbers, integrated has been cheaper in total — but we would rather show you the two case studies than assert it.\"}},{\"@type\":\"Question\",\"name\":\"Can you apply this to our in-house team?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, and it is a common engagement. The security practice embeds with your delivery team, the gates and the backlog are yours, and the goal is that your engineers own the model within two quarters. We bring the testers; you keep the capability.\"}},{\"@type\":\"Question\",\"name\":\"What if a critical finding appears a week before launch?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It blocks the launch, and that is agreed in writing before the engagement starts, so the conversation happens when nobody is under pressure. In practice continuous review means late criticals are rare — the point of the model is to move findings earlier, and the cycle-time number is how you check that it is working.\"}},{\"@type\":\"Question\",\"name\":\"Does this replace a penetration test?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No — it contains one, and adds the continuous work around it. If you only want the point-in-time measurement, buy the test on its own; it is a legitimate purchase. This is for building a system that passes it.\"}},{\"@type\":\"Question\",\"name\":\"How do you prove the cycle-time claim?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every finding is timestamped at confirmation and at the deploy that fixed it, both drawn from your own tracker and your own pipeline rather than from ours. The monthly report shows the distribution, not just the median, because the tail is where the interesting cases are.\"}},{\"@type\":\"Question\",\"name\":\"What compliance evidence does this generate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Secure development policy evidence for SOC 2 CC8.1, ISO 27001 Annex A 8.25 to 8.31, and PCI DSS Requirement 6. Because the evidence is generated by the process rather than assembled for the audit, it tends to survive sampling.\"}}]}17:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$35\"}}]\n36:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n18:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":{\"paddingTop\":\"calc(var(--nav-h) + var(--s16))\"},\"aria-labelledby\":\"devsecops-h1\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-hero__eyebrow\",\"children\":[[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services\",\"children\":\"Services\"}],\" · \",\"Secure SDLC\"]}],[[\"$\",\"style\",null,{\"href\":\"envenox-chapter-opener\",\"precedence\":\"default\",\"children\":\"\\n.chapter {\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s6);\\n}\\n.chapter__line {\\n  font-family: var(--font-instrument-serif), ui-serif, Georgia, serif;\\n  font-weight: 400;\\n  font-size: var(--text-3xl);\\n  line-height: 1.08;\\n  letter-spacing: 0;\\n  color: var(--fg);\\n  max-width: 22ch;\\n  text-wrap: balance;\\n  margin: 0;\\n}\\n@media (min-width: 768px) {\\n  .chapter__line { font-size: var(--text-4xl); max-width: 20ch; }\\n}\\n@media (min-width: 1024px) {\\n  .chapter__line { font-size: var(--text-5xl); }\\n}\\n.chapter__line em { font-style: italic; }\\n.chapter__note {\\n  color: var(--muted);\\n  font-size: var(--text-base);\\n  max-width: 48ch;\\n  margin: 0;\\n}\\n.chapter__rule { height: 1px; background-color: var(--border); width: 100%; }\\n\"}],[\"$\",\"div\",null,{\"className\":\"chapter\",\"children\":[null,null,[\"$\",\"h1\",null,{\"id\":\"devsecops-h1\",\"className\":\"chapter__line\",\"children\":\"We build it and we break it.\"}],[\"$\",\"p\",null,{\"className\":\"chapter__note\",\"children\":\"One firm, two practices, one backlog. The seam between build and break, removed.\"}]]}]],[\"$\",\"p\",null,{\"className\":\"sv-cred\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-cred__figure\",\"children\":\"9 days median\"}],[\"$\",\"span\",null,{\"className\":\"sv-cred__context\",\"children\":\"from a security finding being confirmed to the fix being in production, on joint engagements\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-hero__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$36\"}],\"$L37\"],\"$L38\"]}],\"$L39\"]}]}]]\n19:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"the-gap\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"The gap\"}],[\"$\",\"h2\",null,{\"id\":\"the-gap\",\"className\":\"sv-h2\",\"children\":\"Week forty-one is the expensive way\"}],[\"$\",\"p\",null,{\"className\":\"sv-head__lede\",\"children\":\"We build it and we break it. The findings land in our own sprint backlog.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield-alert\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"var(--accent)\"},\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],[\"$\",\"path\",\"1got3b\",{\"d\":\"M12 8v4\"}],[\"$\",\"path\",\"1drbdi\",{\"d\":\"M12 16h.01\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"style\":{\"marginTop\":\"var(--s4)\"},\"children\":\"The client had to replace a clinical workflow system their customers depended on, carry NHS Data Security and Protection Toolkit obligations plus a SOC 2 Type II commitment made to a US customer, and do it in under a year. Their previous build, with a different vendor, had been tested in its final month: the test returned four criticals, two of which required an architectural change, and the launch slipped by five months. The brief was explicit — never again — but the proposed remedy, buying a second security vendor to test earlier, reproduces the handover rather than removing it.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"p\",null,{\"className\":\"sv-prose-measure\",\"style\":{\"margin\":0,\"fontSize\":\"var(--text-lg)\",\"color\":\"var(--muted-strong)\"},\"children\":\"The standard arrangement is that a development firm builds your software for forty weeks and a security firm tests it in week forty-one. Everything that test finds is now expensive, because the architecture is set, the team is rolling off, and a finding that requires a design change arrives after the design is load-bearing. Both firms behaved correctly and the outcome is still bad. Our two practices run against each other continuously instead: our testers review the design before it is built, read the code as it is written, and raise findings into the same backlog our engineers work from. The number that matters is the nine days between a finding being confirmed and the fix being live, and it is only possible because there is no handover in the middle.\"}]}]]}]]}]}]]\n1a:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"objection\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\",\"style\":{\"marginBottom\":\"var(--s6)\"}}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"The obvious objection\"}],[\"$\",\"h2\",null,{\"id\":\"objection\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Is it a conflict of interest to test your own build?\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-prose-measure\",\"style\":{\"margin\":0,\"fontSize\":\"var(--text-lg)\",\"color\":\"var(--muted-strong)\"},\"children\":\"It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.\"}],[\"$\",\"figure\",null,{\"className\":\"sv-quote\",\"style\":{\"marginTop\":\"var(--s12)\"},\"children\":[[\"$\",\"blockquote\",null,{\"className\":\"sv-quote__text\",\"children\":[\"$\",\"p\",null,{\"style\":{\"margin\":0},\"children\":\"The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"sv-quote__by\",\"children\":\"Chief Technology Officer, Clinical workflow vendor\"}]]}]]}]]}]}]}]]\n1b:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"the-model\",\"children\":[\"$\",\"div\",null,{\"className\":\"sec__bleed\",\"children\":[[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"The integrated model\"}],[\"$\",\"h2\",null,{\"id\":\"the-model\",\"className\":\"sv-h2\",\"children\":\"Secure SDLC\"}],[\"$\",\"p\",null,{\"className\":\"sv-head__lede\",\"children\":\"One firm, two practices, one backlog. The seam between build and break, removed.\"}]]}]}],[\"$\",\"$L3a\",null,{}]]}]}]]\n3d:T43d,\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);