 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"blockquote\\\",null,{\\\"className\\\":\\\"sv-quote__text\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0},\\\"children\\\":\\\"The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.\\\"}]}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"sv-quote__by\\\",\\\"children\\\":\\\"Chief Technology Officer, Clinical workflow vendor\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"5a:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s16)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The technical layer\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__body\\\",\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-prose-measure\\\",\\\"style\\\":{\\\"margin\\\":0,\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"The three architecture-changing findings from the week-one threat model were: an audit log designed as application-writable rather than append-only, which would have failed a DSPT evidence question about tamper-resistance; a plan to hold the clinical record encryption key in the same AWS account as the application, which collapses the blast radius of an account compromise into a total data breach; and a clinician impersonation feature — genuinely required for support — specified without a second-person authorisation step or a distinct audit event, which is the precise shape of the control an Information Commissioner enquiry asks about first. All three cost roughly a sprint to address in week one. The audit log alone would have been a six-week retrofit in month ten, because by then eleven services would have been writing to it.\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"5b:[\\\"$\\\",\\\"th\\\",null,{\\\"scope\\\":\\\"row\\\",\\\"role\\\":\\\"rowheader\\\",\\\"className\\\":\\\"diagram_rowHead__YLZHO\\\",\\\"children\\\":\\\"Remediation lead time\\\"}]\\n5c:[\\\"$\\\",\\\"td\\\",null,{\\\"role\\\":\\\"cell\\\",\\\"className\\\":\\\"diagram_cell__AqgJQ\\\",\\\"data-col\\\":\\\"split\\\",\\\"data-label\\\":\\\"Two vendors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"diagram_cellLabel__XB5X2\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"Two vendors\\\"}],\\\"Weeks. A finding is written into one firm’s report, triaged in a meeting, re-estimated into another firm’s backlog, then scheduled against a roadmap that was agreed before the finding existed.\\\"]}]\\n5d:[\\\"$\\\",\\\"td\\\",null,{\\\"role\\\":\\\"cell\\\",\\\"className\\\":\\\"diagram_cell__AqgJQ\\\",\\\"data-col\\\":\\\"joined\\\",\\\"data-label\\\":\\\"One partner\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"diagram_cellLabel__XB5X2\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"One partner\\\"}],\\\"Nine days median, from a finding being confirmed to the fix being live — measured in your tracker and your pipeline, not ours, and reported monthly as a distribution rather than a headline.\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"5e:[\\\"$\\\",\\\"tr\\\",\\\"Who is accountable when it breaks\\\",{\\\"role\\\":\\\"row\\\",\\\"className\\\":\\\"diagram_row__V8zVi\\\",\\\"children\\\":[[\\\"$\\\",\\\"th\\\",null,{\\\"scope\\\":\\\"row\\\",\\\"role\\\":\\\"rowheader\\\",\\\"className\\\":\\\"diagram_rowHead__YLZHO\\\",\\\"children\\\":\\\"Who is accountable when it breaks\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"role\\\":\\\"cell\\\",\\\"className\\\":\\\"diagram_