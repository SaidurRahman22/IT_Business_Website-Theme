{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/services/layout,_N_T_/services/devsecops/layout,_N_T_/services/devsecops/page,_N_T_/services/devsecops"},"routeCache":{"key":"/route-cache/APP_PAGE/83fbcaeaa92771247fa736df54b8fe4e1dac292ae4271a875d2837e87b73d03f/$/services/devsecops","owner":{"kind":"APP_PAGE","sourceRoute":"/services/devsecops/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/9ace18a20ce1574a.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-services envenox-section envenox-chapter-opener envenox-reveal-group envenox-card envenox-avatar-placeholder envenox-badge envenox-marquee envenox-faq\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ---------- page-level type ---------- */\n.sv-h1 {\n  font-size: clamp(2rem, 6.4vw, 3.75rem);\n  margin: 0;\n  max-width: 20ch;\n}\n.sv-h1--long { max-width: 24ch; font-size: clamp(1.875rem, 5.6vw, 3rem); }\n.sv-sub {\n  margin: var(--s4) 0 0;\n  font-size: var(--text-lg);\n  color: var(--muted-strong);\n  max-width: 54ch;\n}\n.sv-lede {\n  margin: var(--s6) 0 0;\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n.sv-h2 {\n  font-size: clamp(1.5rem, 3.6vw, 2.25rem);\n  margin: 0;\n  max-width: 24ch;\n}\n.sv-h3 {\n  font-size: var(--text-xl);\n  margin: 0;\n}\n.sv-note {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-sm);\n  color: var(--muted);\n  max-width: 68ch;\n}\n\n/* ---------- section head ---------- */\n.sv-head { margin-bottom: var(--s12); }\n.sv-head__rule { height: 1px; background-color: var(--border); margin-bottom: var(--s6); }\n.sv-head__eyebrow { margin: 0 0 var(--s3); }\n.sv-head__lede { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 68ch; }\n\n/* ---------- hero ---------- */\n.sv-hero__eyebrow { margin: 0 0 var(--s4); }\n.sv-hero__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s3);\n  margin-top: var(--s8);\n}\n.sv-hero__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s2) var(--s6);\n  margin: var(--s6) 0 0;\n  padding: 0;\n  list-style: none;\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n/* ---------- credibility stat (first paragraph, PART 8.3) ---------- */\n.sv-cred {\n  margin: var(--s8) 0 0;\n  padding: var(--s6);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  max-width: 68ch;\n}\n.sv-cred__figure {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.sv-cred__context { display: block; margin-top: var(--s2); color: var(--muted-strong); }\n\n/* ---------- grids ---------- */\n.sv-grid { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 680px) { .sv-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-grid > li { min-width: 0; }\n\n/* Two columns of prose: the heading rail and the body. */\n.sv-rail { display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .sv-rail { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s16); }\n}\n.sv-rail__aside { min-width: 0; }\n.sv-rail__body { min-width: 0; }\n\n/* ---------- jump nav ---------- */\n.sv-jump {\n  position: sticky;\n  top: var(--nav-h);\n  z-index: 20;\n  background-color: color-mix(in oklab, var(--bg) 94%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--border);\n}\n.sv-jump__inner {\n  display: flex;\n  gap: var(--s1);\n  overflow-x: auto;\n  scrollbar-width: thin;\n  padding-block: var(--s2);\n  -webkit-overflow-scrolling: touch;\n}\n.sv-jump__link {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  min-height: 40px;\n  padding-inline: var(--s3);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-jump__link:hover { color: var(--fg); background-color: var(--surface); }\n\n/* ---------- service card ---------- */\n.sv-card { display: flex; flex-direction: column; height: 100%; gap: var(--s4); }\n.sv-card__top { display: flex; align-items: flex-start; gap: var(--s3); }\n.sv-card__icon { flex: none; color: var(--accent); margin-top: 2px; }\n.sv-card__name { font-size: var(--text-lg); margin: 0; }\n.sv-card__line { margin: 0; color: var(--muted-strong); }\n.sv-card__list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  display: grid;\n  gap: var(--s2);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n.sv-card__list li { display: flex; gap: var(--s2); }\n.sv-card__tick { flex: none; margin-top: 3px; color: var(--accent); }\n.sv-card__cta {\n  margin: auto 0 0;\n  padding-top: var(--s4);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n}\n\n/* ---------- plain link list ---------- */\n.sv-links { display: grid; gap: 0; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }\n.sv-links > li { border-bottom: 1px solid var(--border); }\n.sv-links__a {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: baseline;\n  gap: var(--s4);\n  padding: var(--s4) 0;\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-links__a:hover { color: var(--accent); }\n.sv-links__label { font-weight: 500; }\n.sv-links__blurb { display: block; margin-top: var(--s1); font-size: var(--text-sm); color: var(--muted); font-weight: 400; }\n.sv-links__arrow { flex: none; color: var(--muted); align-self: center; }\n\n/* ---------- numbered methodology ---------- */\n.sv-phases { list-style: none; margin: 0; padding: 0; counter-reset: none; }\n.sv-phase {\n  display: grid;\n  gap: var(--s2);\n  padding: var(--s6) 0;\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 760px) {\n  .sv-phase { grid-template-columns: 3.5rem minmax(0, 14rem) minmax(0, 1fr); gap: var(--s6); align-items: start; }\n}\n.sv-phase__n { font-size: var(--text-sm); color: var(--muted); }\n.sv-phase__name { font-size: var(--text-lg); margin: 0; font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif; font-weight: 500; }\n.sv-phase__when { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-phase__body { margin: 0; color: var(--muted-strong); }\n\n/* ---------- console exhibits ----------\n   One stacked band per placement. The gap is large on purpose: two dense\n   consoles with 24px between them read as one confused screenshot. */\n.sv-consoles { display: grid; gap: var(--s24); }\n\n/* ---------- phase card stack ----------\n   The stack primitive manages the sticky behaviour; this only sets the rhythm\n   above it and the two type roles inside a card. */\n.sv-phaseStack { margin-top: var(--s16); }\n.sv-phaseWhen {\n  margin: 0 0 var(--s3);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.sv-phaseBody { margin: 0; color: var(--muted-strong); line-height: var(--leading-normal); }\n\n/* The artefact stack sits under the deliverables heading in the rail aside.\n   Capped so it never outgrows a 7fr column on a wide viewport. */\n.sv-deliverableArt { margin-top: var(--s8); max-width: 30rem; }\n\n/* ---------- deliverables / outcomes ---------- */\n.sv-ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n.sv-ticks > li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s3); color: var(--muted-strong); }\n.sv-ticks__mark { flex: none; margin-top: 4px; color: var(--accent); }\n\n/* ---------- chips (frameworks, stack, certifications) ---------- */\n.sv-chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n/*\n * Local override, not an edit to Badge.tsx. Badge sets white-space: nowrap,\n * which is right for a severity word (\"Critical\") and wrong for \"AWS\n * Well-Architected Security Pillar\" inside a 288px content box: a nowrap item\n * cannot shrink, so flex-wrap does not save it and the layout blows out at\n * 320px. Measured in headless Chromium at 320px, which is how the two real\n * offenders on this tree were found.\n *\n * Scoped to the five containers in which these routes render a Badge, so it\n * can never reach a severity badge elsewhere on the site — those live in the\n * product UI and must stay on one line.\n */\n.sv-chips .badge,\n.sv-card .badge,\n.sv-note .badge,\n.sv-seam__cta .badge,\n.sv-hero__meta .badge { white-space: normal; text-align: left; }\n\n/* ---------- accreditation strip ---------- */\n.sv-accred { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-accred { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-accred { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-accred__item {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: var(--s3);\n  padding: var(--s4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  min-width: 0;\n}\n.sv-accred__icon { flex: none; margin-top: 2px; color: var(--accent); }\n.sv-accred__label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); overflow-wrap: anywhere; }\n.sv-accred__issuer { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------- expert ---------- */\n.sv-expert { display: grid; gap: var(--s6); }\n@media (min-width: 760px) { .sv-expert { grid-template-columns: auto minmax(0, 1fr); gap: var(--s8); } }\n.sv-expert__name { margin: 0; font-size: var(--text-xl); }\n.sv-expert__role { margin: var(--s1) 0 0; color: var(--accent); font-size: var(--text-sm); }\n.sv-expert__bio { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 60ch; }\n.sv-expert__certs-label { margin: var(--s6) 0 var(--s2); }\n\n/* ---------- case study ---------- */\n.sv-metrics { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-metric__value {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  overflow-wrap: anywhere;\n}\n.sv-metric__label { display: block; margin-top: var(--s2); color: var(--muted-strong); font-size: var(--text-sm); }\n.sv-metric__note { display: block; margin-top: var(--s1); color: var(--muted); font-size: var(--text-xs); }\n\n.sv-quote { margin: 0; }\n.sv-quote__text {\n  margin: 0;\n  font-size: var(--text-lg);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n  max-width: 52ch;\n}\n.sv-quote__by { display: block; margin-top: var(--s4); font-size: var(--text-sm); color: var(--muted); font-style: normal; }\n.sv-quote__mark { color: var(--muted); margin-bottom: var(--s3); }\n\n/* ---------- definition grid (timeline / team / engagement) ---------- */\n.sv-defs { margin: 0; display: grid; gap: 0; }\n.sv-def { padding: var(--s6) 0; border-top: 1px solid var(--border); display: grid; gap: var(--s2); }\n@media (min-width: 760px) { .sv-def { grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: var(--s6); } }\n.sv-def__term { font-size: var(--text-sm); color: var(--muted); margin: 0; letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-def__desc { margin: 0; color: var(--muted-strong); }\n\n/* ---------- the seam ---------- */\n.sv-seam { display: grid; gap: var(--s6); align-items: stretch; }\n@media (min-width: 980px) {\n  .sv-seam { grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, 1fr); gap: var(--s4); align-items: stretch; }\n}\n.sv-seam__col { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.sv-seam__centre { border-color: var(--accent); }\n.sv-seam__kicker { margin: 0 0 var(--s3); }\n.sv-seam__name { margin: 0; font-size: var(--text-xl); }\n.sv-seam__line { margin: var(--s3) 0 0; color: var(--muted-strong); }\n.sv-seam__body { margin: var(--s4) 0 0; color: var(--muted); font-size: var(--text-sm); }\n.sv-seam__cta { margin: auto 0 0; padding-top: var(--s6); }\n\n/* ---------- contrast pair (engagement models) ---------- */\n.sv-contrast { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-contrast { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-contrast__head { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s4); }\n.sv-contrast__icon { flex: none; color: var(--accent); }\n.sv-contrast__h { margin: 0; font-size: var(--text-lg); }\n.sv-contrast__rows { margin: 0; display: grid; }\n.sv-contrast__row { padding: var(--s4) 0; border-top: 1px solid var(--border); }\n.sv-contrast__term { margin: 0; font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }\n.sv-contrast__desc { margin: var(--s2) 0 0; color: var(--muted-strong); }\n\n/* ---------- form ---------- */\n.sv-form { display: grid; gap: var(--s6); max-width: 44rem; }\n.sv-field { display: grid; gap: var(--s2); min-width: 0; }\n.sv-field--check { grid-template-columns: auto minmax(0, 1fr); align-items: start; column-gap: var(--s3); }\n.sv-label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.sv-req { color: var(--accent); margin-left: 2px; }\n.sv-help { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.sv-input,\n.sv-select,\n.sv-textarea {\n  width: 100%;\n  min-width: 0;\n  min-height: 44px;\n  padding: var(--s3) var(--s4);\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  font: inherit;\n  font-size: var(--text-base);\n  transition: border-color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-textarea { min-height: 7.5rem; resize: vertical; line-height: var(--leading-normal); }\n.sv-input:hover, .sv-select:hover, .sv-textarea:hover { border-color: var(--fg); }\n.sv-input::placeholder, .sv-textarea::placeholder { color: var(--muted); }\n.sv-check { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--accent); flex: none; }\n.sv-form__actions { display: flex; flex-wrap: wrap; gap: var(--s4); align-items: center; }\n.sv-form__sla { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n/*\n * VALIDATION SUMMARY — revealed by :target, so it needs neither JavaScript nor\n * a searchParams read on the page.\n *\n * Reading ?enquiry= would have been the obvious way to show this, and it was\n * the first implementation. It is wrong: a page that reads searchParams opts\n * out of static generation, which would have made all sixteen service pages\n * dynamically rendered to display a message a visitor almost never sees. The\n * server action redirects to #enquiry-incomplete or #enquiry-email instead;\n * the browser scrolls to the matching block and :target reveals it. Static\n * generation survives, and so does the message.\n *\n * The common case never reaches here at all: the \"required\" attribute is\n * native constraint validation, which browsers enforce with scripting off.\n * The server check exists for a crafted POST, not a forgotten field.\n *\n * No --signal-* colour: Badge.tsx states severity colour is the one place in\n * the codebase those tokens appear, and a form error is not a severity rating.\n */\n.sv-form__error {\n  display: none;\n  padding: var(--s4);\n  border: 1px solid var(--border-strong);\n  border-left: 2px solid var(--fg);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  scroll-margin-top: calc(var(--nav-h) + var(--s8));\n}\n.sv-form__error:target { display: block; }\n.sv-form__error p { margin: 0; color: var(--fg); font-size: var(--text-sm); }\n\n/*\n * A box that declares its own palette inside a band of another palette.\n * <Card> sets `color: inherit`, so a bare theme-* class on it would re-colour\n * the surface and leave the text behind; this sets both. Used on\n * /services/engagement-models, where the security retainer and the delivery\n * retainer sit side by side in the palette of their own act — the commercial\n * contrast made visible rather than described.\n */\n.sv-theme-box {\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  min-width: 0;\n}\n\n/* ---------- misc ---------- */\n.sv-cta-band { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-cta-band { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s12); } }\n.sv-cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--s3); }\n\n.sv-hotline {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n}\n.sv-hotline__num {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: clamp(1.375rem, 4.5vw, 1.75rem);\n  font-weight: 500;\n  color: var(--fg);\n  text-decoration: none;\n  overflow-wrap: anywhere;\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-hotline__num:hover { color: var(--accent); }\n\n.sv-stub {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n  max-width: 44rem;\n}\n.sv-prose-measure { max-width: 68ch; }\n.sv-sr {\n  position: absolute;\n  width: 1px; height: 1px;\n  padding: 0; margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n.chapter {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n}\n.chapter__line {\n  font-family: var(--font-instrument-serif), ui-serif, Georgia, serif;\n  font-weight: 400;\n  font-size: var(--text-3xl);\n  line-height: 1.08;\n  letter-spacing: 0;\n  color: var(--fg);\n  max-width: 22ch;\n  text-wrap: balance;\n  margin: 0;\n}\n@media (min-width: 768px) {\n  .chapter__line { font-size: var(--text-4xl); max-width: 20ch; }\n}\n@media (min-width: 1024px) {\n  .chapter__line { font-size: var(--text-5xl); }\n}\n.chapter__line em { font-style: italic; }\n.chapter__note {\n  color: var(--muted);\n  font-size: var(--text-base);\n  max-width: 48ch;\n  margin: 0;\n}\n.chapter__rule { height: 1px; background-color: var(--border); width: 100%; }\n\n.reveal-group > * { --reveal-delay: calc(var(--reveal-base, 0ms) + 0ms); }\n.reveal-group > *:nth-child(2) { --reveal-delay: calc(var(--reveal-base, 0ms) + 60ms); }\n.reveal-group > *:nth-child(3) { --reveal-delay: calc(var(--reveal-base, 0ms) + 120ms); }\n.reveal-group > *:nth-child(4) { --reveal-delay: calc(var(--reveal-base, 0ms) + 180ms); }\n.reveal-group > *:nth-child(n + 5) { --reveal-delay: calc(var(--reveal-base, 0ms) + 240ms); }\n\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\n\n.avatar-ph {\n  display: grid;\n  place-items: center;\n  flex: none;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border);\n  color: var(--paper-50);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  line-height: 1;\n  user-select: none;\n  overflow: hidden;\n}\n.avatar-ph--round { border-radius: 50%; }\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n\n/* Zero the trailing padding so the globals keyframe lands exactly. */\n.marquee__track.mq-track { padding-right: 0; list-style: none; margin: 0; padding-left: 0; }\n\n.mq__item {\n  display: flex;\n  align-items: center;\n  gap: var(--s3);\n  flex: none;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s3) var(--s4);\n  min-height: 56px;\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.mq__item:hover { border-color: var(--border-strong); }\n\n.mq__logo { display: inline-flex; flex: none; color: var(--muted-strong); }\n\n.mq__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.mq__label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1.2;\n  color: var(--fg);\n  white-space: nowrap;\n}\n.mq__meta {\n  font-size: var(--text-xs);\n  line-height: 1.2;\n  color: var(--muted);\n  white-space: nowrap;\n}\n.mq__link { color: inherit; text-decoration: none; }\n.mq__link:hover .mq__label { color: var(--fg); }\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\n\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\n@media (prefers-reduced-motion: reduce) {\n  .marquee__track.mq-track { padding-right: var(--gap); }\n}\n\n.faq { border-top: 1px solid var(--border); }\n.faq__item { border-bottom: 1px solid var(--border); }\n.faq__header { margin: 0; }\n\n.faq__trigger {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--s6);\n  width: 100%;\n  min-height: 44px;\n  padding: var(--s6) 0;\n  appearance: none;\n  background: none;\n  border: 0;\n  text-align: left;\n  cursor: pointer;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  /* Colour only. The row must not move under the pointer. */\n  transition: color var(--dur-base) var(--ease-out);\n}\n.faq__trigger:hover { color: var(--muted-strong); }\n.faq__trigger:focus-visible { outline-offset: -2px; }\n\n.faq__chevron {\n  flex: none;\n  margin-top: 2px;\n  color: var(--muted);\n  transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\n.faq__trigger[data-state='open'] .faq__chevron { transform: rotate(180deg); color: var(--fg); }\n\n/* .acc-content carries the collapseDown / collapseUp animations from globals. */\n.faq__content { overflow: hidden; }\n.faq__answer {\n  padding-bottom: var(--s6);\n  color: var(--muted-strong);\n  max-width: 68ch;\n  margin: 0;\n}\n\n/* The no-JS mirror. display:none also keeps it out of the a11y tree when\n   scripting is available, so nothing is announced twice. */\n.faq__nojs { display: none; border-top: 1px solid var(--border); }\n.no-js .faq__nojs { display: block; }\n.no-js .faq__accordion { display: none; }\n.faq__nojs dt {\n  padding-top: var(--s6);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.faq__nojs dd {\n  margin: var(--s2) 0 0;\n  padding-bottom: var(--s6);\n  border-bottom: 1px solid var(--border);\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/5058-a83b96337b222573.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/services/devsecops/page-bce8ab80695c250e.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>Secure SDLC · Envenox</title><meta name=\"description\" content=\"We build it and we break it. The findings land in our own sprint backlog. 9 days median from a security finding being confirmed to the fix being in production, on joint engagements.\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com/services/devsecops\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"Secure SDLC · Envenox\"/><meta property=\"og:description\" content=\"We build it and we break it. The findings land in our own sprint backlog. 9 days median from a security finding being confirmed to the fix being in production, on joint engagements.\"/><meta property=\"og:url\" content=\"https://envenox.com/services/devsecops\"/><meta property=\"og:site_name\" content=\"Envenox\"/><meta property=\"og:locale\" content=\"en_GB\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Secure SDLC · Envenox\"/><meta name=\"twitter:description\" content=\"We build it and we break it. The findings land in our own sprint backlog. 9 days median from a security finding being confirmed to the fix being in production, on joint engagements.\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav theme-dark transition-theme no-print\" data-scrolled=\"false\" data-nav-theme=\"dark\"><div class=\"nav__bar u-container\"><a class=\"nav__brand\" href=\"/\">Envenox</a><nav aria-label=\"Primary\" data-orientation=\"horizontal\" dir=\"ltr\" class=\"nav__desktop\"><div style=\"position:relative\"><ul data-orientation=\"horizontal\" class=\"nav__list\" dir=\"ltr\"><li><button id=\"radix-_R_klb_-trigger-Services\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Services\" class=\"nav__trigger\" data-radix-collection-item=\"\">Services<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Services\" aria-labelledby=\"radix-_R_klb_-trigger-Services\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/services/devsecops\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Secure SDLC</span><span class=\"nav__featured-blurb\">The page that explains why one firm does both. Start here.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/cybersecurity\"><span class=\"nav__link-label\">Cybersecurity</span><span class=\"nav__link-blurb\">Testing, assurance, detection and response</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/software-development\"><span class=\"nav__link-label\">Software Development</span><span class=\"nav__link-blurb\">Product build, platform and modernisation</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/penetration-testing\"><span class=\"nav__link-label\">Penetration Testing</span><span class=\"nav__link-blurb\">Web, mobile, network, cloud, API</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/application-security\"><span class=\"nav__link-label\">Application Security</span><span class=\"nav__link-blurb\">Secure code review and SDLC uplift</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/managed-detection-response\"><span class=\"nav__link-label\">Managed Detection &amp; Response</span><span class=\"nav__link-blurb\">24/7 SOC on your telemetry</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/grc-compliance\"><span class=\"nav__link-label\">GRC &amp; Compliance</span><span class=\"nav__link-blurb\">SOC 2, ISO 27001, PCI DSS, DORA, NIS2</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/custom-software\"><span class=\"nav__link-label\">Custom Software</span><span class=\"nav__link-blurb\">Systems built to survive an audit</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/engagement-models\"><span class=\"nav__link-label\">Engagement Models</span><span class=\"nav__link-blurb\">How retainers and projects actually run</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/services\">All <!-- -->services<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Industries\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Industries\" class=\"nav__trigger\" data-radix-collection-item=\"\">Industries<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Industries\" aria-labelledby=\"radix-_R_klb_-trigger-Industries\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/financial-services\"><span class=\"nav__link-label\">Financial Services</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/healthcare\"><span class=\"nav__link-label\">Healthcare</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/saas\"><span class=\"nav__link-label\">SaaS &amp; Technology</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/logistics\"><span class=\"nav__link-label\">Logistics</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/public-sector\"><span class=\"nav__link-label\">Public Sector</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/retail\"><span class=\"nav__link-label\">Retail &amp; Payments</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/industries\">All <!-- -->industries<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Proof\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Proof\" class=\"nav__trigger\" data-radix-collection-item=\"\">Proof<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Proof\" aria-labelledby=\"radix-_R_klb_-trigger-Proof\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/sample-report\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Anatomy of a report</span><span class=\"nav__featured-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/case-studies\"><span class=\"nav__link-label\">Case Studies</span><span class=\"nav__link-blurb\">24 stories, filterable</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/customers\"><span class=\"nav__link-label\">Customers</span><span class=\"nav__link-blurb\">Who we work with, and what they say</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/certifications\"><span class=\"nav__link-label\">Certifications</span><span class=\"nav__link-blurb\">Ours, with certificate numbers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/trust\"><span class=\"nav__link-label\">Trust Centre</span><span class=\"nav__link-blurb\">Our own security posture, published</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Resources\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Resources\" class=\"nav__trigger\" data-radix-collection-item=\"\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Resources\" aria-labelledby=\"radix-_R_klb_-trigger-Resources\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/resources\"><span class=\"nav__link-label\">All resources</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/blog\"><span class=\"nav__link-label\">Insights</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/research\"><span class=\"nav__link-label\">Research &amp; Labs</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/tools\"><span class=\"nav__link-label\">Open-source tools</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/methodologies\"><span class=\"nav__link-label\">Methodologies</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Company\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Company\" class=\"nav__trigger\" data-radix-collection-item=\"\">Company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Company\" aria-labelledby=\"radix-_R_klb_-trigger-Company\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about\"><span class=\"nav__link-label\">About</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about/leadership\"><span class=\"nav__link-label\">Leadership</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/approach\"><span class=\"nav__link-label\">The Adversary Loop</span><span class=\"nav__link-blurb\">How we actually work</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/careers\"><span class=\"nav__link-label\">Careers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/newsroom\"><span class=\"nav__link-label\">Newsroom</span></a></li></ul></div></div></li></ul></div></nav><div class=\"nav__actions\"><a class=\"nav__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"nav\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone nav__hotline-icon\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"nav__hotline-text\"><span class=\"nav__hotline-kicker\">Breach? 24/7</span><span class=\"nav__hotline-number\">+44 20 4525 9100</span></span></a><a class=\"btn btn--primary btn--sm nav__cta\" href=\"/contact\"><span>Start a conversation</span></a><details class=\"nav__mobile\"><summary class=\"nav__burger\" aria-label=\"Navigation menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu nav__burger-open\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x nav__burger-close\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></summary><nav class=\"nav__sheet\" aria-label=\"All pages\"><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Services</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/services/devsecops\">Secure SDLC<span class=\"nav__sheet-blurb\">The page that explains why one firm does both. Start here.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/services/cybersecurity\">Cybersecurity</a></li><li><a class=\"nav__sheet-link\" href=\"/services/software-development\">Software Development</a></li><li><a class=\"nav__sheet-link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"nav__sheet-link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"nav__sheet-link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"nav__sheet-link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"nav__sheet-link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"nav__sheet-link\" href=\"/services/engagement-models\">Engagement Models</a></li><li><a class=\"nav__sheet-link\" href=\"/services\">All <!-- -->services</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Industries</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/industries/financial-services\">Financial Services</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/healthcare\">Healthcare</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/saas\">SaaS &amp; Technology</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/logistics\">Logistics</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/public-sector\">Public Sector</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/retail\">Retail &amp; Payments</a></li><li><a class=\"nav__sheet-link\" href=\"/industries\">All <!-- -->industries</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Proof</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/sample-report\">Anatomy of a report<span class=\"nav__sheet-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"nav__sheet-link\" href=\"/customers\">Customers</a></li><li><a class=\"nav__sheet-link\" href=\"/certifications\">Certifications</a></li><li><a class=\"nav__sheet-link\" href=\"/trust\">Trust Centre</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Resources</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/resources\">All resources</a></li><li><a class=\"nav__sheet-link\" href=\"/blog\">Insights</a></li><li><a class=\"nav__sheet-link\" href=\"/research\">Research &amp; Labs</a></li><li><a class=\"nav__sheet-link\" href=\"/tools\">Open-source tools</a></li><li><a class=\"nav__sheet-link\" href=\"/methodologies\">Methodologies</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Company</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/about\">About</a></li><li><a class=\"nav__sheet-link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"nav__sheet-link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"nav__sheet-link\" href=\"/careers\">Careers</a></li><li><a class=\"nav__sheet-link\" href=\"/newsroom\">Newsroom</a></li></ul></div><div class=\"nav__sheet-cta\"><a class=\"btn btn--primary btn--md btn--full\" href=\"/contact\"><span>Start a conversation</span></a><a class=\"nav__sheet-hotline\" href=\"tel:+442045259100\">Incident response, 24/7 — <!-- -->+44 20 4525 9100</a></div></nav></details></div></div></header><main id=\"main\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://envenox.com/services/devsecops#service\",\"name\":\"Secure SDLC\",\"serviceType\":\"Secure SDLC\",\"alternateName\":\"Secure SDLC\",\"description\":\"We build it and we break it. The findings land in our own sprint backlog.\",\"disambiguatingDescription\":\"One firm, two practices, one backlog. The seam between build and break, removed.\",\"url\":\"https://envenox.com/services/devsecops\",\"provider\":{\"@id\":\"https://envenox.com/#organization\"},\"areaServed\":[{\"@type\":\"Country\",\"name\":\"United Kingdom\"},{\"@type\":\"Country\",\"name\":\"Bangladesh\"}],\"audience\":{\"@type\":\"BusinessAudience\",\"name\":\"Regulated organisations\"},\"category\":\"Secure software development lifecycle\",\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Secure SDLC — what is included\",\"itemListElement\":[{\"@type\":\"OfferCatalogItem\",\"position\":1,\"name\":\"Threat model at design time\",\"description\":\"Before the first sprint. The cheapest security finding is an architecture decision, and the most expensive one is the same decision discovered in week forty.\"},{\"@type\":\"OfferCatalogItem\",\"position\":2,\"name\":\"Secure design review at each decision\",\"description\":\"Our testers review architectural decision records as they are written, not the finished system.\"},{\"@type\":\"OfferCatalogItem\",\"position\":3,\"name\":\"Security in the pipeline\",\"description\":\"SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.\"},{\"@type\":\"OfferCatalogItem\",\"position\":4,\"name\":\"Continuous testing during the build\",\"description\":\"Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.\"},{\"@type\":\"OfferCatalogItem\",\"position\":5,\"name\":\"Pre-release penetration test\",\"description\":\"A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.\"},{\"@type\":\"OfferCatalogItem\",\"position\":6,\"name\":\"Monitoring and retest\",\"description\":\"Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.\"}]},\"termsOfService\":\"https://envenox.com/legal/terms\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Envenox\",\"item\":\"https://envenox.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://envenox.com/services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Secure SDLC\",\"item\":\"https://envenox.com/services/devsecops\"}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is it a conflict of interest to test your own build?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.\"}},{\"@type\":\"Question\",\"name\":\"What does this cost compared with building then testing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The security allocation is roughly 8 to 12% of the build cost. Against it: the findings arrive when they cost a sprint rather than a redesign, there is no handover and re-learning period, and compliance evidence comes out of the process rather than out of a separate exercise. On the engagements where we have both numbers, integrated has been cheaper in total — but we would rather show you the two case studies than assert it.\"}},{\"@type\":\"Question\",\"name\":\"Can you apply this to our in-house team?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, and it is a common engagement. The security practice embeds with your delivery team, the gates and the backlog are yours, and the goal is that your engineers own the model within two quarters. We bring the testers; you keep the capability.\"}},{\"@type\":\"Question\",\"name\":\"What if a critical finding appears a week before launch?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It blocks the launch, and that is agreed in writing before the engagement starts, so the conversation happens when nobody is under pressure. In practice continuous review means late criticals are rare — the point of the model is to move findings earlier, and the cycle-time number is how you check that it is working.\"}},{\"@type\":\"Question\",\"name\":\"Does this replace a penetration test?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No — it contains one, and adds the continuous work around it. If you only want the point-in-time measurement, buy the test on its own; it is a legitimate purchase. This is for building a system that passes it.\"}},{\"@type\":\"Question\",\"name\":\"How do you prove the cycle-time claim?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every finding is timestamped at confirmation and at the deploy that fixed it, both drawn from your own tracker and your own pipeline rather than from ours. The monthly report shows the distribution, not just the median, because the tail is where the interesting cases are.\"}},{\"@type\":\"Question\",\"name\":\"What compliance evidence does this generate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Secure development policy evidence for SOC 2 CC8.1, ISO 27001 Annex A 8.25 to 8.31, and PCI DSS Requirement 6. Because the evidence is generated by the process rather than assembled for the audit, it tends to survive sampling.\"}}]}</script><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" style=\"padding-top:calc(var(--nav-h) + var(--s16))\" aria-labelledby=\"devsecops-h1\"><div class=\"u-container\"><p class=\"u-eyebrow sv-hero__eyebrow\"><a class=\"u-link\" href=\"/services\">Services</a> · <!-- -->Secure SDLC</p><div class=\"chapter\"><h1 id=\"devsecops-h1\" class=\"chapter__line\">We build it and we break it.</h1><p class=\"chapter__note\">One firm, two practices, one backlog. The seam between build and break, removed.</p></div><p class=\"sv-cred\"><strong class=\"sv-cred__figure\">9 days median</strong><span class=\"sv-cred__context\">from a security finding being confirmed to the fix being in production, on joint engagements</span></p><div class=\"sv-hero__actions\"><a href=\"#enquiry-form\" class=\"btn btn--primary btn--lg\"><span>Book a secure-SDLC assessment</span></a><a href=\"#the-model\" class=\"btn btn--secondary btn--lg\"><span>See the integrated model</span></a></div><ul class=\"sv-hero__meta\"><li>Runs for the life of the build. The threat model happens before sprint one.</li><li>An overlay on any build engagement, or a programme applied to an existing in-house delivery team.</li></ul></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"the-gap\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">The gap</p><h2 id=\"the-gap\" class=\"sv-h2\">Week forty-one is the expensive way</h2><p class=\"sv-head__lede\">We build it and we break it. The findings land in our own sprint backlog.</p></div><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-alert\" aria-hidden=\"true\" style=\"color:var(--accent)\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"M12 8v4\"></path><path d=\"M12 16h.01\"></path></svg><p class=\"sv-lede\" style=\"margin-top:var(--s4)\">The client had to replace a clinical workflow system their customers depended on, carry NHS Data Security and Protection Toolkit obligations plus a SOC 2 Type II commitment made to a US customer, and do it in under a year. Their previous build, with a different vendor, had been tested in its final month: the test returned four criticals, two of which required an architectural change, and the launch slipped by five months. The brief was explicit — never again — but the proposed remedy, buying a second security vendor to test earlier, reproduces the handover rather than removing it.</p></div><div class=\"sv-rail__body\"><p class=\"sv-prose-measure\" style=\"margin:0;font-size:var(--text-lg);color:var(--muted-strong)\">The standard arrangement is that a development firm builds your software for forty weeks and a security firm tests it in week forty-one. Everything that test finds is now expensive, because the architecture is set, the team is rolling off, and a finding that requires a design change arrives after the design is load-bearing. Both firms behaved correctly and the outcome is still bad. Our two practices run against each other continuously instead: our testers review the design before it is built, read the code as it is written, and raise findings into the same backlog our engineers work from. The number that matters is the nine days between a finding being confirmed and the fix being live, and it is only possible because there is no handover in the middle.</p></div></div></div></section><section class=\"sec theme-dark transition-theme u-section\" data-theme-section=\"dark\" aria-labelledby=\"objection\"><div class=\"u-container\"><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><div class=\"sv-head__rule\" aria-hidden=\"true\" style=\"margin-bottom:var(--s6)\"></div><p class=\"u-eyebrow\">The obvious objection</p><h2 id=\"objection\" class=\"sv-h2\" style=\"margin-top:var(--s3)\">Is it a conflict of interest to test your own build?</h2></div><div class=\"sv-rail__body\"><p class=\"sv-prose-measure\" style=\"margin:0;font-size:var(--text-lg);color:var(--muted-strong)\">It would be if the same person did both, so they do not. The pre-release test is led by a tester who has not contributed code, the report comes to you unedited, and a third reviewer signs it. We will also support an independent third-party test and share the threat model with them — our commercial interest in a clean report is exactly why your structural scepticism is correct.</p><figure class=\"sv-quote\" style=\"margin-top:var(--s12)\"><blockquote class=\"sv-quote__text\"><p style=\"margin:0\">The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.</p></blockquote><figcaption class=\"sv-quote__by\">Chief Technology Officer, Clinical workflow vendor</figcaption></figure></div></div></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"the-model\"><div class=\"sec__bleed\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">The integrated model</p><h2 id=\"the-model\" class=\"sv-h2\">Secure SDLC</h2><p class=\"sv-head__lede\">One firm, two practices, one backlog. The seam between build and break, removed.</p></div></div><figure class=\"diagram_figure__a6PhF\"><figcaption class=\"diagram_caption__Y_IQh\"><p class=\"u-eyebrow diagram_eyebrow__HSKuF\">The Adversary Loop, as a pipeline</p><p class=\"u-measure diagram_lede__NuRfH\">Seven stages, two squads, one backlog. Every stage changes lane, which means every transition is a hand-off inside one team rather than a hand-over between two firms — and the seventh stage returns to the first.</p><ul class=\"diagram_legend__tATmk\"><li class=\"diagram_legendItem__b9P1u\" data-lane=\"security\"><span class=\"diagram_legendMark__f7phv\" aria-hidden=\"true\"></span>Security squad</li><li class=\"diagram_legendItem__b9P1u\" data-lane=\"dev\"><span class=\"diagram_legendMark__f7phv\" aria-hidden=\"true\"></span>Dev squad</li><li class=\"diagram_legendItem__b9P1u\" data-lane=\"handoff\"><span class=\"diagram_legendMark__f7phv\" aria-hidden=\"true\"></span>Lane change — a hand-off, not a hand-over</li></ul></figcaption><svg class=\"diagram_wire__6YYrj\" viewBox=\"0 0 1200 470\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Diagram: the secure software development lifecycle drawn as a closed loop of 7 stages across two lanes — a security squad lane and a dev squad lane. Stage 1, Threat model, before sprint 1, owned by the security squad, producing a ranked control list. Stage 2, Secure design review, per architectural decision, owned by the dev squad, producing a signed decision record. Stage 3, Secure code review, continuous, owned by the security squad, producing comments on the pull request. Stage 4, Pipeline gates, from sprint 1, owned by the dev squad, producing a tuned SAST, DAST and SCA gate with an agreed finding budget. Stage 5, Pre-release test, final 4 weeks, owned by the security squad, producing an unedited penetration test report. Stage 6, Monitoring, post-launch, owned by the dev squad, producing detections in source control. Stage 7, Retest, post-launch, owned by the security squad, producing a delta report and a new threat model. A return path runs from stage 7, Retest, back to stage 1, Threat model: what the retest finds rewrites the threat model. 6 of the 6 stage-to-stage transitions cross between the two lanes. Each crossing is a hand-off inside one team, not a hand-over between two firms.\"><line class=\"diagram_rail___Lcut\" x1=\"77\" y1=\"150\" x2=\"1123\" y2=\"150\"></line><line class=\"diagram_rail___Lcut\" x1=\"77\" y1=\"260\" x2=\"1123\" y2=\"260\"></line><g><g class=\"diagram_edgeGroup__sKhiv\" data-stage-index=\"1\"><path class=\"diagram_edge__dwOkm\" data-dash=\"\" style=\"--dash:218.265\" d=\"M 119 150 H 164 A 16 16 0 0 1 180 166 V 244 A 16 16 0 0 0 196 260 H 241\"></path><path class=\"diagram_handoff__DXMVp\" d=\"M 180 199 L 186 205 L 180 211 L 174 205 Z\"></path></g><g class=\"diagram_edgeGroup__sKhiv\" data-stage-index=\"2\"><path class=\"diagram_edge__dwOkm\" data-dash=\"\" style=\"--dash:218.265\" d=\"M 287 260 H 332 A 16 16 0 0 0 348 244 V 166 A 16 16 0 0 1 364 150 H 409\"></path><path class=\"diagram_handoff__DXMVp\" d=\"M 348 199 L 354 205 L 348 211 L 342 205 Z\"></path></g><g class=\"diagram_edgeGroup__sKhiv\" data-stage-index=\"3\"><path class=\"diagram_edge__dwOkm\" data-dash=\"\" style=\"--dash:218.265\" d=\"M 455 150 H 500 A 16 16 0 0 1 516 166 V 244 A 16 16 0 0 0 532 260 H 577\"></path><path class=\"diagram_handoff__DXMVp\" d=\"M 516 199 L 522 205 L 516 211 L 510 205 Z\"></path></g><g class=\"diagram_edgeGroup__sKhiv\" data-stage-index=\"4\"><path class=\"diagram_edge__dwOkm\" data-dash=\"\" style=\"--dash:218.265\" d=\"M 623 260 H 668 A 16 16 0 0 0 684 244 V 166 A 16 16 0 0 1 700 150 H 745\"></path><path class=\"diagram_handoff__DXMVp\" d=\"M 684 199 L 690 205 L 684 211 L 678 205 Z\"></path></g><g class=\"diagram_edgeGroup__sKhiv\" data-stage-index=\"5\"><path class=\"diagram_edge__dwOkm\" data-dash=\"\" style=\"--dash:218.265\" d=\"M 791 150 H 836 A 16 16 0 0 1 852 166 V 244 A 16 16 0 0 0 868 260 H 913\"></path><path class=\"diagram_handoff__DXMVp\" d=\"M 852 199 L 858 205 L 852 211 L 846 205 Z\"></path></g><g class=\"diagram_edgeGroup__sKhiv\" data-stage-index=\"6\"><path class=\"diagram_edge__dwOkm\" data-dash=\"\" style=\"--dash:218.265\" d=\"M 959 260 H 1004 A 16 16 0 0 0 1020 244 V 166 A 16 16 0 0 1 1036 150 H 1081\"></path><path class=\"diagram_handoff__DXMVp\" d=\"M 1020 199 L 1026 205 L 1020 211 L 1014 205 Z\"></path></g></g><g class=\"diagram_loopGroup__837nu\" data-loop-g=\"\" data-stage-index=\"6\"><path class=\"diagram_loop__duWBn\" data-dash=\"\" style=\"--dash:1467.664\" d=\"M 1104 173 V 380 A 40 40 0 0 1 1064 420 H 136 A 40 40 0 0 1 96 380 V 173\"></path><path class=\"diagram_loopArrow__d6e9u\" d=\"M 89 184 L 96 173 L 103 184\"></path><text class=\"diagram_loopLabel__QpuSp\" x=\"600\" y=\"444\" text-anchor=\"middle\">The loop closes</text></g><g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"0\" data-lane=\"security\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"96\" cy=\"150\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"96\" cy=\"150\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"96\" y=\"155\" text-anchor=\"middle\">01</text><text class=\"diagram_stageName__fpxMF\" x=\"96\" y=\"55\" text-anchor=\"middle\">Threat model</text><text class=\"diagram_stageOwner__JP1D_\" x=\"96\" y=\"84\" text-anchor=\"middle\">Security squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"96\" y=\"124\" text-anchor=\"middle\">Ranked control list</text></g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"1\" data-lane=\"dev\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"264\" cy=\"260\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"264\" cy=\"260\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"264\" y=\"265\" text-anchor=\"middle\">02</text><text class=\"diagram_stageName__fpxMF\" x=\"264\" y=\"300\" text-anchor=\"middle\">Secure design</text><text class=\"diagram_stageName__fpxMF\" x=\"264\" y=\"321\" text-anchor=\"middle\">review</text><text class=\"diagram_stageOwner__JP1D_\" x=\"264\" y=\"347\" text-anchor=\"middle\">Dev squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"264\" y=\"371\" text-anchor=\"middle\">Signed decision</text><text class=\"diagram_stageArtefact__brryN\" x=\"264\" y=\"388\" text-anchor=\"middle\">record</text></g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"2\" data-lane=\"security\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"432\" cy=\"150\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"432\" cy=\"150\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"432\" y=\"155\" text-anchor=\"middle\">03</text><text class=\"diagram_stageName__fpxMF\" x=\"432\" y=\"34\" text-anchor=\"middle\">Secure code</text><text class=\"diagram_stageName__fpxMF\" x=\"432\" y=\"55\" text-anchor=\"middle\">review</text><text class=\"diagram_stageOwner__JP1D_\" x=\"432\" y=\"84\" text-anchor=\"middle\">Security squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"432\" y=\"107\" text-anchor=\"middle\">Comments on the</text><text class=\"diagram_stageArtefact__brryN\" x=\"432\" y=\"124\" text-anchor=\"middle\">pull request</text></g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"3\" data-lane=\"dev\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"600\" cy=\"260\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"600\" cy=\"260\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"600\" y=\"265\" text-anchor=\"middle\">04</text><text class=\"diagram_stageName__fpxMF\" x=\"600\" y=\"300\" text-anchor=\"middle\">Pipeline gates</text><text class=\"diagram_stageOwner__JP1D_\" x=\"600\" y=\"347\" text-anchor=\"middle\">Dev squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"600\" y=\"371\" text-anchor=\"middle\">Tuned SAST / DAST gate,</text><text class=\"diagram_stageArtefact__brryN\" x=\"600\" y=\"388\" text-anchor=\"middle\">agreed finding budget</text></g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"4\" data-lane=\"security\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"768\" cy=\"150\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"768\" cy=\"150\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"768\" y=\"155\" text-anchor=\"middle\">05</text><text class=\"diagram_stageName__fpxMF\" x=\"768\" y=\"34\" text-anchor=\"middle\">Pre-release</text><text class=\"diagram_stageName__fpxMF\" x=\"768\" y=\"55\" text-anchor=\"middle\">test</text><text class=\"diagram_stageOwner__JP1D_\" x=\"768\" y=\"84\" text-anchor=\"middle\">Security squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"768\" y=\"107\" text-anchor=\"middle\">Unedited pen</text><text class=\"diagram_stageArtefact__brryN\" x=\"768\" y=\"124\" text-anchor=\"middle\">test report</text></g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"5\" data-lane=\"dev\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"936\" cy=\"260\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"936\" cy=\"260\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"936\" y=\"265\" text-anchor=\"middle\">06</text><text class=\"diagram_stageName__fpxMF\" x=\"936\" y=\"300\" text-anchor=\"middle\">Monitoring</text><text class=\"diagram_stageOwner__JP1D_\" x=\"936\" y=\"347\" text-anchor=\"middle\">Dev squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"936\" y=\"371\" text-anchor=\"middle\">Detections in</text><text class=\"diagram_stageArtefact__brryN\" x=\"936\" y=\"388\" text-anchor=\"middle\">source control</text></g><g class=\"diagram_stage__XG1eN\" data-stage-g=\"\" data-stage-index=\"6\" data-lane=\"security\"><circle class=\"diagram_nodeDisc__6NhV8\" cx=\"1104\" cy=\"150\" r=\"19\"></circle><circle class=\"diagram_nodeRing__hkdur\" cx=\"1104\" cy=\"150\" r=\"19\"></circle><text class=\"diagram_nodeNum__iIP1_\" x=\"1104\" y=\"155\" text-anchor=\"middle\">07</text><text class=\"diagram_stageName__fpxMF\" x=\"1104\" y=\"55\" text-anchor=\"middle\">Retest</text><text class=\"diagram_stageOwner__JP1D_\" x=\"1104\" y=\"84\" text-anchor=\"middle\">Security squad</text><text class=\"diagram_stageArtefact__brryN\" x=\"1104\" y=\"107\" text-anchor=\"middle\">Delta report, and</text><text class=\"diagram_stageArtefact__brryN\" x=\"1104\" y=\"124\" text-anchor=\"middle\">a new threat model</text></g></g></svg><div class=\"diagram_sequenceWrap__OGo8K\"><span class=\"diagram_loopBracket__AHLvZ\" data-stage-index=\"6\" aria-hidden=\"true\"></span><ol class=\"diagram_sequence__7I7MR\"><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"0\" data-lane=\"security\"><svg class=\"diagram_stepRail__cI0AC\" viewBox=\"0 0 2 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\"><line class=\"diagram_stepRailLine__FM9LL\" style=\"--dash:100\" data-dash=\"\" x1=\"1\" y1=\"0\" x2=\"1\" y2=\"100\"></line></svg><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">01</span><span class=\"diagram_stepOwner__uMXm3\">Security squad</span><span class=\"diagram_stepWhen__Uf1WP\">Before sprint 1</span></p><p class=\"diagram_stepName__H13yj\">Threat model</p><p class=\"diagram_stepDetail__5RVGB\">Security and engineering in one room with the architecture, before a line of it is built. The cheapest security finding is an architecture decision.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Ranked control list</p></li><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"1\" data-lane=\"dev\" data-crosses=\"true\"><svg class=\"diagram_stepRail__cI0AC\" viewBox=\"0 0 2 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\"><line class=\"diagram_stepRailLine__FM9LL\" style=\"--dash:100\" data-dash=\"\" x1=\"1\" y1=\"0\" x2=\"1\" y2=\"100\"></line></svg><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">02</span><span class=\"diagram_stepOwner__uMXm3\">Dev squad</span><span class=\"diagram_stepWhen__Uf1WP\">Per architectural decision</span></p><p class=\"diagram_stepName__H13yj\">Secure design review</p><p class=\"diagram_stepDetail__5RVGB\">Engineers author the decision record and a security engineer reads it before it is built. Disagreements get resolved in the record, so the reasoning survives the people.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Signed decision record</p></li><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"2\" data-lane=\"security\" data-crosses=\"true\"><svg class=\"diagram_stepRail__cI0AC\" viewBox=\"0 0 2 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\"><line class=\"diagram_stepRailLine__FM9LL\" style=\"--dash:100\" data-dash=\"\" x1=\"1\" y1=\"0\" x2=\"1\" y2=\"100\"></line></svg><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">03</span><span class=\"diagram_stepOwner__uMXm3\">Security squad</span><span class=\"diagram_stepWhen__Uf1WP\">Continuous</span></p><p class=\"diagram_stepName__H13yj\">Secure code review</p><p class=\"diagram_stepDetail__5RVGB\">Every pull request touching authentication, authorisation, cryptography or data access gets a security read. Comments in the PR, not a separate report nobody opens.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Comments on the pull request</p></li><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"3\" data-lane=\"dev\" data-crosses=\"true\"><svg class=\"diagram_stepRail__cI0AC\" viewBox=\"0 0 2 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\"><line class=\"diagram_stepRailLine__FM9LL\" style=\"--dash:100\" data-dash=\"\" x1=\"1\" y1=\"0\" x2=\"1\" y2=\"100\"></line></svg><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">04</span><span class=\"diagram_stepOwner__uMXm3\">Dev squad</span><span class=\"diagram_stepWhen__Uf1WP\">From sprint 1</span></p><p class=\"diagram_stepName__H13yj\">Pipeline gates</p><p class=\"diagram_stepDetail__5RVGB\">SAST, DAST, SCA and secret scanning in CI, tuned to a signal-to-noise ratio the delivery team actually accepts. Findings become tickets in the same backlog as features.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Tuned SAST / DAST gate, agreed finding budget</p></li><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"4\" data-lane=\"security\" data-crosses=\"true\"><svg class=\"diagram_stepRail__cI0AC\" viewBox=\"0 0 2 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\"><line class=\"diagram_stepRailLine__FM9LL\" style=\"--dash:100\" data-dash=\"\" x1=\"1\" y1=\"0\" x2=\"1\" y2=\"100\"></line></svg><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">05</span><span class=\"diagram_stepOwner__uMXm3\">Security squad</span><span class=\"diagram_stepWhen__Uf1WP\">Final 4 weeks</span></p><p class=\"diagram_stepName__H13yj\">Pre-release test</p><p class=\"diagram_stepDetail__5RVGB\">A full penetration test led by someone who wrote none of the code, with the report issued to you unedited. Criticals block the release, and that is agreed in writing beforehand.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Unedited pen test report</p></li><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"5\" data-lane=\"dev\" data-crosses=\"true\"><svg class=\"diagram_stepRail__cI0AC\" viewBox=\"0 0 2 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\"><line class=\"diagram_stepRailLine__FM9LL\" style=\"--dash:100\" data-dash=\"\" x1=\"1\" y1=\"0\" x2=\"1\" y2=\"100\"></line></svg><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">06</span><span class=\"diagram_stepOwner__uMXm3\">Dev squad</span><span class=\"diagram_stepWhen__Uf1WP\">Post-launch</span></p><p class=\"diagram_stepName__H13yj\">Monitoring</p><p class=\"diagram_stepDetail__5RVGB\">Detections written for the system as built, versioned in the same repository as the system they watch. Not a generic rule pack.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Detections in source control</p></li><li class=\"diagram_step__kOkph\" data-stage-li=\"\" data-stage-index=\"6\" data-lane=\"security\" data-crosses=\"true\"><p class=\"diagram_stepMeta__hozOh\"><span class=\"u-mono diagram_stepNum__hwvGQ\" aria-hidden=\"true\">07</span><span class=\"diagram_stepOwner__uMXm3\">Security squad</span><span class=\"diagram_stepWhen__Uf1WP\">Post-launch</span></p><p class=\"diagram_stepName__H13yj\">Retest</p><p class=\"diagram_stepDetail__5RVGB\">Thirty days after launch, then on an agreed cadence. What the retest finds does not go in a backlog of its own — it rewrites stage one.</p><p class=\"diagram_stepArtefact__kutzj\"><span class=\"u-mono diagram_stepArtefactLabel__f8XVP\">Artefact</span>Delta report, and a new threat model</p></li></ol></div><p class=\"diagram_loopNote__KcVI_\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-rotate-ccw diagram_loopNoteIcon__8yUQJ\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"></path><path d=\"M3 3v5h5\"></path></svg><span><strong class=\"diagram_loopNoteStrong__41jRq\">The loop closes.</strong> What the retest finds does not open a report of its own — it rewrites stage one, and the next pass through the pipeline is run against the threat model the last pass produced.</span></p></figure></div></section><section class=\"sec theme-dark transition-theme u-section\" data-theme-section=\"dark\" aria-labelledby=\"included\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Scope</p><h2 id=\"included\" class=\"sv-h2\">What is included</h2></div><ul class=\"reveal-group sv-grid sv-grid--3\"><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Threat model at design time</h3><p class=\"sv-card__line\">Before the first sprint. The cheapest security finding is an architecture decision, and the most expensive one is the same decision discovered in week forty.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Secure design review at each decision</h3><p class=\"sv-card__line\">Our testers review architectural decision records as they are written, not the finished system.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Security in the pipeline</h3><p class=\"sv-card__line\">SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Continuous testing during the build</h3><p class=\"sv-card__line\">Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Pre-release penetration test</h3><p class=\"sv-card__line\">A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Monitoring and retest</h3><p class=\"sv-card__line\">Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.</p></div></li></ul></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"squads\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Who does what</p><h2 id=\"squads\" class=\"sv-h2\">The dev squad and the security squad</h2><p class=\"sv-head__lede\">Your delivery squad plus a named security engineer at 20–30% allocation, and an independent lead tester for the pre-release test.</p></div><div class=\"sv-contrast\"><div><div class=\"sv-contrast__head\"><span class=\"sv-contrast__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code\" aria-hidden=\"true\"><path d=\"m16 18 6-6-6-6\"></path><path d=\"m8 6-6 6 6 6\"></path></svg></span><h3 class=\"sv-contrast__h\">Software Development</h3></div><p class=\"sv-card__line\">Products, platforms and business systems built to survive an audit and a handover.</p><ul class=\"reveal-group sv-grid\" style=\"margin-top:var(--s6)\"><li data-reveal=\"\"><div class=\"card card--pad\"><div style=\"display:flex;gap:var(--s4);align-items:flex-start\"><div role=\"img\" aria-label=\"Placeholder portrait for Marcus Reid\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(319 18% 22%), hsl(319 22% 14%))\"><span aria-hidden=\"true\">MR</span></div><div style=\"min-width:0\"><p style=\"margin:0;font-weight:500\">Marcus Reid</p><p class=\"sv-expert__role\" style=\"margin-top:2px\">Head of Engineering</p><ul class=\"sv-chips\" style=\"margin-top:var(--s3)\" aria-label=\"Marcus Reid certifications\"><li><span class=\"badge badge--sm badge--neutral\">AWS Solutions Architect Professional</span></li></ul></div></div></div></li><li data-reveal=\"\"><div class=\"card card--pad\"><div style=\"display:flex;gap:var(--s4);align-items:flex-start\"><div role=\"img\" aria-label=\"Placeholder portrait for Priya Raman\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(324 18% 22%), hsl(324 22% 14%))\"><span aria-hidden=\"true\">PR</span></div><div style=\"min-width:0\"><p style=\"margin:0;font-weight:500\">Priya Raman</p><p class=\"sv-expert__role\" style=\"margin-top:2px\">Principal Architect</p><ul class=\"sv-chips\" style=\"margin-top:var(--s3)\" aria-label=\"Priya Raman certifications\"><li><span class=\"badge badge--sm badge--neutral\">AWS Solutions Architect Professional</span></li><li><span class=\"badge badge--sm badge--neutral\">CKA</span></li></ul></div></div></div></li></ul></div><div><div class=\"sv-contrast__head\"><span class=\"sv-contrast__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></span><h3 class=\"sv-contrast__h\">Cybersecurity</h3></div><p class=\"sv-card__line\">Testing, assurance, detection and response — by people who also ship production software.</p><ul class=\"reveal-group sv-grid\" style=\"margin-top:var(--s6)\"><li data-reveal=\"\"><div class=\"card card--pad\"><div style=\"display:flex;gap:var(--s4);align-items:flex-start\"><div role=\"img\" aria-label=\"Placeholder portrait for Sofia Marek\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(306 18% 22%), hsl(306 22% 14%))\"><span aria-hidden=\"true\">SM</span></div><div style=\"min-width:0\"><p style=\"margin:0;font-weight:500\">Sofia Marek</p><p class=\"sv-expert__role\" style=\"margin-top:2px\">Principal Application Security Engineer</p><ul class=\"sv-chips\" style=\"margin-top:var(--s3)\" aria-label=\"Sofia Marek certifications\"><li><span class=\"badge badge--sm badge--neutral\">OSWE</span></li><li><span class=\"badge badge--sm badge--neutral\">CISSP</span></li><li><span class=\"badge badge--sm badge--neutral\">GIAC GWAPT</span></li></ul></div></div></div></li><li data-reveal=\"\"><div class=\"card card--pad\"><div style=\"display:flex;gap:var(--s4);align-items:flex-start\"><div role=\"img\" aria-label=\"Placeholder portrait for Imran Haque\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(315 18% 22%), hsl(315 22% 14%))\"><span aria-hidden=\"true\">IH</span></div><div style=\"min-width:0\"><p style=\"margin:0;font-weight:500\">Imran Haque</p><p class=\"sv-expert__role\" style=\"margin-top:2px\">Head of Offensive Security</p><ul class=\"sv-chips\" style=\"margin-top:var(--s3)\" aria-label=\"Imran Haque certifications\"><li><span class=\"badge badge--sm badge--neutral\">OSCP</span></li><li><span class=\"badge badge--sm badge--neutral\">OSWE</span></li><li><span class=\"badge badge--sm badge--neutral\">CREST CRT</span></li><li><span class=\"badge badge--sm badge--neutral\">GIAC GXPN</span></li></ul></div></div></div></li></ul></div></div><p class=\"sv-note\" style=\"margin-top:var(--s12)\">A tech lead, four engineers, a designer, a security engineer at 25%, and an independent lead tester for the pre-release test.</p></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"phases\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">The Adversary Loop</p><h2 id=\"phases\" class=\"sv-h2\">How the loop runs</h2><p class=\"sv-head__lede\">Threat models shape the build. The build gets attacked. The attack rewrites the threat model.</p></div><ol class=\"reveal-group sv-phases\"><li data-reveal=\"\" class=\"sv-phase\"><p class=\"sv-phase__n u-mono\" aria-hidden=\"true\">01</p><div><h3 class=\"sv-phase__name\"><span class=\"sv-sr\">Phase 1: </span>Threat model</h3><span class=\"sv-phase__when\">Before sprint 1</span></div><p class=\"sv-phase__body\">Security and engineering in one room with the architecture. Output is a threat model and a ranked list of the controls worth building, owned by the engineers.</p></li><li data-reveal=\"\" class=\"sv-phase\"><p class=\"sv-phase__n u-mono\" aria-hidden=\"true\">02</p><div><h3 class=\"sv-phase__name\"><span class=\"sv-sr\">Phase 2: </span>Secure design review</h3><span class=\"sv-phase__when\">Per architectural decision</span></div><p class=\"sv-phase__body\">Each decision record gets a security read. Disagreements get resolved in the record, so the reasoning survives the people.</p></li><li data-reveal=\"\" class=\"sv-phase\"><p class=\"sv-phase__n u-mono\" aria-hidden=\"true\">03</p><div><h3 class=\"sv-phase__name\"><span class=\"sv-sr\">Phase 3: </span>Secure code review</h3><span class=\"sv-phase__when\">Continuous</span></div><p class=\"sv-phase__body\">Security engineers review pull requests touching authentication, authorisation, cryptography and data access. Comments, not a separate report.</p></li><li data-reveal=\"\" class=\"sv-phase\"><p class=\"sv-phase__n u-mono\" aria-hidden=\"true\">04</p><div><h3 class=\"sv-phase__name\"><span class=\"sv-sr\">Phase 4: </span>Pipeline gates</h3><span class=\"sv-phase__when\">From sprint 1</span></div><p class=\"sv-phase__body\">SAST, DAST, SCA and secret scanning, tuned and gated against the agreed budget. Findings become tickets in the same backlog as features.</p></li><li data-reveal=\"\" class=\"sv-phase\"><p class=\"sv-phase__n u-mono\" aria-hidden=\"true\">05</p><div><h3 class=\"sv-phase__name\"><span class=\"sv-sr\">Phase 5: </span>Pre-release test</h3><span class=\"sv-phase__when\">Final 4 weeks</span></div><p class=\"sv-phase__body\">Full penetration test by an independent lead tester. Report unedited to you. Criticals block the release.</p></li><li data-reveal=\"\" class=\"sv-phase\"><p class=\"sv-phase__n u-mono\" aria-hidden=\"true\">06</p><div><h3 class=\"sv-phase__name\"><span class=\"sv-sr\">Phase 6: </span>Monitor and retest</h3><span class=\"sv-phase__when\">Post-launch</span></div><p class=\"sv-phase__body\">Detections for the system as built, a 30-day retest, and a cadence thereafter. The threat model is updated from what the testing found.</p></li></ol></div></section><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" aria-labelledby=\"evidence\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Evidence</p><h2 id=\"evidence\" class=\"sv-h2\">Findings land in our own sprint backlog</h2><p class=\"sv-head__lede\">Every finding is timestamped at confirmation and at the deploy that fixed it, both drawn from your own tracker and your own pipeline rather than from ours. The monthly report shows the distribution, not just the median, because the tail is where the interesting cases are.</p></div><ul class=\"sv-metrics\"><li><strong class=\"sv-metric__value u-tnum\">9 days median</strong><span class=\"sv-metric__label\">from a security finding being confirmed to the fix being in production, on joint engagements</span></li><li><strong class=\"sv-metric__value u-tnum\">0 critical, 2 high</strong><span class=\"sv-metric__label\">at the independent pre-release penetration test</span><span class=\"sv-metric__note\">Both highs fixed and retested inside 5 days</span></li><li><strong class=\"sv-metric__value u-tnum\">9 days</strong><span class=\"sv-metric__label\">median finding-confirmed to fix-in-production</span><span class=\"sv-metric__note\">Measured from the client’s own tracker and pipeline</span></li></ul><div class=\"sv-rail\" style=\"margin-top:var(--s16)\"><div class=\"sv-rail__aside\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock\" aria-hidden=\"true\" style=\"color:var(--accent)\"><path d=\"M12 6v6l4 2\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg><p class=\"sv-lede\" style=\"margin-top:var(--s4)\">We build it and we break it. The findings land in our own sprint backlog.</p></div><div class=\"sv-rail__body\"><ul class=\"reveal-group sv-ticks\" aria-label=\"What the engagement produces\"><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Threat model in your repository, authored by the engineers who own the components</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Security review comments in the pull requests, not in a separate document</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Tuned pipeline with an agreed finding budget and the rationale recorded</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Independent pre-release penetration test report, issued unedited</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Detections written for the system as built, in your source control</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Cycle-time evidence: finding confirmed to fix in production, per finding</span></li></ul></div></div></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"compliance\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Compliance</p><h2 id=\"compliance\" class=\"sv-h2\">Compliance as a by-product</h2><p class=\"sv-head__lede\">Secure development policy evidence for SOC 2 CC8.1, ISO 27001 Annex A 8.25 to 8.31, and PCI DSS Requirement 6. Because the evidence is generated by the process rather than assembled for the audit, it tends to survive sampling.</p></div><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check\" aria-hidden=\"true\" style=\"color:var(--accent)\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><div style=\"margin-top:var(--s6)\"><ul class=\"sv-chips\" aria-label=\"Frameworks this process satisfies\"><li><span class=\"badge badge--md badge--neutral\">NIST SSDF (SP 800-218)</span></li><li><span class=\"badge badge--md badge--neutral\">OWASP SAMM 2.0</span></li><li><span class=\"badge badge--md badge--neutral\">OWASP ASVS 4.0</span></li><li><span class=\"badge badge--md badge--neutral\">SLSA v1.0</span></li></ul></div><p class=\"sv-note\"><a class=\"u-link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a> · <a class=\"u-link\" href=\"/trust\">Our own posture</a></p></div><div class=\"sv-rail__body\"><ul class=\"reveal-group sv-ticks\" aria-label=\"Outcomes\"><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Security findings that arrive while they are still cheap to fix</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>No week-forty-one surprise that invalidates an architectural decision</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>One backlog, one set of priorities, one team accountable</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>SOC 2, ISO 27001 and PCI readiness as a by-product of the process</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Measured cycle time from finding to fix, published to you monthly</span></li></ul></div></div></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"case-study\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Proof</p><h2 id=\"case-study\" class=\"sv-h2\">A build where the security practice caught something</h2></div><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><p class=\"u-eyebrow\">Clinical workflow vendor, 180 employees</p><p class=\"sv-h3\" style=\"margin-top:var(--s4)\">A clinical workflow platform shipped with zero critical findings at its pre-release test — because the security practice had been reading the code for eight months.</p><ul class=\"sv-hero__meta\" style=\"margin-top:var(--s6)\"><li>Healthcare</li><li>Programme</li><li>11 months to first release</li><li><span class=\"badge badge--sm badge--neutral\">Under NDA</span></li></ul><p style=\"margin-top:var(--s6)\"><a class=\"btn btn--secondary btn--md\" href=\"/case-studies/healthtech-secure-sdlc\"><span>Read the case study</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></p></div><div class=\"sv-rail__body\"><ul class=\"sv-metrics\"><li><strong class=\"sv-metric__value u-tnum\">0 critical, 2 high</strong><span class=\"sv-metric__label\">at the independent pre-release penetration test</span><span class=\"sv-metric__note\">Both highs fixed and retested inside 5 days</span></li><li><strong class=\"sv-metric__value u-tnum\">9 days</strong><span class=\"sv-metric__label\">median finding-confirmed to fix-in-production</span><span class=\"sv-metric__note\">Measured from the client’s own tracker and pipeline</span></li><li><strong class=\"sv-metric__value u-tnum\">94%</strong><span class=\"sv-metric__label\">of SOC 2 CC7 and CC8 evidence generated by the process</span><span class=\"sv-metric__note\">Rather than assembled for the audit</span></li></ul><figure class=\"sv-quote\" style=\"margin-top:var(--s12)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote sv-quote__mark\" aria-hidden=\"true\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg><blockquote class=\"sv-quote__text\"><p style=\"margin:0\">The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.</p></blockquote><figcaption class=\"sv-quote__by\">Chief Technology Officer, Clinical workflow vendor</figcaption></figure></div></div><div class=\"sv-rail\" style=\"margin-top:var(--s16)\"><div class=\"sv-rail__aside\"><p class=\"u-eyebrow\">The technical layer</p></div><div class=\"sv-rail__body\"><p class=\"sv-prose-measure\" style=\"margin:0;color:var(--muted-strong)\">The three architecture-changing findings from the week-one threat model were: an audit log designed as application-writable rather than append-only, which would have failed a DSPT evidence question about tamper-resistance; a plan to hold the clinical record encryption key in the same AWS account as the application, which collapses the blast radius of an account compromise into a total data breach; and a clinician impersonation feature — genuinely required for support — specified without a second-person authorisation step or a distinct audit event, which is the precise shape of the control an Information Commissioner enquiry asks about first. All three cost roughly a sprint to address in week one. The audit log alone would have been a six-week retrofit in month ten, because by then eleven services would have been writing to it.</p></div></div></div></section><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" aria-labelledby=\"comparison\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Two vendors, or one partner</p><h2 id=\"comparison\" class=\"sv-h2\">What changes when the seam is removed</h2></div><div class=\"diagram_tableWrap__ZaTRQ\"><table class=\"diagram_table__zZlgT\" role=\"table\"><caption class=\"diagram_tableCaption__abPeh\">What changes when the people who test the system share a backlog with the people who build it. The left column is the standard arrangement; nobody in it behaves badly, and the outcome is still worse.</caption><thead><tr role=\"row\"><th scope=\"col\" role=\"columnheader\" class=\"diagram_colHead__yjUGQ\" data-col=\"label\"><span class=\"diagram_srOnly__8CNPG\">Compared on</span></th><th scope=\"col\" role=\"columnheader\" class=\"diagram_colHead__yjUGQ\" data-col=\"split\"><span class=\"diagram_colHeadInner__VTbyy\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users diagram_colHeadIcon__B0Zp1\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg>Two vendors</span></th><th scope=\"col\" role=\"columnheader\" class=\"diagram_colHead__yjUGQ\" data-col=\"joined\"><span class=\"diagram_colHeadInner__VTbyy\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check diagram_colHeadIcon__B0Zp1\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>One partner</span></th></tr></thead><tbody><tr role=\"row\" class=\"diagram_row__V8zVi\"><th scope=\"row\" role=\"rowheader\" class=\"diagram_rowHead__YLZHO\">Hand-off cost</th><td role=\"cell\" class=\"diagram_cell__AqgJQ\" data-col=\"split\" data-label=\"Two vendors\"><span class=\"diagram_cellLabel__XB5X2\" aria-hidden=\"true\">Two vendors</span>A full re-learning period, paid twice. The testers meet the architecture for the first time in week forty-one, and the engineers who could answer their questions have rolled off the account.</td><td role=\"cell\" class=\"diagram_cell__AqgJQ\" data-col=\"joined\" data-label=\"One partner\"><span class=\"diagram_cellLabel__XB5X2\" aria-hidden=\"true\">One partner</span>None to pay. The tester who runs the pre-release test read the first decision record in week two, and has been in the stand-up ever since.</td></tr><tr role=\"row\" class=\"diagram_row__V8zVi\"><th scope=\"row\" role=\"rowheader\" class=\"diagram_rowHead__YLZHO\">Remediation lead time</th><td role=\"cell\" class=\"diagram_cell__AqgJQ\" data-col=\"split\" data-label=\"Two vendors\"><span class=\"diagram_cellLabel__XB5X2\" aria-hidden=\"true\">Two vendors</span>Weeks. A finding is written into one firm’s report, triaged in a meeting, re-estimated into another firm’s backlog, then scheduled against a roadmap that was agreed before the finding existed.</td><td role=\"cell\" class=\"diagram_cell__AqgJQ\" data-col=\"joined\" data-label=\"One partner\"><span class=\"diagram_cellLabel__XB5X2\" aria-hidden=\"true\">One partner</span>Nine days median, from a finding being confirmed to the fix being live — measured in your tracker and your pipeline, not ours, and reported monthly as a distribution rather than a headline.</td></tr><tr role=\"row\" class=\"diagram_row__V8zVi\"><th scope=\"row\" role=\"rowheader\" class=\"diagram_rowHead__YLZHO\">Who is accountable when it breaks</th><td role=\"cell\" class=\"diagram_cell__AqgJQ\" data-col=\"split\" data-label=\"Two vendors\"><span class=\"diagram_cellLabel__XB5X2\" aria-hidden=\"true\">Two vendors</span>Both firms, which in practice means neither. The builder points at the specification, the tester points at the build, and you hold two contracts that each exclude the other’s work.</td><td role=\"cell\" class=\"diagram_cell__AqgJQ\" data-col=\"joined\" data-label=\"One partner\"><span class=\"diagram_cellLabel__XB5X2\" aria-hidden=\"true\">One partner</span>One contract, one backlog, one named engineering lead. The pre-release test is still signed by a tester who contributed no code, and the report comes to you unedited.</td></tr></tbody></table><p class=\"diagram_tableNote__MVpzw\">The nine-day median is drawn from joint engagements where we hold both the confirmation timestamp and the deploy timestamp. Engagements where we cannot see both are excluded rather than estimated.</p></div></div></section><section class=\"sec theme-deep transition-theme u-section-tight\" data-theme-section=\"deep\" aria-labelledby=\"clients\"><div class=\"u-container\"><h2 id=\"clients\" class=\"u-eyebrow\" style=\"margin-bottom:var(--s6)\">Selected clients</h2><div class=\"marquee\" style=\"--gap:var(--s12);--marquee-dur:52s\" tabindex=\"0\" role=\"group\" aria-label=\"Selected clients\"><ul class=\"marquee__track mq-track\" aria-label=\"Selected clients\"><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"mq__meta\">Retail &amp; Payments</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Carrick Analytics</span><span class=\"mq__meta\">SaaS &amp; Technology</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Pelham Energy</span><span class=\"mq__meta\">Energy</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Severn Mutual</span><span class=\"mq__meta\">Insurance</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Orbis Education</span><span class=\"mq__meta\">Education</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"mq__meta\">Retail &amp; Payments</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Carrick Analytics</span><span class=\"mq__meta\">SaaS &amp; Technology</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Pelham Energy</span><span class=\"mq__meta\">Energy</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Severn Mutual</span><span class=\"mq__meta\">Insurance</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Orbis Education</span><span class=\"mq__meta\">Education</span></span></li></ul></div></div></section><section class=\"sec theme-dark transition-theme u-section\" data-theme-section=\"dark\" aria-labelledby=\"related\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Related</p><h2 id=\"related\" class=\"sv-h2\">What this overlays</h2></div><ul class=\"reveal-group sv-grid sv-grid--2\"><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-code2 lucide-file-code-2 sv-card__icon\" aria-hidden=\"true\"><path d=\"M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"m5 12-3 3 3 3\"></path><path d=\"m9 18 3-3-3-3\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/application-security\">Application Security</a></h3></div><p class=\"sv-card__line\">Secure code review, CI gates and threat models that engineers will actually maintain.</p><p style=\"margin:0\"><span class=\"badge badge--md badge--brand\">Cybersecurity</span></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-boxes sv-card__icon\" aria-hidden=\"true\"><path d=\"M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z\"></path><path d=\"m7 16.5-4.74-2.85\"></path><path d=\"m7 16.5 5-3\"></path><path d=\"M7 16.5v5.17\"></path><path d=\"M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z\"></path><path d=\"m17 16.5-5-3\"></path><path d=\"m17 16.5 4.74-2.85\"></path><path d=\"M17 16.5v5.17\"></path><path d=\"M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z\"></path><path d=\"M12 8 7.26 5.15\"></path><path d=\"m12 8 4.74-2.85\"></path><path d=\"M12 13.5V8\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/custom-software\">Custom Software</a></h3></div><p class=\"sv-card__line\">Production systems with authorisation, audit and secrets handled properly from the first commit.</p><p style=\"margin:0\"><span class=\"badge badge--md badge--brand\">Software Development</span></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bug sv-card__icon\" aria-hidden=\"true\"><path d=\"M12 20v-9\"></path><path d=\"M14 7a4 4 0 0 1 4 4v3a6 6 0 0 1-12 0v-3a4 4 0 0 1 4-4z\"></path><path d=\"M14.12 3.88 16 2\"></path><path d=\"M21 21a4 4 0 0 0-3.81-4\"></path><path d=\"M21 5a4 4 0 0 1-3.55 3.97\"></path><path d=\"M22 13h-4\"></path><path d=\"M3 21a4 4 0 0 1 3.81-4\"></path><path d=\"M3 5a4 4 0 0 0 3.55 3.97\"></path><path d=\"M6 13H2\"></path><path d=\"m8 2 1.88 1.88\"></path><path d=\"M9 7.13V6a3 3 0 1 1 6 0v1.13\"></path></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/penetration-testing\">Penetration Testing</a></h3></div><p class=\"sv-card__line\">Manual, evidence-led testing with criticals reported the hour they are confirmed.</p><p style=\"margin:0\"><span class=\"badge badge--md badge--brand\">Cybersecurity</span></p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><div class=\"sv-card__top\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-server sv-card__icon\" aria-hidden=\"true\"><rect width=\"20\" height=\"8\" x=\"2\" y=\"2\" rx=\"2\" ry=\"2\"></rect><rect width=\"20\" height=\"8\" x=\"2\" y=\"14\" rx=\"2\" ry=\"2\"></rect><line x1=\"6\" x2=\"6.01\" y1=\"6\" y2=\"6\"></line><line x1=\"6\" x2=\"6.01\" y1=\"18\" y2=\"18\"></line></svg><h3 class=\"sv-card__name\"><a class=\"card__link\" href=\"/services/platform-engineering\">Platform &amp; DevOps</a></h3></div><p class=\"sv-card__line\">Reproducible infrastructure, short-lived pipeline identity, and a rehearsed rollback.</p><p style=\"margin:0\"><span class=\"badge badge--md badge--brand\">Software Development</span></p></div></li></ul><p class=\"sv-note\" style=\"margin-top:var(--s8)\"><a class=\"u-link\" href=\"/services/cybersecurity\">See everything under Cybersecurity</a></p></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"engagement\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Commercials</p><h2 id=\"engagement\" class=\"sv-h2\">Shape, timeline and scoping</h2></div><dl class=\"sv-defs\"><div class=\"sv-def\"><dt class=\"sv-def__term\">Timeline</dt><dd class=\"sv-def__desc\">Runs for the life of the build. The threat model happens before sprint one.</dd></div><div class=\"sv-def\"><dt class=\"sv-def__term\">Team shape</dt><dd class=\"sv-def__desc\">Your delivery squad plus a named security engineer at 20–30% allocation, and an independent lead tester for the pre-release test.</dd></div><div class=\"sv-def\"><dt class=\"sv-def__term\">Engagement</dt><dd class=\"sv-def__desc\">An overlay on any build engagement, or a programme applied to an existing in-house delivery team.</dd></div><div class=\"sv-def\"><dt class=\"sv-def__term\">Scoping</dt><dd class=\"sv-def__desc\">A named engineer replies within one business day. Scoping call within three.<!-- --> <a class=\"u-link\" href=\"/services/engagement-models\">How the four engagement models differ</a>.</dd></div></dl></div></section><section class=\"sec theme-dark transition-theme u-section\" data-theme-section=\"dark\" aria-labelledby=\"faq\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Questions</p><h2 id=\"faq\" class=\"sv-h2\">The rest of what buyers ask</h2><p class=\"sv-head__lede\">The conflict-of-interest question is answered in full further up this page.</p></div><div class=\"\"><div class=\"faq faq__accordion\" data-orientation=\"vertical\"><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_iukqnpfiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_2ukqnpfiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>What does this cost compared with building then testing?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_iukqnpfiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_2ukqnpfiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_kukqnpfiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_4ukqnpfiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>Can you apply this to our in-house team?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_kukqnpfiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_4ukqnpfiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_mukqnpfiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_6ukqnpfiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>What if a critical finding appears a week before launch?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_mukqnpfiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_6ukqnpfiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_oukqnpfiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_8ukqnpfiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>Does this replace a penetration test?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_oukqnpfiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_8ukqnpfiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_qukqnpfiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_aukqnpfiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>How do you prove the cycle-time claim?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_qukqnpfiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_aukqnpfiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_sukqnpfiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_cukqnpfiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>What compliance evidence does this generate?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_sukqnpfiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_cukqnpfiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div></div><dl class=\"faq__nojs\"><div><dt>What does this cost compared with building then testing?</dt><dd>The security allocation is roughly 8 to 12% of the build cost. Against it: the findings arrive when they cost a sprint rather than a redesign, there is no handover and re-learning period, and compliance evidence comes out of the process rather than out of a separate exercise. On the engagements where we have both numbers, integrated has been cheaper in total — but we would rather show you the two case studies than assert it.</dd></div><div><dt>Can you apply this to our in-house team?</dt><dd>Yes, and it is a common engagement. The security practice embeds with your delivery team, the gates and the backlog are yours, and the goal is that your engineers own the model within two quarters. We bring the testers; you keep the capability.</dd></div><div><dt>What if a critical finding appears a week before launch?</dt><dd>It blocks the launch, and that is agreed in writing before the engagement starts, so the conversation happens when nobody is under pressure. In practice continuous review means late criticals are rare — the point of the model is to move findings earlier, and the cycle-time number is how you check that it is working.</dd></div><div><dt>Does this replace a penetration test?</dt><dd>No — it contains one, and adds the continuous work around it. If you only want the point-in-time measurement, buy the test on its own; it is a legitimate purchase. This is for building a system that passes it.</dd></div><div><dt>How do you prove the cycle-time claim?</dt><dd>Every finding is timestamped at confirmation and at the deploy that fixed it, both drawn from your own tracker and your own pipeline rather than from ours. The monthly report shows the distribution, not just the median, because the tail is where the interesting cases are.</dd></div><div><dt>What compliance evidence does this generate?</dt><dd>Secure development policy evidence for SOC 2 CC8.1, ISO 27001 Annex A 8.25 to 8.31, and PCI DSS Requirement 6. Because the evidence is generated by the process rather than assembled for the audit, it tends to survive sampling.</dd></div></dl></div></div></section><section class=\"sec theme-light transition-theme u-section grain\" data-theme-section=\"light\" aria-labelledby=\"enquiry-h2\"><div class=\"u-container\"><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><p class=\"u-eyebrow\">Get started</p><h2 id=\"enquiry-h2\" class=\"sv-h2\" style=\"margin-top:var(--s3)\">Book a secure-SDLC assessment</h2><p class=\"sv-lede\">A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.</p><p class=\"sv-note\">A named engineer replies within one business day. Scoping call within three.</p><p style=\"margin-top:var(--s6)\"><a class=\"btn btn--secondary btn--md\" href=\"/case-studies\"><span>See the work</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></p></div><div class=\"sv-rail__body\"><form class=\"sv-form\" id=\"enquiry-form\" action=\"\" encType=\"multipart/form-data\" method=\"POST\"><input type=\"hidden\" name=\"$ACTION_ID_403c44504416ed33d4af4350092b655f174641e336\"/><input type=\"hidden\" name=\"returnTo\" value=\"/services/devsecops\"/><div id=\"enquiry-incomplete\" class=\"sv-form__error\" role=\"alert\"><p>Some required fields came through empty. They are marked below — fill them in and send again.</p></div><div id=\"enquiry-email\" class=\"sv-form__error\" role=\"alert\"><p>That email address did not look complete. Check it and send again.</p></div><div class=\"sv-field\"><label class=\"sv-label\" for=\"enq-name\">Your name<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><input id=\"enq-name\" class=\"sv-input\" type=\"text\" required=\"\" autoComplete=\"name\" name=\"name\"/></div><div class=\"sv-field\"><label class=\"sv-label\" for=\"enq-email\">Business email<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><input id=\"enq-email\" class=\"sv-input\" type=\"email\" required=\"\" autoComplete=\"email\" aria-describedby=\"enq-email-help\" name=\"email\"/><p class=\"sv-help\" id=\"enq-email-help\">We reply from a person, not a no-reply address.</p></div><div class=\"sv-field\"><label class=\"sv-label\" for=\"enq-company\">Company<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><input id=\"enq-company\" class=\"sv-input\" type=\"text\" required=\"\" autoComplete=\"organization\" name=\"company\"/></div><div class=\"sv-field\"><label class=\"sv-label\" for=\"enq-country\">Country<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><input id=\"enq-country\" class=\"sv-input\" type=\"text\" required=\"\" autoComplete=\"country-name\" aria-describedby=\"enq-country-help\" name=\"country\"/><p class=\"sv-help\" id=\"enq-country-help\">Relevant for data residency and time zone.</p></div><div class=\"sv-field\"><label class=\"sv-label\" for=\"enq-interest\">What is this about<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><select id=\"enq-interest\" name=\"interest\" class=\"sv-select\" required=\"\"><option value=\"\" disabled=\"\">Choose one</option><option value=\"penetration-testing\">Penetration testing</option><option value=\"application-security\">Application security programme</option><option value=\"cloud-security\">Cloud security review</option><option value=\"grc-compliance\">SOC 2 / ISO 27001 / PCI DSS</option><option value=\"managed-detection-response\">Managed detection &amp; response</option><option value=\"red-teaming\">Red team</option><option value=\"vciso\">vCISO</option><option value=\"custom-software\">Custom software build</option><option value=\"web-application-development\">Web application</option><option value=\"platform-engineering\">Platform &amp; DevOps</option><option value=\"business-systems\">ERP / CRM / HRM / LMS</option><option value=\"devsecops\" selected=\"\">Secure SDLC — build and test together</option><option value=\"not-sure\">Not sure yet — help me work it out</option></select></div><div class=\"sv-field\"><label class=\"sv-label\" for=\"enq-message\">What are you trying to achieve, and what is the deadline<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><textarea id=\"enq-message\" name=\"message\" class=\"sv-textarea\" rows=\"5\" required=\"\" aria-describedby=\"enq-message-help\"></textarea><p class=\"sv-help\" id=\"enq-message-help\">Two or three sentences is plenty. The constraint is usually more useful than the requirement.</p></div><div class=\"sv-field sv-field--check\"><input id=\"enq-consent\" type=\"checkbox\" class=\"sv-check\" required=\"\" aria-describedby=\"enq-consent-help\" name=\"consent\"/><span><label class=\"sv-label\" for=\"enq-consent\">I agree to Envenox contacting me about this enquiry.<span class=\"sv-req\" aria-hidden=\"true\">*</span></label><p class=\"sv-help\" id=\"enq-consent-help\">We keep enquiry details for 24 months from last contact and never share them. See the privacy notice.</p></span></div><p class=\"sv-help\"><span aria-hidden=\"true\" class=\"sv-req\">*</span> <!-- -->Required.</p><div class=\"sv-form__actions\"><button type=\"submit\" class=\"btn btn--primary btn--lg\"><span>Send an enquiry</span></button><p class=\"sv-form__sla\">A named engineer replies within one business day. Scoping call within three.</p></div></form></div></div></div></section><!--$--><!--/$--></main><footer class=\"foot theme-dark transition-theme grain\" data-theme-section=\"dark\"><div class=\"u-container\"><div class=\"foot__top\"><div class=\"foot__brand\"><a class=\"foot__wordmark\" href=\"/\">Envenox</a><p class=\"foot__positioning\">Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.</p><a class=\"foot__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"footer\"><span class=\"foot__hotline-row\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"u-eyebrow\">Incident response — 24/7</span></span><span class=\"foot__hotline-number\">+44 20 4525 9100</span><span class=\"foot__hotline-note\">Answered by a responder, 24/7. Median pickup under 4 minutes.</span></a></div><nav class=\"foot__cols\" aria-label=\"Footer\"><div><h2 class=\"foot__col-heading\">Cybersecurity</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"foot__link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"foot__link\" href=\"/services/cloud-security\">Cloud Security</a></li><li><a class=\"foot__link\" href=\"/services/red-teaming\">Red Teaming</a></li><li><a class=\"foot__link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"foot__link\" href=\"/services/incident-response\">Incident Response</a></li><li><a class=\"foot__link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"foot__link\" href=\"/services/vciso\">vCISO</a></li></ul></div><div><h2 class=\"foot__col-heading\">Software Development</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"foot__link\" href=\"/services/web-application-development\">Web Applications</a></li><li><a class=\"foot__link\" href=\"/services/platform-engineering\">Platform &amp; DevOps</a></li><li><a class=\"foot__link\" href=\"/services/erp\">ERP</a></li><li><a class=\"foot__link\" href=\"/services/crm\">CRM</a></li><li><a class=\"foot__link\" href=\"/services/hrm\">HRM</a></li><li><a class=\"foot__link\" href=\"/services/lms\">LMS</a></li><li><a class=\"foot__link\" href=\"/services/qa-automation\">QA &amp; Test Automation</a></li></ul></div><div><h2 class=\"foot__col-heading\">Company</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/about\">About</a></li><li><a class=\"foot__link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"foot__link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"foot__link\" href=\"/careers\">Careers</a></li><li><a class=\"foot__link\" href=\"/newsroom\">Newsroom</a></li><li><a class=\"foot__link\" href=\"/locations\">Locations</a></li><li><a class=\"foot__link\" href=\"/partners\">Partners</a></li></ul></div><div><h2 class=\"foot__col-heading\">Proof &amp; Resources</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"foot__link\" href=\"/sample-report\">Sample Report</a></li><li><a class=\"foot__link\" href=\"/customers\">Customers</a></li><li><a class=\"foot__link\" href=\"/certifications\">Certifications</a></li><li><a class=\"foot__link\" href=\"/trust\">Trust Centre</a></li><li><a class=\"foot__link\" href=\"/blog\">Insights</a></li><li><a class=\"foot__link\" href=\"/research\">Research &amp; Labs</a></li></ul></div></nav></div><div class=\"foot__mid\"><div><h2 class=\"foot__col-hea