eLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Security findings that arrive while they are still cheap to fix\"}]]}],[\"$\",\"$L3c\",\"No week-forty-one surprise that invalidates an architectural decision\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"No week-forty-one surprise that invalidates an architectural decision\"}]]}],[\"$\",\"$L3c\",\"One backlog, one set of priorities, one team accountable\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"One backlog, one set of priorities, one team accountable\"}]]}],[\"$\",\"$L3c\",\"SOC 2, ISO 27001 and PCI readiness as a by-product of the process\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"SOC 2, ISO 27001 and PCI readiness as a by-product of the process\"}]]}],[\"$\",\"$L3c\",\"Measured cycle time from finding to fix, published to you monthly\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Measured cycle time from finding to fix, published to you monthly\"}]]}]]}]}]\n57:[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--neutral\",\"children\":[null,\"Under NDA\"]}]\n97:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n58:[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s6)\"},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$97\"}],\"$L98\"]}]\n59:[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[[\"$\",\"ul\",null,{\"className\":\"sv-metrics\",\"children\":[[\"$\",\"li\",\"at the independent pre-release penetration test\",{\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-metric__value u-tnum\",\"children\":\"0 critical, 2 high\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__label\",\"children\":\"at the independent pre-release penetration test\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__note\",\"children\":\"Both highs fixed and retested inside 5 days\"}]]}],[\"$\",\"li\",\"median finding-confirmed to fix-in-production\",{\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-metric__value u-tnum\",\"children\":\"9 days\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__label\",\"children\":\"median finding-confirmed to fix-in-production\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__note\",\"children\":\"Measured from the client’s own tracker and pipeline\"}]]}],[\"$\",\"li\",\"of SOC 2 CC7 and CC8 evidence generated by the process\",{\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-metric__value u-tnum\",\"children\":\"94%\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__label\",\"children\":\"of SOC 2 CC7 and CC8 evidence generated by the process\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__note\",\"children\":\"Rather than assembled for the audit\"}]]}]]}],[\"$\",\"figure\",null,{\"className\":\"sv-quote\",\"style\":{\"marginTop\":\"var(--s12)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-quote sv-quote__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"rib7q0\",{\"d\":\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"}],[\"$\",\"path\",\"1ymkrd\",{\"d\":\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"}],\"$undefined\"]}],[\"$\",\"blockquote\",null,{\"className\":\"sv-quote__text\",\"children\":[\"$\",\"p\",null,{\"style\":{\"margin\":0},\"children\":\"The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"sv-quote__by\",\"children\":\"Chief Technology Officer, Clinical workflow vendor\"}]]}]]}]\n5a:[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"style\":{\"marginTop\":\"var(--s16)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"The technical layer\"}]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"p\",null,{\"className\":\"sv-prose-measure\",\"style\":{\"margin\":0,\"color\":\"var(--muted-strong)\"},\"children\":\"The three architecture-changing findings from the week-one threat model were: an audit log designed as application-writable rather than append-only, which would have failed a DSPT evidence question about tamper-resistance; a plan to hold the clinical record encryption key in the same AWS account as the application, which collapses the blast radius of an account compromise into a total data breach; and a clinician impersonation feature — genuinely required for support — specified without a second-person authorisation step or a distinct audit event, which is the precise shape of the control an Information Commissioner enquiry asks about first. All three cost roughly a sprint to address in week one. The audit log alone would have been a six-week retrofit in month ten, because by then eleven services would have been writing to it.\"}]}]]}]\n5b:[\"$\",\"th\",null,{\"scope\":\"row\",\"role\":\"rowheader\",\"className\":\"diagram_rowHead__YLZHO\",\"children\":\"Remediation lead time\"}]\n5c:[\"$\",\"td\",null,{\"role\":\"cell\",\"className\":\"diagram_cell__AqgJQ\",\"data-col\":\"split\",\"data-label\":\"Two vendors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"diagram_cellLabel__XB5X2\",\"aria-hidden\":\"true\",\"children\":\"Two vendors\"}],\"Weeks. A finding is written into one firm’s report, triaged in a meeting, re-estimated into another firm’s backlog, then scheduled against a roadmap that was agreed before the finding existed.\"]}]\n5d:[\"$\",\"td\",null,{\"role\":\"cell\",\"className\":\"diagram_cell__AqgJQ\",\"data-col\":\"joined\",\"data-label\":\"One partner\",\"children\":[[\"$\",\"span\",null,{\"className\":\"diagram_cellLabel__XB5X2\",\"aria-hidden\":\"true\",\"children\":\"One partner\"}],\"Nine days median, from a finding being confirmed to the fix being live — measured in your tracker and your pipeline, not ours, and reported monthly as a distribution rather than a headline.\"]}]\n5e:[\"$\",\"tr\",\"Who is accountable when it breaks\",{\"role\":\"row\",\"className\":\"diagram_row__V8zVi\",\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"role\":\"rowheader\",\"className\":\"diagram_rowHead__YLZHO\",\"children\":\"Who is accountable when it breaks\"}],[\"$\",\"td\",null,{\"role\":\"cell\",\"className\":\"diagram_cell__AqgJQ\",\"data-col\":\"split\",\"data-label\":\"Two vendors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"diagram_cellLabel__XB5X2\",\"aria-hidden\":\"true\",\"children\":\"Two vendors\"}],\"Both firms, which in practice means neither. The builder points at the specification, the tester points at the build, and you hold two contracts that each exclude the other’s work.\"]}],[\"$\",\"td\",null,{\"role\":\"cell\",\"className\":\"diagram_cell__AqgJQ\",\"data-col\":\"joined\",\"data-label\":\"One partner\",\"children\":[[\"$\",\"span\",null,{\"className\":\"diagram_cellLabel__XB5X2\",\"aria-hidden\":\"true\",\"children\":\"One partner\"}],\"One contract, one backlog, one named engineering lead. The pre-release test is still signed by a tester who contributed no code, and the report comes to you unedited.\"]}]]}]\n5f:[\"$\",\"p\",null,{\"className\":\"diagram_tableNote__MVpzw\",\"children\":\"The nine-day median is drawn from joint engagements where we hold both the confirmation timestamp and the deploy timestamp. Engagements where we cannot see both are excluded rather than estimated.\"}]\n61:[\"$\",\"span\",null,{\"className\":\"mq__label\",\"children\":\"Hallstead Retail\"}]\n62:[\"$\",\"span\",null,{\"className\":\"mq__meta\",\"children\":\"Retail & Payments\"}]\n63:[\"$\",\"li\",\"a-Carrick Analytics\",{\"className\":\"mq__item\",\"children\":[null,[\"$\",\"span\",null,{\"className\":\"mq__text\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mq__label\",\"children\":\"Carrick Analytics\"}],[\"$\",\"span\",null,{\"className\":\"mq__meta\",\"children\":\"SaaS & Technology\"}]]}]]}]\n64:[\"$\",\"li\",\"a-Pelham Energy\",{\"className\":\"mq__item\",\"children\":[null,[\"$\",\"s