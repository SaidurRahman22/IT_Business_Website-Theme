{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"routeCache":{"key":"/route-cache/APP_PAGE/8ea96f8d7e219f7e75d837cc965b244d188bb8a31f6a68f7ebce2a71d28d45fb/$/about","owner":{"kind":"APP_PAGE","sourceRoute":"/about/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/806e8b938e28c0c7.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-section envenox-statbar envenox-stat envenox-reveal-group envenox-card envenox-avatar-placeholder envenox-marquee envenox-badge\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n.statbar {\n  display: grid;\n  gap: var(--s8);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.statbar > li { min-width: 0; }\n\n@media (min-width: 640px) {\n  .statbar { gap: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .statbar > li { padding: var(--s6) var(--s6) var(--s6) 0; border-top: 1px solid var(--border); }\n  .statbar > li + li { border-left: 1px solid var(--border); padding-left: var(--s6); }\n  /* The second cell of each pair starts a new row edge, not a mid-row border. */\n  .statbar--2 > li:nth-child(2n + 1) { border-left: 0; padding-left: 0; }\n}\n@media (min-width: 1024px) {\n  .statbar--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .statbar--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .statbar--3 > li:nth-child(2n + 1),\n  .statbar--4 > li:nth-child(2n + 1) { border-left: 1px solid var(--border); padding-left: var(--s6); }\n  .statbar--3 > li:first-child,\n  .statbar--4 > li:first-child { border-left: 0; padding-left: 0; }\n}\n\n.stat { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }\n\n.stat__figure {\n  display: flex;\n  align-items: baseline;\n  gap: 1px;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  font-variant-numeric: tabular-nums;\n}\n.stat--sm .stat__figure { font-size: var(--text-xl); }\n.stat--md .stat__figure { font-size: var(--text-3xl); }\n.stat--lg .stat__figure { font-size: var(--text-4xl); }\n@media (min-width: 768px) {\n  .stat--lg .stat__figure { font-size: var(--text-5xl); }\n}\n\n/* The roll strip. overflow:hidden is what clips the sanctioned keyframe. */\n.stat__roll { display: inline-block; overflow: hidden; vertical-align: bottom; }\n.stat__value { display: inline-block; }\n.stat__roll[data-rolled='true'] > .stat__value {\n  animation: inFromBelow var(--dur-base) var(--ease-out);\n}\n.stat__suffix { color: var(--accent); }\n\n.stat__label {\n  color: var(--muted);\n  font-size: var(--text-sm);\n  line-height: 1.35;\n  margin: 0;\n  max-width: 28ch;\n}\n\n.stat__prov { font-size: var(--text-xs); color: var(--muted); }\n.stat__prov > summary {\n  cursor: pointer;\n  list-style: none;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  color: var(--muted);\n  border-bottom: 1px dotted var(--border-strong);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.stat__prov > summary::-webkit-details-marker { display: none; }\n.stat__prov > summary:hover { color: var(--fg); }\n.stat__prov > p {\n  margin: var(--s2) 0 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 34ch;\n}\n\n.reveal-group > * { --reveal-delay: calc(var(--reveal-base, 0ms) + 0ms); }\n.reveal-group > *:nth-child(2) { --reveal-delay: calc(var(--reveal-base, 0ms) + 60ms); }\n.reveal-group > *:nth-child(3) { --reveal-delay: calc(var(--reveal-base, 0ms) + 120ms); }\n.reveal-group > *:nth-child(4) { --reveal-delay: calc(var(--reveal-base, 0ms) + 180ms); }\n.reveal-group > *:nth-child(n + 5) { --reveal-delay: calc(var(--reveal-base, 0ms) + 240ms); }\n\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\n\n.avatar-ph {\n  display: grid;\n  place-items: center;\n  flex: none;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border);\n  color: var(--paper-50);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  line-height: 1;\n  user-select: none;\n  overflow: hidden;\n}\n.avatar-ph--round { border-radius: 50%; }\n\n/* Zero the trailing padding so the globals keyframe lands exactly. */\n.marquee__track.mq-track { padding-right: 0; list-style: none; margin: 0; padding-left: 0; }\n\n.mq__item {\n  display: flex;\n  align-items: center;\n  gap: var(--s3);\n  flex: none;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s3) var(--s4);\n  min-height: 56px;\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.mq__item:hover { border-color: var(--border-strong); }\n\n.mq__logo { display: inline-flex; flex: none; color: var(--muted-strong); }\n\n.mq__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.mq__label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1.2;\n  color: var(--fg);\n  white-space: nowrap;\n}\n.mq__meta {\n  font-size: var(--text-xs);\n  line-height: 1.2;\n  color: var(--muted);\n  white-space: nowrap;\n}\n.mq__link { color: inherit; text-decoration: none; }\n.mq__link:hover .mq__label { color: var(--fg); }\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\n\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\n@media (prefers-reduced-motion: reduce) {\n  .marquee__track.mq-track { padding-right: var(--gap); }\n}\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/about/page-e407f7c445b39597.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>About · Envenox</title><meta name=\"description\" content=\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com/about\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"About · Envenox\"/><meta property=\"og:description\" content=\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"/><meta property=\"og:url\" content=\"https://envenox.com/about\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Envenox — We build the software. Then we try to break it.\"/><meta name=\"twitter:description\" content=\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav theme-dark transition-theme no-print\" data-scrolled=\"false\" data-nav-theme=\"dark\"><div class=\"nav__bar u-container\"><a class=\"nav__brand\" href=\"/\">Envenox</a><nav aria-label=\"Primary\" data-orientation=\"horizontal\" dir=\"ltr\" class=\"nav__desktop\"><div style=\"position:relative\"><ul data-orientation=\"horizontal\" class=\"nav__list\" dir=\"ltr\"><li><button id=\"radix-_R_klb_-trigger-Services\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Services\" class=\"nav__trigger\" data-radix-collection-item=\"\">Services<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Services\" aria-labelledby=\"radix-_R_klb_-trigger-Services\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/services/devsecops\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Secure SDLC</span><span class=\"nav__featured-blurb\">The page that explains why one firm does both. Start here.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/cybersecurity\"><span class=\"nav__link-label\">Cybersecurity</span><span class=\"nav__link-blurb\">Testing, assurance, detection and response</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/software-development\"><span class=\"nav__link-label\">Software Development</span><span class=\"nav__link-blurb\">Product build, platform and modernisation</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/penetration-testing\"><span class=\"nav__link-label\">Penetration Testing</span><span class=\"nav__link-blurb\">Web, mobile, network, cloud, API</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/application-security\"><span class=\"nav__link-label\">Application Security</span><span class=\"nav__link-blurb\">Secure code review and SDLC uplift</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/managed-detection-response\"><span class=\"nav__link-label\">Managed Detection &amp; Response</span><span class=\"nav__link-blurb\">24/7 SOC on your telemetry</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/grc-compliance\"><span class=\"nav__link-label\">GRC &amp; Compliance</span><span class=\"nav__link-blurb\">SOC 2, ISO 27001, PCI DSS, DORA, NIS2</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/custom-software\"><span class=\"nav__link-label\">Custom Software</span><span class=\"nav__link-blurb\">Systems built to survive an audit</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/engagement-models\"><span class=\"nav__link-label\">Engagement Models</span><span class=\"nav__link-blurb\">How retainers and projects actually run</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/services\">All <!-- -->services<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Industries\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Industries\" class=\"nav__trigger\" data-radix-collection-item=\"\">Industries<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Industries\" aria-labelledby=\"radix-_R_klb_-trigger-Industries\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/financial-services\"><span class=\"nav__link-label\">Financial Services</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/healthcare\"><span class=\"nav__link-label\">Healthcare</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/saas\"><span class=\"nav__link-label\">SaaS &amp; Technology</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/logistics\"><span class=\"nav__link-label\">Logistics</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/public-sector\"><span class=\"nav__link-label\">Public Sector</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/retail\"><span class=\"nav__link-label\">Retail &amp; Payments</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/industries\">All <!-- -->industries<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Proof\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Proof\" class=\"nav__trigger\" data-radix-collection-item=\"\">Proof<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Proof\" aria-labelledby=\"radix-_R_klb_-trigger-Proof\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/sample-report\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Anatomy of a report</span><span class=\"nav__featured-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/case-studies\"><span class=\"nav__link-label\">Case Studies</span><span class=\"nav__link-blurb\">24 stories, filterable</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/customers\"><span class=\"nav__link-label\">Customers</span><span class=\"nav__link-blurb\">Who we work with, and what they say</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/certifications\"><span class=\"nav__link-label\">Certifications</span><span class=\"nav__link-blurb\">Ours, with certificate numbers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/trust\"><span class=\"nav__link-label\">Trust Centre</span><span class=\"nav__link-blurb\">Our own security posture, published</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Resources\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Resources\" class=\"nav__trigger\" data-radix-collection-item=\"\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Resources\" aria-labelledby=\"radix-_R_klb_-trigger-Resources\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/resources\"><span class=\"nav__link-label\">All resources</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/blog\"><span class=\"nav__link-label\">Insights</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/research\"><span class=\"nav__link-label\">Research &amp; Labs</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/tools\"><span class=\"nav__link-label\">Open-source tools</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/methodologies\"><span class=\"nav__link-label\">Methodologies</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Company\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Company\" class=\"nav__trigger\" data-radix-collection-item=\"\">Company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Company\" aria-labelledby=\"radix-_R_klb_-trigger-Company\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about\"><span class=\"nav__link-label\">About</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about/leadership\"><span class=\"nav__link-label\">Leadership</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/approach\"><span class=\"nav__link-label\">The Adversary Loop</span><span class=\"nav__link-blurb\">How we actually work</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/careers\"><span class=\"nav__link-label\">Careers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/newsroom\"><span class=\"nav__link-label\">Newsroom</span></a></li></ul></div></div></li></ul></div></nav><div class=\"nav__actions\"><a class=\"nav__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"nav\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone nav__hotline-icon\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"nav__hotline-text\"><span class=\"nav__hotline-kicker\">Breach? 24/7</span><span class=\"nav__hotline-number\">+44 20 4525 9100</span></span></a><a class=\"btn btn--primary btn--sm nav__cta\" href=\"/contact\"><span>Start a conversation</span></a><details class=\"nav__mobile\"><summary class=\"nav__burger\" aria-label=\"Navigation menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu nav__burger-open\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x nav__burger-close\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></summary><nav class=\"nav__sheet\" aria-label=\"All pages\"><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Services</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/services/devsecops\">Secure SDLC<span class=\"nav__sheet-blurb\">The page that explains why one firm does both. Start here.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/services/cybersecurity\">Cybersecurity</a></li><li><a class=\"nav__sheet-link\" href=\"/services/software-development\">Software Development</a></li><li><a class=\"nav__sheet-link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"nav__sheet-link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"nav__sheet-link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"nav__sheet-link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"nav__sheet-link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"nav__sheet-link\" href=\"/services/engagement-models\">Engagement Models</a></li><li><a class=\"nav__sheet-link\" href=\"/services\">All <!-- -->services</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Industries</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/industries/financial-services\">Financial Services</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/healthcare\">Healthcare</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/saas\">SaaS &amp; Technology</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/logistics\">Logistics</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/public-sector\">Public Sector</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/retail\">Retail &amp; Payments</a></li><li><a class=\"nav__sheet-link\" href=\"/industries\">All <!-- -->industries</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Proof</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/sample-report\">Anatomy of a report<span class=\"nav__sheet-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"nav__sheet-link\" href=\"/customers\">Customers</a></li><li><a class=\"nav__sheet-link\" href=\"/certifications\">Certifications</a></li><li><a class=\"nav__sheet-link\" href=\"/trust\">Trust Centre</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Resources</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/resources\">All resources</a></li><li><a class=\"nav__sheet-link\" href=\"/blog\">Insights</a></li><li><a class=\"nav__sheet-link\" href=\"/research\">Research &amp; Labs</a></li><li><a class=\"nav__sheet-link\" href=\"/tools\">Open-source tools</a></li><li><a class=\"nav__sheet-link\" href=\"/methodologies\">Methodologies</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Company</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/about\">About</a></li><li><a class=\"nav__sheet-link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"nav__sheet-link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"nav__sheet-link\" href=\"/careers\">Careers</a></li><li><a class=\"nav__sheet-link\" href=\"/newsroom\">Newsroom</a></li></ul></div><div class=\"nav__sheet-cta\"><a class=\"btn btn--primary btn--md btn--full\" href=\"/contact\"><span>Start a conversation</span></a><a class=\"nav__sheet-hotline\" href=\"tel:+442045259100\">Incident response, 24/7 — <!-- -->+44 20 4525 9100</a></div></nav></details></div></div></header><main id=\"main\"><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" style=\"padding-top:calc(var(--nav-h) + var(--s16))\" aria-labelledby=\"about-title\"><div class=\"u-container\"><p class=\"u-eyebrow\">About <!-- -->Envenox</p><h1 id=\"about-title\" style=\"font-size:clamp(2.25rem, 6vw, 4rem);max-width:18ch;margin-top:var(--s4)\">We build the software. Then we try to break it.</h1><p class=\"u-measure\" style=\"color:var(--muted-strong);font-size:var(--text-lg);margin-top:var(--s6)\">Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.</p></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"practices-heading\"><div class=\"u-container\"><h2 id=\"practices-heading\" style=\"font-size:var(--text-3xl);max-width:20ch\">Two practices, one firm</h2><div class=\"about_twoUp__pZZI7\"><div class=\"about_practice__L4rOR\"><h3 class=\"about_practiceName__9G737\">Cybersecurity</h3><p class=\"about_practiceLine__uf6F7\">Testing, assurance, detection and response — by people who also ship production software.</p><p class=\"about_practiceBody__GNLtG\">Our testers are not career report-writers. They have shipped systems, which is why their findings arrive with a fix an engineer will accept rather than a recommendation an engineer has to translate.</p><a class=\"u-link about_practiceLink__ZmiIa\" href=\"/services/cybersecurity\">Cybersecurity<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-move-right\" aria-hidden=\"true\"><path d=\"M18 8L22 12L18 16\"></path><path d=\"M2 12H22\"></path></svg></a></div><div class=\"about_practice__L4rOR\"><h3 class=\"about_practiceName__9G737\">Software Development</h3><p class=\"about_practiceLine__uf6F7\">Products, platforms and business systems built to survive an audit and a handover.</p><p class=\"about_practiceBody__GNLtG\">Our engineers work next to a security practice that will attack what they build. That changes how authorisation, audit logging and secrets get designed — before the first commit rather than after the first report.</p><a class=\"u-link about_practiceLink__ZmiIa\" href=\"/services/software-development\">Software Development<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-move-right\" aria-hidden=\"true\"><path d=\"M18 8L22 12L18 16\"></path><path d=\"M2 12H22\"></path></svg></a></div></div><p class=\"about_seam__VoClp\">Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.</p></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"capacity-heading\"><div class=\"u-container\"><h2 id=\"capacity-heading\" class=\"u-eyebrow\">Capacity, with its provenance</h2><ul class=\"statbar statbar--4\" aria-label=\"Envenox at a glance\"><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">38</span></span></p><p class=\"stat__label\">engineers and testers on staff</p><details class=\"stat__prov\"><summary>Source</summary><p>Internal headcount register · as of 2026-10-01</p></details></li><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">11</span></span></p><p class=\"stat__label\">years operating</p><details class=\"stat__prov\"><summary>Source</summary><p>Companies House incorporation record · as of 2026-01-01</p></details></li><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">240</span></span><span class=\"stat__suffix\">+</span></p><p class=\"stat__label\">engagements delivered</p><details class=\"stat__prov\"><summary>Source</summary><p>Delivery system export · as of 2026-10-01</p></details></li><li class=\"stat stat--md\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">71</span></span></p><p class=\"stat__label\">net promoter score</p><details class=\"stat__prov\"><summary>Source</summary><p>Post-engagement survey, 94 responses · as of 2026-09-30</p></details></li></ul><h3 style=\"font-size:var(--text-2xl);margin-top:var(--s20);max-width:22ch\">Certifications held by the people, not the brochure</h3><ul class=\"reveal-group about_credGrid__V_Ydo\" aria-label=\"Team certifications held\"><li data-reveal=\"\" class=\"about_credCell__qPdcd\"><span class=\"u-mono u-tnum about_credCount__pTxM6\">14</span><span class=\"about_credLabel__d_z3q\">OSCP</span></li><li data-reveal=\"\" class=\"about_credCell__qPdcd\"><span class=\"u-mono u-tnum about_credCount__pTxM6\">6</span><span class=\"about_credLabel__d_z3q\">CISSP</span></li><li data-reveal=\"\" class=\"about_credCell__qPdcd\"><span class=\"u-mono u-tnum about_credCount__pTxM6\">4</span><span class=\"about_credLabel__d_z3q\">CREST CRT</span></li><li data-reveal=\"\" class=\"about_credCell__qPdcd\"><span class=\"u-mono u-tnum about_credCount__pTxM6\">3</span><span class=\"about_credLabel__d_z3q\">OSWE</span></li><li data-reveal=\"\" class=\"about_credCell__qPdcd\"><span class=\"u-mono u-tnum about_credCount__pTxM6\">5</span><span class=\"about_credLabel__d_z3q\">AWS Solutions Architect</span></li><li data-reveal=\"\" class=\"about_credCell__qPdcd\"><span class=\"u-mono u-tnum about_credCount__pTxM6\">2</span><span class=\"about_credLabel__d_z3q\">ISO 27001 Lead Auditor</span></li></ul><p class=\"u-mono about_credLine__tGnXa\">14 OSCP · 6 CISSP · 4 CREST CRT · 3 OSWE · 5 AWS Solutions Architect · 2 ISO 27001 Lead Auditor · 38 engineers and testers on staff</p></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"leadership-heading\"><div class=\"u-container\"><h2 id=\"leadership-heading\" style=\"font-size:var(--text-3xl);max-width:20ch\">Who you would actually work with</h2><ul class=\"reveal-group about_peopleGrid__trO0w\"><li data-reveal=\"\"><div class=\"card card--pad-lg\" style=\"height:100%\"><div class=\"about_personCardInner__rkfGi\"><div class=\"about_personTop__2J4G_\"><div role=\"img\" aria-label=\"Placeholder portrait for Tomás Lindqvist\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(194 18% 22%), hsl(194 22% 14%))\"><span aria-hidden=\"true\">TL</span></div><div style=\"min-width:0\"><h3 class=\"about_personName__cm073\"><a class=\"card__link\" href=\"/about/leadership/tomas-lindqvist\">Tomás Lindqvist</a></h3><p class=\"about_personRole__IlqnC\">Chief Executive</p></div></div></div></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg\" style=\"height:100%\"><div class=\"about_personCardInner__rkfGi\"><div class=\"about_personTop__2J4G_\"><div role=\"img\" aria-label=\"Placeholder portrait for Amara Nwosu\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(334 18% 22%), hsl(334 22% 14%))\"><span aria-hidden=\"true\">AN</span></div><div style=\"min-width:0\"><h3 class=\"about_personName__cm073\"><a class=\"card__link\" href=\"/about/leadership/amara-nwosu\">Amara Nwosu</a></h3><p class=\"about_personRole__IlqnC\">Chief Operating Officer</p></div></div></div></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg\" style=\"height:100%\"><div class=\"about_personCardInner__rkfGi\"><div class=\"about_personTop__2J4G_\"><div role=\"img\" aria-label=\"Placeholder portrait for Imran Haque\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(315 18% 22%), hsl(315 22% 14%))\"><span aria-hidden=\"true\">IH</span></div><div style=\"min-width:0\"><h3 class=\"about_personName__cm073\"><a class=\"card__link\" href=\"/about/leadership/imran-haque\">Imran Haque</a></h3><p class=\"about_personRole__IlqnC\">Head of Offensive Security</p></div></div><ul class=\"about_certs__hAzHB\" aria-label=\"Certifications held by Imran Haque\"><li><span class=\"badge badge--sm badge--neutral u-mono\">OSCP</span></li><li><span class=\"badge badge--sm badge--neutral u-mono\">OSWE</span></li><li><span class=\"badge badge--sm badge--neutral u-mono\">CREST CRT</span></li><li><span class=\"badge badge--sm badge--neutral u-mono\">GIAC GXPN</span></li></ul></div></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg\" style=\"height:100%\"><div class=\"about_personCardInner__rkfGi\"><div class=\"about_personTop__2J4G_\"><div role=\"img\" aria-label=\"Placeholder portrait for Sofia Marek\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(306 18% 22%), hsl(306 22% 14%))\"><span aria-hidden=\"true\">SM</span></div><div style=\"min-width:0\"><h3 class=\"about_personName__cm073\"><a class=\"card__link\" href=\"/about/leadership/sofia-marek\">Sofia Marek</a></h3><p class=\"about_personRole__IlqnC\">Principal Application Security Engineer</p></div></div><ul class=\"about_certs__hAzHB\" aria-label=\"Certifications held by Sofia Marek\"><li><span class=\"badge badge--sm badge--neutral u-mono\">OSWE</span></li><li><span class=\"badge badge--sm badge--neutral u-mono\">CISSP</span></li><li><span class=\"badge badge--sm badge--neutral u-mono\">GIAC GWAPT</span></li></ul></div></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg\" style=\"height:100%\"><div class=\"about_personCardInner__rkfGi\"><div class=\"about_personTop__2J4G_\"><div role=\"img\" aria-label=\"Placeholder portrait for Marcus Reid\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(319 18% 22%), hsl(319 22% 14%))\"><span aria-hidden=\"true\">MR</span></div><div style=\"min-width:0\"><h3 class=\"about_personName__cm073\"><a class=\"card__link\" href=\"/about/leadership/marcus-reid\">Marcus Reid</a></h3><p class=\"about_personRole__IlqnC\">Head of Engineering</p></div></div><ul class=\"about_certs__hAzHB\" aria-label=\"Certifications held by Marcus Reid\"><li><span class=\"badge badge--sm badge--neutral u-mono\">AWS Solutions Architect Professional</span></li></ul></div></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg\" style=\"height:100%\"><div class=\"about_personCardInner__rkfGi\"><div class=\"about_personTop__2J4G_\"><div role=\"img\" aria-label=\"Placeholder portrait for Priya Raman\" class=\"avatar-ph\" style=\"width:56px;height:56px;font-size:19px;background-image:linear-gradient(135deg, hsl(324 18% 22%), hsl(324 22% 14%))\"><span aria-hidden=\"true\">PR</span></div><div style=\"min-width:0\"><h3 class=\"about_personName__cm073\"><a class=\"card__link\" href=\"/about/leadership/priya-raman\">Priya Raman</a></h3><p class=\"about_personRole__IlqnC\">Principal Architect</p></div></div><ul class=\"about_certs__hAzHB\" aria-label=\"Certifications held by Priya Raman\"><li><span class=\"badge badge--sm badge--neutral u-mono\">AWS Solutions Architect Professional</span></li><li><span class=\"badge badge--sm badge--neutral u-mono\">CKA</span></li></ul></div></div></li></ul><p style=\"margin-top:var(--s8)\"><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/about/leadership\">All 9 — with bios and the certifications each security lead holds</a></p></div></section><section class=\"sec theme-dark transition-theme u-section\" data-theme-section=\"dark\" aria-labelledby=\"certifications-heading\"><div class=\"u-container\"><h2 id=\"certifications-heading\" style=\"font-size:var(--text-3xl);max-width:20ch\">What the company itself is certified against</h2><div class=\"about_tableWrap__rc7YB\" role=\"region\" aria-labelledby=\"certifications-heading\" tabindex=\"0\"><table class=\"about_certTable__XDVTw\"><caption class=\"about_srOnly__e1UXy\">Certifications and accreditations held by <!-- -->Envenox Ltd<!-- -->, with issuer, certificate number where one exists, and expiry.</caption><thead><tr><th scope=\"col\">Certification</th><th scope=\"col\">Issuer</th><th scope=\"col\">Certificate</th><th scope=\"col\">Expires</th></tr></thead><tbody><tr><th scope=\"row\">ISO/IEC 27001:2022<span class=\"about_certScope__AiNma\">Delivery of cybersecurity and software development services, London and Dhaka.</span></th><td>UKAS-accredited certification body</td><td class=\"u-mono about_certNum__8BEge\">—</td><td class=\"u-mono about_certNum__8BEge\">2029-03-13</td></tr><tr><th scope=\"row\">ISO 9001:2015<span class=\"about_certScope__AiNma\">Software development delivery.</span></th><td>UKAS-accredited certification body</td><td class=\"u-mono about_certNum__8BEge\">—</td><td class=\"u-mono about_certNum__8BEge\">2028-09-01</td></tr><tr><th scope=\"row\">SOC 2 Type II<span class=\"about_certScope__AiNma\">Envenox engagement platform and evidence workspace. Report available under NDA.</span></th><td>Independent CPA firm</td><td class=\"u-mono about_certNum__8BEge\">—</td><td class=\"u-mono about_certNum__8BEge\">2027-06-29</td></tr><tr><th scope=\"row\">Cyber Essentials Plus<span class=\"about_certScope__AiNma\">Whole organisation.</span></th><td>IASME, on behalf of the NCSC</td><td class=\"u-mono about_certNum__8BEge\">—</td><td class=\"u-mono about_certNum__8BEge\">2027-05-19</td></tr><tr><th scope=\"row\">CREST<span class=\"about_certScope__AiNma\">Penetration testing services.</span></th><td>CREST International</td><td class=\"u-mono about_certNum__8BEge\">—</td><td class=\"u-mono about_certNum__8BEge\">2027-10-31</td></tr><tr><th scope=\"row\">PCI DSS Qualified Security Assessor<span class=\"about_certScope__AiNma\">PCI DSS 4.0 assessment and advisory.</span></th><td>PCI Security Standards Council</td><td class=\"u-mono about_certNum__8BEge\">—</td><td class=\"u-mono about_certNum__8BEge\">2027-01-14</td></tr></tbody></table></div><p style=\"margin-top:var(--s8);display:flex;flex-wrap:wrap;gap:var(--s4)\"><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/certifications\">Every certificate in full</a><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/trust\">Including the one we do not hold, and why</a></p></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"method-heading\"><div class=\"u-container\"><p class=\"u-eyebrow\">Our method</p><h2 id=\"method-heading\" style=\"font-size:var(--text-3xl);max-width:20ch\">The Adversary Loop</h2><p class=\"u-measure\" style=\"color:var(--fg);font-size:var(--text-lg);margin-top:var(--s4)\">Threat models shape the build. The build gets attacked. The attack rewrites the threat model.</p><ol class=\"about_loopPreview__RlIxJ\"><li class=\"about_loopRow___pmN_\"><span class=\"u-mono about_loopNum__opUL1\" aria-hidden=\"true\">01</span><span><span class=\"about_loopName__rj9qp\">Model</span><span class=\"about_loopLine__6xNZG\">Before the first sprint, with the people who will own the components.</span></span></li><li class=\"about_loopRow___pmN_\"><span class=\"u-mono about_loopNum__opUL1\" aria-hidden=\"true\">02</span><span><span class=\"about_loopName__rj9qp\">Build</span><span class=\"about_loopLine__6xNZG\">Ordinary good delivery, with security reading the decisions as they are made.</span></span></li><li class=\"about_loopRow___pmN_\"><span class=\"u-mono about_loopNum__opUL1\" aria-hidden=\"true\">03</span><span><span class=\"about_loopName__rj9qp\">Attack</span><span class=\"about_loopLine__6xNZG\">Continuously during the build, then independently before release.</span></span></li><li class=\"about_loopRow___pmN_\"><span class=\"u-mono about_loopNum__opUL1\" aria-hidden=\"true\">04</span><span><span class=\"about_loopName__rj9qp\">Watch</span><span class=\"about_loopLine__6xNZG\">Detections written by people who have been reading this system for months.</span></span></li><li class=\"about_loopRow___pmN_\"><span class=\"u-mono about_loopNum__opUL1\" aria-hidden=\"true\">05</span><span><span class=\"about_loopName__rj9qp\">Rewrite</span><span class=\"about_loopLine__6xNZG\">What was found goes back into the model. This is the whole point.</span></span></li></ol><p style=\"margin-top:var(--s8)\"><a class=\"btn btn--secondary btn--md\" href=\"/approach\"><span>The Adversary Loop in full</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></p></div></section><section class=\"sec theme-deep transition-theme u-section-tight\" data-theme-section=\"deep\" aria-labelledby=\"clients-heading\"><div class=\"sec__bleed\"><div class=\"u-container\"><h2 id=\"clients-heading\" class=\"u-eyebrow\">Selected clients</h2></div><div style=\"margin-top:var(--s8)\"><div class=\"marquee\" style=\"--gap:var(--s12);--marquee-dur:52s\" tabindex=\"0\" role=\"group\" aria-label=\"Selected clients\"><ul class=\"marquee__track mq-track\" aria-label=\"Selected clients\"><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"mq__meta\">Retail &amp; Payments</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Carrick Analytics</span><span class=\"mq__meta\">SaaS &amp; Technology</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Pelham Energy</span><span class=\"mq__meta\">Energy</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Severn Mutual</span><span class=\"mq__meta\">Insurance</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Orbis Education</span><span class=\"mq__meta\">Education</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"mq__meta\">Retail &amp; Payments</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Carrick Analytics</span><span class=\"mq__meta\">SaaS &amp; Technology</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Pelham Energy</span><span class=\"mq__meta\">Energy</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Severn Mutual</span><span class=\"mq__meta\">Insurance</span></span></li><li class=\"mq__item\" aria-hidden=\"true\"><span class=\"mq__text\"><span class=\"mq__label\">Orbis Education</span><span class=\"mq__meta\">Education</span></span></li></ul></div></div><div class=\"u-container\" style=\"margin-top:var(--s8)\"><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/customers\">Who we work with, and what they say</a></div></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"reviews-heading\"><div class=\"u-container\"><h2 id=\"reviews-heading\" style=\"font-size:var(--text-2xl);max-width:24ch\">Third-party reviews, by pillar</h2><ul class=\"reveal-group about_badgeRow__URiE3\"><li data-reveal=\"\" class=\"about_reviewCard__ur7Xb\"><span class=\"u-mono u-tnum about_reviewScore__I6p_W\">4.9</span><p class=\"about_reviewSource__0rlT9\">Clutch</p><p class=\"about_reviewMeta__jKl96\">31 reviews · read on the software side</p><a class=\"u-link about_reviewLink__S6ero\" href=\"https://clutch.co/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Clutch profile<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\" style=\"display:inline-block;vertical-align:-2px;margin-left:4px\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></li><li data-reveal=\"\" class=\"about_reviewCard__ur7Xb\"><span class=\"u-mono u-tnum about_reviewScore__I6p_W\">4.7</span><p class=\"about_reviewSource__0rlT9\">G2</p><p class=\"about_reviewMeta__jKl96\">44 reviews · read on the software side</p><a class=\"u-link about_reviewLink__S6ero\" href=\"https://www.g2.com/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">G2 profile<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\" style=\"display:inline-block;vertical-align:-2px;margin-left:4px\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></li><li data-reveal=\"\" class=\"about_reviewCard__ur7Xb\"><span class=\"u-mono u-tnum about_reviewScore__I6p_W\">4.6</span><p class=\"about_reviewSource__0rlT9\">Gartner Peer Insights</p><p class=\"about_reviewMeta__jKl96\">18 reviews · read on the security side</p><a class=\"u-link about_reviewLink__S6ero\" href=\"https://www.gartner.com/reviews/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Gartner Peer Insights profile<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\" style=\"display:inline-block;vertical-align:-2px;margin-left:4px\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></li></ul></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" aria-labelledby=\"where-heading\"><div class=\"u-container\"><h2 id=\"where-heading\" class=\"about_srOnly__e1UXy\">Where we are, and joining us</h2><div class=\"about_splitPanels__Xi_Kg\"><div class=\"about_panel__NqCZj\"><h3 class=\"about_panelHeading__lY4Mm\">Where we are</h3><ul class=\"about_officeList__L7w9H\"><li><span class=\"about_officeCity__ip2oH\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin\" aria-hidden=\"true\" style=\"display:inline-block;vertical-align:-2px;margin-right:6px\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>London<!-- -->, <!-- -->United Kingdom</span><span class=\"about_officeLine__B4M5X\">1 Fore Street Avenue, London EC2Y 9DT</span></li><li><span class=\"about_officeCity__ip2oH\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin\" aria-hidden=\"true\" style=\"display:inline-block;vertical-align:-2px;margin-right:6px\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Dhaka<!-- -->, <!-- -->Bangladesh</span><span class=\"about_officeLine__B4M5X\">Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212</span></li></ul><p style=\"margin:0\"><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/locations\">Offices, entity and data residency</a></p></div><div class=\"about_panel__NqCZj\"><h3 class=\"about_panelHeading__lY4Mm\">Joining us</h3><p class=\"about_panelBody__YEUgh\">Open roles are listed with salary bands, because a role advertised without one wastes everybody’s afternoon.</p><p class=\"about_panelBody__YEUgh\">Every engineer and tester is background-checked before they are assigned to an engagement, and the policy is published here rather than described on request.</p><p style=\"margin:0;display:flex;flex-wrap:wrap;gap:var(--s4)\"><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/careers\">Careers</a><a class=\"u-link\" style=\"color:var(--fg)\" href=\"/trust\">The background-check policy</a></p></div></div></div></section><section class=\"sec theme-dark transition-theme u-section-tight\" data-theme-section=\"dark\"><div class=\"u-container\"><h2 style=\"font-size:var(--text-2xl);max-width:24ch\">Book a 60-minute scoping call</h2><p class=\"u-measure\" style=\"color:var(--muted);margin-top:var(--s4)\">A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.</p><div style=\"display:flex;flex-wrap:wrap;gap:var(--s3);margin-top:var(--s8)\"><a class=\"btn btn--primary btn--lg\" href=\"/contact\"><span>Start a conversation</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"btn btn--secondary btn--lg\" href=\"/case-studies\"><span>See the work</span></a></div></div></section><!--$--><!--/$--></main><footer class=\"foot theme-dark transition-theme grain\" data-theme-section=\"dark\"><div class=\"u-container\"><div class=\"foot__top\"><div class=\"foot__brand\"><a class=\"foot__wordmark\" href=\"/\">Envenox</a><p class=\"foot__positioning\">Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.</p><a class=\"foot__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"footer\"><span class=\"foot__hotline-row\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"u-eyebrow\">Incident response — 24/7</span></span><span class=\"foot__hotline-number\">+44 20 4525 9100</span><span class=\"foot__hotline-note\">Answered by a responder, 24/7. Median pickup under 4 minutes.</span></a></div><nav class=\"foot__cols\" aria-label=\"Footer\"><div><h2 class=\"foot__col-heading\">Cybersecurity</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"foot__link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"foot__link\" href=\"/services/cloud-security\">Cloud Security</a></li><li><a class=\"foot__link\" href=\"/services/red-teaming\">Red Teaming</a></li><li><a class=\"foot__link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"foot__link\" href=\"/services/incident-response\">Incident Response</a></li><li><a class=\"foot__link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"foot__link\" href=\"/services/vciso\">vCISO</a></li></ul></div><div><h2 class=\"foot__col-heading\">Software Development</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"foot__link\" href=\"/services/web-application-development\">Web Applications</a></li><li><a class=\"foot__link\" href=\"/services/platform-engineering\">Platform &amp; DevOps</a></li><li><a class=\"foot__link\" href=\"/services/erp\">ERP</a></li><li><a class=\"foot__link\" href=\"/services/crm\">CRM</a></li><li><a class=\"foot__link\" href=\"/services/hrm\">HRM</a></li><li><a class=\"foot__link\" href=\"/services/lms\">LMS</a></li><li><a class=\"foot__link\" href=\"/services/qa-automation\">QA &amp; Test Automation</a></li></ul></div><div><h2 class=\"foot__col-heading\">Company</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/about\">About</a></li><li><a class=\"foot__link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"foot__link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"foot__link\" href=\"/careers\">Careers</a></li><li><a class=\"foot__link\" href=\"/newsroom\">Newsroom</a></li><li><a class=\"foot__link\" href=\"/locations\">Locations</a></li><li><a class=\"foot__link\" href=\"/partners\">Partners</a></li></ul></div><div><h2 class=\"foot__col-heading\">Proof &amp; Resources</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"foot__link\" href=\"/sample-report\">Sample Report</a></li><li><a class=\"foot__link\" href=\"/customers\">Customers</a></li><li><a class=\"foot__link\" href=\"/certifications\">Certifications</a></li><li><a class=\"foot__link\" href=\"/trust\">Trust Centre</a></li><li><a class=