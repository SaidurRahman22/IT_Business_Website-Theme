em arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\"}]\n15:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"capacity-heading\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"capacity-heading\",\"className\":\"u-eyebrow\",\"children\":\"Capacity, with its provenance\"}],[[\"$\",\"style\",null,{\"href\":\"envenox-statbar\",\"precedence\":\"default\",\"children\":\"\\n.statbar {\\n  display: grid;\\n  gap: var(--s8);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n.statbar > li { min-width: 0; }\\n\\n@media (min-width: 640px) {\\n  .statbar { gap: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }\\n  .statbar > li { padding: var(--s6) var(--s6) var(--s6) 0; border-top: 1px solid var(--border); }\\n  .statbar > li + li { border-left: 1px solid var(--border); padding-left: var(--s6); }\\n  /* The second cell of each pair starts a new row edge, not a mid-row border. */\\n  .statbar--2 > li:nth-child(2n + 1) { border-left: 0; padding-left: 0; }\\n}\\n@media (min-width: 1024px) {\\n  .statbar--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\\n  .statbar--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\\n  .statbar--3 > li:nth-child(2n + 1),\\n  .statbar--4 > li:nth-ch