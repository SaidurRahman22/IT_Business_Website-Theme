3\\\",{\\\"rel\\\":\\\"author\\\",\\\"href\\\":\\\"https://envenox.com\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"Envenox Ltd\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"referrer\\\",\\\"content\\\":\\\"strict-origin-when-cross-origin\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"Envenox Ltd\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"publisher\\\",\\\"content\\\":\\\"Envenox Ltd\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"name\\\":\\\"googlebot\\\",\\\"content\\\":\\\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\\\"}],[\\\"$\\\",\\\"link\\\",\\\"11\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://envenox.com/sample-report\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"name\\\":\\\"format-detection\\\",\\\"content\\\":\\\"telephone=no, address=no, email=no\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"See exactly what lands in your inbox · Envenox\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://envenox.com/sample-report\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"article\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"17\\\",{\\\"name\\\":\\\"twitter: