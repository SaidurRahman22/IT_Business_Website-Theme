{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/sample-report/layout,_N_T_/sample-report/page,_N_T_/sample-report"},"routeCache":{"key":"/route-cache/APP_PAGE/c40e1ecb236186091ec906995b05645f172f632703deb820ab4caa10a04eb301/$/sample-report","owner":{"kind":"APP_PAGE","sourceRoute":"/sample-report/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-sample-report envenox-proof-surfaces envenox-doc-frame envenox-section envenox-stat envenox-report-rail envenox-faq envenox-badge envenox-avatar-placeholder\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ---------------- hero ---------------- */\n.sr-stats {\n  display: grid;\n  gap: var(--s6);\n  list-style: none;\n  margin: var(--s12) 0 0;\n  padding: 0;\n}\n@media (min-width: 640px) { .sr-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s8); } }\n.sr-stats > li { min-width: 0; }\n\n.sr-disclaimer {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--s3);\n  margin-top: var(--s12);\n  max-width: 68ch;\n  border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n}\n.sr-disclaimer__icon { color: var(--accent); flex: none; margin-top: 3px; }\n.sr-disclaimer p { margin: 0; font-size: var(--text-sm); line-height: 1.6; color: var(--fg); }\n\n.sr-actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s8); }\n.sr-print { margin: var(--s4) 0 0; font-size: var(--text-xs); color: var(--muted); display: inline-flex; align-items: center; gap: var(--s2); }\n\n/* ---------------- sticky strip (narrow viewports) ---------------- */\n.sr-strip {\n  position: sticky;\n  top: var(--nav-h);\n  z-index: 20;\n  margin-inline: calc(var(--gutter) * -1);\n  margin-bottom: var(--s8);\n  padding: var(--s2) var(--gutter);\n  background-color: var(--bg);\n  border-bottom: 1px solid var(--border);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n@media (min-width: 1024px) { .sr-strip { display: none; } }\n\n/* ---------------- layout ---------------- */\n.sr-layout { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .sr-layout { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); gap: var(--s16); align-items: start; }\n}\n.sr-body { display: grid; gap: var(--s20); min-width: 0; }\n\n/* ---------------- one report section ---------------- */\n.sr-section { scroll-margin-top: calc(var(--nav-h) + var(--s8)); min-width: 0; }\n.sr-section__n {\n  margin: 0 0 var(--s2);\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.sr-section__title {\n  margin: 0;\n  font-size: var(--text-xl);\n  line-height: var(--leading-snug);\n}\n@media (min-width: 768px) { .sr-section__title { font-size: var(--text-2xl); } }\n.sr-section[data-feature='true'] .sr-section__title { font-size: var(--text-2xl); }\n@media (min-width: 768px) {\n  .sr-section[data-feature='true'] .sr-section__title { font-size: var(--text-3xl); }\n}\n\n.sr-qa { margin: var(--s6) 0 0; max-width: 68ch; }\n.sr-qa dt {\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.sr-qa dd { margin: var(--s2) 0 0; color: var(--muted-strong); line-height: var(--leading-normal); font-size: var(--text-sm); }\n@media (min-width: 768px) { .sr-qa dd { font-size: var(--text-base); } }\n.sr-qa dd + dt { margin-top: var(--s6); }\n\n.sr-frame { margin-top: var(--s8); }\n\n.sr-foot { margin-top: var(--s20); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.sr-foot p { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n\n/* ---------------- print ---------------- */\n@media print {\n  .sr-layout { display: block; }\n  .sr-body { display: block; }\n  .sr-section { break-inside: auto; break-after: auto; margin-bottom: 24pt; }\n  .sr-section__head { break-after: avoid; }\n  .sr-disclaimer { border: 1pt solid currentColor; }\n  .sr-actions { display: none; }\n}\n\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\n.metrics {\n  display: grid;\n  gap: var(--s8);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n@media (min-width: 768px) {\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\n}\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\n   headline rather than in a full-width row under it. */\n.metrics--stack { gap: var(--s4); }\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\n/* The key runs inline with its note in the stacked variant — one line saved per\n   metric is what keeps all three on the first screen. */\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\n.metrics--stack .metric__note-key::after { content: ' — '; }\n.metric {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  min-width: 0;\n  border-top: 1px solid var(--border-strong);\n  padding-top: var(--s4);\n}\n.metric__value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n@media (min-width: 768px) {\n  .metric__value { font-size: var(--text-3xl); }\n}\n.metric__label {\n  margin: 0;\n  color: var(--muted-strong);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n  max-width: 34ch;\n}\n.metric__note {\n  margin: var(--s2) 0 0;\n  padding-top: var(--s2);\n  border-top: 1px solid var(--border);\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 36ch;\n}\n.metric__note-key {\n  display: block;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 2px;\n}\n\n/* ---------------- NDA block ---------------- */\n.nda {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--s3);\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\n  border-radius: var(--radius-md);\n  padding: var(--s3) var(--s4);\n}\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.nda__kicker {\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.nda__name {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n}\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\n\n/* ---------------- dual-pillar marker ---------------- */\n.dual {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s2) var(--s3);\n  color: var(--fg);\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  text-decoration: none;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\n.dual__icon { color: var(--accent); flex: none; }\n\n/* ---------------- case study card ---------------- */\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\n.cs-card__client {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  color: var(--muted-strong);\n}\n.cs-card__headline {\n  margin: 0;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.cs-card__headline a { color: inherit; text-decoration: none; }\n.cs-card__meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--s2) var(--s4);\n  font-size: var(--text-xs);\n  color: var(--muted);\n  margin: 0;\n}\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-card__metric {\n  margin-top: auto;\n  padding-top: var(--s4);\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n}\n.cs-card__metric-value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.1;\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\n\n/* ---------------- testimonial rail ---------------- */\n.trail {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\n  gap: var(--s4);\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  scroll-snap-type: x mandatory;\n  list-style: none;\n  margin: 0;\n  padding: 0 0 var(--s4);\n  scrollbar-width: thin;\n}\n@media (min-width: 768px) {\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\n}\n.trail > li { scroll-snap-align: start; min-width: 0; }\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.trail__quote {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n@media (min-width: 768px) {\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\n}\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------------- named-humans CTA ---------------- */\n.humans { display: grid; gap: var(--s8); }\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n.human { display: flex; align-items: center; gap: var(--s4); }\n.human__name {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-base);\n  font-weight: 500;\n  color: var(--fg);\n}\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\n\n.doc {\n  margin: 0;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--bg);\n  color: var(--fg);\n  overflow: hidden;\n}\n\n.doc__chrome {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--s2) var(--s4);\n  padding: var(--s3) var(--s4);\n  border-bottom: 1px solid var(--border);\n  background-color: var(--surface);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.doc__stamp { display: inline-flex; align-items: center; gap: var(--s2); color: var(--muted); }\n.doc__stamp::before {\n  content: '';\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--accent);\n  flex: none;\n}\n.doc__pages { color: var(--muted); white-space: nowrap; }\n\n.doc__sheet { padding: var(--s6) var(--s4); }\n@media (min-width: 768px) { .doc__sheet { padding: var(--s8); } }\n/* Code and table excerpts run to the frame edge so the masked scroll edges sit\n   on the frame itself; their inner padding is restored below. */\n.doc__sheet--flush { padding-inline: 0; }\n\n/* ---------------- prose ---------------- */\n.doc__prose { max-width: 66ch; }\n.doc__prose p {\n  margin: 0;\n  font-size: var(--text-sm);\n  line-height: 1.7;\n  color: var(--fg);\n}\n@media (min-width: 768px) { .doc__prose p { font-size: var(--text-base); } }\n.doc__prose p + p { margin-top: var(--s4); }\n\n/* ---------------- table ---------------- */\n.doc__scroll {\n  position: relative;\n  /* Masked edges signal that the content continues past the frame. */\n  mask-image: linear-gradient(90deg, transparent 0, #000 var(--s4), #000 calc(100% - var(--s4)), transparent 100%);\n  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--s4), #000 calc(100% - var(--s4)), transparent 100%);\n}\n.doc__scroll > * {\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  padding-inline: var(--s4);\n}\n@media (min-width: 768px) { .doc__scroll > * { padding-inline: var(--s8); } }\n.doc__table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-sm);\n  font-variant-numeric: tabular-nums;\n  text-align: left;\n}\n.doc__table caption {\n  caption-side: top;\n  text-align: left;\n  padding-bottom: var(--s3);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.doc__table th,\n.doc__table td {\n  padding: var(--s3) var(--s4) var(--s3) 0;\n  border-bottom: 1px solid var(--border);\n  vertical-align: top;\n  line-height: 1.5;\n}\n.doc__table tr:last-child th,\n.doc__table tr:last-child td { border-bottom: 0; }\n.doc__table th[scope='row'] {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  color: var(--muted-strong);\n  white-space: nowrap;\n  padding-right: var(--s6);\n}\n.doc__table td { color: var(--fg); }\n\n/* ---------------- code ---------------- */\n.doc__pre {\n  margin: 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: var(--text-xs);\n  line-height: 1.65;\n  color: var(--fg);\n  white-space: pre;\n  tab-size: 2;\n}\n@media (min-width: 900px) { .doc__pre { font-size: var(--text-sm); } }\n.doc__pre:focus-visible { outline-offset: -2px; }\n\n/* ---------------- the refusal block ---------------- */\n.doc__refusal {\n  margin: var(--s6) var(--s4) 0;\n  max-width: 72ch;\n  border: 1px solid var(--border-strong);\n  border-left: 3px solid var(--accent);\n  border-radius: var(--radius-sm);\n  background-color: var(--surface);\n  padding: var(--s4);\n}\n.doc__refusal-key {\n  display: block;\n  font-size: var(--text-xs);\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  color: var(--accent);\n  margin-bottom: var(--s3);\n}\n.doc__refusal-body {\n  margin: 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: var(--text-xs);\n  line-height: 1.7;\n  color: var(--fg);\n  max-width: 68ch;\n}\n@media (min-width: 900px) { .doc__refusal-body { font-size: var(--text-sm); } }\n@media (min-width: 768px) {\n  .doc__refusal { margin-inline: var(--s8); }\n}\n\n/* ---------------- list ---------------- */\n.doc__list { list-style: none; margin: 0; padding: 0; max-width: 72ch; }\n.doc__list > li { border-top: 1px solid var(--border); padding-block: var(--s4); }\n.doc__list > li:first-child { border-top: 0; padding-top: 0; }\n.doc__list > li:last-child { padding-bottom: 0; }\n.doc__tag {\n  display: inline-flex;\n  align-items: center;\n  width: fit-content;\n  margin-bottom: var(--s2);\n  padding: 2px var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-sm);\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.06em;\n  color: var(--muted-strong);\n  text-transform: none;\n}\n.doc__list-body { margin: 0; font-size: var(--text-sm); line-height: 1.65; color: var(--fg); }\n\n/* ---------------- print ---------------- */\n@media print {\n  .doc { break-inside: avoid; border-color: currentColor; }\n  .doc__scroll { mask-image: none; -webkit-mask-image: none; }\n  .doc__scroll > * { overflow: visible; }\n  .doc__pre { white-space: pre-wrap; }\n}\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n.stat { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }\n\n.stat__figure {\n  display: flex;\n  align-items: baseline;\n  gap: 1px;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  font-variant-numeric: tabular-nums;\n}\n.stat--sm .stat__figure { font-size: var(--text-xl); }\n.stat--md .stat__figure { font-size: var(--text-3xl); }\n.stat--lg .stat__figure { font-size: var(--text-4xl); }\n@media (min-width: 768px) {\n  .stat--lg .stat__figure { font-size: var(--text-5xl); }\n}\n\n/* The roll strip. overflow:hidden is what clips the sanctioned keyframe. */\n.stat__roll { display: inline-block; overflow: hidden; vertical-align: bottom; }\n.stat__value { display: inline-block; }\n.stat__roll[data-rolled='true'] > .stat__value {\n  animation: inFromBelow var(--dur-base) var(--ease-out);\n}\n.stat__suffix { color: var(--accent); }\n\n.stat__label {\n  color: var(--muted);\n  font-size: var(--text-sm);\n  line-height: 1.35;\n  margin: 0;\n  max-width: 28ch;\n}\n\n.stat__prov { font-size: var(--text-xs); color: var(--muted); }\n.stat__prov > summary {\n  cursor: pointer;\n  list-style: none;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  color: var(--muted);\n  border-bottom: 1px dotted var(--border-strong);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.stat__prov > summary::-webkit-details-marker { display: none; }\n.stat__prov > summary:hover { color: var(--fg); }\n.stat__prov > p {\n  margin: var(--s2) 0 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 34ch;\n}\n\n.rail { position: static; }\n@media (min-width: 1024px) {\n  .rail {\n    position: sticky;\n    top: calc(var(--nav-h) + var(--s6));\n    align-self: start;\n  }\n}\n.rail__stamp {\n  display: block;\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--accent);\n  padding-bottom: var(--s3);\n  margin-bottom: var(--s3);\n  border-bottom: 1px solid var(--border);\n}\n.rail__key { margin: 0 0 var(--s3); }\n.rail__list { list-style: none; margin: 0; padding: 0; }\n.rail__item + .rail__item { margin-top: 1px; }\n.rail__link {\n  display: flex;\n  gap: var(--s3);\n  align-items: baseline;\n  padding: var(--s2) var(--s3);\n  border-left: 1px solid var(--border);\n  color: var(--muted);\n  font-size: var(--text-sm);\n  line-height: 1.35;\n  text-decoration: none;\n  /* Colour only. */\n  transition:\n    color var(--dur-micro) var(--ease-out),\n    border-color var(--dur-micro) var(--ease-out),\n    background-color var(--dur-micro) var(--ease-out);\n}\n.rail__link:hover { color: var(--fg); border-left-color: var(--border-strong); background-color: var(--surface); }\n.rail__link[aria-current='true'] { color: var(--fg); border-left-color: var(--accent); }\n.rail__n { flex: none; font-size: var(--text-xs); color: var(--muted); font-variant-numeric: tabular-nums; }\n.rail__link[aria-current='true'] .rail__n { color: var(--accent); }\n.rail__pages { display: block; font-size: var(--text-xs); color: var(--muted); }\n\n@media print {\n  .rail { display: none; }\n}\n\n.faq { border-top: 1px solid var(--border); }\n.faq__item { border-bottom: 1px solid var(--border); }\n.faq__header { margin: 0; }\n\n.faq__trigger {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--s6);\n  width: 100%;\n  min-height: 44px;\n  padding: var(--s6) 0;\n  appearance: none;\n  background: none;\n  border: 0;\n  text-align: left;\n  cursor: pointer;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  /* Colour only. The row must not move under the pointer. */\n  transition: color var(--dur-base) var(--ease-out);\n}\n.faq__trigger:hover { color: var(--muted-strong); }\n.faq__trigger:focus-visible { outline-offset: -2px; }\n\n.faq__chevron {\n  flex: none;\n  margin-top: 2px;\n  color: var(--muted);\n  transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\n.faq__trigger[data-state='open'] .faq__chevron { transform: rotate(180deg); color: var(--fg); }\n\n/* .acc-content carries the collapseDown / collapseUp animations from globals. */\n.faq__content { overflow: hidden; }\n.faq__answer {\n  padding-bottom: var(--s6);\n  color: var(--muted-strong);\n  max-width: 68ch;\n  margin: 0;\n}\n\n/* The no-JS mirror. display:none also keeps it out of the a11y tree when\n   scripting is available, so nothing is announced twice. */\n.faq__nojs { display: none; border-top: 1px solid var(--border); }\n.no-js .faq__nojs { display: block; }\n.no-js .faq__accordion { display: none; }\n.faq__nojs dt {\n  padding-top: var(--s6);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.faq__nojs dd {\n  margin: var(--s2) 0 0;\n  padding-bottom: var(--s6);\n  border-bottom: 1px solid var(--border);\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n\n.avatar-ph {\n  display: grid;\n  place-items: center;\n  flex: none;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border);\n  color: var(--paper-50);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  line-height: 1;\n  user-select: none;\n  overflow: hidden;\n}\n.avatar-ph--round { border-radius: 50%; }\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/sample-report/page-11fef9718df08254.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>Sample report — anatomy of a penetration test report · Envenox</title><meta name=\"description\" content=\"A penetration test is a document and a conversation. You are asked to buy both before seeing either. This is the whole structure of an Envenox report, section by section, with a real finding written out in full — redacted, for a fictional client, and otherwise exactly as it would be delivered.\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com/sample-report\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"See exactly what lands in your inbox · Envenox\"/><meta property=\"og:description\" content=\"Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.\"/><meta property=\"og:url\" content=\"https://envenox.com/sample-report\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"See exactly what lands in your inbox\"/><meta name=\"twitter:description\" content=\"Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav theme-dark transition-theme no-print\" data-scrolled=\"false\" data-nav-theme=\"dark\"><div class=\"nav__bar u-container\"><a class=\"nav__brand\" href=\"/\">Envenox</a><nav aria-label=\"Primary\" data-orientation=\"horizontal\" dir=\"ltr\" class=\"nav__desktop\"><div style=\"position:relative\"><ul data-orientation=\"horizontal\" class=\"nav__list\" dir=\"ltr\"><li><button id=\"radix-_R_klb_-trigger-Services\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Services\" class=\"nav__trigger\" data-radix-collection-item=\"\">Services<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Services\" aria-labelledby=\"radix-_R_klb_-trigger-Services\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/services/devsecops\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Secure SDLC</span><span class=\"nav__featured-blurb\">The page that explains why one firm does both. Start here.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/cybersecurity\"><span class=\"nav__link-label\">Cybersecurity</span><span class=\"nav__link-blurb\">Testing, assurance, detection and response</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/software-development\"><span class=\"nav__link-label\">Software Development</span><span class=\"nav__link-blurb\">Product build, platform and modernisation</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/penetration-testing\"><span class=\"nav__link-label\">Penetration Testing</span><span class=\"nav__link-blurb\">Web, mobile, network, cloud, API</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/application-security\"><span class=\"nav__link-label\">Application Security</span><span class=\"nav__link-blurb\">Secure code review and SDLC uplift</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/managed-detection-response\"><span class=\"nav__link-label\">Managed Detection &amp; Response</span><span class=\"nav__link-blurb\">24/7 SOC on your telemetry</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/grc-compliance\"><span class=\"nav__link-label\">GRC &amp; Compliance</span><span class=\"nav__link-blurb\">SOC 2, ISO 27001, PCI DSS, DORA, NIS2</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/custom-software\"><span class=\"nav__link-label\">Custom Software</span><span class=\"nav__link-blurb\">Systems built to survive an audit</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/engagement-models\"><span class=\"nav__link-label\">Engagement Models</span><span class=\"nav__link-blurb\">How retainers and projects actually run</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/services\">All <!-- -->services<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Industries\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Industries\" class=\"nav__trigger\" data-radix-collection-item=\"\">Industries<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Industries\" aria-labelledby=\"radix-_R_klb_-trigger-Industries\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/financial-services\"><span class=\"nav__link-label\">Financial Services</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/healthcare\"><span class=\"nav__link-label\">Healthcare</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/saas\"><span class=\"nav__link-label\">SaaS &amp; Technology</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/logistics\"><span class=\"nav__link-label\">Logistics</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/public-sector\"><span class=\"nav__link-label\">Public Sector</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/retail\"><span class=\"nav__link-label\">Retail &amp; Payments</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/industries\">All <!-- -->industries<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Proof\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Proof\" class=\"nav__trigger\" data-radix-collection-item=\"\">Proof<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Proof\" aria-labelledby=\"radix-_R_klb_-trigger-Proof\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/sample-report\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Anatomy of a report</span><span class=\"nav__featured-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/case-studies\"><span class=\"nav__link-label\">Case Studies</span><span class=\"nav__link-blurb\">24 stories, filterable</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/customers\"><span class=\"nav__link-label\">Customers</span><span class=\"nav__link-blurb\">Who we work with, and what they say</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/certifications\"><span class=\"nav__link-label\">Certifications</span><span class=\"nav__link-blurb\">Ours, with certificate numbers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/trust\"><span class=\"nav__link-label\">Trust Centre</span><span class=\"nav__link-blurb\">Our own security posture, published</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Resources\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Resources\" class=\"nav__trigger\" data-radix-collection-item=\"\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Resources\" aria-labelledby=\"radix-_R_klb_-trigger-Resources\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/resources\"><span class=\"nav__link-label\">All resources</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/blog\"><span class=\"nav__link-label\">Insights</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/research\"><span class=\"nav__link-label\">Research &amp; Labs</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/tools\"><span class=\"nav__link-label\">Open-source tools</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/methodologies\"><span class=\"nav__link-label\">Methodologies</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Company\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Company\" class=\"nav__trigger\" data-radix-collection-item=\"\">Company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Company\" aria-labelledby=\"radix-_R_klb_-trigger-Company\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about\"><span class=\"nav__link-label\">About</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about/leadership\"><span class=\"nav__link-label\">Leadership</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/approach\"><span class=\"nav__link-label\">The Adversary Loop</span><span class=\"nav__link-blurb\">How we actually work</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/careers\"><span class=\"nav__link-label\">Careers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/newsroom\"><span class=\"nav__link-label\">Newsroom</span></a></li></ul></div></div></li></ul></div></nav><div class=\"nav__actions\"><a class=\"nav__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"nav\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone nav__hotline-icon\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"nav__hotline-text\"><span class=\"nav__hotline-kicker\">Breach? 24/7</span><span class=\"nav__hotline-number\">+44 20 4525 9100</span></span></a><a class=\"btn btn--primary btn--sm nav__cta\" href=\"/contact\"><span>Start a conversation</span></a><details class=\"nav__mobile\"><summary class=\"nav__burger\" aria-label=\"Navigation menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu nav__burger-open\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x nav__burger-close\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></summary><nav class=\"nav__sheet\" aria-label=\"All pages\"><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Services</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/services/devsecops\">Secure SDLC<span class=\"nav__sheet-blurb\">The page that explains why one firm does both. Start here.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/services/cybersecurity\">Cybersecurity</a></li><li><a class=\"nav__sheet-link\" href=\"/services/software-development\">Software Development</a></li><li><a class=\"nav__sheet-link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"nav__sheet-link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"nav__sheet-link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"nav__sheet-link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"nav__sheet-link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"nav__sheet-link\" href=\"/services/engagement-models\">Engagement Models</a></li><li><a class=\"nav__sheet-link\" href=\"/services\">All <!-- -->services</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Industries</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/industries/financial-services\">Financial Services</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/healthcare\">Healthcare</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/saas\">SaaS &amp; Technology</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/logistics\">Logistics</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/public-sector\">Public Sector</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/retail\">Retail &amp; Payments</a></li><li><a class=\"nav__sheet-link\" href=\"/industries\">All <!-- -->industries</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Proof</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/sample-report\">Anatomy of a report<span class=\"nav__sheet-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"nav__sheet-link\" href=\"/customers\">Customers</a></li><li><a class=\"nav__sheet-link\" href=\"/certifications\">Certifications</a></li><li><a class=\"nav__sheet-link\" href=\"/trust\">Trust Centre</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Resources</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/resources\">All resources</a></li><li><a class=\"nav__sheet-link\" href=\"/blog\">Insights</a></li><li><a class=\"nav__sheet-link\" href=\"/research\">Research &amp; Labs</a></li><li><a class=\"nav__sheet-link\" href=\"/tools\">Open-source tools</a></li><li><a class=\"nav__sheet-link\" href=\"/methodologies\">Methodologies</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Company</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/about\">About</a></li><li><a class=\"nav__sheet-link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"nav__sheet-link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"nav__sheet-link\" href=\"/careers\">Careers</a></li><li><a class=\"nav__sheet-link\" href=\"/newsroom\">Newsroom</a></li></ul></div><div class=\"nav__sheet-cta\"><a class=\"btn btn--primary btn--md btn--full\" href=\"/contact\"><span>Start a conversation</span></a><a class=\"nav__sheet-hotline\" href=\"tel:+442045259100\">Incident response, 24/7 — <!-- -->+44 20 4525 9100</a></div></nav></details></div></div></header><main id=\"main\"><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" style=\"padding-top:calc(var(--nav-h) + var(--s16))\" aria-labelledby=\"sr-title\"><div class=\"u-container\"><p class=\"u-eyebrow\">Anatomy of a report</p><h1 id=\"sr-title\" style=\"font-size:clamp(var(--text-3xl), 5vw, var(--text-5xl));margin-top:var(--s4);max-width:18ch\">See exactly what lands in your inbox</h1><p class=\"u-measure\" style=\"margin-top:var(--s6);font-size:var(--text-lg);color:var(--muted-strong)\">A penetration test is a document and a conversation. You are asked to buy both before seeing either. This is the whole structure of an Envenox report, section by section, with a real finding written out in full — redacted, for a fictional client, and otherwise exactly as it would be delivered.</p><ul class=\"sr-stats\" aria-label=\"What a standard delivery contains\"><li class=\"stat stat--sm\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">6</span></span></p><p class=\"stat__label\">documents in a standard delivery</p></li><li class=\"stat stat--sm\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">2 pages</span></span></p><p class=\"stat__label\">executive summary, written for a board</p></li><li class=\"stat stat--sm\"><p class=\"stat__figure u-tnum\"><span class=\"stat__roll\"><span class=\"stat__value\">30 days</span></span></p><p class=\"stat__label\">retest included, with a per-finding verified status</p></li></ul><aside class=\"sr-disclaimer\" aria-label=\"Disclaimer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3333333333333335\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-alert sr-disclaimer__icon\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"></line><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"></line></svg><p>Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.</p></aside><div class=\"sr-actions\"><a href=\"#section-cover\" class=\"btn btn--primary btn--lg\"><span>Walk the report</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"btn btn--secondary btn--lg\" href=\"/case-studies\"><span>See the work</span></a></div><p class=\"sr-print\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-printer\" aria-hidden=\"true\"><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"></path><path d=\"M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6\"></path><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\" rx=\"1\"></rect></svg>This page is laid out to print.</p></div></section><section class=\"sec theme-deep transition-theme u-section\" data-theme-section=\"deep\" id=\"report-body\" aria-labelledby=\"sr-walk\"><div class=\"u-container\"><p class=\"sr-strip u-mono no-print\" aria-hidden=\"true\">Sample report — illustrative</p><h2 id=\"sr-walk\" class=\"u-eyebrow\" style=\"margin-bottom:var(--s8)\">The report, section by section</h2><div class=\"sr-layout\"><nav class=\"rail\" aria-label=\"Report sections\" id=\"report-index\"><span class=\"rail__stamp u-mono\">Sample report — illustrative</span><p class=\"u-eyebrow rail__key\">Sections</p><ol class=\"rail__list\"><li class=\"rail__item\"><a href=\"#section-cover\" class=\"rail__link\"><span class=\"rail__n u-mono\">01</span><span>Cover and document control<span class=\"rail__pages u-mono\">p. 1</span></span></a></li><li class=\"rail__item\"><a href=\"#section-executive-summary\" class=\"rail__link\"><span class=\"rail__n u-mono\">02</span><span>Executive summary<span class=\"rail__pages u-mono\">pp. 2–3</span></span></a></li><li class=\"rail__item\"><a href=\"#section-scope\" class=\"rail__link\"><span class=\"rail__n u-mono\">03</span><span>Scope, approach and explicit exclusions<span class=\"rail__pages u-mono\">pp. 4–5</span></span></a></li><li class=\"rail__item\"><a href=\"#section-severity\" class=\"rail__link\"><span class=\"rail__n u-mono\">04</span><span>The severity model, with the working shown<span class=\"rail__pages u-mono\">p. 6</span></span></a></li><li class=\"rail__item\"><a href=\"#section-findings-index\" class=\"rail__link\"><span class=\"rail__n u-mono\">05</span><span>Findings index<span class=\"rail__pages u-mono\">p. 7</span></span></a></li><li class=\"rail__item\"><a href=\"#section-finding\" class=\"rail__link\"><span class=\"rail__n u-mono\">06</span><span>A finding, written out in full<span class=\"rail__pages u-mono\">pp. 8–11 (one finding)</span></span></a></li><li class=\"rail__item\"><a href=\"#section-remediation\" class=\"rail__link\"><span class=\"rail__n u-mono\">07</span><span>Remediation guidance and ordering<span class=\"rail__pages u-mono\">pp. 12–13</span></span></a></li><li class=\"rail__item\"><a href=\"#section-retest\" class=\"rail__link\"><span class=\"rail__n u-mono\">08</span><span>Retest report<span class=\"rail__pages u-mono\">reissued report, v1.2</span></span></a></li><li class=\"rail__item\"><a href=\"#section-attestation\" class=\"rail__link\"><span class=\"rail__n u-mono\">09</span><span>Attestation letter<span class=\"rail__pages u-mono\">separate 1-page document</span></span></a></li><li class=\"rail__item\"><a href=\"#section-appendices\" class=\"rail__link\"><span class=\"rail__n u-mono\">10</span><span>Appendices<span class=\"rail__pages u-mono\">pp. 14+</span></span></a></li></ol></nav><div class=\"sr-body\"><article class=\"sr-section\" id=\"section-cover\" data-section-id=\"cover\" aria-labelledby=\"title-cover\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->01<!-- --> · <!-- -->p. 1</p><h3 id=\"title-cover\" class=\"sr-section__title\">Cover and document control</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>Client, engagement reference, test window, report version, classification, the lead tester by name, and the reviewer who signed it.</dd><dt>Why it is in it</dt><dd>Version and classification sound like bureaucracy until a report is three months old and someone is arguing about whether a finding was closed. The named reviewer matters more: it is the commitment that someone other than the author read this before it reached you.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">p. 1</span></div><div class=\"doc__sheet doc__sheet--flush\"><div class=\"doc__scroll\"><div><table class=\"doc__table\"><caption>Cover and document control<!-- --> — sample report, illustrative</caption><tbody><tr><th scope=\"row\">Client</th><td>Meridian Clinical Systems Ltd</td></tr><tr><th scope=\"row\">Engagement</th><td>ENX-2026-0418 — Web application and API penetration test</td></tr><tr><th scope=\"row\">Test window</th><td>2026-04-13 to 2026-04-24 (8 testing days)</td></tr><tr><th scope=\"row\">Environment</th><td>Production, with a staged out-of-hours window for destructive checks</td></tr><tr><th scope=\"row\">Report version</th><td>1.2 — reissued 2026-05-26 with retest status</td></tr><tr><th scope=\"row\">Classification</th><td>Confidential — Meridian and Envenox only</td></tr><tr><th scope=\"row\">Lead tester</th><td>I. Haque (OSCP, CREST CRT)</td></tr><tr><th scope=\"row\">Technical reviewer</th><td>S. Marek (OSWE, CISSP)</td></tr></tbody></table></div></div></div></figure></div></article><article class=\"sr-section\" id=\"section-executive-summary\" data-section-id=\"executive-summary\" aria-labelledby=\"title-executive-summary\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->02<!-- --> · <!-- -->pp. 2–3</p><h3 id=\"title-executive-summary\" class=\"sr-section__title\">Executive summary</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>Two pages. The risk narrative in plain language, the three decisions that need a decision-maker, and a severity distribution. No CVSS vectors, no request/response pairs, no tool names.</dd><dt>Why it is in it</dt><dd>Written for a board, which means it must survive being read by someone who will never open the technical body. The failure mode is an executive summary that is a shortened technical report — it satisfies nobody, because the technical reader skips it and the executive reader cannot act on it.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">pp. 2–3</span></div><div class=\"doc__sheet\"><div class=\"doc__prose\"><p>Two of the eleven findings in this report would allow one Meridian customer to read another customer’s patient records. Neither requires a software vulnerability in the conventional sense; both follow from authorisation being decided in more places than any single engineer can enumerate. We consider this the material finding of the engagement and it is the subject of ENX-0418-01 and ENX-0418-02.</p><p>The remaining nine findings are the ordinary result of a system built at pace and are individually unremarkable. We would not delay a release for any of them.</p><p>Three decisions need an owner. First, whether the reporting view described in ENX-0418-01 is retired or rewritten — rewriting it is roughly a sprint, retiring it affects four customers who use the export. Second, whether the clinician impersonation feature (ENX-0418-04) keeps its current single-approval design, which we think will not survive an Information Commissioner enquiry. Third, whether authorisation consolidation is funded now as a piece of work, or absorbed into feature delivery, which in our experience means it does not happen.</p></div></div></figure></div></article><article class=\"sr-section\" id=\"section-scope\" data-section-id=\"scope\" aria-labelledby=\"title-scope\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->03<!-- --> · <!-- -->pp. 4–5</p><h3 id=\"title-scope\" class=\"sr-section__title\">Scope, approach and explicit exclusions</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>What was tested, from what position, with which roles and credentials, during which window — and an explicit list of what was not tested and why.</dd><dt>Why it is in it</dt><dd>The exclusions are the honest part and they belong in the body, not in an appendix. A report that implies coverage it did not have is worse than a shorter report: it becomes the document someone points at after an incident to argue the area was assessed.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">pp. 4–5</span></div><div class=\"doc__sheet\"><ul class=\"doc__list\"><li><span class=\"doc__tag\">IN SCOPE</span><p class=\"doc__list-body\">app.meridianclinical.io (3 roles: clinician, practice-admin, support), api.meridianclinical.io (REST, 94 endpoints from the OpenAPI document plus 7 found that were not in it), the tenant isolation boundary, and the SSO integration with Entra ID.</p></li><li><span class=\"doc__tag\">NOT TESTED</span><p class=\"doc__list-body\">Denial of service, which proves little and risks much on a clinical system. Social engineering of Meridian staff, which belongs in a red team with different rules of engagement. The mobile application, which is a separate scope. Third-party integrations beyond the authentication boundary. The underlying AWS account configuration, which was reviewed separately under ENX-2026-0402.</p></li><li><span class=\"doc__tag\">DEVIATION</span><p class=\"doc__list-body\">The out-of-hours window on 2026-04-18 was cancelled at Meridian’s request following an unrelated production incident. Two destructive checks on the export pipeline were therefore not performed. This is stated here rather than silently omitted.</p></li></ul></div></figure></div></article><article class=\"sr-section\" id=\"section-severity\" data-section-id=\"severity\" aria-labelledby=\"title-severity\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->04<!-- --> · <!-- -->p. 6</p><h3 id=\"title-severity\" class=\"sr-section__title\">The severity model, with the working shown</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>CVSS v4.0 base score, plus an environmental adjustment, plus the reasoning for the adjustment in one sentence per finding.</dd><dt>Why it is in it</dt><dd>Severity is where most reports lose an argument. A bare &quot;High&quot; invites a client to reclassify it as accepted risk, and a bare CVSS vector invites the opposite — treating a theoretically-high finding as urgent when the exploit path does not exist in this deployment. Showing the adjustment means you can disagree with us precisely rather than generally, and an auditor can see that the number was reasoned rather than assigned.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">p. 6</span></div><div class=\"doc__sheet\"><div class=\"doc__prose\"><p>We adjust base scores up as well as down. ENX-0418-01 has a CVSS v4.0 base of 8.1; we report it as Critical because the affected data is special category health data under UK GDPR Article 9 and the exploit requires only a valid login from any tenant, which in Meridian’s case means any of 1,340 clinician accounts. ENX-0418-07 has a base of 7.5 and we report it as Medium, because the vulnerable endpoint is unreachable from the internet in Meridian’s network topology and requires a foothold the other findings do not provide.</p></div></div></figure></div></article><article class=\"sr-section\" id=\"section-findings-index\" data-section-id=\"findings-index\" aria-labelledby=\"title-findings-index\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->05<!-- --> · <!-- -->p. 7</p><h3 id=\"title-findings-index\" class=\"sr-section__title\">Findings index</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>Every finding on one page: ID, title, severity, affected component, and retest status.</dd><dt>Why it is in it</dt><dd>This is the page that gets photographed and put in a slide. It is also the page a programme manager works from for the next six weeks, so it carries the retest column from version 1.2 onward rather than requiring a second document.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">p. 7</span></div><div class=\"doc__sheet doc__sheet--flush\"><div class=\"doc__scroll\"><div><table class=\"doc__table\"><caption>Findings index<!-- --> — sample report, illustrative</caption><tbody><tr><th scope=\"row\">ENX-0418-01</th><td>Cross-tenant patient record disclosure via reporting view</td><td><span class=\"badge badge--sm badge--severity badge--critical\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>Critical</span></td><td>reporting-api</td><td>Fixed, verified 2026-05-22</td></tr><tr><th scope=\"row\">ENX-0418-02</th><td>Broken object-level authorisation on episode export</td><td><span class=\"badge badge--sm badge--severity badge--critical\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>Critical</span></td><td>export-worker</td><td>Fixed, verified 2026-05-22</td></tr><tr><th scope=\"row\">ENX-0418-03</th><td>Audit log writable by application role</td><td><span class=\"badge badge--sm badge--severity badge--high\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>High</span></td><td>core-api</td><td>Fixed, verified 2026-05-23</td></tr><tr><th scope=\"row\">ENX-0418-04</th><td>Clinician impersonation lacks second-person approval</td><td><span class=\"badge badge--sm badge--severity badge--high\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>High</span></td><td>support-console</td><td>Open — accepted with compensating control, review 2026-11</td></tr><tr><th scope=\"row\">ENX-0418-05</th><td>Session not invalidated on password change</td><td><span class=\"badge badge--sm badge--severity badge--medium\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>Medium</span></td><td>identity</td><td>Fixed, verified 2026-05-22</td></tr><tr><th scope=\"row\">ENX-0418-06</th><td>Undocumented API endpoints outside the OpenAPI contract</td><td><span class=\"badge badge--sm badge--severity badge--medium\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>Medium</span></td><td>api-gateway</td><td>Fixed, verified 2026-05-23</td></tr><tr><th scope=\"row\">ENX-0418-07</th><td>Deserialisation of untrusted data in legacy import</td><td><span class=\"badge badge--sm badge--severity badge--medium\"><span class=\"badge__dot\" aria-hidden=\"true\"></span>Medium</span></td><td>import-legacy</td><td>Open — scheduled, sprint 2026-24</td></tr></tbody></table></div></div></div></figure></div></article><article class=\"sr-section\" id=\"section-finding\" data-section-id=\"finding\" data-feature=\"true\" aria-labelledby=\"title-finding\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->06<!-- --> · <!-- -->pp. 8–11 (one finding)</p><h3 id=\"title-finding\" class=\"sr-section__title\">A finding, written out in full</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>Summary, affected component, CVSS vector and adjustment, prerequisites, reproduction path, raw request and response evidence, impact in the client’s own terms, and a remediation written for the person who owns the code.</dd><dt>Why it is in it</dt><dd>This is the unit of the report and it is where a test is won or lost. The remediation section is the one we are judged on: it must be a change we would accept in code review, not a recommendation the client has to translate. &quot;Implement proper authorisation checks&quot; is not remediation.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">pp. 8–11 (one finding)</span></div><div class=\"doc__sheet doc__sheet--flush\"><div class=\"doc__scroll\"><pre class=\"doc__pre u-mono\" tabindex=\"0\" role=\"region\" aria-label=\"A finding, written out in full — report excerpt, horizontally scrollable\">ENX-0418-01  Cross-tenant patient record disclosure via reporting view\nSeverity    Critical (CVSS v4.0 base 8.1, adjusted up — see §4)\nComponent   reporting-api @ 4f2a9c1 · view public.v_episode_summary\nPrereq      Any authenticated clinician or practice-admin account, any tenant\n\nREPRODUCTION\n1. Authenticate as clinician@tenant-a.example and capture the session cookie.\n2. GET /reporting/v2/episode-summary?from=2026-01-01&amp;to=2026-04-01\n3. Observe 2,847 rows returned. 2,106 belong to tenant-b and tenant-c.\n\nROOT CAUSE\nThe view public.v_episode_summary joins episode and patient without a tenant\npredicate. The predicate lives in the single caller added alongside the view in\n2021 (reporting-api/src/queries/exportEpisodes.ts:88). A second caller added in\n2023 (reporting-api/src/routes/episodeSummary.ts:41) queries the same view with\nno predicate and has been in production for 19 months.\n\nREMEDIATION  — in priority order\n1. Immediate: add the tenant predicate at episodeSummary.ts:41. One line, deploys\n   today, closes the exposure.\n2. Structural: move the predicate into the view itself as a security barrier view,\n   or replace it with a table-valued function taking tenant_id as a required\n   argument. The second caller was able to be written because the view permitted\n   it — a fix at the call site leaves the next caller able to make the same mistake.\n3. Preventive: enable row-level security on episode and patient with a policy keyed\n   on the session tenant. This is the change that makes the bug class unwriteable,\n   and it is the one we would push for. Expect roughly a sprint, mostly in testing.</pre></div><div class=\"doc__refusal\"><span class=\"doc__refusal-key u-mono\">WHAT WE WOULD NOT DO</span><p class=\"doc__refusal-body\">Adding a tenant check in the reporting-api middleware. It looks like a fix, it passes a retest, and it leaves the view exploitable from the export worker, which does not pass through that middleware.</p></div></div></figure></div></article><article class=\"sr-section\" id=\"section-remediation\" data-section-id=\"remediation\" aria-labelledby=\"title-remediation\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->07<!-- --> · <!-- -->pp. 12–13</p><h3 id=\"title-remediation\" class=\"sr-section__title\">Remediation guidance and ordering</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>The findings grouped by root cause rather than by severity, with a suggested order and a rough effort estimate per group.</dd><dt>Why it is in it</dt><dd>Eleven findings ranked by severity gives you eleven tickets. The same eleven grouped by cause often gives you four pieces of work, and the order matters because fixing the structural cause closes findings that have not been found yet. This section is why a programme beats a sequence of tests.</dd></dl><div class=\"sr-frame\"><figure class=\"doc theme-light transition-theme\"><div class=\"doc__chrome\"><span class=\"doc__stamp u-mono\">Sample report — illustrative</span><span class=\"doc__pages u-mono\">pp. 12–13</span></div><div class=\"doc__sheet\"><div class=\"doc__prose\"><p>Findings 01, 02 and 06 are one problem: authorisation is decided at the call site, so each new caller is a new opportunity. Findings 03 and 05 are a second: state changes that should be irreversible or invalidating are implemented as ordinary writes. Finding 04 is a design decision, not a defect, and needs a decision-maker rather than an engineer. Finding 07 is isolated and genuinely just needs fixing.</p></div></div></figure></div></article><article class=\"sr-section\" id=\"section-retest\" data-section-id=\"retest\" aria-labelledby=\"title-retest\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->08<!-- --> · <!-- -->reissued report, v1.2</p><h3 id=\"title-retest\" class=\"sr-section__title\">Retest report</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>Every finding retested within 30 days, with a verified status per finding. Anything still open is reopened with fresh evidence, not with the original screenshot.</dd><dt>Why it is in it</dt><dd>A report without a retest ages into a document about the past. Reissuing the same report with a status column — rather than sending a separate retest letter — means there is one current document, which is what an auditor, a customer and your own team all need.</dd></dl></article><article class=\"sr-section\" id=\"section-attestation\" data-section-id=\"attestation\" aria-labelledby=\"title-attestation\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->09<!-- --> · <!-- -->separate 1-page document</p><h3 id=\"title-attestation\" class=\"sr-section__title\">Attestation letter</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>A one-page signed letter stating that the engagement took place, over what window, against what scope, by a named accredited firm — with no finding detail.</dd><dt>Why it is in it</dt><dd>This is the document you send to a customer, an auditor or an insurer. It exists so you are not forced to choose between redacting a technical report by hand and disclosing more than you want to.</dd></dl></article><article class=\"sr-section\" id=\"section-appendices\" data-section-id=\"appendices\" aria-labelledby=\"title-appendices\"><header class=\"sr-section__head\"><p class=\"sr-section__n u-mono u-tnum\">Section <!-- -->10<!-- --> · <!-- -->pp. 14+</p><h3 id=\"title-appendices\" class=\"sr-section__title\">Appendices</h3></header><dl class=\"sr-qa\"><dt>What is in it</dt><dd>Methodology and standards mapping (OWASP ASVS 4.0, WSTG, PTES), the tool inventory, and — on request — the raw tooling output, clearly labelled as unverified.</dd><dt>Why it is in it</dt><dd>Raw scanner output belongs in an appendix and nowhere else. Mixing confirmed findings with unverified tool noise in the body is how a severity model loses its meaning, and it is the single clearest tell that a report is a lightly edited scanner export.</dd></dl></article><div class=\"sr-foot\"><p>Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.</p></div></div></div></div></section><section class=\"sec theme-dark transition-theme u-section\" data-theme-section=\"dark\" aria-labelledby=\"sr-faq\"><div class=\"u-container\"><h2 id=\"sr-faq\" style=\"font-size:var(--text-2xl);margin-bottom:var(--s8)\">Common questions</h2><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is this a real report?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The structure, severity model, remediation format and tone are exactly what you receive. The client, the hostnames and the findings are fictional, written for this page so we could show a full finding without redacting it into uselessness. Every page of this walkthrough is labelled illustrative.\"}},{\"@type\":\"Question\",\"name\":\"How long is a real report?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For an eight-day web and API test, typically 30 to 45 pages including appendices. Length is a function of finding count, not of effort — a clean test produces a short report and that is a good outcome, not a shortfall. We do not pad.\"}},{\"@type\":\"Question\",\"name\":\"Can we get it in a format other than PDF?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The findings register ships as CSV and JSON keyed for direct import into Jira, Linear or ServiceNow, so nobody retypes a finding. Some clients take only the register and the executive summary and never open the PDF, which is a perfectly reasonable way to work.\"}},{\"@type\":\"Question\",\"name\":\"Who writes it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The tester who found the issues, reviewed and signed by a second senior tester who did not work the engagement. Not a technical author, and not an account manager. The debrief call is with the same person, which is why they write it knowing they will have to defend it.\"}},{\"@type\":\"Question\",\"name\":\"What if we disagree with a severity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Argue it at the debrief. We show the environmental adjustment and the reasoning precisely so the disagreement can be specific. We change severities when the argument is good and we record that we did, with the reason — a severity quietly lowered after a client objection is worse than no severity model at all.\"}},{\"@type\":\"Question\",\"name\":\"Will you help us fix the findings?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We will tell you exactly what to change, and our engineering practice can do the work as a separate engagement. What we will not do is have the same person fix and then retest their own work, because that retest means nothing.\"}}]}</script><div class=\"\"><div class=\"faq faq__accordion\" data-orientation=\"vertical\"><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_9fb5fiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_1fb5fiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>Is this a real report?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_9fb5fiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_1fb5fiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_afb5fiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_2fb5fiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>How long is a real report?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_afb5fiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_2fb5fiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_bfb5fiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_3fb5fiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>Can we get it in a format other than PDF?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_bfb5fiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_3fb5fiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_cfb5fiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_4fb5fiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>Who writes it?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_cfb5fiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_4fb5fiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_dfb5fiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_5fb5fiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>What if we disagree with a severity?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_dfb5fiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_5fb5fiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div><div data-state=\"closed\" data-orientation=\"vertical\" class=\"faq__item\"><h3 class=\"faq__header\" data-orientation=\"vertical\" data-state=\"closed\"><button type=\"button\" aria-controls=\"radix-_R_efb5fiutb_\" aria-expanded=\"false\" data-state=\"closed\" data-orientation=\"vertical\" id=\"radix-_R_6fb5fiutb_\" class=\"faq__trigger\" data-radix-collection-item=\"\"><span>Will you help us fix the findings?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down faq__chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></h3><div data-state=\"closed\" id=\"radix-_R_efb5fiutb_\" hidden=\"\" role=\"region\" aria-labelledby=\"radix-_R_6fb5fiutb_\" data-orientation=\"vertical\" class=\"acc-content faq__content\" style=\"--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)\"></div></div></div><dl class=\"faq__nojs\"><div><dt>Is this a real report?</dt><dd>The structure, severity model, remediation format and tone are exactly what you receive. The client, the hostnames and the findings are fictional, written for this page so we could show a full finding without redacting it into uselessness. Every page of this walkthrough is labelled illustrative.</dd></div><div><dt>How long is a real report?</dt><dd>For an eight-day web and API test, typically 30 to 45 pages including appendices. Length is a function of finding count, not of effort — a clean test produces a short report and that is a good outcome, not a shortfall. We do not pad.</dd></div><div><dt>Can we get it in a format other than PDF?</dt><dd>Yes. The findings register ships as CSV and JSON keyed for direct import into Jira, Linear or ServiceNow, so nobody retypes a finding. Some clients take only the register and the executive summary and never open the PDF, which is a perfectly reasonable way to work.</dd></div><div><dt>Who writes it?</dt><dd>The tester who found the issues, reviewed and signed by a second senior tester who did not work the engagement. Not a technical author, and not an account manager. The debrief call is with the same person, which is why they write it knowing they will have to defend it.</dd></div><div><dt>What if we disagree with a severity?</dt><dd>Argue it at the debrief. We show the environmental adjustment and the reasoning precisely so the disagreement can be specific. We change severities when the argument is good and we record that we did, with the reason — a severity quietly lowered after a client objection is worse than no severity model at all.</dd></div><div><dt>Will you help us fix the findings?</dt><dd>We will tell you exactly what to change, and our engineering practice can do the work as a separate engagement. What we will not do is have the same person fix and then retest their own work, because that retest means nothing.</dd></div></dl></div><p style=\"margin-top:var(--s8);font-size:var(--text-sm)\"><a class=\"u-link\" href=\"/services/penetration-testing\">How a penetration test is scoped and run</a> · <a class=\"u-link\" href=\"/trust\">What we do with your evidence afterwards</a></p></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"sr-cta\"><div class=\"u-container\"><div class=\"humans\"><div><p class=\"u-eyebrow\">Get started</p><h2 id=\"sr-cta\" style=\"font-size:var(--text-3xl);margin:var(--s3) 0 0\">Book a 60-minute scoping call</h2><p style=\"color:var(--muted-strong);max-width:52ch;margin-top:var(--s4)\">A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.</p><div class=\"humans__actions\"><a class=\"btn btn--primary btn--lg\" href=\"/contact\"><span>Start a conversation</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></div><p class=\"humans__sla\">A named engineer replies within one business day. Scoping call within three.</p></div><ul class=\"humans__people\" aria-label=\"Who replies to a new enquiry\"><li class=\"human\"><div role=\"img\" aria-label=\"Placeholder portrait for Claire Benoit\" class=\"avatar-ph\" style=\"width:48px;height:48px;font-size:16px;background-image:linear-gradient(135deg, hsl(153 18% 22%), hsl(153 22% 14%))\"><span aria-hidden=\"true\">CB</span></div><div><p class=\"human__name\">Claire Benoit</p><p class=\"human__role\">Practice Director, Governance &amp; Risk</p></div></li><li class=\"human\"><div role=\"img\" aria-label=\"Placeholder portrait for Marcus Reid\" class=\"avatar-ph\" style=\"width:48px;height:48px;font-size:16px;background-image:linear-gradient(135deg, hsl(319 18% 22%), hsl(319 22% 14%))\"><span aria-hidden=\"true\">MR</span></div><div><p class=\"human__name\">Marcus Reid</p><p class=\"human__role\">Head of Engineering</p></div></li><li class=\"human\"><div role=\"img\" aria-label=\"Placeholder portrait for Amara Nwosu\" class=\"avatar-ph\" style=\"width:48px;height:48px;font-size:16px;background-image:linear-gradient(135deg, hsl(334 18% 22%), hsl(334 22% 14%))\"><span aria-hidden=\"true\">AN</span></div><div><p class=\"human__name\">Amara Nwosu</p><p class=\"human__role\">Chief Operating Officer</p></div></li></ul></div></div></section><!--$--><!--/$--></main><footer class=\"foot theme-dark transition-theme grain\" data-theme-section=\"dark\"><div class=\"u-container\"><div class=\"foot__top\"><div class=\"foot__brand\"><a class=\"foot__wordmark\" href=\"/\">Envenox</a><p class=\"foot__positioning\">Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.</p><a class=\"foot__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"footer\"><span class=\"foot__hotline-row\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"u-eyebrow\">Incident response — 24/7</span></span><span class=\"foot__hotline-number\">+44 20 4525 9100</span><span class=\"foot__hotline-note\">Answered by a responder, 24/7. Median pickup under 4 minutes.</span></a></div><nav class=\"foot__cols\" aria-label=\"Footer\"><div><h2 class=\"foot__col-heading\">Cybersecurity</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"foot__link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"foot__link\" href=\"/services/cloud-security\">Cloud Security</a></li><li><a class=\"foot__link\" href=\"/services/red-teaming\">Red Teaming</a></li><li><a class=\"foot__link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"foot__link\" href=\"/services/incident-response\">Incident Response</a></li><li><a class=\"foot__link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"foot__link\" href=\"/services/vciso\">vCISO</a></li></ul></div><div><h2 class=\"foot__col-heading\">Software Development</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"foot__link\" href=\"/services/web-application-development\">Web Applications</a></li><li><a class=\"foot__link\" href=\"/services/platform-engineering\">Platform &amp; DevOps</a></li><li><a class=\"foot__link\" href=\"/services/erp\">ERP</a></li><li><a class=\"foot__link\" href=\"/services/crm\">CRM</a></li><li><a class=\"foot__link\" href=\"/services/hrm\">HRM</a></li><li><a class=\"foot__link\" href=\"/services/lms\">LMS</a></li><li><a class=\"foot__link\" href=\"/services/qa-automation\">QA &amp; Test Automation</a></li></ul></div><div><h2 class=\"foot__col-heading\">Company</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/about\">About</a></li><li><a class=\"foot__link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"foot__link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"foot__link\" href=\"/careers\">Careers</a></li><li><a class=\"foot__link\" href=\"/newsroom\">Newsroom</a></li><li><a class=\"foot__link\" href=\"/locations\">Locations</a></li><li><a class=\"foot__link\" href=\"/partners\">Partners</a></li></ul></div><div><h2 class=\"foot__col-heading\">Proof &amp; Resources</h2><ul class=\"foot__list\"><li><a class=\"foot__link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"foot__link\" href=\"/sample-report\">Sample Report</a></li><li><a class=\"foot__link\" href=\"/customers\">Customers</a></li><li><a class=\"foot__link\" href=\"/certifications\">Certifications</a></li><li><a class=\"foot__link\" href=\"/trust\">Trust Centre</a></li><li><a class=\"foot__link\" href=\"/blog\">Insights</a></li><li><a class=\"foot__link\" href=\"/research\">Research &amp; Labs</a></li></ul></div></nav></div><div class=\"foot__mid\"><div><h2 class=\"foot__col-heading\">Offices</h2><div class=\"foot__offices\"><div><p class=\"foot__office-city\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap