or a metric trio that sits in a narrow column beside the\\n   headline rather than in a full-width row under it. */\\n.metrics--stack { gap: var(--s4); }\\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\\n/* The key runs inline with its note in the stacked variant — one line saved per\\n   metric is what keeps all three on the first screen. */\\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\\n.metrics--stack .metric__note-key::after { content: ' — '; }\\n.metric {\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s2);\\n  min-width: 0;\\n  border-top: 1px solid var(--border-strong);\\n  padding-top: var(--s4);\\n}\\n.metric__value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  line-height: 1.05;\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n@media (min-width: 768px) {\\n  .metric__value { font-size: var(--text-3xl); }\\n}\\n.metric__label {\\n  margin: 0;\\n  color: var(--muted-strong);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n  max-width: 34ch;\\n}\\n.metric__note {\\n  margin: var(--s2) 0 0;\\n  padding-top: var(--s2);\\n  border-top: 1px solid var(--border);\\n  font-size: var(--text-xs);\\n  line-height: 1.5;\\n  color: var(--muted);\\n  max-width: 36ch;\\n}\\n.metric__note-key {\\n  display: block;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n  margin-bottom: 2px;\\n}\\n\\n/* ---------------- NDA block ---------------- */\\n.nda {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: var(--s3);\\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\\n  border-radius: var(--radius-md);\\n  padding: var(--s3) var(--s4);\\n}\\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.nda__kicker {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.nda__name {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n}\\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\\n\\n/* ---------------- dual-pillar marker ---------------- */\\n.dual {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-md);\\n  padding: var(--s2) var(--s3);\\n  color: var(--fg);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\\n.dual__icon { color: var(--accent); flex: none; }\\n\\n/* ---------------- case study card ---------------- */\\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\\n.cs-card__client {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n}\\n.cs-card__headline {\\n  margin: 0;\\n  font-size: var(--text-lg);\\n  font-weight: 500;\\n  line-height: var(--leading-snug);\\n  color: var(--fg);\\n}\\n.cs-card__headline a { color: inherit; text-decoration: none; }\\n.cs-card__meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s2) var(--s4);\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  margin: 0;\\n}\\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-card__metric {\\n  margin-top: auto;\\n  padding-top: var(--s4);\\n  border-top: 1px solid var(--border);\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s1);\\n}\\n.cs-card__metric-value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-xl);\\n  font-weight: 600;\\n  letter-spacing: var(--tracking-tight);\\n  line-height: 1.1;\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\\n\\n/* ---------------- testimonial rail ---------------- */\\n.trail {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\\n  gap: var(--s4);\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  scroll-snap-type: x mandatory;\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 var(--s4);\\n  scrollbar-width: thin;\\n}\\n@media (min-width: 768px) {\\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\\n}\\n.trail \\u003e li { scroll-snap-align: start; min-width: 0; }\\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.trail__quote {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-base);\\n  line-height: var(--leading-normal);\\n}\\n@media (min-width: 768px) {\\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\\n}\\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\\n\\n/* ---------------- named-humans CTA ---------------- */\\n.humans { display: grid; gap: var(--s8); }\\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\\n.human { display: flex; align-items: center; gap: var(--s4); }\\n.human__name {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-base);\\n  font-weight: 500;\\n  color: var(--fg);\\n}\\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\\n\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-proof-surfaces\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$24\\\"}]\\n25:T14ac,\"])</script><script>self.__next_f.push([1,\"\\n.doc {\\n  margin: 0;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--bg);\\n  color: var(--fg);\\n  overflow: hidden;\\n}\\n\\n.doc__chrome {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: var(--s2) var(--s4);\\n  padding: var(--s3) var(--s4);\\n  border-bottom: 1px solid var(--border);\\n  background-color: var(--surface);\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n.doc__stamp { display: inline-flex; align-items: center; gap: var(--s2); color: var(--muted); }\\n.doc__stamp::before {\\n  content: '';\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--accent);\\n  flex: none;\\n}\\n.doc__pages { color: var(--muted); white-space: nowrap; }\\n\\n.doc__sheet { padding: var(--s6) var(--s4); }\\n@media (min-width: 768px) { .doc__sheet { padding: var(--s8); } }\\n/* Code and table excerpts run to the frame edge so the masked scroll edges sit\\n   on the frame itself; their inner padding is restored below. */\\n.doc__sheet--flush { padding-inline: 0; }\\n\\n/* ---------------- prose ---------------- */\\n.doc__prose { max-width: 66ch; }\\n.doc__prose p {\\n  margin: 0;\\n  font-size: var(--text-sm);\\n  line-height: 1.7;\\n  color: var(--fg);\\n}\\n@media (min-width: 768px) { .doc__prose p { font-size: var(--text-base); } }\\n.doc__prose p + p { margin-top: var(--s4); }\\n\\n/* ---------------- table ---------------- */\\n.doc__scroll {\\n  position: relative;\\n  /* Masked edges signal that the content continues past the frame. */\\n  mask-image: linear-gradient(90deg, transparent 0, #000 var(--s4), #000 calc(100% - var(--s4)), transparent 100%);\\n  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--s4), #000 calc(100% - var(--s4)), transparent 100%);\\n}\\n.doc__scroll \\u003e * {\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  padding-inline: var(--s4);\\n}\\n@media (min-width: 768px) { .doc__scroll \\u003e * { padding-inline: var(--s8); } }\\n.doc__table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  font-size: var(--text-sm);\\n  font-variant-numeric: tabular-nums;\\n  text-align: left;\\n}\\n.doc__table caption {\\n  caption-side: top;\\n  text-align: left;\\n  padding-bottom: var(--s3);\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n.doc__table th,\\n.doc__table td {\\n  padding: var(--s3) var(--s4) var(--s3) 0;\\n  border-bottom: 1px solid var(--border);\\n  vertical-align: top;\\n  line-height: 1.5;\\n}\\n.doc__table tr:last-child th,\\n.doc__table tr:last-child td { border-bottom: 0; }\\n.doc__table th[scope='row'] {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n  white-space: nowrap;\\n  padding-right: var(--s6);\\n}\\n.doc__table td { color: var(--fg); }\\n\\n/* ---------------- code ---------------- */\\n.doc__pre {\\n  margin: 0;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-variant-ligatures: none;\\n  font-size: var(--text-xs);\\n  line-height: 1.65;\\n  color: var(--fg);\\n  white-space: pre;\\n  tab-size: 2;\\n}\\n@media (min-width: 900px) { .doc__pre { font-size: var(--text-sm); } }\\n.doc__pre:focus-visible { outline-offset: -2px; }\\n\\n/* ---------------- the refusal block ---------------- */\\n.doc__refusal {\\n  margin: var(--s6) var(--s4) 0;\\n  max-width: 72ch;\\n  border: 1px solid var(--border-strong);\\n  border-left: 3px solid var(--accent);\\n  border-radius: var(--radius-sm);\\n  background-color: var(--surface);\\n  padding: var(--s4);\\n}\\n.doc__refusal-key {\\n  display: block;\\n  font-size: var(--text-xs);\\n  font-weight: 600;\\n  letter-spacing: 0.12em;\\n  color: var(--accent);\\n  margin-bottom: var(--s3);\\n}\\n.doc__refusal-body {\\n  margin: 0;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-variant-ligatures: none;\\n  font-size: var(--text-xs);\\n  line-height: 1.7;\\n  color: var(--fg);\\n  max-width: 68ch;\\n}\\n@media (min-width: 900px) { .doc__refusal-body { font-size: var(--text-sm); } }\\n@media (min-width: 768px) {\\n  .doc__refusal { margin-inline: var(--s8); }\\n}\\n\\n/* ---------------- list ---------------- */\\n.doc__list { list-style: none; margin: 0; padding: 0; max-width: 72ch; }\\n.doc__list \\u003e li { border-top: 1px solid var(--border); padding-block: var(--s4); }\\n.doc__list \\u003e li:first-child { border-top: 0; padding-top: 0; }\\n.doc__list \\u003e li:last-child { padding-bottom: 0; }\\n.doc__tag {\\n  display: inline-flex;\\n  align-items: center;\\n  width: fit-content;\\n  margin-bottom: var(--s2);\\n  padding: 2px var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-sm);\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.06em;\\n  color: var(--muted-strong);\\n  text-transform: none;\\n}\\n.doc__list-body { margin: 0; font-size: var(--text-sm); line-height: 1.65; color: var(--fg); }\\n\\n/* ---------------- print ---------------- */\\n@media print {\\n  .doc { break-inside: avoid; border-color: currentColor; }\\n  .doc__scroll { mask-image: none; -webkit-mask-image: none; }\\n  .doc__scroll \\u003e * { overflow: visible; }\\n  .doc__pre { white-space: pre-wrap; }\\n}\\n\"])</script><script>self.__next_f.push([1,\"14:[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-doc-frame\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$25\\\"}]\\n27:Tdb3,\"])</script><script>self.__next_f.push([1,\"\\n.btn {\\n  --btn-bg: transparent;\\n  --btn-bg-hover: transparent;\\n  --btn-fg: var(--fg);\\n  --btn-border: transparent;\\n  --btn-border-hover: transparent;\\n\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--btn-border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--btn-bg);\\n  color: var(--btn-fg);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 500;\\n  letter-spacing: -0.01em;\\n  line-height: 1;\\n  text-align: center;\\n  text-decoration: none;\\n  cursor: pointer;\\n  /* ONLY colour transitions. A transform here would break the house rule. */\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.btn:hover {\\n  background-color: var(--btn-bg-hover);\\n  border-color: var(--btn-border-hover);\\n  /* Falls back to the resting label colour, so no existing variant changes.\\n     A variant whose hover fill moves far in lightness needs to move its label\\n     too, or the hover state quietly fails contrast while the resting state\\n     passes — which is the kind of thing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"15:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":{\\\"paddingTop\\\":\\\"calc(var(--nav-h) + var(--s16))\\\"},\\\"aria-labelledby\\\":\\\"sr-title\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"Anatomy of a report\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"id\\\":\\\"sr-title\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"clamp(var(--text-3xl), 5vw, var(--text-5xl))\\\",\\\"marginTop\\\":\\\"var(--s4)\\\",\\\"maxWidth\\\":\\\"18ch\\\"},\\\"children\\\":\\\"See exactly what lands in your inbox\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-measure\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s6)\\\",\\\"fontSize\\\":\\\"var(--text-lg)\\\",\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"A penetration test is a document and a conversation. You are asked to buy both before seeing either. This is the whole structure of an Envenox report, section by section, with a real finding written out in full — redacted, for a fictional client, and otherwise exactly as it would be delivered.\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"sr-stats\\\",\\\"aria-label\\\":\\\"What a standard delivery contains\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L26\\\",\\\"documents in a standard delivery\\\",{\\\"as\\\":\\\"li\\\",\\\"value\\\":\\\"6\\\",\\\"label\\\":\\\"documents in a standard delivery\\\",\\\"size\\\":\\\"sm\\\",\\\"provenance\\\":\\\"none\\\"}],[\\\"$\\\",\\\"$L26\\\",\\\"executive summary, written for a board\\\",{\\\"as\\\":\\\"li\\\",\\\"value\\\":\\\"2 pages\\\",\\\"label\\\":\\\"executive summary, written for a board\\\",\\\"size\\\":\\\"sm\\\",\\\"provenance\\\":\\\"none\\\"}],[\\\"$\\\",\\\"$L26\\\",\\\"retest included, with a per-finding verified status\\\",{\\\"as\\\":\\\"li\\\",\\\"value\\\":\\\"30 days\\\",\\\"label\\\":\\\"retest included, with a per-finding verified status\\\",\\\"size\\\":\\\"sm\\\",\\\"provenance\\\":\\\"none\\\"}]]}],[\\\"$\\\",\\\"aside\\\",null,{\\\"className\\\":\\\"sr-disclaimer\\\",\\\"aria-label\\\":\\\"Disclaimer\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":18,\\\"height\\\":18,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2.3333333333333335,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-circle-alert sr-disclaimer__icon\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],[\\\"$\\\",\\\"line\\\",\\\"1pkeuh\\\",{\\\"x1\\\":\\\"12\\\",\\\"x2\\\":\\\"12\\\",\\\"y1\\\":\\\"8\\\",\\\"y2\\\":\\\"12\\\"}],[\\\"$\\\",\\\"line\\\",\\\"4dfq90\\\",{\\\"x1\\\":\\\"12\\\",\\\"x2\\\":\\\"12.01\\\",\\\"y1\\\":\\\"16\\\",\\\"y2\\\":\\\"16\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sr-actions\\\",\\\"children\\\":[[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$27\\\"}],\\\"$L28\\\"],\\\"$L29\\\"]}],\\\"$L2a\\\"]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"2c:T14ac,\"])</script><script>self.__next_f.push([1,\"\\n.doc {\\n  margin: 0;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--bg);\\n  color: var(--fg);\\n  overflow: hidden;\\n}\\n\\n.doc__chrome {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: var(--s2) var(--s4);\\n  padding: var(--s3) var(--s4);\\n  border-bottom: 1px solid var(--border);\\n  background-color: var(--surface);\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n.doc__stamp { display: inline-flex; align-items: center; gap: var(--s2); color: var(--muted); }\\n.doc__stamp::before {\\n  content: '';\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--accent);\\n  flex: none;\\n}\\n.doc__pages { color: var(--muted); white-space: nowrap; }\\n\\n.doc__sheet { padding: var(--s6) var(--s4); }\\n@media (min-width: 768px) { .doc__sheet { padding: var(--s8); } }\\n/* Code and table excerpts run to the frame edge so the masked scroll edges sit\\n   on the frame itself; their inner padding is restored below. */\\n.doc__sheet--flush { padding-inline: 0; }\\n\\n/* ---------------- prose ---------------- */\\n.doc__prose { max-width: 66ch; }\\n.doc__prose p {\\n  margin: 0;\\n  font-size: var(--text-sm);\\n  line-height: 1.7;\\n  color: var(--fg);\\n}\\n@media (min-width: 768px) { .doc__prose p { font-size: var(--text-base); } }\\n.doc__prose p + p { margin-top: var(--s4); }\\n\\n/* ---------------- table ---------------- */\\n.doc__scroll {\\n  position: relative;\\n  /* Masked edges signal that the content continues past the frame. */\\n  mask-image: linear-gradient(90deg, transparent 0, #000 var(--s4), #000 calc(100% - var(--s4)), transparent 100%);\\n  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--s4), #000 calc(100% - var(--s4)), transparent 100%);\\n}\\n.doc__scroll \\u003e * {\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  padding-inline: var(--s4);\\n}\\n@media (min-width: 768px) { .doc__scroll \\u003e * { padding-inline: var(--s8); } }\\n.doc__table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  font-size: var(--text-sm);\\n  font-variant-numeric: tabular-nums;\\n  text-align: left;\\n}\\n.doc__table caption {\\n  caption-side: top;\\n  text-align: left;\\n  padding-bottom: var(--s3);\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n.doc__table th,\\n.doc__table td {\\n  padding: var(--s3) var(--s4) var(--s3) 0;\\n  border-bottom: 1px solid var(--border);\\n  vertical-align: top;\\n  line-height: 1.5;\\n}\\n.doc__table tr:last-child th,\\n.doc__table tr:last-child td { border-bottom: 0; }\\n.doc__table th[scope='row'] {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n  white-space: nowrap;\\n  padding-right: var(--s6);\\n}\\n.doc__table td { color: var(--fg); }\\n\\n/* ---------------- code ---------------- */\\n.doc__pre {\\n  margin: 0;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-variant-ligatures: none;\\n  font-size: var(--text-xs);\\n  line-height: 1.65;\\n  color: var(--fg);\\n  white-space: pre;\\n  tab-size: 2;\\n}\\n@media (min-width: 900px) { .doc__pre { font-size: var(--text-sm); } }\\n.doc__pre:focus-visible { outline-offset: -2px; }\\n\\n/* ---------------- the refusal block ---------------- */\\n.doc__refusal {\\n  margin: var(--s6) var(--s4) 0;\\n  max-width: 72ch;\\n  border: 1px solid var(--border-strong);\\n  border-left: 3px solid var(--accent);\\n  border-radius: var(--radius-sm);\\n  background-color: var(--surface);\\n  padding: var(--s4);\\n}\\n.doc__refusal-key {\\n  display: block;\\n  font-size: var(--text-xs);\\n  font-weight: 600;\\n  letter-spacing: 0.12em;\\n  color: var(--accent);\\n  margin-bottom: var(--s3);\\n}\\n.doc__refusal-body {\\n  margin: 0;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-variant-ligatures: none;\\n  font-size: var(--text-xs);\\n  line-height: 1.7;\\n  color: var(--fg);\\n  max-width: 68ch;\\n}\\n@media (min-width: 900px) { .doc__refusal-body { font-size: var(--text-sm); } }\\n@media (min-width: 768px) {\\n  .doc__refusal { margin-inline: var(--s8); }\\n}\\n\\n/* ---------------- list ---------------- */\\n.doc__list { list-style: none; margin: 0; padding: 0; max-width: 72ch; }\\n.doc__list \\u003e li { border-top: 1px solid var(--border); padding-block: var(--s4); }\\n.doc__list \\u003e li:first-child { border-top: 0; padding-top: 0; }\\n.doc__list \\u003e li:last-child { padding-bottom: 0; }\\n.doc__tag {\\n  display: inline-flex;\\n  align-items: center;\\n  width: fit-content;\\n  margin-bottom: var(--s2);\\n  padding: 2px var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-sm);\\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.06em;\\n  color: var(--muted-strong);\\n  text-transform: none;\\n}\\n.doc__list-body { margin: 0; font-size: var(--text-sm); line-height: 1.65; color: var(--fg); }\\n\\n/* ---------------- print ---------------- */\\n@media print {\\n  .doc { break-inside: avoid; border-color: currentColor; }\\n  .doc__scroll { mask-image: none; -webkit-mask-image: none; }\\n  .doc__scroll \\u003e * { overflow: visible; }\\n  .doc__pre { white-space: pre-wrap; }\\n}\\n\"])</script><script>self.__next_f.push([1,\"16:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"id\\\":\\\"report-body\\\",\\\"aria-labelledby\\\":\\\"sr-walk\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sr-strip u-mono no-print\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"Sample report — illustrative\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"sr-walk\\\",\\\"className\\\":\\\"u-eyebrow\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s8)\\\"},\\\"children\\\":\\\"The report, section by section\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sr-layout\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L2b\\\",null,{\\\"entries\\\":[{\\\"n\\\":1,\\\"id\\\":\\\"cover\\\",\\\"title\\\":\\\"Cover and document control\\\",\\\"pages\\\":\\\"p. 1\\\"},{\\\"n\\\":2,\\\"id\\\":\\\"executive-summary\\\",\\\"title\\\":\\\"Executive summary\\\",\\\"pages\\\":\\\"pp. 2–3\\\"},{\\\"n\\\":3,\\\"id\\\":\\\"scope\\\",\\\"title\\\":\\\"Scope, approach and explicit exclusions\\\",\\\"pages\\\":\\\"pp. 4–5\\\"},{\\\"n\\\":4,\\\"id\\\":\\\"severity\\\",\\\"title\\\":\\\"The severity model, with the working shown\\\",\\\"pages\\\":\\\"p. 6\\\"},{\\\"n\\\":5,\\\"id\\\":\\\"findings-index\\\",\\\"title\\\":\\\"Findings index\\\",\\\"pages\\\":\\\"p. 7\\\"},{\\\"n\\\":6,\\\"id\\\":\\\"finding\\\",\\\"title\\\":\\\"A finding, written out in full\\\",\\\"pages\\\":\\\"pp. 8–11 (one finding)\\\"},{\\\"n\\\":7,\\\"id\\\":\\\"remediation\\\",\\\"title\\\":\\\"Remediation guidance and ordering\\\",\\\"pages\\\":\\\"pp. 12–13\\\"},{\\\"n\\\":8,\\\"id\\\":\\\"retest\\\",\\\"title\\\":\\\"Retest report\\\",\\\"pages\\\":\\\"reissued report, v1.2\\\"},{\\\"n\\\":9,\\\"id\\\":\\\"attestation\\\",\\\"title\\\":\\\"Attestation letter\\\",\\\"pages\\\":\\\"separate 1-page document\\\"},{\\\"n\\\":10,\\\"id\\\":\\\"appendices\\\",\\\"title\\\":\\\"Appendices\\\",\\\"pages\\\":\\\"pp. 14+\\\"}],\\\"stamp\\\":\\\"Sample report — illustrative\\\",\\\"ariaLabel\\\":\\\"Report sections\\\",\\\"id\\\":\\\"report-index\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sr-body\\\",\\\"children\\\":[[[\\\"$\\\",\\\"article\\\",\\\"cover\\\",{\\\"className\\\":\\\"sr-section\\\",\\\"id\\\":\\\"section-cover\\\",\\\"data-section-id\\\":\\\"cover\\\",\\\"data-feature\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"title-cover\\\",\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"sr-section__head\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sr-section__n u-mono u-tnum\\\",\\\"children\\\":[\\\"Section \\\",\\\"01\\\",\\\" · \\\",\\\"p. 1\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"id\\\":\\\"title-cover\\\",\\\"className\\\":\\\"sr-section__title\\\",\\\"children\\\":\\\"Cover and document control\\\"}]]}],[\\\"$\\\",\\\"dl\\\",null,{\\\"className\\\":\\\"sr-qa\\\",\\\"children\\\":[[\\\"$\\\",\\\"dt\\\",null,{\\\"children\\\":\\\"What is in it\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"children\\\":\\\"Client, engagement reference, test window, report version, classification, the lead tester by name, and the reviewer who signed it.\\\"}],[\\\"$\\\",\\\"dt\\\",null,{\\\"children\\\":\\\"Why it is in it\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"children\\\":\\\"Version and classification sound like bureaucracy until a report is three months old and someone is arguing about whether a finding was closed. The named reviewer matters more: it is the commitment that someone other than the author read this before it reached you.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sr-frame\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-doc-frame\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$2c\\\"}],\\\"$L2d\\\"]}]]}],\\\"$L2e\\\",\\\"$L2f\\\",\\\"$L30\\\",\\\"$L31\\\",\\\"$L32\\\",\\\"$L33\\\",\\\"$L34\\\",\\\"$L35\\\",\\\"$L36\\\"],\\\"$L37\\\"]}]]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"17:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"sr-faq\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"sr-faq\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"var(--text-2xl)\\\",\\\"marginBottom\\\":\\\"var(--s8)\\\"},\\\"children\\\":\\\"Common questions\\\"}],[\\\"$\\\",\\\"$L38\\\",null,{\\\"items\\\":[{\\\"q\\\":\\\"Is this a real report?\\\",\\\"a\\\":\\\"The structure, severity model, remediation format and tone are exactly what you receive. The client, the hostnames and the findings are fictional, written for this page so we could show a full finding without redacting it into uselessness. Every page of this walkthrough is labelled illustrative.\\\"},{\\\"q\\\":\\\"How long is a real report?\\\",\\\"a\\\":\\\"For an eight-day web and API test, typically 30 to 45 pages including appendices. Length is a function of finding count, not of effort — a clean test produces a short report and that is a good outcome, not a shortfall. We do not pad.\\\"},{\\\"q\\\":\\\"Can we get it in a format other than PDF?\\\",\\\"a\\\":\\\"Yes. The findings register ships as CSV and JSON keyed for direct import into Jira, Linear or ServiceNow, so nobody retypes a finding. Some clients take only the register and the executive summary and never open the PDF, which is a perfectly reasonable way to work.\\\"},{\\\"q\\\":\\\"Who writes it?\\\",\\\"a\\\":\\\"The tester who found the issues, reviewed and signed by a second senior tester who did not work the engagement. Not a technical author, and not an account manager. The debrief call is with the same person, which is why they write it knowing they will have to defend it.\\\"},{\\\"q\\\":\\\"What if we disagree with a severity?\\\",\\\"a\\\":\\\"Argue it at the debrief. We show the environmental adjustment and the reasoning precisely so the disagreement can be specific. We change severities when the argument is good and we record that we did, with the reason — a severity quietly lowered after a client objection is worse than no severity model at all.\\\"},{\\\"q\\\":\\\"Will you help us fix the findings?\\\",\\\"a\\\":\\\"We will tell you exactly what to change, and our engineering practice can do the work as a separate engagement. What we will not do is have the same person fix and then retest their own work, because that retest means nothing.\\\"}],\\\"headingLevel\\\":3}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s8)\\\",\\\"fontSize\\\":\\\"var(--text-sm)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$Ld\\\",null,{\\\"href\\\":\\\"/services/penetration-testing\\\",\\\"className\\\":\\\"u-link\\\",\\\"children\\\":\\\"How a penetration test is scoped and run\\\"}],\\\" · \\\",[\\\"$\\\",\\\"$Ld\\\",null,{\\\"href\\\":\\\"/trust\\\",\\\"className\\\":\\\"u-link\\\",\\\"children\\\":\\\"What we do with your evidence afterwards\\\"}]]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"39:T1b85,\"])</script><script>self.__next_f.push([1,\"\\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\\n.metrics {\\n  display: grid;\\n  gap: var(--s8);\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n@media (min-width: 768px) {\\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\\n}\\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\\n   headline rather than in a full-width row under it. */\\n.metrics--stack { gap: var(--s4); }\\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\\n/* The key runs inline with its note in the stacked variant — one line saved per\\n   metric is what keeps all three on the first screen. */\\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\\n.metrics--stack .metric__note-key::after { content: ' — '; }\\n.metric {\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s2);\\n  min-width: 0;\\n  border-top: 1px solid var(--border-strong);\\n  padding-top: var(--s4);\\n}\\n.metric__value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-2xl);\\n  font-weight: 600;\\n  line-height: 1.05;\\n  letter-spacing: var(--tracking-tight);\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n@media (min-width: 768px) {\\n  .metric__value { font-size: var(--text-3xl); }\\n}\\n.metric__label {\\n  margin: 0;\\n  color: var(--muted-strong);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n  max-width: 34ch;\\n}\\n.metric__note {\\n  margin: var(--s2) 0 0;\\n  padding-top: var(--s2);\\n  border-top: 1px solid var(--border);\\n  font-size: var(--text-xs);\\n  line-height: 1.5;\\n  color: var(--muted);\\n  max-width: 36ch;\\n}\\n.metric__note-key {\\n  display: block;\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n  margin-bottom: 2px;\\n}\\n\\n/* ---------------- NDA block ---------------- */\\n.nda {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: var(--s3);\\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\\n  border-radius: var(--radius-md);\\n  padding: var(--s3) var(--s4);\\n}\\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.nda__kicker {\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.nda__name {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-sm);\\n  line-height: 1.4;\\n}\\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\\n\\n/* ---------------- dual-pillar marker ---------------- */\\n.dual {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--border-strong);\\n  border-radius: var(--radius-md);\\n  padding: var(--s2) var(--s3);\\n  color: var(--fg);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\\n.dual__icon { color: var(--accent); flex: none; }\\n\\n/* ---------------- case study card ---------------- */\\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\\n.cs-card__client {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  letter-spacing: 0.02em;\\n  color: var(--muted-strong);\\n}\\n.cs-card__headline {\\n  margin: 0;\\n  font-size: var(--text-lg);\\n  font-weight: 500;\\n  line-height: var(--leading-snug);\\n  color: var(--fg);\\n}\\n.cs-card__headline a { color: inherit; text-decoration: none; }\\n.cs-card__meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: var(--s2) var(--s4);\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  margin: 0;\\n}\\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\\n.cs-card__metric {\\n  margin-top: auto;\\n  padding-top: var(--s4);\\n  border-top: 1px solid var(--border);\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--s1);\\n}\\n.cs-card__metric-value {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-xl);\\n  font-weight: 600;\\n  letter-spacing: var(--tracking-tight);\\n  line-height: 1.1;\\n  color: var(--fg);\\n  margin: 0;\\n  overflow-wrap: break-word;\\n}\\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\\n\\n/* ---------------- testimonial rail ---------------- */\\n.trail {\\n  display: grid;\\n  grid-auto-flow: column;\\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\\n  gap: var(--s4);\\n  overflow-x: auto;\\n  overscroll-behavior-x: contain;\\n  scroll-snap-type: x mandatory;\\n  list-style: none;\\n  margin: 0;\\n  padding: 0 0 var(--s4);\\n  scrollbar-width: thin;\\n}\\n@media (min-width: 768px) {\\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\\n}\\n.trail \\u003e li { scroll-snap-align: start; min-width: 0; }\\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\\n.trail__quote {\\n  margin: 0;\\n  color: var(--fg);\\n  font-size: var(--text-base);\\n  line-height: var(--leading-normal);\\n}\\n@media (min-width: 768px) {\\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\\n}\\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\\n\\n/* ---------------- named-humans CTA ---------------- */\\n.humans { display: grid; gap: var(--s8); }\\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\\n.human { display: flex; align-items: center; gap: var(--s4); }\\n.human__name {\\n  margin: 0;\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-base);\\n  font-weight: 500;\\n  color: var(--fg);\\n}\\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\\n\"])</script><script>self.__next_f.push([1,\"18:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-light transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"light\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"sr-cta\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-proof-surfaces\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$39\\\"}],\\\"$L3a\\\"]}]}]]\\n19:[\\\"$\\\",\\\"$L3b\\\",null,{\\\"children\\\":[\\\"$L3c\\\",[\\\"$\\\",\\\"$L3d\\\",null,{\\\"promise\\\":\\\"$@3e\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"li\\\",\\\"/services/qa-automation\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Ld\\\",null,{\\\"href\\\":\\\"/services/qa-automation\\\",\\\"className\\\":\\\"foot__link\\\",\\\"children\\\":\\\"QA \\u0026 Test Automation\\\"}]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\