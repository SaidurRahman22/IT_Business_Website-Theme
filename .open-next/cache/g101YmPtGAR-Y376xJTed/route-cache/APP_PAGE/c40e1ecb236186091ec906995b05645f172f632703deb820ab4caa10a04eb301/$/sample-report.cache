 th,\n.doc__table td {\n  padding: var(--s3) var(--s4) var(--s3) 0;\n  border-bottom: 1px solid var(--border);\n  vertical-align: top;\n  line-height: 1.5;\n}\n.doc__table tr:last-child th,\n.doc__table tr:last-child td { border-bottom: 0; }\n.doc__table th[scope='row'] {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  color: var(--muted-strong);\n  white-space: nowrap;\n  padding-right: var(--s6);\n}\n.doc__table td { color: var(--fg); }\n\n/* ---------------- code ---------------- */\n.doc__pre {\n  margin: 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: var(--text-xs);\n  line-height: 1.65;\n  color: var(--fg);\n  white-space: pre;\n  tab-size: 2;\n}\n@media (min-width: 900px) { .doc__pre { font-size: var(--text-sm); } }\n.doc__pre:focus-visible { outline-offset: -2px; }\n\n/* ---------------- the refusal block ---------------- */\n.doc__refusal {\n  margin: var(--s6) var(--s4) 0;\n  max-width: 72ch;\n  border: 1px solid var(--border-strong);\n  border-left: 3px solid var(--accent);\n  border-radius: var(--radius-sm);\n  background-color: var(--surface);\n  padding: var(--s4);\n}\n.doc__refusal-key {\n  display: block;\n  font-size: var(--text-xs);\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  color: var(--accent);\n  margin-bottom: var(--s3);\n}\n.doc__refusal-body {\n  margin: 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: var(--text-xs);\n  line-height: 1.7;\n  color: var(--fg);\n  max-width: 68ch;\n}\n@media (min-width: 900px) { .doc__refusal-body { font-size: var(--text-sm); } }\n@media (min-width: 768px) {\n  .doc__refusal { margin-inline: var(--s8); }\n}\n\n/* ---------------- list ---------------- */\n.doc__list { list-style: none; margin: 0; padding: 0; max-width: 72ch; }\n.doc__list > li { border-top: 1px solid var(--border); padding-block: var(--s4); }\n.doc__list > li:first-child { border-top: 0; padding-top: 0; }\n.doc__list > li:last-child { padding-bottom: 0; }\n.doc__tag {\n  display: inline-flex;\n  align-items: center;\n  width: fit-content;\n  margin-bottom: var(--s2);\n  padding: 2px var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-sm);\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.06em;\n  color: var(--muted-strong);\n  text-transform: none;\n}\n.doc__list-body { margin: 0; font-size: var(--text-sm); line-height: 1.65; color: var(--fg); }\n\n/* ---------------- print ---------------- */\n@media print {\n  .doc { break-inside: avoid; border-color: currentColor; }\n  .doc__scroll { mask-image: none; -webkit-mask-image: none; }\n  .doc__scroll > * { overflow: visible; }\n  .doc__pre { white-space: pre-wrap; }\n}\n33:[\"$\",\"article\",\"remediation\",{\"className\":\"sr-section\",\"id\":\"section-remediation\",\"data-section-id\":\"remediation\",\"data-feature\":\"$undefined\",\"aria-labelledby\":\"title-remediation\",\"children\":[[\"$\",\"header\",null,{\"className\":\"sr-section__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sr-section__n u-mono u-tnum\",\"children\":[\"Section \",\"07\",\" · \",\"pp. 12–13\"]}],[\"$\",\"h3\",null,{\"id\":\"title-remediation\",\"className\":\"sr-section__title\",\"children\":\"Remediation guidance and ordering\"}]]}],[\"$\",\"dl\",null,{\"className\":\"sr-qa\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"What is in it\"}],[\"$\",\"dd\",null,{\"children\":\"The findings grouped by root cause rather than by severity, with a suggested order and a rough effort estimate per group.\"}],[\"$\",\"dt\",null,{\"children\":\"Why it is in it\"}],[\"$\",\"dd\",null,{\"children\":\"Eleven findings ranked by severity gives you eleven tickets. The same eleven grouped by cause often gives you four pieces of work, and the order matters because fixing the structural cause closes findings that have not been found yet. This section is why a programme beats a sequence of tests.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sr-frame\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-doc-frame\",\"precedence\":\"default\",\"children\":\"$4e\"}],\"$L4f\"]}]]}]\n34:[\"$\",\"article\",\"retest\",{\"className\":\"sr-section\",\"id\":\"section-retest\",\"data-section-id\":\"retest\",\"data-feature\":\"$undefined\",\"aria-labelledby\":\"title-retest\",\"children\":[[\"$\",\"header\",null,{\"className\":\"sr-section__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sr-section__n u-mono u-tnum\",\"children\":[\"Section \",\"08\",\" · \",\"reissued report, v1.2\"]}],[\"$\",\"h3\",null,{\"id\":\"title-retest\",\"className\":\"sr-section__title\",\"children\":\"Retest report\"}]]}],[\"$\",\"dl\",null,{\"className\":\"sr-qa\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"What is in it\"}],[\"$\",\"dd\",null,{\"children\":\"Every finding retested within 30 days, with a verified status per finding. Anything still open is reopened with fresh evidence, not with the original screenshot.\"}],[\"$\",\"dt\",null,{\"children\":\"Why it is in it\"}],[\"$\",\"dd\",null,{\"children\":\"A report without a retest ages into a document about the past. Reissuing the same report with a status column — rather than sending a separate retest letter — means there is one current document, which is what an auditor, a customer and your own team all need.\"}]]}],null]}]\n35:[\"$\",\"article\",\"attestation\",{\"className\":\"sr-section\",\"id\":\"section-attestation\",\"data-section-id\":\"attestation\",\"data-feature\":\"$undefined\",\"aria-labelledby\":\"title-attestation\",\"children\":[[\"$\",\"header\",null,{\"className\":\"sr-section__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sr-section__n u-mono u-tnum\",\"children\":[\"Section \",\"09\",\" · \",\"separate 1-page document\"]}],[\"$\",\"h3\",null,{\"id\":\"title-attestation\",\"className\":\"sr-section__title\",\"children\":\"Attestation letter\"}]]}],[\"$\",\"dl\",null,{\"className\":\"sr-qa\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"What is in it\"}],[\"$\",\"dd\",null,{\"children\":\"A one-page signed letter stating that the engagement took place, over what window, against what scope, by a named accredited firm — with no finding detail.\"}],[\"$\",\"dt\",null,{\"children\":\"Why it is in it\"}],[\"$\",\"dd\",null,{\"children\":\"This is the document you send to a customer, an auditor or an insurer. It exists so you are not forced to choose between redacting a technical report by hand and disclosing more than you want to.\"}]]}],null]}]\n36:[\"$\",\"article\",\"appendices\",{\"className\":\"sr-section\",\"id\":\"section-appendices\",\"data-section-id\":\"appendices\",\"data-feature\":\"$undefined\",\"aria-labelledby\":\"title-appendices\",\"children\":[[\"$\",\"header\",null,{\"className\":\"sr-section__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sr-section__n u-mono u-tnum\",\"children\":[\"Section \",\"10\",\" · \",\"pp. 14+\"]}],[\"$\",\"h3\",null,{\"id\":\"title-appendices\",\"className\":\"sr-section__title\",\"children\":\"Appendices\"}]]}],[\"$\",\"dl\",null,{\"className\":\"sr-qa\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"What is in it\"}],[\"$\",\"dd\",null,{\"children\":\"Methodology and standards mapping (OWASP ASVS 4.0, WSTG, PTES), the tool inventory, and — on request — the raw tooling output, clearly labelled as unverified.\"}],[\"$\",\"dt\",null,{\"children\":\"Why it is in it\"}],[\"$\",\"dd\",null,{\"children\":\"Raw scanner output belongs in an appendix and nowhere else. Mixing confirmed findings with unverified tool noise in the body is how a severity model loses its meaning, and it is the single clearest tell that a report is a lightly edited scanner export.\"}]]}],null]}]\n37:[\"$\",\"div\",null,{\"className\":\"sr-foot\",\"children\":[\"$\",\"p\",null,{\"children\":\"Sample report — illustrative. The client, the hostnames and the finding are fictional. The structure, the severity model, the remediation format and the tone are what you receive.\"}]}]\n50:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n3a:[\"$\",\"div\",null,{\"className\":\"humans\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"sr-cta\",\"style\":{\"fontSize\":\"var(--text-3xl)\",\"margin\":\"var(--s3) 0 0\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"style\":{\"color\":\"var(--muted-strong)\",\"maxWidth\":\"52ch\",\"marginTop\":\"var(--s4)\"},\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"div\",null,{\"className\":\"humans__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$50\"}],\"$L51\"],\"$undefined\"]}],\"$L52\"]}],\"$L53\"]}]\n3f:[\"$\",\"span\",null,{\"children\":\"X\"}]\n40:[\"$\",\"span\",null,{\"className\":\"foot__vh\",\"children\":\" (opens in a new tab)\"}]\n41:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.625,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]\n43:[\"$\",\"$Ld\",null,{\"href\":\"/case-studies\",\"className\":\"btn btn--secondary btn--lg\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"See the work\"}],null]}]\n45:[\"$\",\"figure\",null,{\"className\":\"doc theme-light transition-theme\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__chrome\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__stamp u-mono\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"span\",null,{\"className\":\"doc__pages u-mono\",\"children\":\"pp. 2–3\"}]]}],[\"$\",\"div\",null,{\"className\":\"doc__sheet\",\"children\":[\"$\",\"div\",null,{\"className\":\"doc__prose\",\"children\":[[\"$\",\"p\",\"Two of the eleven findings in this report would \",{\"children\":\"Two of the eleven findings in this report would allow one Meridian customer to read another customer’s patient records. Neither requires a software vulnerability in the conventional sense; both follow from authorisation being decided in more places than any single engineer can enumerate. We consider this the material finding of the engagement and it is the subject of ENX-0418-01 and ENX-0418-02.\"}],[\"$\",\"p\",\"The remaining nine findings are the ordinary res\",{\"children\":\"The remaining nine findings are the ordinary result of a system built at pace and are individually unremarkable. We would not delay a release for any of them.\"}],[\"$\",\"p\",\"Three decisions need an owner. First, whether th\",{\"children\":\"Three decisions need an owner. First, whether the reporting view described in ENX-0418-01 is retired or rewritten — rewriting it is roughly a sprint, retiring it affects four customers who use the export. Second, whether the clinician impersonation feature (ENX-0418-04) keeps its current single-approval design, which we think will not survive an Information Commissioner enquiry. Third, whether authorisation consolidation is funded now as a piece of work, or absorbed into feature delivery, which in our experience means it does not happen.\"}]]}]}]]}]\n47:[\"$\",\"figure\",null,{\"className\":\"doc theme-light transition-theme\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__chrome\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__stamp u-mono\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"span\",null,{\"className\":\"doc__pages u-mono\",\"children\":\"pp. 4–5\"}]]}],[\"$\",\"div\",null,{\"className\":\"doc__sheet\",\"children\":[\"$\",\"ul\",null,{\"className\":\"doc__list\",\"children\":[[\"$\",\"li\",\"IN SCOPE — app.meridianclinical.\",{\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__tag\",\"children\":\"IN SCOPE\"}],[\"$\",\"p\",null,{\"className\":\"doc__list-body\",\"children\":\"app.meridianclinical.io (3 roles: clinician, practice-admin, support), api.meridianclinical.io (REST, 94 endpoints from the OpenAPI document plus 7 found that were not in it), the tenant isolation boundary, and the SSO integration with Entra ID.\"}]]}],[\"$\",\"li\",\"NOT TESTED — Denial of service, \",{\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__tag\",\"children\":\"NOT TESTED\"}],[\"$\",\"p\",null,{\"className\":\"doc__list-body\",\"children\":\"Denial of service, which proves little and risks much on a clinical system. Social engineering of Meridian staff, which belongs in a red team with different rules of engagement. The mobile application, which is a separate scope. Third-party integrations beyond the authentication boundary. The underlying AWS account configuration, which was reviewed separately under ENX-2026-0402.\"}]]}],[\"$\",\"li\",\"DEVIATION — The out-of-hours win\",{\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__tag\",\"children\":\"DEVIATION\"}],[\"$\",\"p\",null,{\"className\":\"doc__list-body\",\"children\":\"The out-of-hours window on 2026-04-18 was cancelled at Meridian’s request following an unrelated production incident. Two destructive checks on the export pipeline were therefore not performed. This is stated here rather than silently omitted.\"}]]}]]}]}]]}]\n49:[\"$\",\"figure\",null,{\"className\":\"doc theme-light transition-theme\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__chrome\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__stamp u-mono\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"span\",null,{\"className\":\"doc__pages u-mono\",\"children\":\"p. 6\"}]]}],[\"$\",\"div\",null,{\"className\":\"doc__sheet\",\"children\":[\"$\",\"div\",null,{\"className\":\"doc__prose\",\"children\":[[\"$\",\"p\",\"We adjust base scores up as well as down. ENX-04\",{\"children\":\"We adjust base scores up as well as down. ENX-0418-01 has a CVSS v4.0 base of 8.1; we report it as Critical because the affected data is special category health data under UK GDPR Article 9 and the exploit requires only a valid login from any tenant, which in Meridian’s case means any of 1,340 clinician accounts. ENX-0418-07 has a base of 7.5 and we report it as Medium, because the vulnerable endpoint is unreachable from the internet in Meridian’s network topology and requires a foothold the other findings do not provide.\"}]]}]}]]}]\n54:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n55:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n4b:[\"$\",\"figure\",null,{\"className\":\"doc theme-light transition-theme\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__chrome\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__stamp u-mono\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"span\",null,{\"className\":\"doc__pages u-mono\",\"children\":\"p. 7\"}]]}],[\"$\",\"div\",null,{\"className\":\"doc__sheet doc__sheet--flush\",\"children\":[\"$\",\"div\",null,{\"className\":\"doc__scroll\",\"children\":[\"$\",\"div\",null,{\"children\":[\"$\",\"table\",null,{\"className\":\"doc__table\",\"children\":[[\"$\",\"caption\",null,{\"children\":[\"Findings index\",\" — sample report, illustrative\"]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"ENX-0418-01\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"ENX-0418-01\"}],[[\"$\",\"td\",\"ENX-0418-01-0\",{\"children\":\"Cross-tenant patient record disclosure via reporting view\"}],[\"$\",\"td\",\"ENX-0418-01-1\",{\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$54\"}],[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--severity badge--critical\",\"children\":[[\"$\",\"span\",null,{\"className\":\"badge__dot\",\"aria-hidden\":\"true\"}],\"Critical\"]}]]}],[\"$\",\"td\",\"ENX-0418-01-2\",{\"children\":\"reporting-api\"}],[\"$\",\"td\",\"ENX-0418-01-3\",{\"children\":\"Fixed, verified 2026-05-22\"}]]]}],[\"$\",\"tr\",\"ENX-0418-02\",{\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"children\":\"ENX-0418-02\"}],[[\"$\",\"td\",\"ENX-0418-02-0\",{\"children\":\"Broken object-level authorisation on episode export\"}],[\"$\",\"td\",\"ENX-0418-02-1\",{\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$55\"}],\"$L56\"]}],\"$L57\",\"$L58\"]]}],\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\"]}]]}]}]}]}]]}]\n5e:T65a,ENX-0418-01  Cross-tenant patient record disclosure via reporting view\nSeverity    Critical (CVSS v4.0 base 8.1, adjusted up — see §4)\nComponent   reporting-api @ 4f2a9c1 · view public.v_episode_summary\nPrereq      Any authenticated clinician or practice-admin account, any tenant\n\nREPRODUCTION\n1. Authenticate as clinician@tenant-a.example and capture the session cookie.\n2. GET /reporting/v2/episode-summary?from=2026-01-01&to=2026-04-01\n3. Observe 2,847 rows returned. 2,106 belong to tenant-b and tenant-c.\n\nROOT CAUSE\nThe view public.v_episode_summary joins episode and patient without a tenant\npredicate. The predicate lives in the single caller added alongside the view in\n2021 (reporting-api/src/queries/exportEpisodes.ts:88). A second caller added in\n2023 (reporting-api/src/routes/episodeSummary.ts:41) queries the same view with\nno predicate and has been in production for 19 months.\n\nREMEDIATION  — in priority order\n1. Immediate: add the tenant predicate at episodeSummary.ts:41. One line, deploys\n   today, closes the exposure.\n2. Structural: move the predicate into the view itself as a security barrier view,\n   or replace it with a table-valued function taking tenant_id as a required\n   argument. The second caller was able to be written because the view permitted\n   it — a fix at the call site leaves the next caller able to make the same mistake.\n3. Preventive: enable row-level security on episode and patient with a policy keyed\n   on the session tenant. This is the change that makes the bug class unwriteable,\n   and it is the one we would push for. Expect roughly a sprint, mostly in testing.4d:[\"$\",\"figure\",null,{\"className\":\"doc theme-light transition-theme\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__chrome\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__stamp u-mono\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"span\",null,{\"className\":\"doc__pages u-mono\",\"children\":\"pp. 8–11 (one finding)\"}]]}],[\"$\",\"div\",null,{\"className\":\"doc__sheet doc__sheet--flush\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__scroll\",\"children\":[\"$\",\"pre\",null,{\"className\":\"doc__pre u-mono\",\"tabIndex\":0,\"role\":\"region\",\"aria-label\":\"A finding, written out in full — report excerpt, horizontally scrollable\",\"children\":\"$5e\"}]}],[\"$\",\"div\",null,{\"className\":\"doc__refusal\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__refusal-key u-mono\",\"children\":\"WHAT WE WOULD NOT DO\"}],[\"$\",\"p\",null,{\"className\":\"doc__refusal-body\",\"children\":\"Adding a tenant check in the reporting-api middleware. It looks like a fix, it passes a retest, and it leaves the view exploitable from the export worker, which does not pass through that middleware.\"}]]}]]}]]}]\n4f:[\"$\",\"figure\",null,{\"className\":\"doc theme-light transition-theme\",\"children\":[[\"$\",\"div\",null,{\"className\":\"doc__chrome\",\"children\":[[\"$\",\"span\",null,{\"className\":\"doc__stamp u-mono\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"span\",null,{\"className\":\"doc__pages u-mono\",\"children\":\"pp. 12–13\"}]]}],[\"$\",\"div\",null,{\"className\":\"doc__sheet\",\"children\":[\"$\",\"div\",null,{\"className\":\"doc__prose\",\"children\":[[\"$\",\"p\",\"Findings 01, 02 and 06 are one problem: authoris\",{\"children\":\"Findings 01, 02 and 06 are one problem: authorisation is decided at the call site, so each new caller is a new opportunity. Findings 03 and 05 are a second: state changes that should be irreversible or invalidating are implemented as ordinary writes. Finding 04 is a design decision, not a defect, and needs a decision-maker rather than an engineer. Finding 07 is isolated and genuinely just needs fixing.\"}]]}]}]]}]\n51:[\"$\",\"$Ld\",null,{\"href\":\"/contact\",\"className\":\"btn btn--primary btn--lg\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Start a conversation\"}],[\"$\",\"span\",null,{\"className\":\"btn__icon\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.625,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]}]]}]\n52:[\"$\",\"p\",null,{\"className\":\"humans__sla\",\"children\":\"A named engineer replies within one business day. Scoping call within three.\"}]\n53:[\"$\",\"ul\",null,{\"className\":\"humans__people\",\"aria-label\":\"Who replies to a new enquiry\",\"children\":[[\"$\",\"li\",\"claire-benoit\",{\"className\":\"human\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-avatar-placeholder\",\"precedence\":\"default\",\"children\":\"\\n.avatar-ph {\\n  display: grid;\\n  place-items: center;\\n  flex: none;\\n  border-radius: var(--radius-md);\\