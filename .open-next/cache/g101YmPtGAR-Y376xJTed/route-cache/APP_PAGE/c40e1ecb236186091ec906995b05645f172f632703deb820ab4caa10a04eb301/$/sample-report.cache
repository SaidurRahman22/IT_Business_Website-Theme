--- */\n.doc__refusal {\n  margin: var(--s6) var(--s4) 0;\n  max-width: 72ch;\n  border: 1px solid var(--border-strong);\n  border-left: 3px solid var(--accent);\n  border-radius: var(--radius-sm);\n  background-color: var(--surface);\n  padding: var(--s4);\n}\n.doc__refusal-key {\n  display: block;\n  font-size: var(--text-xs);\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  color: var(--accent);\n  margin-bottom: var(--s3);\n}\n.doc__refusal-body {\n  margin: 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: var(--text-xs);\n  line-height: 1.7;\n  color: var(--fg);\n  max-width: 68ch;\n}\n@media (min-width: 900px) { .doc__refusal-body { font-size: var(--text-sm); } }\n@media (min-width: 768px) {\n  .doc__refusal { margin-inline: var(--s8); }\n}\n\n/* ---------------- list ---------------- */\n.doc__list { list-style: none; margin: 0; padding: 0; max-width: 72ch; }\n.doc__list > li { border-top: 1px solid var(--border); padding-block: var(--s4); }\n.doc__list > li:first-child { border-top: 0; padding-top: 0; }\n.doc__list > li:last-child { padding-bottom: 0; }\n.doc__tag {\n  display: inline-flex;\n  align-items: center;\n  width: fit-content;\n  margin-bottom: var(--s2);\n  padding: 2px var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-sm);\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.06em;\n  color: var(--muted-strong);\n  text-transform: none;\n}\n.doc__list-body { margin: 0; font-size: var(--text-sm); line-height: 1.65; color: var(--fg); }\n\n/* ---------------- print ---------------- */\n@media print {\n  .doc { break-inside: avoid; border-color: currentColor; }\n  .doc__scroll { mask-image: none; -webkit-mask-image: none; }\n  .doc__scroll > * { overflow: visible; }\n  .doc__pre { white-space: pre-wrap; }\n}\n16:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"id\":\"report-body\",\"aria-labelledby\":\"sr-walk\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sr-strip u-mono no-print\",\"aria-hidden\":\"true\",\"children\":\"Sample report — illustrative\"}],[\"$\",\"h2\",null,{\"id\":\"sr-walk\",\"className\":\"u-eyebrow\",\"style\":{\"marginBottom\":\"var(--s8)\"},\"children\":\"The report, section by section\"}],[\"$\",\"div\",null,{\"className\":\"sr-layout\",\"children\":[[\"$\",\"$L2b\",null,{\"entries\":[{\"n\":1,\"id\":\"cover\",\"title\":\"Cover and document control\",\"pages\":\"p. 1\"},{\"n\":2,\"id\":\"executive-summary\",\"title\":\"Executive summary\",\"pages\":\"pp. 2–3\"},{\"n\":3,\"id\":\"scope\",\"title\":\"Scope, approach and explicit exclusions\",\"pages\":\"pp. 4–5\"},{\"n\":4,\"id\":\"severity\",\"title\":\"The severity model, with the working shown\",\"pages\":\"p. 6\"},{\"n\":5,\"id\":\"findings-index\",\"title\":\"Findings index\",\"pages\":\"p. 7\"},{\"n\":6,\"id\":\"finding\",\"title\":\"A finding, written out in full\",\"pages\":\"pp. 8–11 (one finding)\"},{\"n\":7,\"id\":\"remediation\",\"title\":\"Remediation guidance and ordering\",\"pages\":\"pp. 12–13\"},{\"n\":8,\"id\":\"retest\",\"title\":\"Retest report\",\"pages\":\"reissued report, v1.2\"},{\"n\":9,\"id\":\"attestation\",\"title\":\"Attestation letter\",\"pages\":\"separate 1-page document\"},{\"n\":10,\"id\":\"appendices\",\"title\":\"Appendices\",\"pages\":\"pp. 14+\"}],\"stamp\":\"Sample report — illustrative\",\"ariaLabel\":\"Report sections\",\"id\":\"report-index\"}],[\"$\",\"div\",null,{\"className\":\"sr-body\",\"children\":[[[\"$\",\"article\",\"cover\",{\"className\":\"sr-section\",\"id\":\"section-cover\",\"data-section-id\":\"cover\",\"data-feature\":\"$undefined\",\"aria-labelledby\":\"title-cover\",\"children\":[[\"$\",\"header\",null,{\"className\":\"sr-section__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sr-section__n u-mono u-tnum\",\"children\":[\"Section \",\"01\",\" · \",\"p. 1\"]}],[\"$\",\"h3\",null,{\"id\":\"title-cover\",\"className\":\"sr-section__title\",\"children\":\"Cover and document control\"}]]}],[\"$\",\"dl\",null,{\"className\":\"sr-qa\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"What is in it\"}],[\"$\",\"dd\",null,{\"children\":\"Client, engagement reference, test window, report version, classification, the lead tester by name, and the reviewer who signed it.\"}],[\"$\",\"dt\",null,{\"children\":\"Why it is in it\"}],[\"$\",\"dd\",null,{\"children\":\"Version and classification sound like bureaucracy until a report is three months old and someone is arguing about whether a finding was closed. The named reviewer matters more: it is the commitment that someone other than the author read this before it reached you.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sr-frame\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-doc-frame\",\"precedence\":\"default\",\"children\":\"$2c\"}],\"$L2d\"]}]]}],\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\"],\"$L37\"]}]]}]]}]}]]\n17:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"sr-faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"sr-faq\",\"style\":{\"fontSize\":\"var(--text-2xl)\",\"marginBottom\":\"var(--s8)\"},\"children\":\"Common questions\"}],[\"$\",\"$L38\",null,{\"items\":[{\"q\":\"Is this a real report?\",\"a\":\"The structure, severity model, remediation format and tone are exactly what you receive. The client, the hostnames and the findings are fictional, written for this page so we could show a full finding without redacting it into uselessness. Every page of this walkthrough is labelled illustrative.\"},{\"q\":\"How long is a real report?\",\"a\":\"For an eight-day web and API test, typically 30 to 45 pages including appendices. Length is a function of finding count, not of effort — a clean test produces a short report and that is a good outcome, not a shortfall. We do not pad.\"},{\"q\":\"Can we get it in a format other than PDF?\",\"a\":\"Yes. The findings register ships as CSV and JSON keyed for direct import into Jira, Linear or ServiceNow, so nobody retypes a finding. Some clients take only the register and the executive summary and never open the PDF, which is a perfectly reasonable way to work.\"},{\"q\":\"Who writes it?\",\"a\":\"The tester who found the issues, reviewed and signed by a second senior tester who did not work the engagement. Not a technical author, and not an account manager. The debrief call is with the same person, which is why they write it knowing they will have to defend it.\"},{\"q\":\"What if we disagree with a severity?\",\"a\":\"Argue it at the debrief. We show the environmental adjustment and the reasoning precisely so the disagreement can be specific. We change severities when the argument is good and we record that we did, with the reason — a severity quietly lowered after a client objection is worse than no severity model at all.\"},{\"q\":\"Will you help us fix the findings?\",\"a\":\"We will tell you exactly what to change, and our engineering practice can do the work as a separate engagement. What we will not do is have the same person fix and then retest their own work, because that retest means nothing.\"}],\"headingLevel\":3}],[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s8)\",\"fontSize\":\"var(--text-sm)\"},\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/services/penetration-testing\",\"className\":\"u-link\",\"children\":\"How a penetration test is scoped and run\"}],\" · \",[\"$\",\"$Ld\",null,{\"href\":\"/trust\",\"className\":\"u-link\",\"children\":\"What we do with your evidence afterwards\"}]]}]]}]}]]\n39:T1b85,\n/* ---------------- metric trio — ABOVE THE FOLD ---------------- */\n.metrics {\n  display: grid;\n  gap: var(--s8);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n@media (min-width: 768px) {\n  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }\n}\n/* Stacked variant, for a metric trio that sits in a narrow column beside the\n   headline rather than in a full-width row under it. */\n.metrics--stack { gap: var(--s4); }\n@media (min-width: 768px) { .metrics--stack { grid-template-columns: minmax(0, 1fr); } }\n.metrics--stack .metric__value { font-size: var(--text-2xl); }\n.metrics--stack .metric__note { margin-top: var(--s1); padding-top: 0; border-top: 0; max-width: 42ch; }\n/* The key runs inline with its note in the stacked variant — one line saved per\n   metric is what keeps all three on the first screen. */\n.metrics--stack .metric__note-key { display: inline; margin-bottom: 0; }\n.metrics--stack .metric__note-key::after { content: ' — '; }\n.metric {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  min-width: 0;\n  border-top: 1px solid var(--border-strong);\n  padding-top: var(--s4);\n}\n.metric__value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n@media (min-width: 768px) {\n  .metric__value { font-size: var(--text-3xl); }\n}\n.metric__label {\n  margin: 0;\n  color: var(--muted-strong);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n  max-width: 34ch;\n}\n.metric__note {\n  margin: var(--s2) 0 0;\n  padding-top: var(--s2);\n  border-top: 1px solid var(--border);\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 36ch;\n}\n.metric__note-key {\n  display: block;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 2px;\n}\n\n/* ---------------- NDA block ---------------- */\n.nda {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--s3);\n  border: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);\n  background-color: color-mix(in oklab, var(--accent) 10%, transparent);\n  border-radius: var(--radius-md);\n  padding: var(--s3) var(--s4);\n}\n.nda__icon { color: var(--accent); flex: none; margin-top: 2px; }\n.nda__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.nda__kicker {\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.nda__name {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-sm);\n  line-height: 1.4;\n}\n.nda__note { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }\n\n/* ---------------- dual-pillar marker ---------------- */\n.dual {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s2) var(--s3);\n  color: var(--fg);\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  text-decoration: none;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.dual:hover { background-color: var(--surface); border-color: var(--fg); }\n.dual__icon { color: var(--accent); flex: none; }\n\n/* ---------------- case study card ---------------- */\n.cs-card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.cs-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }\n.cs-card__client {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n  color: var(--muted-strong);\n}\n.cs-card__headline {\n  margin: 0;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.cs-card__headline a { color: inherit; text-decoration: none; }\n.cs-card__meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--s2) var(--s4);\n  font-size: var(--text-xs);\n  color: var(--muted);\n  margin: 0;\n}\n.cs-card__meta span { display: inline-flex; align-items: center; gap: var(--s1); }\n.cs-card__tags { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.cs-card__metric {\n  margin-top: auto;\n  padding-top: var(--s4);\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n}\n.cs-card__metric-value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.1;\n  color: var(--fg);\n  margin: 0;\n  overflow-wrap: break-word;\n}\n.cs-card__metric-label { margin: 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }\n\n/* ---------------- testimonial rail ---------------- */\n.trail {\n  display: grid;\n  grid-auto-flow: column;\n  grid-auto-columns: minmax(min(84vw, 320px), 1fr);\n  gap: var(--s4);\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  scroll-snap-type: x mandatory;\n  list-style: none;\n  margin: 0;\n  padding: 0 0 var(--s4);\n  scrollbar-width: thin;\n}\n@media (min-width: 768px) {\n  .trail { grid-auto-columns: minmax(0, 420px); gap: var(--s6); }\n}\n.trail > li { scroll-snap-align: start; min-width: 0; }\n.trail__card { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.trail__quote {\n  margin: 0;\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n@media (min-width: 768px) {\n  .trail__quote { font-size: var(--text-lg); line-height: var(--leading-snug); }\n}\n.trail__who { display: flex; align-items: center; gap: var(--s3); margin-top: auto; }\n.trail__name { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.trail__role { margin: 0; font-size: var(--text-xs); color: var(--muted); }\n.trail__hint { margin: var(--s3) 0 0; font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------------- named-humans CTA ---------------- */\n.humans { display: grid; gap: var(--s8); }\n@media (min-width: 900px) { .humans { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); align-items: start; } }\n.humans__people { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n.human { display: flex; align-items: center; gap: var(--s4); }\n.human__name {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-base);\n  font-weight: 500;\n  color: var(--fg);\n}\n.human__role { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n.humans__actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }\n.humans__sla { margin: var(--s4) 0 0; font-size: var(--text-sm); color: var(--muted); max-width: 46ch; }\n18:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"sr-cta\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-proof-surfaces\",\"precedence\":\"default\",\"children\":\"$39\"}],\"$L3a\"]}]}]]\n19:[\"$\",\"$L3b\",null,{\"children\":[\"$L3c\",[\"$\",\"$L3d\",null,{\"promise\":\"$@3e\"}]]}]\n1f:[\"$\",\"li\",\"/services/qa-automation\",{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/services/qa-automation\",\"className\":\"foot__link\",\"children\":\"QA & Test Automation\"}]}]\n20:[\"$\",\"div\",\"Company\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"foot__col-heading\",\"children\":\"Company\"}],[\"$\",\"ul\",null,{\"className\":\"foot__list\",\"children\":[[\"$\",\"li\",\"/about\",{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/about\",\"className\":\"foot__link\",\"children\":\"About\"}]}],[\"$\",\"li\",\"/about/leadership\",{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/about/leadership\",\"className\":\"foot__link\",\"children\":\"Leadership\"}]}],[\"$\",\"li\",\"/approach\",{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/approach\",\"className\":\"foot__link\",\"children\":\"The Adversary Loop\"}]}],[\"$\",\"li\",\"/careers\",{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/careers\",\"className\":\"foot__link\",\"children\":\"Careers\"}]}],[\"$\",\"li\",\"/newsroom\",{\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/newsroom\",\"className\":\"foot__link\",\"children\":\"Newsroom\"}]}],[\"$\",\"li\",\"/locations\",{\"children\":[\"$\",\"$Ld\",null,