(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n66:[\"$\",\"div\",null,{\"style\":{\"marginTop\":\"var(--s12)\"},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$cb\"}],\"$Lcc\"]}]\n67:[\"$\",\"$L45\",null,{\"delay\":60,\"children\":[\"$\",\"figure\",null,{\"className\":\"hp-quote\",\"children\":[[\"$\",\"blockquote\",null,{\"children\":\"The pre-release test came back with no criticals and my first reaction was to distrust it, because the same firm built the thing. So we paid a third party to test it as well. They found one medium. That is when I stopped arguing about the structure.\"}],[\"$\",\"figcaption\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Chief Technology Officer\"}],\"Clinical workflow vendor\"]}]]}]}]\n68:[\"$\",\"$L45\",null,{\"className\":\"hp-stack-tight\",\"style\":{\"marginTop\":\"var(--s16)\"},\"children\":[[\"$\",\"p\",null,{\"className\":\"hp-sub\",\"children\":\"One backlog, as the study describes it\"}],[\"$\",\"div\",null,{\"className\":\"hp-console\",\"role\":\"group\",\"aria-label\":\"Sprint 34 delivery board, a wide console that scrolls horizontally\",\"tabIndex\":0,\"children\":[\"$\",\"$L45\",null,{\"as\":\"figure\",\"className\":\"product_figure__CFsTQ\",\"children\":[[\"$\",\"div\",null,{\"className\":\"product_console__JtIC_\",\"children\":[[\"$\",\"div\",null,{\"className\":\"product_titlebar__rns9g\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_titleGroup__MMGDe\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.o