tn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"17:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"join-heading\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"$L45\\\",null,{\\\"className\\\":\\\"hp-join\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The seam\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"join-heading\\\",\\\"className\\\":\\\"hp-join__heading\\\",\\\"children\\\":\\\"Secure SDLC\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hp-join__body\\\",\\\"children\\\":\\\"The page nobody else has built, because for most firms there is nothing to put on it. One backlog, one set of priorities, one team accountable — and a number you can check.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hp-actions\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$50\\\"}],\\\"$L51\\\"]}]]}],\\\"$L52\\\"]}]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"53:Tc1d,\"])</script><script>self.__next_f.push([1,\"\\n/* ---- Chapter ------------------------------------------------------------\\n   A numbered chapter with a heading that HOLDS while its body scrolls under\\n   it. The number is not decoration: it tells a reader where they are in a long\\n   page, which is the thing a long page actually owes them. */\\n.ch {\\n  position: relative;\\n  display: grid;\\n  gap: var(--s8);\\n}\\n@media (min-width: 1024px) {\\n  .ch {\\n    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\\n    gap: var(--s16);\\n    align-items: start;\\n  }\\n}\\n\\n.ch__head {\\n  position: relative;\\n}\\n@media (min-width: 1024px) {\\n  .ch__head {\\n    position: sticky;\\n    /* Clears the fixed 72px nav plus breathing room. */\\n    top: calc(var(--nav-h) + var(--s8));\\n  }\\n}\\n\\n.ch__num {\\n  display: block;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.18em;\\n  color: var(--accent);\\n  margin-bottom: var(--s3);\\n}\\n\\n.ch__title {\\n  margin: 0;\\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\\n  letter-spacing: var(--tracking-tight);\\n  text-wrap: balance;\\n}\\n\\n.ch__lede {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  font-size: var(--text-base);\\n  line-height: 1.6;\\n  max-width: 34ch;\\n}\\n\\n.ch__rule {\\n  margin-top: var(--s6);\\n  height: 1px;\\n  background: linear-gradient(90deg, var(--accent), transparent);\\n}\\n\\n.ch__body {\\n  min-width: 0;\\n  display: grid;\\n  gap: var(--s12);\\n}\\n\\n/* ---- Sticky card stack --------------------------------------------------\\n   Every card is sticky at the SAME offset, so each comes to rest on the one\\n   before it and the stack assembles itself as you scroll. The entire effect is\\n   the equal `top` value — there is no JavaScript here at all.\\n\\n   Each card needs its own opaque background or the stack reads as a smear;\\n   that is the one thing people get wrong when copying this. */\\n.stack {\\n  display: grid;\\n  gap: var(--s8);\\n}\\n.stack__card {\\n  position: sticky;\\n  top: calc(var(--nav-h) + var(--s8));\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  padding: var(--s8);\\n  /* A hairline of the ground above each card so stacked edges stay readable. */\\n  box-shadow: 0 -1px 0 0 var(--bg);\\n}\\n@media (min-width: 768px) {\\n  .stack__card {\\n    padding: var(--s12);\\n  }\\n}\\n\\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\\n   which is what it already is semantically, so nothing is lost. */\\n@media (prefers-reduced-motion: reduce) {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n/* Sticky needs a real scroll context; without JS the layout is identical, so\\n   no .no-js override is required here. */\\n\\n.stack__index {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.16em;\\n  color: var(--accent);\\n}\\n.stack__title {\\n  margin: var(--s3) 0 0;\\n  font-size: var(--text-2xl);\\n  letter-spacing: var(--tracking-tight);\\n}\\n.stack__body {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  line-height: 1.65;\\n  max-width: 62ch;\\n}\\n\\n@media print {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n\"])</script><script>self.__next_f.push([1,\"18:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"work-heading\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hp-work\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L45\\\",null,{\\\"className\\\":\\\"hp-work__intro\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The work\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"work-heading\\\",\\\"className\\\":\\\"hp-h2 hp-h2--wide\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s4)\\\"},\\\"children\\\":\\\"What the work actually looks like\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hp-lede\\\",\\\"children\\\":\\\"One client estate, one afternoon, six consoles. The integration test that fails in the pipeline asserts the same tenant predicate whose absence shows up in the detection queue; the pull request that fixes it is a ticket on the board; the rollback on the release panel is another ticket on the same board. They are views of one system, not four mood boards.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hp-work__note\\\",\\\"children\\\":\\\"Drawn in HTML, CSS and SVG rather than captured from a vendor console — so they stay sharp at any zoom, render correctly in every palette, and belong to nobody else. Every hostname, ticket, figure and amount is invented. One fictional tenant, Northwind Logistics Group, runs through all of them.\\\"}]]}],[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-story\\\",\\\"precedence\\\"