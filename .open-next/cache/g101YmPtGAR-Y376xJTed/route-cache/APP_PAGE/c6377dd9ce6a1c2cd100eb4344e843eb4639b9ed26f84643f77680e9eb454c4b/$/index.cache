v plus breathing room. */\\n    top: calc(var(--nav-h) + var(--s8));\\n  }\\n}\\n\\n.ch__num {\\n  display: block;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.18em;\\n  color: var(--accent);\\n  margin-bottom: var(--s3);\\n}\\n\\n.ch__title {\\n  margin: 0;\\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\\n  letter-spacing: var(--tracking-tight);\\n  text-wrap: balance;\\n}\\n\\n.ch__lede {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  font-size: var(--text-base);\\n  line-height: 1.6;\\n  max-width: 34ch;\\n}\\n\\n.ch__rule {\\n  margin-top: var(--s6);\\n  height: 1px;\\n  background: linear-gradient(90deg, var(--accent), transparent);\\n}\\n\\n.ch__body {\\n  min-width: 0;\\n  display: grid;\\n  gap: var(--s12);\\n}\\n\\n/* ---- Sticky card stack --------------------------------------------------\\n   Every card is sticky at the SAME offset, so each comes to rest on the one\\n   before it and the stack assembles itself as you scroll. The entire effect is\\n   the equal `top` value — there is no JavaScript here at all.\\n\\n   Each card needs its own opaque background or the stack reads as a smear;\\n   that is the one thing people get wrong when copying this. */\\n.stack {\\n  display: grid;\\n  gap: var(--s8);\\n}\\n.stack__card {\\n  position: sticky;\\n  top: calc(var(--nav-h) + var(--s8));\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  padding: var(--s8);\\n  /* A hairline of the ground above each card so stacked edges stay readable. */\\n  box-shadow: 0 -1px 0 0 var(--bg);\\n}\\n@media (min-width: 768px) {\\n  .stack__card {\\n    padding: var(--s12);\\n  }\\n}\\n\\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\\n   which is what it already is semantically, so nothing is lost. */\\n@media (prefers-reduced-motion: reduce) {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n/* Sticky needs a real scroll context; without JS the layout is identical, so\\n   no .no-js override is required here. */\\n\\n.stack__index {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.16em;\\n  color: var(--accent);\\n}\\n.stack__title {\\n  margin: var(--s3) 0 0;\\n  font-size: var(--text-2xl);\\n  letter-spacing: var(--tracking-tight);\\n}\\n.stack__body {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  line-height: 1.65;\\n  max-width: 62ch;\\n}\\n\\n@media print {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n\"])</script><script>self.__next_f.push([1,\"58:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-story\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$b4\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"ch\\\",\\\"id\\\":\\\"work-run\\\",\\\"aria-labelledby\\\":\\\"work-run-title\\\",\\\"children\\\":[\\\"$Lb5\\\",\\\"$Lb6\\\"]}]]\\n5c:[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"badge badge--sm badge--neutral\\\",\\\"children\\\":[null,\\\"Cybersecurity\\\"]}]\\n5d:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":16,\\\"height\\\":16,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2.625,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-arrow-up-right\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1tivn9\\\",{\\\"d\\\":\\\"M7 7h10v10\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1vkiza\\\",{\\\"d\\\":\\\"M7 17 17 7\\\"}],\\\"$undefined\\\"]}]\\nb7:T43d,\"])</script><script>self.__next_f.push([1,\"\\n.card {\\n  position: relative;\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  color: inherit;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out);\\n}\\n.card--pad { padding: var(--s6); }\\n.card--pad-lg { padding: var(--s8); }\\n.card--flush { background-color: transparent; }\\n\\n/* Hover: colour only. Anything that moves the card is a spec violation. */\\n.card[data-interactive='true']:hover,\\n.card:has(.card__link):hover,\\n.card:has(.card__link:focus-visible) {\\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\\n  border-color: var(--border-strong);\\n}\\n\\n/* The stretched link. The anchor's own text stays the accessible name. */\\n.card__link {\\n  color: inherit;\\n  text-decoration: none;\\n  outline-offset: 4px;\\n}\\n.card__link::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  border-radius: inherit;\\n  z-index: 1;\\n}\\n/* Anything that must stay clickable inside a stretched-link card. */\\n.card__above { position: relative; z-index: 2; }\\n\"])</script><script>self.__next_f.push([1,\"b8:T859,\"])</script><script>self.__next_f.push([1,\"\\n.badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--badge-border, var(--border));\\n  border-radius: var(--radius-sm);\\n  background-color: var(--badge-bg, transparent);\\n  color: var(--badge-fg, var(--muted-strong));\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.04em;\\n  line-height: 1;\\n  padding: var(--s1) var(--s2);\\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\\n     a badge held arbitrary data — \\\"3 weeks review, 14 weeks remediation\\\",\\n     \\\"AWS Solutions Architect Professional\\\", a credibility sentence — and an\\n     unbreakable chip wider than its card pushes the whole grid track past the\\n     viewport. A badge is a label primitive, but callers legitimately put\\n     variable-length data in one, and the component should survive that rather\\n     than require every caller to override it. Severity badges keep nowrap\\n     below: \\\"Critical\\\" is two syllables and must never break. */\\n  white-space: normal;\\n  text-wrap: balance;\\n}\\n.badge--severity {\\n  white-space: nowrap;\\n}\\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\\n.badge--md { padding: var(--s1) var(--s3); }\\n\\n.badge--neutral {\\n  --badge-bg: var(--surface);\\n  --badge-fg: var(--muted-strong);\\n  --badge-border: var(--border);\\n}\\n.badge--brand {\\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\\n  --badge-fg: var(--accent);\\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\\n}\\n\\n/* --- the only --signal-* usage in the codebase --- */\\n.badge--severity {\\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\\n  --badge-fg: var(--sig);\\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"5e:[\\\"$\\\",\\\"$L45\\\",\\\"application-security\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-card\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$b7\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card card--pad-lg hp-card\\\",\\\"data-interactive\\\":\\\"$undefined\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\"