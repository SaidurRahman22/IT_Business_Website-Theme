ing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"hero_hero__ZRqSa theme-dark grain transition-theme\\\",\\\"aria-labelledby\\\":\\\"hero-heading\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero_track__aal_l\\\",\\\"data-hero-track\\\":true,\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero_stage__QYMwK\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero_field__Li4BM\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero_horizon__uleOs\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hero_copy__ya7y6 u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hero_eyebrow__zEWCj u-eyebrow\\\",\\\"children\\\":\\\"Software development · in-house adversaries\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"id\\\":\\\"hero-heading\\\",\\\"className\\\":\\\"hero_headline__tukAT\\\",\\\"aria-label\\\":\\\"We build the software. Then we try to break it — before anyone else gets the chance.\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"0\\\",{\\\"className\\\":\\\"hero_beat__HMJ_G\\\",\\\"data-hero-beat\\\":true,\\\"data-state\\\":\\\"active\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[[\\\"$\\\",\\\"span\\\",\\\"We-0\\\",{\\\"className\\\":\\\"hero_word__C8Fvt\\\",\\\"style\\\":{\\\"--i\\\":\\\"0\\\"},\\\"children\\\":[\\\"We\\\",\\\" \\\"]}],[\\\"$\\\",\\\"span\\\",\\\"build-1\\\",{\\\"className\\\":\\\"hero_word__C8Fvt\\\