e__track.mq-track { padding-right: 0; list-style: none; margin: 0; padding-left: 0; }\\n\\n.mq__item {\\n  display: flex;\\n  align-items: center;\\n  gap: var(--s3);\\n  flex: none;\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--surface);\\n  padding: var(--s3) var(--s4);\\n  min-height: 56px;\\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\\n}\\n.mq__item:hover { border-color: var(--border-strong); }\\n\\n.mq__logo { display: inline-flex; flex: none; color: var(--muted-strong); }\\n\\n.mq__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\\n.mq__label {\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  line-height: 1.2;\\n  color: var(--fg);\\n  white-space: nowrap;\\n}\\n.mq__meta {\\n  font-size: var(--text-xs);\\n  line-height: 1.2;\\n  color: var(--muted);\\n  white-space: nowrap;\\n}\\n.mq__link { color: inherit; text-decoration: none; }\\n.mq__link:hover .mq__label { color: var(--fg); }\\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\\n\\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\\n@media (prefers-reduced-motion: reduce) {\\n  .marquee__track.mq-track { padding-right: var(--gap); }\\n}\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section-