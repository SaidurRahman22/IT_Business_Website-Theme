",null,{\\\"children\\\":\\\"Software development\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Security practice\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"hp-seam\\\",\\\"viewBox\\\":\\\"0 0 320 72\\\",\\\"fill\\\":\\\"none\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"focusable\\\":\\\"false\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M8 4 V28 C8 44 48 44 96 44 H224 C272 44 312 44 312 28 V4\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1\\\"}],[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M160 44 V68\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hp-join__figure u-tnum\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s6)\\\"},\\\"children\\\":\\\"9 days\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hp-join__figure-label\\\",\\\"children\\\":\\\"median from a finding being confirmed to the fix being live in production\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"54:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"ch\\\",\\\"id\\\":\\\"work-review\\\",\\\"aria-labelledby\\\":\\\"work-review-title\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ch__head\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ch__num\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"01\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"ch__title\\\",\\\"id\\\":\\\"work-review-title\\\",\\\"children\\\":\\\"A security finding is a comment on a line of code\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"ch__lede\\\",\\\"children\\\":\\\"The same finding, arriving in the form the person who will change it can act on.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ch__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ch__body\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L45\\\",null,{\\\"className\\\":\\\"hp-work__prose\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Pull request 482 fixes a reporting query that returned rows for every tenant rather than the caller’s. Continuous review raised it on 13 October; the fix merged at 14:33 the following afternoon. What makes it cheap is where the conversation happened — on line 148, in the branch, with the author already in the file — rather than in a document four months later that somebody has to translate back into a ticket.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"The second comment in that thread is the part worth reading. The security engineer approves the fix and still asks for a follow-up, because the database view underneath has no tenant predicate of its own and whoever writes the third caller would repeat the bug. That follow-up is pointed into the same sprint before this change is allowed to merge.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hp-console\\\",\\\"role\\\":\\\"group\\\",\\\"aria-label\\\":\\\"Pull request 482 under review, a wide console that scrolls horizontally\\\",\\\"tabIndex\\\":0,\\\"children\\\":[\\\"$\\\",\\\"$L45\\\",null,{\\\"as\\\":\\\"figure\\\",\\\"className\\\":\\\"product_figure__CFsTQ\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"product_console__JtIC_\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"product_titlebar__rns9g\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_titleGroup__MMGDe\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-git-pull-request product_titleIcon__O6a8i\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1xkwt0\\\",{\\\"cx\\\":\\\"18\\\",\\\"cy\\\":\\\"18\\\",\\\"r\\\":\\\"3\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"1lh9wr\\\",{\\\"cx\\\":\\\"6\\\",\\\"cy\\\":\\\"6\\\",\\\"r\\\":\\\"3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1yeb86\\\",{\\\"d\\\":\\\"M13 6h3a2 2 0 0 1 2 2v7\\\"}],[\\\"$\\\",\\\"line\\\",\\\"rroup\\\",{\\\"x1\\\":\\\"6\\\",\\\"x2\\\":\\\"6\\\",\\\"y1\\\":\\\"9\\\",\\\"y2\\\":\\\"21\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_title__jwaL7\\\",\\\"children\\\":[\\\"Pull request \\\",\\\"482\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_tenant__pmMjS\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono\\\",\\\"children\\\":\\\"northwind/freight-booking-api\\\"}],\\\" · \\\",\\\"Northwind Logistics Group\\\"]}]]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_titleSpacer__ZMvYH\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_titleMeta__atJAM\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono\\\",\\\"children\\\":\\\"fix/consignment-tenant-predicate\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"→\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono\\\",\\\"children\\\":\\\"main\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"delivery_commitBar__Jh_gL\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"delivery_commitMsg__lu7O_\\\",\\\"children\\\":\\\"Scope the reporting summary to the caller’s tenant\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_titleSpacer__ZMvYH\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_muted__1Uj0m\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono\\\",\\\"children\\\":\\\"NWL-4471\\\"}],\\\" · opened\\\",\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono u-tnum\\\",\\\"children\\\":\\\"2026-10-14 09:12:40\\\"}],\\\" by\\\",\\\" \\\",\\\"D. Marchetti\\\"]}]]}],[\\\"$\\\",\\\"dl\\\",null,{\\\"className\\\":\\\"delivery_facts__FCEgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"delivery_fact__pthd2\\\",\\\"style\\\":{\\\"--enter-delay\\\":\\\"0ms\\\"},\\\"children\\\":[[\\\"$\\\",\\\"dt\\\",null,{\\\"className\\\":\\\"delivery_factKey__qphev\\\",\\\"children\\\":\\\"State\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"className\\\":\\\"delivery_factVal__Lkdp5\\\",\\\"style\\\":{\\\"margin\\\":0},\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_sevBadge__tIWHP product_sevLow__yBYsg product_sevLow__yBYsg\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_sevMark__N39VN\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_srOnly__1a3B7\\\",\\\"children\\\":[\\\"Review state\\\",\\\": \\\"]}],\\\"Approved — 2 of 2 required reviews\\\"]}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"delivery_fact__pthd2\\\",\\\"style\\\":{\\\"--enter-delay\\\":\\\"60ms\\\"},\\\"children\\\":[\\\"$L9d\\\",\\\"$L9e\\\"]}],\\\"$L9f\\\",\\\"$La0\\\"]}],\\\"$La1\\\",\\\"$La2\\\",\\\"$La3\\\",\\\"$La4\\\",\\\"$La5\\\"]}],\\\"$La6\\\"]}]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"a7:Tc1d,\"])</script><script>self.__next_f.push([1,\"\\n/* ---- Chapter ------------------------------------------------------------\\n   A numbered chapter with a heading that HOLDS while its body scrolls under\\n   it. The number is not decoration: it tells a reader where they are in a long\\n   page, which is the thing a long page actually owes them. */\\n.ch {\\n  position: relative;\\n  display: grid;\\n  gap: var(--s8);\\n}\\n@media (min-width: 1024px) {\\n  .ch {\\n    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\\n    gap: var(--s16);\\n    align-items: start;\\n  }\\n}\\n\\n.ch__head {\\n  position: relative;\\n}\\n@media (min-width: 1024px) {\\n  .ch__head {\\n    position: sticky;\\n    /* Clears the fixed 72px nav plus breathing room. */\\n    top: calc(var(--nav-h) + var(--s8));\\n  }\\n}\\n\\n.ch__num {\\n  display: block;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.18em;\\n  color: var(--accent);\\n  margin-bottom: var(--s3);\\n}\\n\\n.ch__title {\\n  margin: 0;\\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\\n  letter-spacing: var(--tracking-tight);\\n  text-wrap: balance;\\n}\\n\\n.ch__lede {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  font-size: var(--text-base);\\n  line-height: 1.6;\\n  max-width: 34ch;\\n}\\n\\n.ch__rule {\\n  margin-top: var(--s6);\\n  height: 1px;\\n  background: linear-gradient(90deg, var(--accent), transparent);\\n}\\n\\n.ch__body {\\n  min-width: 0;\\n  display: grid;\\n  gap: var(--s12);\\n}\\n\\n/* ---- Sticky card stack --------------------------------------------------\\n   Every card is sticky at the SAME offset, so each comes to rest on the one\\n   before it and the stack assembles itself as you scroll. The entire effect is\\n   the equal `top` value — there is no JavaScript here at all.\\n\\n   Each card needs its own opaque background or the stack reads as a smear;\\n   that is the one thing people get wrong when copying this. */\\n.stack {\\n  display: grid;\\n  gap: var(--s8);\\n}\\n.stack__card {\\n  position: sticky;\\n  top: calc(var(--nav-h) + var(--s8));\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  padding: var(--s8);\\n  /* A hairline of the ground above each card so stacked edges stay readable. */\\n  box-shadow: 0 -1px 0 0 var(--bg);\\n}\\n@media (min-width: 768px) {\\n  .stack__card {\\n    padding: var(--s12);\\n  }\\n}\\n\\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\\n   which is what it already is semantically, so nothing is lost. */\\n@media (prefers-reduced-motion: reduce) {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n/* Sticky needs a real scroll context; without JS the layout is identical, so\\n   no .no-js override is required here. */\\n\\n.stack__index {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.16em;\\n  color: var(--accent);\\n}\\n.stack__title {\\n  margin: var(--s3) 0 0;\\n  font-size: var(--text-2xl);\\n  letter-spacing: var(--tracking-tight);\\n}\\n.stack__body {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  line-height: 1.65;\\n  max-width: 62ch;\\n}\\n\\n@media print {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n\"])</script><script>self.__next_f.push([1,\"55:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-story\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$a7\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"ch\\\",\\\"id\\\":\\\"work-release\\\",\\\"aria-labelledby\\\":\\\"work-release-title\\\",\\\"children\\\":[\\\"$La8\\\",\\\"$La9\\\"]}]]\\n\"])</script><script>self.__next_f.push([1,\"57:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"ch\\\",\\\"id\\\":\\\"work-erp\\\",\\\"aria-labelledby\\\":\\\"work-erp-title\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ch__head\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ch__num\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"03\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"ch__title\\\",\\\"id\\\":\\\"work-erp-title\\\",\\\"children\\\":\\\"And the system the business actually runs on\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"ch__lede\\\",\\\"children\\\":\\\"A month-end close in an ERP we built. Two working days, against nine on the system it replaced.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ch__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"ch__body\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L45\\\",null,{\\\"className\\\":\\\"hp-work__prose\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"ERP is where the unglamorous words live — period, reconciliation, variance, approval — and it is also where a business finds out whether the software works. This close balances to the penny: £7,306,619.29 on each side, a £0.00 variance against a £500.00 tolerance that was agreed before the first migration rehearsal rather than after the result was known.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Step two of the approval chain is a refused self-approval. The preparer tried to approve her own period at 17:44:51 and the control stopped her, and the attempt is written to the audit log rather than discarded — which is the part an auditor tests. Further down, the purchase-order threshold control carries a note saying it is enforced in the API and not only in the interface. That note exists because our own pre-go-live test found it had been enforced in the interface alone.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hp-console\\\",\\\"role\\\":\\\"group\\\",\\\"aria-label\\\":\\\"Month-end close ledger, a wide console that scrolls horizontally\\\",\\\"tabIndex\\\":0,\\\"children\\\":[\\\"$\\\",\\\"$L45\\\",null,{\\\"as\\\":\\\"figure\\\",\\\"className\\\":\\\"product_figure__CFsTQ\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"product_console__JtIC_\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"product_titlebar__rns9g\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"product_titleGroup__MMGDe\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":13,\\\"height\\\":13,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\"