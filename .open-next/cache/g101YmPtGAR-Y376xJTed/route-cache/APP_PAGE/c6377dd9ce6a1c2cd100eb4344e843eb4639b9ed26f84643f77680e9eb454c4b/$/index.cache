hich is what it already is semantically, so nothing is lost. */\n@media (prefers-reduced-motion: reduce) {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n/* Sticky needs a real scroll context; without JS the layout is identical, so\n   no .no-js override is required here. */\n\n.stack__index {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.16em;\n  color: var(--accent);\n}\n.stack__title {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-2xl);\n  letter-spacing: var(--tracking-tight);\n}\n.stack__body {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  line-height: 1.65;\n  max-width: 62ch;\n}\n\n@media print {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n55:[[\"$\",\"style\",null,{\"href\":\"envenox-story\",\"precedence\":\"default\",\"children\":\"$a7\"}],[\"$\",\"section\",null,{\"className\":\"ch\",\"id\":\"work-release\",\"aria-labelledby\":\"work-release-title\",\"children\":[\"$La8\",\"$La9\"]}]]\n57:[\"$\",\"section\",null,{\"className\":\"ch\",\"id\":\"work-erp\",\"aria-labelledby\":\"work-erp-title\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ch__head\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ch__num\",\"aria-hidden\":\"true\",\"children\":\"03\"}],[\"$\",\"h2\",null,{\"className\":\"ch__title\",\"id\":\"work-erp-title\",\"children\":\"And the system the business actually runs on\"}],[\"$\",\"p\",null,{\"className\":\"ch__lede\",\"children\":\"A month-end close in an ERP we built. Two working days, against nine on the system it replaced.\"}],[\"$\",\"div\",null,{\"className\":\"ch__rule\",\"aria-hidden\":\"true\"}]]}],[\"$\",\"div\",null,{\"className\":\"ch__body\",\"children\":[[\"$\",\"$L45\",null,{\"className\":\"hp-work__prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"ERP is where the unglamorous words live — period, reconciliation, variance, approval — and it is also where a business finds out whether the software works. This close balances to the penny: £7,306,619.29 on each side, a £0.00 variance against a £500.00 tolerance that was agreed before the first migration rehearsal rather than after the result was known.\"}],[\"$\",\"p\",null,{\"children\":\"Step two of the approval chain is a refused self-approval. The preparer tried to approve her own period at 17:44:51 and the control stopped her, and the attempt is written to the audit log rather than discarded — which is the part an auditor tests. Further down, the purchase-order threshold control carries a note saying it is enforced in the API and not only in the interface. That note exists because our own pre-go-live test found it had been enforced in the interface alone.\"}]]}],[\"$\",\"div\",null,{\"className\":\"hp-console\",\"role\":\"group\",\"aria-label\":\"Month-end close ledger, a wide console that scrolls horizontally\",\"tabIndex\":0,\"children\":[\"$\",\"$L45\",null,{\"as\":\"figure\",\"className\":\"product_figure__CFsTQ\",\"children\":[[\"$\",\"div\",null,{\"className\":\"product_console__JtIC_\",\"children\":[[\"$\",\"div\",null,{\"className\":\"product_titlebar__rns9g\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_titleGroup__MMGDe\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":13,\"height\":13,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-scale product_titleIcon__O6a8i\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"7g6ntu\",{\"d\":\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"}],[\"$\",\"path\",\"ijws7r\",{\"d\":\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"}],[\"$\",\"path\",\"1b0cd5\",{\"d\":\"M7 21h10\"}],[\"$\",\"path\",\"108xh3\",{\"d\":\"M12 3v18\"}],[\"$\",\"path\",\"3gwbw2\",{\"d\":\"M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"classN