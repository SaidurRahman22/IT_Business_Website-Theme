var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n8:[[\"$\",\"style\",null,{\"href\":\"envenox-footer\",\"precedence\":\"default\",\"children\":\"$f\"}],\"$L10\"]\n11:T30e2,\n.hp-sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.hp-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--s6);\n  flex-wrap: wrap;\n}\n\n.hp-h2 { font-size: var(--text-2xl); margin: 0; max-width: 26ch; }\n@media (min-width: 768px) { .hp-h2 { font-size: var(--text-3xl); } }\n.hp-h2--wide { max-width: 34ch; }\n\n.hp-lede { color: var(--muted-strong); max-width: 62ch; margin: var(--s6) 0 0; }\n.hp-note { color: var(--muted); font-size: var(--text-sm); max-width: 62ch; margin: 0; }\n\n.hp-stack > * + * { margin-top: var(--s12); }\n.hp-stack-tight > * + * { margin-top: var(--s6); }\n\n.hp-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  color: var(--fg);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.hp-link:hover { color: var(--muted-strong); }\n\n.hp-actions { display: flex; flex-wrap: wrap; gap: var(--s3); }\n\n/* ---- logo wall ---- */\n.hp-logos__head { margin-bottom: var(--s6); }\n\n/* ---- problem ---- */\n.hp-problem { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .hp-problem { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); }\n}\n.hp-evidence { border-left: 1px solid var(--accent); padding-left: var(--s6); }\n.hp-evidence__figure {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-3xl);\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n  margin: 0;\n}\n.hp-evidence__label { color: var(--muted); font-size: var(--text-sm); margin: var(--s2) 0 var(--s4); max-width: 42ch; }\n\n/* ---- the console wrapper ----\n   EVERY console on this page sits in one of these, and the three declarations\n   that matter are not cosmetic:\n\n   position: relative — the containing block. The .u-sr-only utility and the\n   product components' own .srOnly are position: absolute, and every\n   [data-reveal] element carries a non-none translate, which makes THAT element\n   their containing block. An absolutely positioned element is only clipped by an\n   ancestor's overflow when that ancestor is in its containing-block chain, so\n   without this, visually-hidden text inside a 1,000px-wide console table\n   escapes the scroller, lands off to the right, and silently gives the whole\n   page a horizontal scrollbar. That has cost one real 930px overflow at 390px\n   on this codebase already; globals.css documents it at .u-sr-only.\n\n   overflow-x: auto — the safety net. The consoles shrink to their container and\n   scroll their own tables internally, so this rarely bites; when a future\n   console does out-measure its column, it scrolls here rather than widening\n   the document.\n\n   min-width: 0 — a grid/flex item defaults to min-width: auto and refuses to\n   shrink below its min-content width, which would push the pillar grid wider\n   than the viewport before overflow-x ever got a chance to apply. */\n.hp-console {\n  position: relative;\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  min-width: 0;\n  max-width: 100%;\n  scrollbar-width: thin;\n  scrollbar-color: var(--border-strong) transparent;\n}\n.hp-console:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 4px;\n  border-radius: var(--radius-md);\n}\n\n/* ---- a pillar that carries its artefact beside its copy ---- */\n.hp-pillar2 { display: grid; gap: var(--s8); align-items: start; }\n.hp-pillar2 > * { min-width: 0; }\n@media (min-width: 1100px) {\n  .hp-pillar2 { grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); gap: var(--s12); }\n}\n\n/* ---- the work band ---- */\n.hp-work { display: grid; gap: var(--s20); }\n@media (min-width: 768px) { .hp-work { gap: var(--s24); } }\n.hp-work__intro { max-width: 68ch; }\n.hp-work__prose { display: grid; gap: var(--s4); }\n.hp-work__prose p { color: var(--muted-strong); margin: 0; max-width: 68ch; }\n.hp-work__tabs { display: grid; gap: var(--s6); }\n\n/* ---- the two pillars ---- */\n.hp-pillar { display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .hp-pillar {\n    grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 17rem);\n    gap: var(--s12);\n    align-items: start;\n  }\n}\n.hp-pillar__index {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--muted);\n  margin: 0;\n}\n.hp-pillar__name { font-size: var(--text-2xl); margin: 0; }\n@media (min-width: 768px) { .hp-pillar__name { font-size: var(--text-3xl); } }\n.hp-pillar__line { color: var(--muted); margin: var(--s3) 0 0; }\n.hp-pillar__body { color: var(--muted-strong); margin: var(--s6) 0 0; max-width: 62ch; }\n.hp-pillar__proof { border-top: 1px solid var(--border); padding-top: var(--s6); }\n\n/* ---- the seam. The heaviest block on the page after the hero. ---- */\n.hp-join {\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-xl);\n  background-color: var(--surface);\n  padding: var(--s8);\n  display: grid;\n  gap: var(--s12);\n}\n@media (min-width: 900px) {\n  .hp-join {\n    padding: var(--s16);\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    gap: var(--s16);\n    align-items: center;\n  }\n}\n.hp-join__heading { font-size: var(--text-3xl); margin: var(--s4) 0 0; }\n@media (min-width: 768px) { .hp-join__heading { font-size: var(--text-4xl); } }\n.hp-join__body { color: var(--muted-strong); margin: var(--s6) 0 var(--s8); max-width: 54ch; }\n.hp-join__figure {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-4xl);\n  font-weight: 600;\n  line-height: 1.02;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n  margin: 0;\n}\n@media (min-width: 768px) { .hp-join__figure { font-size: var(--text-5xl); } }\n.hp-join__figure-label { color: var(--muted); font-size: var(--text-sm); margin: var(--s4) 0 0; max-width: 34ch; }\n.hp-seam { display: block; width: 100%; height: auto; color: var(--border-strong); }\n.hp-seam__labels {\n  display: flex;\n  justify-content: space-between;\n  gap: var(--s4);\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n\n/* ---- card grids ---- */\n.hp-grid { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 640px) { .hp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1024px) { .hp-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n\n.hp-card { display: flex; flex-direction: column; height: 100%; gap: var(--s3); }\n.hp-card__icon { color: var(--muted); }\n.hp-card__title { font-size: var(--text-lg); margin: 0; }\n.hp-card__line { color: var(--muted); font-size: var(--text-sm); margin: 0; }\n.hp-card__foot {\n  margin-top: auto;\n  padding-top: var(--s4);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--s3);\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n\n/* ---- featured case study ---- */\n.hp-case { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .hp-case { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--s16); align-items: start; }\n}\n.hp-case__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3); }\n.hp-case__anon {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n.hp-case__headline { font-size: var(--text-2xl); margin: var(--s6) 0 0; max-width: 30ch; }\n@media (min-width: 768px) { .hp-case__headline { font-size: var(--text-3xl); } }\n\n.hp-metrics { display: grid; gap: var(--s6); list-style: none; margin: var(--s12) 0 0; padding: 0; }\n@media (min-width: 640px) { .hp-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; } }\n.hp-metric { border-top: 1px solid var(--border); padding-top: var(--s4); }\n@media (min-width: 640px) {\n  .hp-metric { padding: var(--s4) var(--s6) 0 0; }\n  .hp-metric + .hp-metric { border-left: 1px solid var(--border); padding-left: var(--s6); }\n}\n.hp-metric__value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  line-height: 1.1;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n  margin: 0;\n}\n.hp-metric__label { color: var(--muted-strong); font-size: var(--text-sm); margin: var(--s2) 0 0; }\n.hp-metric__note { color: var(--muted); font-size: var(--text-xs); margin: var(--s2) 0 0; }\n\n.hp-quote {\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n  padding: var(--s8);\n}\n.hp-quote blockquote {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n}\n.hp-quote figcaption { margin-top: var(--s6); font-size: var(--text-sm); color: var(--muted); }\n.hp-quote figcaption b { display: block; color: var(--fg); font-weight: 500; }\n\n/* ---- the Adversary Loop ----\n   The five steps are now a <CardStack> from components/story/Story.tsx, which\n   carries its own CSS. Nothing is needed here. */\n\n/* ---- credentials ---- */\n.hp-creds { display: grid; gap: var(--s12); }\n.hp-cred-counts { display: flex; flex-wrap: wrap; gap: var(--s6) var(--s12); list-style: none; margin: 0; padding: 0; }\n.hp-cred-count { display: flex; align-items: baseline; gap: var(--s2); }\n.hp-cred-count__n {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n}\n.hp-cred-count__l { font-size: var(--text-sm); color: var(--muted); }\n\n.hp-sub { font-size: var(--text-sm); font-weight: 500; color: var(--fg); margin: 0 0 var(--s4); }\n.hp-chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.hp-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  background-color: var(--surface);\n  color: var(--muted-strong);\n  padding: var(--s2) var(--s3);\n  font-size: var(--text-xs);\n  line-height: 1.3;\n  max-width: 100%;\n  text-decoration: none;\n  /* Colour only. */\n  transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\na.hp-chip:hover { border-color: var(--border-strong); color: var(--fg); }\n.hp-chip__mark { flex: none; color: var(--muted); }\n\n.hp-reviews { display: grid; gap: var(--s8); }\n@media (min-width: 768px) { .hp-reviews { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s12); } }\n.hp-review {\n  display: flex;\n  align-items: center;\n  gap: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s3) var(--s4);\n  color: var(--muted-strong);\n  font-size: var(--text-sm);\n  text-decoration: none;\n  transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\n.hp-review:hover { border-color: var(--border-strong); color: var(--fg); }\n.hp-review__score {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n  color: var(--fg);\n  line-height: 1;\n}\n\n/* ---- industries ---- */\n.hp-ind__name { font-size: var(--text-lg); margin: 0 0 var(--s2); }\n.hp-ind__pressure { color: var(--muted); font-size: var(--text-sm); margin: 0 0 var(--s4); }\n\n/* ---- closing ---- */\n.hp-cta { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .hp-cta { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--s16); align-items: start; }\n}\n.hp-reassure { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n.hp-reassure li {\n  display: flex;\n  gap: var(--s3);\n  color: var(--muted);\n  font-size: var(--text-sm);\n  line-height: 1.5;\n}\n.hp-reassure li::before {\n  content: '';\n  flex: none;\n  width: 6px;\n  height: 1px;\n  margin-top: 0.7em;\n  background-color: var(--border-strong);\n}\n9:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-home\",\"precedence\":\"default\",\"children\":\"$11\"}],\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],[\"$L22\"],\"$L23\"]}]\na:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L24\",null,{\"children\":\"$L25\"}],null],[\"$\",\"$L26\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$27\",null,{\"fallback\":null,\"children\":\"$L28\"}]}]}]]}]\n45:I[7664,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"4553\",\"static/chunks/4553-42d73557a9dc5e67.js\",\"7489\",\"static/chunks/7489-8556539fdb255aba.js\",\"8974\",\"static/chunks/app/page-c8132742734c5e75.js\"],\"Reveal\"]\n49:I[4773,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"4553\",\"static/chunks/4553-42d73557a9dc5e67.js\",\"7489\",\"static/chunks/7489-8556539fdb255aba.js\",\"8974\",\"static/chunks/app/page-c8132742734c5e75.js\"],\"Stat\"]\n59:I[7664,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"4553\",\"static/chunks/4553-42d73557a9dc5e67.js\",\"7489\",\"static/chunks/7489-8556539fdb255aba.js\",\"8974\",\"static/chunks/app/page-c8132742734c5e75.js\"],\"RevealGroup\"]\n86:I[4431,[],\"OutletBoundary\"]\n88:I[5278,[],\"AsyncMetadataOutlet\"]\nd:[\"$\",\"span\",null,{\"style\":{\"display\":\"block\",\"color\":\"var(--muted)\",\"fontSize\":\"var(--text-sm)\",\"marginTop\":\"var(--s1)\"},\"children\":\"Book a 60-minute scoping call\"}]\ne:[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s12)\",\"color\":\"var(--muted)\",\"fontSize\":\"var(--text-sm)\"},\"children\":[\"Everything in one list: \",[\"$\",\"$Lc\",null,{\"className\":\"u-link\",\"href\":\"/sitemap\",\"style\":{\"color\":\"var(--fg)\"},\"children\":\"site map\"}],\".\",\" \",\"In an active incident?\",\" \",[\"$\",\"a\",null,{\"className\":\"u-link u-mono\",\"href\":\"tel:+442045259100\",\"style\":{\"color\":\"var(--fg)\"},\"children\":\"+44 20 4525 9100\"}],\" \",\"— answered by a responder, 24/7.\"]}]\n10:[\"$\",\"footer\",null,{\"className\":\"foot theme-dark transition-theme grain\",\"data-theme-section\":\"dark\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"foot__top\",\"children\":[[\"$\",\"div\",null,{\"className\":\"foot__brand\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/\",\"className\":\"foot__wordmark\",\"children\":\"Envenox\"}],[\"$\",\"p\",null,{\"className\":\"foot__positioning\",\"children\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"}],[\"$\",\"a\",null,{\"className\":\"foot__hotline\",\"href\":\"tel:+442045259100\",\"data-ir-hotline\":\"footer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"foot__hotline-row\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentCol