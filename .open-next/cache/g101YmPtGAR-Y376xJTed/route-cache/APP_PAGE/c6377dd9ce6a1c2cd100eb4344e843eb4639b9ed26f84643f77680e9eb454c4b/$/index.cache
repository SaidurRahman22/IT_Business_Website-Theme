newsletter-hint\" name=\"email\"/><button class=\"foot__submit\" type=\"submit\">Subscribe</button></div><input type=\"hidden\" name=\"source\" value=\"footer\"/><p class=\"foot__form-hint\" id=\"footer-newsletter-hint\">Advisories, teardowns and methodology notes. Roughly monthly. No sales sequence, one-click unsubscribe.</p></form></div></div><div class=\"foot__bottom\"><div class=\"foot__legal\"><p class=\"foot__legal-line\">© <!-- -->2026<!-- --> <!-- -->Envenox Ltd<!-- -->. Registered in England and Wales. Registered office:<!-- --> <!-- -->1 Fore Street Avenue, London EC2Y 9DT<!-- -->.</p><ul class=\"foot__legal-nav\"><li><a class=\"foot__legal-link\" href=\"/legal/privacy\">Privacy</a></li><li><a class=\"foot__legal-link\" href=\"/legal/cookies\">Cookies</a></li><li><a class=\"foot__legal-link\" href=\"/legal/terms\">Terms</a></li><li><a class=\"foot__legal-link\" href=\"/legal/accessibility\">Accessibility</a></li><li><a class=\"foot__legal-link\" href=\"/legal/vulnerability-disclosure\">Vulnerability disclosure</a></li><li><a class=\"foot__legal-link\" href=\"/sitemap\">Sitemap</a></li></ul></div><ul class=\"foot__social\"><li><a class=\"foot__social-link\" href=\"https://www.linkedin.com/company/envenox\" rel=\"me noopener noreferrer\" target=\"_blank\"><span>LinkedIn</span><span class=\"foot__vh\"> (opens in a new tab)</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></li><li><a class=\"foot__social-link\" href=\"https://github.com/envenox\" rel=\"me noopener noreferrer\" target=\"_blank\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\" focusable=\"false\"><g transform=\"translate(2.16 2.