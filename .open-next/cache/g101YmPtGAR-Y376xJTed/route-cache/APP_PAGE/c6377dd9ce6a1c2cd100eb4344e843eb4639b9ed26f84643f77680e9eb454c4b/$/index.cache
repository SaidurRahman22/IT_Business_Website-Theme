{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"},"routeCache":{"key":"/route-cache/APP_PAGE/c6377dd9ce6a1c2cd100eb4344e843eb4639b9ed26f84643f77680e9eb454c4b/$/index","owner":{"kind":"APP_PAGE","sourceRoute":"/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c03e25c6a7b6c11d.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-home envenox-section envenox-marquee envenox-chapter-opener envenox-prose envenox-stat envenox-story envenox-reveal-group envenox-card envenox-badge envenox-statbar envenox-tabs\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.hp-sr {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.hp-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: var(--s6);\n  flex-wrap: wrap;\n}\n\n.hp-h2 { font-size: var(--text-2xl); margin: 0; max-width: 26ch; }\n@media (min-width: 768px) { .hp-h2 { font-size: var(--text-3xl); } }\n.hp-h2--wide { max-width: 34ch; }\n\n.hp-lede { color: var(--muted-strong); max-width: 62ch; margin: var(--s6) 0 0; }\n.hp-note { color: var(--muted); font-size: var(--text-sm); max-width: 62ch; margin: 0; }\n\n.hp-stack > * + * { margin-top: var(--s12); }\n.hp-stack-tight > * + * { margin-top: var(--s6); }\n\n.hp-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  color: var(--fg);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.hp-link:hover { color: var(--muted-strong); }\n\n.hp-actions { display: flex; flex-wrap: wrap; gap: var(--s3); }\n\n/* ---- logo wall ---- */\n.hp-logos__head { margin-bottom: var(--s6); }\n\n/* ---- problem ---- */\n.hp-problem { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .hp-problem { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); }\n}\n.hp-evidence { border-left: 1px solid var(--accent); padding-left: var(--s6); }\n.hp-evidence__figure {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-3xl);\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n  margin: 0;\n}\n.hp-evidence__label { color: var(--muted); font-size: var(--text-sm); margin: var(--s2) 0 var(--s4); max-width: 42ch; }\n\n/* ---- the console wrapper ----\n   EVERY console on this page sits in one of these, and the three declarations\n   that matter are not cosmetic:\n\n   position: relative — the containing block. The .u-sr-only utility and the\n   product components' own .srOnly are position: absolute, and every\n   [data-reveal] element carries a non-none translate, which makes THAT element\n   their containing block. An absolutely positioned element is only clipped by an\n   ancestor's overflow when that ancestor is in its containing-block chain, so\n   without this, visually-hidden text inside a 1,000px-wide console table\n   escapes the scroller, lands off to the right, and silently gives the whole\n   page a horizontal scrollbar. That has cost one real 930px overflow at 390px\n   on this codebase already; globals.css documents it at .u-sr-only.\n\n   overflow-x: auto — the safety net. The consoles shrink to their container and\n   scroll their own tables internally, so this rarely bites; when a future\n   console does out-measure its column, it scrolls here rather than widening\n   the document.\n\n   min-width: 0 — a grid/flex item defaults to min-width: auto and refuses to\n   shrink below its min-content width, which would push the pillar grid wider\n   than the viewport before overflow-x ever got a chance to apply. */\n.hp-console {\n  position: relative;\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  min-width: 0;\n  max-width: 100%;\n  scrollbar-width: thin;\n  scrollbar-color: var(--border-strong) transparent;\n}\n.hp-console:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 4px;\n  border-radius: var(--radius-md);\n}\n\n/* ---- a pillar that carries its artefact beside its copy ---- */\n.hp-pillar2 { display: grid; gap: var(--s8); align-items: start; }\n.hp-pillar2 > * { min-width: 0; }\n@media (min-width: 1100px) {\n  .hp-pillar2 { grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); gap: var(--s12); }\n}\n\n/* ---- the work band ---- */\n.hp-work { display: grid; gap: var(--s20); }\n@media (min-width: 768px) { .hp-work { gap: var(--s24); } }\n.hp-work__intro { max-width: 68ch; }\n.hp-work__prose { display: grid; gap: var(--s4); }\n.hp-work__prose p { color: var(--muted-strong); margin: 0; max-width: 68ch; }\n.hp-work__tabs { display: grid; gap: var(--s6); }\n\n/* ---- the two pillars ---- */\n.hp-pillar { display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .hp-pillar {\n    grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 17rem);\n    gap: var(--s12);\n    align-items: start;\n  }\n}\n.hp-pillar__index {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--muted);\n  margin: 0;\n}\n.hp-pillar__name { font-size: var(--text-2xl); margin: 0; }\n@media (min-width: 768px) { .hp-pillar__name { font-size: var(--text-3xl); } }\n.hp-pillar__line { color: var(--muted); margin: var(--s3) 0 0; }\n.hp-pillar__body { color: var(--muted-strong); margin: var(--s6) 0 0; max-width: 62ch; }\n.hp-pillar__proof { border-top: 1px solid var(--border); padding-top: var(--s6); }\n\n/* ---- the seam. The heaviest block on the page after the hero. ---- */\n.hp-join {\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-xl);\n  background-color: var(--surface);\n  padding: var(--s8);\n  display: grid;\n  gap: var(--s12);\n}\n@media (min-width: 900px) {\n  .hp-join {\n    padding: var(--s16);\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    gap: var(--s16);\n    align-items: center;\n  }\n}\n.hp-join__heading { font-size: var(--text-3xl); margin: var(--s4) 0 0; }\n@media (min-width: 768px) { .hp-join__heading { font-size: var(--text-4xl); } }\n.hp-join__body { color: var(--muted-strong); margin: var(--s6) 0 var(--s8); max-width: 54ch; }\n.hp-join__figure {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-4xl);\n  font-weight: 600;\n  line-height: 1.02;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n  margin: 0;\n}\n@media (min-width: 768px) { .hp-join__figure { font-size: var(--text-5xl); } }\n.hp-join__figure-label { color: var(--muted); font-size: var(--text-sm); margin: var(--s4) 0 0; max-width: 34ch; }\n.hp-seam { display: block; width: 100%; height: auto; color: var(--border-strong); }\n.hp-seam__labels {\n  display: flex;\n  justify-content: space-between;\n  gap: var(--s4);\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n\n/* ---- card grids ---- */\n.hp-grid { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 640px) { .hp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1024px) { .hp-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n\n.hp-card { display: flex; flex-direction: column; height: 100%; gap: var(--s3); }\n.hp-card__icon { color: var(--muted); }\n.hp-card__title { font-size: var(--text-lg); margin: 0; }\n.hp-card__line { color: var(--muted); font-size: var(--text-sm); margin: 0; }\n.hp-card__foot {\n  margin-top: auto;\n  padding-top: var(--s4);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--s3);\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n\n/* ---- featured case study ---- */\n.hp-case { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .hp-case { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--s16); align-items: start; }\n}\n.hp-case__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3); }\n.hp-case__anon {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n.hp-case__headline { font-size: var(--text-2xl); margin: var(--s6) 0 0; max-width: 30ch; }\n@media (min-width: 768px) { .hp-case__headline { font-size: var(--text-3xl); } }\n\n.hp-metrics { display: grid; gap: var(--s6); list-style: none; margin: var(--s12) 0 0; padding: 0; }\n@media (min-width: 640px) { .hp-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; } }\n.hp-metric { border-top: 1px solid var(--border); padding-top: var(--s4); }\n@media (min-width: 640px) {\n  .hp-metric { padding: var(--s4) var(--s6) 0 0; }\n  .hp-metric + .hp-metric { border-left: 1px solid var(--border); padding-left: var(--s6); }\n}\n.hp-metric__value {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  line-height: 1.1;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n  margin: 0;\n}\n.hp-metric__label { color: var(--muted-strong); font-size: var(--text-sm); margin: var(--s2) 0 0; }\n.hp-metric__note { color: var(--muted); font-size: var(--text-xs); margin: var(--s2) 0 0; }\n\n.hp-quote {\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n  padding: var(--s8);\n}\n.hp-quote blockquote {\n  margin: 0;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n}\n.hp-quote figcaption { margin-top: var(--s6); font-size: var(--text-sm); color: var(--muted); }\n.hp-quote figcaption b { display: block; color: var(--fg); font-weight: 500; }\n\n/* ---- the Adversary Loop ----\n   The five steps are now a <CardStack> from components/story/Story.tsx, which\n   carries its own CSS. Nothing is needed here. */\n\n/* ---- credentials ---- */\n.hp-creds { display: grid; gap: var(--s12); }\n.hp-cred-counts { display: flex; flex-wrap: wrap; gap: var(--s6) var(--s12); list-style: none; margin: 0; padding: 0; }\n.hp-cred-count { display: flex; align-items: baseline; gap: var(--s2); }\n.hp-cred-count__n {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: var(--tracking-tight);\n  font-variant-numeric: tabular-nums;\n}\n.hp-cred-count__l { font-size: var(--text-sm); color: var(--muted); }\n\n.hp-sub { font-size: var(--text-sm); font-weight: 500; color: var(--fg); margin: 0 0 var(--s4); }\n.hp-chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.hp-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  background-color: var(--surface);\n  color: var(--muted-strong);\n  padding: var(--s2) var(--s3);\n  font-size: var(--text-xs);\n  line-height: 1.3;\n  max-width: 100%;\n  text-decoration: none;\n  /* Colour only. */\n  transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\na.hp-chip:hover { border-color: var(--border-strong); color: var(--fg); }\n.hp-chip__mark { flex: none; color: var(--muted); }\n\n.hp-reviews { display: grid; gap: var(--s8); }\n@media (min-width: 768px) { .hp-reviews { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s12); } }\n.hp-review {\n  display: flex;\n  align-items: center;\n  gap: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s3) var(--s4);\n  color: var(--muted-strong);\n  font-size: var(--text-sm);\n  text-decoration: none;\n  transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\n.hp-review:hover { border-color: var(--border-strong); color: var(--fg); }\n.hp-review__score {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n  color: var(--fg);\n  line-height: 1;\n}\n\n/* ---- industries ---- */\n.hp-ind__name { font-size: var(--text-lg); margin: 0 0 var(--s2); }\n.hp-ind__pressure { color: var(--muted); font-size: var(--text-sm); margin: 0 0 var(--s4); }\n\n/* ---- closing ---- */\n.hp-cta { display: grid; gap: var(--s12); }\n@media (min-width: 1024px) {\n  .hp-cta { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--s16); align-items: start; }\n}\n.hp-reassure { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n.hp-reassure li {\n  display: flex;\n  gap: var(--s3);\n  color: var(--muted);\n  font-size: var(--text-sm);\n  line-height: 1.5;\n}\n.hp-reassure li::before {\n  content: '';\n  flex: none;\n  width: 6px;\n  height: 1px;\n  margin-top: 0.7em;\n  background-color: var(--border-strong);\n}\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n/* Zero the trailing padding so the globals keyframe lands exactly. */\n.marquee__track.mq-track { padding-right: 0; list-style: none; margin: 0; padding-left: 0; }\n\n.mq__item {\n  display: flex;\n  align-items: center;\n  gap: var(--s3);\n  flex: none;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s3) var(--s4);\n  min-height: 56px;\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.mq__item:hover { border-color: var(--border-strong); }\n\n.mq__logo { display: inline-flex; flex: none; color: var(--muted-strong); }\n\n.mq__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.mq__label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1.2;\n  color: var(--fg);\n  white-space: nowrap;\n}\n.mq__meta {\n  font-size: var(--text-xs);\n  line-height: 1.2;\n  color: var(--muted);\n  white-space: nowrap;\n}\n.mq__link { color: inherit; text-decoration: none; }\n.mq__link:hover .mq__label { color: var(--fg); }\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\n\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\n@media (prefers-reduced-motion: reduce) {\n  .marquee__track.mq-track { padding-right: var(--gap); }\n}\n\n.chapter {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n}\n.chapter__line {\n  font-family: var(--font-instrument-serif), ui-serif, Georgia, serif;\n  font-weight: 400;\n  font-size: var(--text-3xl);\n  line-height: 1.08;\n  letter-spacing: 0;\n  color: var(--fg);\n  max-width: 22ch;\n  text-wrap: balance;\n  margin: 0;\n}\n@media (min-width: 768px) {\n  .chapter__line { font-size: var(--text-4xl); max-width: 20ch; }\n}\n@media (min-width: 1024px) {\n  .chapter__line { font-size: var(--text-5xl); }\n}\n.chapter__line em { font-style: italic; }\n.chapter__note {\n  color: var(--muted);\n  font-size: var(--text-base);\n  max-width: 48ch;\n  margin: 0;\n}\n.chapter__rule { height: 1px; background-color: var(--border); width: 100%; }\n\n.prose {\n  color: var(--fg);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n}\n.prose > * + * { margin-top: var(--s4); }\n\n.prose h2,\n.prose h3,\n.prose h4 { color: var(--fg); text-wrap: balance; }\n.prose h2 { font-size: var(--text-2xl); margin-top: var(--s12); }\n.prose h3 { font-size: var(--text-xl); margin-top: var(--s8); }\n.prose h4 { font-size: var(--text-lg); font-weight: 500; margin-top: var(--s6); }\n.prose > h2:first-child,\n.prose > h3:first-child,\n.prose > h4:first-child { margin-top: 0; }\n.prose h2 + *,\n.prose h3 + *,\n.prose h4 + * { margin-top: var(--s3); }\n\n.prose p { color: var(--muted-strong); }\n.prose .prose__lead,\n.prose > p:first-child { color: var(--fg); font-size: var(--text-lg); }\n\n.prose a {\n  color: var(--fg);\n  text-decoration: underline;\n  text-decoration-color: color-mix(in oklab, var(--fg) 40%, transparent);\n  text-underline-offset: 3px;\n  transition: text-decoration-color var(--dur-micro) var(--ease-out);\n}\n.prose a:hover { text-decoration-color: var(--fg); }\n\n.prose strong { color: var(--fg); font-weight: 600; }\n.prose em { font-style: italic; }\n.prose small { font-size: var(--text-sm); color: var(--muted); }\n\n.prose ul,\n.prose ol { padding-left: var(--s6); color: var(--muted-strong); }\n.prose ul { list-style: none; padding-left: var(--s4); }\n.prose ul > li { position: relative; padding-left: var(--s4); }\n.prose ul > li::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0.68em;\n  width: 6px;\n  height: 1px;\n  background-color: var(--border-strong);\n}\n.prose ol { list-style: decimal; }\n.prose ol > li::marker { color: var(--muted); font-variant-numeric: tabular-nums; }\n.prose li + li { margin-top: var(--s2); }\n.prose li > ul,\n.prose li > ol { margin-top: var(--s2); }\n\n.prose blockquote {\n  border-left: 1px solid var(--border-strong);\n  padding-left: var(--s6);\n  color: var(--fg);\n  font-size: var(--text-lg);\n  line-height: var(--leading-snug);\n}\n.prose blockquote cite {\n  display: block;\n  margin-top: var(--s3);\n  font-size: var(--text-sm);\n  font-style: normal;\n  color: var(--muted);\n}\n\n.prose code {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-variant-ligatures: none;\n  font-size: 0.875em;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 1px var(--s1);\n}\n.prose pre {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  overflow-x: auto;\n}\n.prose pre code { background: none; border: 0; padding: 0; font-size: inherit; }\n\n.prose hr { border: 0; height: 1px; background-color: var(--border); margin-block: var(--s8); }\n\n.prose table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-sm);\n  font-variant-numeric: tabular-nums;\n}\n.prose th,\n.prose td { text-align: left; padding: var(--s3) var(--s4); border-bottom: 1px solid var(--border); }\n.prose th { color: var(--fg); font-weight: 500; }\n.prose td { color: var(--muted-strong); }\n\n.prose figure figcaption {\n  margin-top: var(--s3);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n.prose dt { color: var(--fg); font-weight: 500; }\n.prose dd { color: var(--muted-strong); margin-top: var(--s1); }\n.prose dd + dt { margin-top: var(--s4); }\n\n.stat { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }\n\n.stat__figure {\n  display: flex;\n  align-items: baseline;\n  gap: 1px;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  line-height: 1.05;\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  font-variant-numeric: tabular-nums;\n}\n.stat--sm .stat__figure { font-size: var(--text-xl); }\n.stat--md .stat__figure { font-size: var(--text-3xl); }\n.stat--lg .stat__figure { font-size: var(--text-4xl); }\n@media (min-width: 768px) {\n  .stat--lg .stat__figure { font-size: var(--text-5xl); }\n}\n\n/* The roll strip. overflow:hidden is what clips the sanctioned keyframe. */\n.stat__roll { display: inline-block; overflow: hidden; vertical-align: bottom; }\n.stat__value { display: inline-block; }\n.stat__roll[data-rolled='true'] > .stat__value {\n  animation: inFromBelow var(--dur-base) var(--ease-out);\n}\n.stat__suffix { color: var(--accent); }\n\n.stat__label {\n  color: var(--muted);\n  font-size: var(--text-sm);\n  line-height: 1.35;\n  margin: 0;\n  max-width: 28ch;\n}\n\n.stat__prov { font-size: var(--text-xs); color: var(--muted); }\n.stat__prov > summary {\n  cursor: pointer;\n  list-style: none;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  color: var(--muted);\n  border-bottom: 1px dotted var(--border-strong);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.stat__prov > summary::-webkit-details-marker { display: none; }\n.stat__prov > summary:hover { color: var(--fg); }\n.stat__prov > p {\n  margin: var(--s2) 0 0;\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  line-height: 1.5;\n  color: var(--muted);\n  max-width: 34ch;\n}\n\n/* ---- Chapter ------------------------------------------------------------\n   A numbered chapter with a heading that HOLDS while its body scrolls under\n   it. The number is not decoration: it tells a reader where they are in a long\n   page, which is the thing a long page actually owes them. */\n.ch {\n  position: relative;\n  display: grid;\n  gap: var(--s8);\n}\n@media (min-width: 1024px) {\n  .ch {\n    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\n    gap: var(--s16);\n    align-items: start;\n  }\n}\n\n.ch__head {\n  position: relative;\n}\n@media (min-width: 1024px) {\n  .ch__head {\n    position: sticky;\n    /* Clears the fixed 72px nav plus breathing room. */\n    top: calc(var(--nav-h) + var(--s8));\n  }\n}\n\n.ch__num {\n  display: block;\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.18em;\n  color: var(--accent);\n  margin-bottom: var(--s3);\n}\n\n.ch__title {\n  margin: 0;\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\n  letter-spacing: var(--tracking-tight);\n  text-wrap: balance;\n}\n\n.ch__lede {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  font-size: var(--text-base);\n  line-height: 1.6;\n  max-width: 34ch;\n}\n\n.ch__rule {\n  margin-top: var(--s6);\n  height: 1px;\n  background: linear-gradient(90deg, var(--accent), transparent);\n}\n\n.ch__body {\n  min-width: 0;\n  display: grid;\n  gap: var(--s12);\n}\n\n/* ---- Sticky card stack --------------------------------------------------\n   Every card is sticky at the SAME offset, so each comes to rest on the one\n   before it and the stack assembles itself as you scroll. The entire effect is\n   the equal `top` value — there is no JavaScript here at all.\n\n   Each card needs its own opaque background or the stack reads as a smear;\n   that is the one thing people get wrong when copying this. */\n.stack {\n  display: grid;\n  gap: var(--s8);\n}\n.stack__card {\n  position: sticky;\n  top: calc(var(--nav-h) + var(--s8));\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  /* A hairline of the ground above each card so stacked edges stay readable. */\n  box-shadow: 0 -1px 0 0 var(--bg);\n}\n@media (min-width: 768px) {\n  .stack__card {\n    padding: var(--s12);\n  }\n}\n\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\n   which is what it already is semantically, so nothing is lost. */\n@media (prefers-reduced-motion: reduce) {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n/* Sticky needs a real scroll context; without JS the layout is identical, so\n   no .no-js override is required here. */\n\n.stack__index {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.16em;\n  color: var(--accent);\n}\n.stack__title {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-2xl);\n  letter-spacing: var(--tracking-tight);\n}\n.stack__body {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  line-height: 1.65;\n  max-width: 62ch;\n}\n\n@media print {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n\n.reveal-group > * { --reveal-delay: calc(var(--reveal-base, 0ms) + 0ms); }\n.reveal-group > *:nth-child(2) { --reveal-delay: calc(var(--reveal-base, 0ms) + 60ms); }\n.reveal-group > *:nth-child(3) { --reveal-delay: calc(var(--reveal-base, 0ms) + 120ms); }\n.reveal-group > *:nth-child(4) { --reveal-delay: calc(var(--reveal-base, 0ms) + 180ms); }\n.reveal-group > *:nth-child(n + 5) { --reveal-delay: calc(var(--reveal-base, 0ms) + 240ms); }\n\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n\n.statbar {\n  display: grid;\n  gap: var(--s8);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.statbar > li { min-width: 0; }\n\n@media (min-width: 640px) {\n  .statbar { gap: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .statbar > li { padding: var(--s6) var(--s6) var(--s6) 0; border-top: 1px solid var(--border); }\n  .statbar > li + li { border-left: 1px solid var(--border); padding-left: var(--s6); }\n  /* The second cell of each pair starts a new row edge, not a mid-row border. */\n  .statbar--2 > li:nth-child(2n + 1) { border-left: 0; padding-left: 0; }\n}\n@media (min-width: 1024px) {\n  .statbar--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .statbar--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .statbar--3 > li:nth-child(2n + 1),\n  .statbar--4 > li:nth-child(2n + 1) { border-left: 1px solid var(--border); padding-left: var(--s6); }\n  .statbar--3 > li:first-child,\n  .statbar--4 > li:first-child { border-left: 0; padding-left: 0; }\n}\n\n.tabs__list {\n  display: flex;\n  gap: var(--s1);\n  border-bottom: 1px solid var(--border);\n  overflow-x: auto;\n  scrollbar-width: none;\n}\n.tabs__list::-webkit-scrollbar { display: none; }\n\n.tabs__trigger {\n  position: relative;\n  flex: none;\n  appearance: none;\n  background: none;\n  border: 0;\n  border-bottom: 1px solid transparent;\n  margin-bottom: -1px;\n  padding: var(--s3) var(--s4);\n  min-height: 44px;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted);\n  cursor: pointer;\n  white-space: nowrap;\n  /* Colour only. No transform on hover or on selection. */\n  transition:\n    color var(--dur-base) var(--ease-out),\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.tabs__trigger:hover { color: var(--fg); background-color: var(--surface); }\n.tabs__trigger[data-state='active'] { color: var(--fg); border-bottom-color: var(--accent); }\n\n.tabs__panel { outline: none; padding-top: var(--s6); }\n.tabs__panel:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }\n\n/* Shown only when the no-js class survives, i.e. scripting is unavailable. */\n.tabs__nojs-label { display: none; }\n.no-js .tabs__list { display: none; }\n.no-js .tabs__panel[hidden] { display: block; }\n.no-js .tabs__nojs-label {\n  display: block;\n  font-size: var(--text-xl);\n  margin-bottom: var(--s3);\n}\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/4553-42d73557a9dc5e67.js\" async=\"\"></script><script src=\"/_next/static/chunks/7489-8556539fdb255aba.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-c8132742734c5e75.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>Envenox — We build the software. Then we try to break it.</title><meta name=\"description\" content=\"Envenox is a software development firm. We ship production systems — ERP, platforms, web applications — and we keep an offensive security practice on staff whose findings land in the same sprint backlog our engineers work from. Median nine days from a finding being confirmed to the fix being live.\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"We build the software. Then we try to break it — before anyone else gets the chance.\"/><meta property=\"og:description\" content=\"Envenox is a software development firm. We ship production systems — ERP, platforms, web applications — and we keep an offensive security practice on staff whose findings land in the same sprint backlog our engineers work from. Median nine days from a finding being confirmed to the fix being live.\"/><meta property=\"og:url\" content=\"https://envenox.com\"/><meta property=\"og:site_name\" content=\"Envenox\"/><meta property=\"og:locale\" content=\"en_GB\"/><meta property=\"og:image:alt\" content=\"Envenox — cybersecurity and software development\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image\" content=\"https://envenox.com/opengraph-image?be415c17a8510f02\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"We build the software. Then we try to break it — before anyone else gets the chance.\"/><meta name=\"twitter:description\" content=\"Envenox is a software development firm. We ship production systems — ERP, platforms, web applications — and we keep an offensive security practice on staff whose findings land in the same sprint backlog our engineers work from. Median nine days from a finding being confirmed to the fix being live.\"/><meta name=\"twitter:image:alt\" content=\"Envenox — cybersecurity and software development\"/><meta name=\"twitter:image:type\" content=\"image/png\"/><meta name=\"twitter:image\" content=\"https://envenox.com/opengraph-image?be415c17a8510f02\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav theme-dark transition-theme no-print\" data-scrolled=\"false\" data-nav-theme=\"dark\"><div class=\"nav__bar u-container\"><a class=\"nav__brand\" href=\"/\">Envenox</a><nav aria-label=\"Primary\" data-orientation=\"horizontal\" dir=\"ltr\" class=\"nav__desktop\"><div style=\"position:relative\"><ul data-orientation=\"horizontal\" class=\"nav__list\" dir=\"ltr\"><li><button id=\"radix-_R_klb_-trigger-Services\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Services\" class=\"nav__trigger\" data-radix-collection-item=\"\">Services<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Services\" aria-labelledby=\"radix-_R_klb_-trigger-Services\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/services/devsecops\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Secure SDLC</span><span class=\"nav__featured-blurb\">The page that explains why one firm does both. Start here.</span></a><ul class=\