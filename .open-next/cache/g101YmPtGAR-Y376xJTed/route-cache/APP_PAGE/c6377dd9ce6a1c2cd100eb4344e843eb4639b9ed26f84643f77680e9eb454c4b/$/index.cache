block;\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.18em;\\n  color: var(--accent);\\n  margin-bottom: var(--s3);\\n}\\n\\n.ch__title {\\n  margin: 0;\\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\\n  letter-spacing: var(--tracking-tight);\\n  text-wrap: balance;\\n}\\n\\n.ch__lede {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  font-size: var(--text-base);\\n  line-height: 1.6;\\n  max-width: 34ch;\\n}\\n\\n.ch__rule {\\n  margin-top: var(--s6);\\n  height: 1px;\\n  background: linear-gradient(90deg, var(--accent), transparent);\\n}\\n\\n.ch__body {\\n  min-width: 0;\\n  display: grid;\\n  gap: var(--s12);\\n}\\n\\n/* ---- Sticky card stack --------------------------------------------------\\n   Every card is sticky at the SAME offset, so each comes to rest on the one\\n   before it and the stack assembles itself as you scroll. The entire effect is\\n   the equal `top` value — there is no JavaScript here at all.\\n\\n   Each card needs its own opaque background or the stack reads as a smear;\\n   that is the one thing people get wrong when copying this. */\\n.stack {\\n  display: grid;\\n  gap: var(--s8);\\n}\\n.stack__card {\\n  position: sticky;\\n  top: calc(var(--nav-h) + var(--s8));\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  padding: var(--s8);\\n  /* A hairline of the ground above each card so stacked edges stay readable. */\\n  box-shadow: 0 -1px 0 0 var(--bg);\\n}\\n@media (min-width: 768px) {\\n  .stack__card {\\n    padding: var(--s12);\\n  }\\n}\\n\\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\\n   which is what it already is semantically, so nothing is lost. */\\n@media (prefers-reduced-motion: reduce) {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n/* Sticky needs a real scroll context; without JS the layout is identical, so\\n   no .no-js override is required here. */\\n\\n.stack__index {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.16em;\\n  color: var(--accent);\\n}\\n.stack__title {\\n  margin: var(--s3) 0 0;\\n  font-size: var(--text-2xl);\\n  letter-spacing: var(--tracking-tight);\\n}\\n.stack__body {\\n  margin: var(--s4) 0 0;\\n  color: var(--muted);\\n  line-height: 1.65;\\n  max-width: 62ch;\\n}\\n\\n@media print {\\n  .stack__card,\\n  .ch__head {\\n    position: static;\\n  }\\n}\\n\"])</script><script>self.__next_f.push([1,\"1d:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"loop-heading\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"hp-stack\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L45\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"How we work\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"loop-heading\\\",\\\"className\\\":\\\"hp-h2\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s4)\\\"},\\\"children\\\":\\\"The Adversary Loop\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"hp-lede\\\",\\\"children\\\":\\\"Threat models shape the build. The build gets attacked. The attack rewrites the threat model.\\\"}]]}],[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"