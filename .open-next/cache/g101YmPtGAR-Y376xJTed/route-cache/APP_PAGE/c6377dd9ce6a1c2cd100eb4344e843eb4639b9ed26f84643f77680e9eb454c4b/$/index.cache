ot a mid-row border. */\\n  .statbar--2 > li:nth-child(2n + 1) { border-left: 0; padding-left: 0; }\\n}\\n@media (min-width: 1024px) {\\n  .statbar--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\\n  .statbar--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\\n  .statbar--3 > li:nth-child(2n + 1),\\n  .statbar--4 > li:nth-child(2n + 1) { border-left: 1px solid var(--border); padding-left: var(--s6); }\\n  .statbar--3 > li:first-child,\\n  .statbar--4 > li:first-child { border-left: 0; padding-left: 0; }\\n}\\n\"}],[\"$\",\"ul\",null,{\"className\":\"statbar statbar--4\",\"aria-label\":\"Envenox at a glance\",\"style\":\"$undefined\",\"children\":[[\"$\",\"$L49\",\"engineers and testers on staff\",{\"as\":\"li\",\"value\":\"38\",\"suffix\":\"$undefined\",\"label\":\"engineers and testers on staff\",\"source\":\"Internal headcount register\",\"asOf\":\"2026-10-01\",\"size\":\"lg\",\"provenance\":\"details\"}],[\"$\",\"$L49\",\"years operating\",{\"as\":\"li\",\"value\":\"11\",\"suffix\":\"$undefined\",\"label\":\"years operating\",\"source\":\"Companies House incorporation record\",\"asOf\":\"2026-01-01\",\"size\":\"lg\",\"provenance\":\"details\"}],[\"$\",\"$L49\",\"engagements delivered\",{\"as\":\"li\",\"value\":\"240\",\"suffix\":\"+\",\"label\":\"engagements delivered\",\"source\":\"Delivery system export\",\"asOf\":\"2026-10-01\",\"size\":\"lg\",\"provenance\":\"details\"}],[\"$\",\"$L49\",\"net promoter score\",{\"as\":\"li\",\"value\":\"71\",\"suffix\":\"$undefined\",\"label\":\"net promoter score\",\"source\":\"Post-engagement survey, 94 responses\",\"asOf\":\"2026-09-30\",\"size\":\"lg\",\"provenance\":\"details\"}]]}]]]}]}]]\n63:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weig