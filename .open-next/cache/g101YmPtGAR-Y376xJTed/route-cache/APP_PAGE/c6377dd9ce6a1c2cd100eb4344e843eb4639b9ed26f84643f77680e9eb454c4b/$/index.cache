{ min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n15:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"split-heading\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"hp-stack\",\"children\":[[\"$\",\"$L45\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Two practices\"}],[\"$\",\"h2\",null,{\"id\":\"split-heading\",\"className\":\"hp-h2 hp-h2--wide\",\"style\":{\"marginTop\":\"var(--s4)\"},\"children\":\"One of these firms attacks systems. The other builds them. They sit nine metres apart.\"}]]}],[\"$\",\"$L45\",null,{\"className\":\"hp-pillar2\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"hp-pillar__index\",\"children\":\"01 / 02\"}],[\"$\",\"h3\",null,{\"className\":\"hp-pillar__name\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Software development\"}],[\"$\",\"p\",null,{\"className\":\"hp-pillar__line\",\"children\":\"Products, platforms and the business systems a company runs on.\"}],[\"$\",\"p\",null,{\"className\":\"hp-pillar__body\",\"children\":\"We build and hand over production systems — custom software, web applications, ERP, CRM, platform and DevOps. Our engineers work next to a practice that will attack what they build, which changes how authorisation, audit logging and secrets get designed: in week one, against a threat model, rather than in month ten against a report.\"}],[\"$\",\"div\",null,{\"className\":\"hp-pillar__proof\",\"style\":{\"marginTop\":\"var(--s8)\"},\"children\":[\"$\",\"$L49\",null,{\"value\":\"27 of 31\",\"label\":\"systems we have built are now run by the client’s own team\",\"size\":\"md\",\"provenance\":\"none\"}]}],[\"$\",\"div\",null,{\"style\":{\"marginTop\":\"var(--s8)\"},\"chi