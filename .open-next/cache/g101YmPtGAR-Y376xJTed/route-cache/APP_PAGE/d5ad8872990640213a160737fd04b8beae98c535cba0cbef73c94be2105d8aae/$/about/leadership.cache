--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n1a:[\"$\",\"div\",\"software\",{\"className\":\"about_pillarBlock__2tJWS\",\"children\":[[\"$\",\"div\",null,{\"className\":\"about_pillarHead__BxbTU\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"about_pillarName__wbOJs\",\"id\":\"group-software\",\"children\":\"Software practice\"}],[\"$\",\"span\",null,{\"className\":\"u-mono about_pillarCount__4_bMy\",\"children\":\"2 people\"}]]}],[\"$\",\"$L13\",null,{\"as\":\"ul\",\"className\":\"about_peopleGrid__trO0w\",\"aria-labelledby\":\"group-software\",\"children\":[[\"$\",\"$L14\",\"marcus-reid\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$35\"}],[\"$\",\"article\",null,{\"className\":\"card card--pad-lg\",\"data-interactive\":\"$undefined\",\"style\":{\"height\":\"100%\"},\"children\":[\"$\",\"div\",null,{\"className\":\"about_personCardInner__rkfGi\",\"children\":[[\"$\",\"div\",null,{\"className\":\"about_personTop__2J4G_\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-avatar-placeholder\",\"precedence\":\"default\",\"children\":\"\\n.avatar-ph {\\n  display: grid;\\n  place-items: center;\\n  flex: none;\\n  border-radius: var(--radius-md);\\n  border: 1px solid var(--border);\\n  color: var(--paper-50);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 600;\\n  letter-spacing: 0.02em;\\n  line-height: 1;\\n  user-select: none;\\n  overflow: hidden;\\n}\\n.avatar-ph--round { border-radius: 50%; }\\n\"}],[\"$\",\"div\",null,{\"role\":\"img\",\"aria-label\":\"Placeholder portrait for Marcus Reid\",\"className\":\"avatar-ph\",\"style\":{\"width\":64,\"height\":64,\"fontSize\":22,\"backgroundImage\":\"linear-gradient(135deg, hsl(319 18% 22%), hsl(319 22% 14%))\"},\"children\":[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"MR\"}]}]],[\"$\",\"div\",null,{\"style\":{\"minWid