ace);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n1d:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section-tight\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-cta-band\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"sv-h2\",\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-cta-band__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$48\"}],\"$L49\"],\"$L4a\"]}]]}]}]}]]\n1e:[\"$\",\"$L4b\",null,{\"children\":[\"$L4c\",[\"$\",\"$L4d\",null,{\"promise\":\"$@4e\"}]]}]\n24:[\"$\",\"li\",\"/services/qa-automation\",{\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/qa-automation\",\"className\":\"foot__link\",\"children\":\"QA & Test Automation\"}]}]\n25:[\"$\",\"div\",\"Company\",{\"childre