isplay: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n3f:[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-prose-measure\",\"style\":{\"margin\":0,\"color\":\"var(--muted-strong)\"},\"children\":\"The standard arrangement is that a development firm builds your software for forty weeks and a security firm tests it in week forty-one. Everything that test finds is now expensive, because the architecture is set, the team is rolling off, and a finding that requires a design change arrives after the design is load-bearing. Both firms behaved correctly and the outcome is still bad. Our two practices run against each other continuously instead: our testers review the design before it is built, read the code as it is written, and raise findings into the same backlog our engineers work from. The number that matters is the nine days between a finding being confirmed and the fix being live, and it is only possible because there is no handover in the middle.\"}],[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s6)\"},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$66\"}],\"$L67\"]}]]}]\n40:[\"$\",\"span\",null,{\"className\":\"sv-accred__issuer\",\"children\":\"CREST International\"}]\n41:[\"$\",\"li\",\"pci-qsa\",{\"className\":\"sv-accred__item\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-badge-check sv-accred__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"3c2336\",{\"d\":\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-accred__label\",\"children\":\"PCI QSA — qualified assessor company\"}],[\"$\",\"span\",null,{\"className\":\"sv-accred__issuer\",\"children\":\"PCI Security Standards Council\"}]]}]]}]\n42:[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/certifications\",\"children\":\"Every certificate number and expiry date is published\"}],\" · \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/trust\",\"children\":\"Our own security posture\"}]]}