ddress\\\":\\\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\\\",\\\"addressLocality\\\":\\\"Dhaka\\\",\\\"addressCountry\\\":\\\"Bangladesh\\\"}],\\\"contactPoint\\\":[{\\\"@type\\\":\\\"ContactPoint\\\",\\\"contactType\\\":\\\"emergency\\\",\\\"name\\\":\\\"Incident response hotline\\\",\\\"telephone\\\":\\\"+44 20 4525 9100\\\",\\\"availableLanguage\\\":[\\\"en\\\"],\\\"hoursAvailable\\\":{\\\"@type\\\":\\\"OpeningHoursSpecification\\\",\\\"dayOfWeek\\\":[\\\"Monday\\\",\\\"Tuesday\\\",\\\"Wednesday\\\",\\\"Thursday\\\",\\\"Friday\\\",\\\"Saturday\\\",\\\"Sunday\\\"],\\\"opens\\\":\\\"00:00\\\",\\\"closes\\\":\\\"23:59\\\"}},{\\\"@type\\\":\\\"ContactPoint\\\",\\\"contactType\\\":\\\"sales\\\",\\\"email\\\":\\\"hello@envenox.com\\\",\\\"telephone\\\":\\\"+44 20 4525 9101\\\",\\\"availableLanguage\\\":[\\\"en\\\"]},{\\\"@type\\\":\\\"ContactPoint\\\",\\\"contactType\\\":\\\"security\\\",\\\"email\\\":\\\"security@envenox.com\\\",\\\"availableLanguage\\\":[\\\"en\\\"]}]},{\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://envenox.com/#website\\\",\\\"url\\\":\\\"https://envenox.com\\\",\\\"name\\\":\\\"Envenox\\\",\\\"description\\\":\\\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\\\",\\\"inLanguage\\\":\\\"en-GB\\\",\\\"publisher\\\":{\\\"@id\\\":\\\"https://envenox.com/#organization\\\"}}]}\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"g101YmPtGAR-Y376xJTed\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"services\\\",\\\"cybersecurity\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"services\\\",{\\\"children\\\":[\\\"cybersecurity\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link