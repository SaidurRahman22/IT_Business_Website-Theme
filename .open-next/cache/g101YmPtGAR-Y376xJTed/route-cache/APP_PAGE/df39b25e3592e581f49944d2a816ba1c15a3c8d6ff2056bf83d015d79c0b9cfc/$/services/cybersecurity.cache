ground-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\\n  border-color: var(--border-strong);\\n}\\n\\n/* The stretched link. The anchor's own text stays the accessible name. */\\n.card__link {\\n  color: inherit;\\n  text-decoration: none;\\n  outline-offset: 4px;\\n}\\n.card__link::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  border-radius: inherit;\\n  z-index: 1;\\n}\\n/* Anything that must stay clickable inside a stretched-link card. */\\n.card__above { position: relative; z-index: 2; }\\n\"])</script><script>self.__next_f.push([1,\"18:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"pillar-services\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"What you can buy\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"pillar-services\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Cybersecurity services\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-head__lede\\\",\\\"children\\\":\\\"Testing, assurance, detection and response — by people who also ship production software.\\\"}]]}],[\\\"$\\\",\\\"$L2e\\\",null,{\