:[[\"$\",\"span\",null,{\"className\":\"product_sevBadge__tIWHP product_sevCritical__qnAYH\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevMark__N39VN\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"className\":\"product_srOnly__1a3B7\",\"children\":[\"Status\",\": \"]}],\"Detection\"]}],[\"$\",\"span\",null,{\"className\":\"product_chipCount__IT0BR u-mono u-tnum\",\"children\":2}]]}],[\"$\",\"span\",\"isolated\",{\"className\":\"product_legendItem__rbLW6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevBadge__tIWHP product_sevHigh__aqAna\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevMark__N39VN\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"className\":\"product_srOnly__1a3B7\",\"children\":[\"Status\",\": \"]}],\"Isolated\"]}],[\"$\",\"span\",null,{\"className\":\"product_chipCount__IT0BR u-mono u-tnum\",\"children\":1}]]}],[\"$\",\"span\",\"stale-telemetry\",{\"className\":\"product_legendItem__rbLW6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevBadge__tIWHP product_sevMedium__b33PA\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevMark__N39VN\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"className\":\"product_srOnly__1a3B7\",\"children\":[\"Status\",\": \"]}],\"Stale telemetry\"]}],[\"$\",\"span\",null,{\"className\":\"product_chipCount__IT0BR u-mono u-tnum\",\"children\":4}]]}],[\"$\",\"span\",\"healthy\",{\"className\":\"product_legendItem__rbLW6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevBadge__tIWHP product_sevLow__yBYsg\",\"children\":[[\"$\",\"span\",null,{\"className\":\"product_sevMark__N39VN\",\"aria-hidden\":\"true\"}],[\"$\",\"span\",null,{\"className\":\"product_srOnly__1a3B7\",\"children\":[\"Status\",\": \"]}],\"Healthy\"]}],[\"$\",\"span\",null,{\"className\":\"product_chipCount__IT0BR u-mono u-tnum\",\"children\":41}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"product_scroller__YfDg4 product_fleetScroll__waFX9\",\"role\":\"group\",\"aria-label\":\"Monitored endpoints, scrolls vertically\",\"tabIndex\":0,\"children\":\"$L7e\"}],\"$L7f\",\"$L80\"]}],\"$L81\"]}]}]]}]\n45:[\"$\",\"figure\",null,{\"className\":\"dg dg-scope\",\"children\":[[\"$\",\"div\",null,{\"className\":\"dg-scopeIn\",\"children\":[[\"$\",\"p\",null,{\"className\":\"dg-scopeTag u-mono\",\"children\":[\"Inside the boundary\",[\"$\",\"span\",null,{\"className\":\"dg-scopeCount\",\"children\":\"6 surfaces\"}]]}],[\"$\",\"ol\",null,{\"className\":\"dg-scopeGrid\",\"children\":[[\"$\",\"li\",\"Identity and access review\",{\"className\":\"dg-scopeCell\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-scopeNum\",\"aria-hidden\":\"true\",\"children\":\"01\"}],[\"$\",\"h3\",null,{\"className\":\"dg-scopeName\",\"children\":\"Identity and access review\"}],[\"$\",\"p\",null,{\"className\":\"dg-scopeBody\",\"children\":\"IAM policies, trust relationships, permission boundaries, SCPs, and every path from an assumable identity to a privileged one.\"}]]}],[\"$\",\"li\",\"Network and perimeter\",{\"className\":\"dg-scopeCell\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-scopeNum\",\"aria-hidden\":\"true\",\"children\":\"02\"}],[\"$\",\"h3\",null,{\"className\":\"dg-scopeName\",\"children\":\"Network and perimeter\"}],[\"$\",\"p\",null,{\"className\":\"dg-scopeBody\",\"children\":\"VPC design, security groups, NACLs, private endpoints, egress control, and what is actually reachable from the internet versus what you believe is.\"}]]}],[\"$\",\"li\",\"Data protection\",{\"className\":\"dg-scopeCell\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-scopeNum\",\"aria-hidden\":\"true\",\"children\":\"03\"}],[\"$\",\"h3\",null,{\"className\":\"dg-scopeName\",\"children\":\"Data protection\"}],[\"$\",\"p\",null,{\"className\":\"dg-scopeBody\",\"children\":\"Encryption at rest and in transit, KMS key policies, and who can decrypt what through which role chain.\"}]]}],[\"$\",\"li\",\"Workload security\",{\"className\":\"dg-scopeCell\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-scopeNum\",\"aria-hidden\":\"true\",\"children\":\"04\"}],[\"$\",\"h3\",null,{\"className\":\"dg-scopeName\",\"children\":\"Workload security\"}],[\"$\",\"p\",null,{\"className\":\"dg-scopeBody\",\"children\":\"Container images, Kubernetes RBAC and admission control, serverless execution roles, and metadata service access from compute.\"}]]}],[\"$\",\"li\",\"CI/CD and supply chain\",{\"className\":\"dg-scopeCell\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-scopeNum\",\"aria-hidden\":\"true\",\"children\":\"05\"}],[\"$\",\"h3\",null,{\"className\":\"dg-scopeName\",\"children\":\"CI/CD and supply chain\"}],[\"$\",\"p\",null,{\"className\":\"dg-scopeBody\",\"children\":\"Pipeline identities, OIDC federation to your repository provider, artefact signing, and the branch protection that stands between a pull request and production.\"}]]}],[\"$\",\"li\",\"Detection coverage\",{\"className\":\"dg-scopeCell\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-scopeNum\",\"aria-hidden\":\"true\",\"children\":\"06\"}],[\"$\",\"h3\",null,{\"className\":\"dg-scopeName\",\"children\":\"Detection coverage\"}],[\"$\",\"p\",null,{\"className\":\"dg-scopeBody\",\"children\":\"What your current logging would and would not have caught, mapped against MITRE ATT&CK for Cloud.\"}]]}]]}]]}],null]}]\n47:[\"$\",\"figure\",null,{\"className\":\"dg\",\"id\":\"engagement-shape\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"dg-gantt\",\"viewBox\":\"0 0 1000 252\",\"preserveAspectRatio\":\"xMidYMid meet\",\"role\":\"img\",\"aria-label\":\"Engagement shape for Cloud Security: 6 phases. Phase 1, Inventory, Week 1, inside the engagement window. Phase 2, Path analysis, Week 1–2, inside the engagement window, producing the identity graph with every privilege-escalation and lateral-movement path, as a diagram and as queryable data. Phase 3, Configuration review, Week 2, inside the engagement window, producing the configuration findings filtered to what is exploitable in your topology, with cis benchmark mapping. Phase 4, Detection gap analysis, Week 3, inside the engagement window, producing the detection coverage matrix against mitre att&ck for cloud. Phase 5, Remediation plan, Week 3, inside the engagement window, producing the verification report after remediation. Phase 6, Verification, Week 6, inside the engagement window.\",\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-axisUnit\",\"x\":0,\"y\":16,\"children\":\"weeks from kick-off\"}],[[\"$\",\"g\",\"0\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":236,\"y1\":30,\"x2\":236,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":236,\"y\":24,\"textAnchor\":\"middle\",\"children\":0}]]}],[\"$\",\"g\",\"2\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":403.3333333333333,\"y1\":30,\"x2\":403.3333333333333,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":403.3333333333333,\"y\":24,\"textAnchor\":\"middle\",\"children\":2}]]}],[\"$\",\"g\",\"4\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":570.6666666666666,\"y1\":30,\"x2\":570.6666666666666,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":570.6666666666666,\"y\":24,\"textAnchor\":\"middle\",\"children\":4}]]}],[\"$\",\"g\",\"6\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":738,\"y1\":30,\"x2\":738,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":738,\"y\":24,\"textAnchor\":\"middle\",\"children\":6}]]}]],[[\"$\",\"line\",null,{\"className\":\"dg-zero\",\"x1\":236,\"y1\":30,\"x2\":236,\"y2\":232}],[\"$\",\"text\",null,{\"className\":\"dg-zeroLabel\",\"x\":236,\"y\":245,\"textAnchor\":\"middle\",\"children\":\"kick-off\"}]],[\"$\",\"text\",null,{\"className\":\"dg-colHead\",\"x\":762,\"y\":16,\"children\":\"Drops out\"}],[[\"$\",\"g\",\"1\",{\"children\":[