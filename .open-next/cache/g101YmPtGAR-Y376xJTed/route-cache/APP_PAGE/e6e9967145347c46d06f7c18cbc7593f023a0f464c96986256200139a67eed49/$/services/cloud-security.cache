und\",\"className\":\"lucide lucide-badge-check sv-accred__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"3c2336\",{\"d\":\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-accred__label\",\"children\":\"PCI QSA — qualified assessor company\"}],[\"$\",\"span\",null,{\"className\":\"sv-accred__issuer\",\"children\":\"PCI Security Standards Council\"}]]}]]}]\n4f:[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/certifications\",\"children\":\"Every certificate number and expiry date is published\"}],\" · \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/trust\",\"children\":\"Our own security posture\"}]]}]\n53:[\"$\",\"span\",null,{\"className\":\"badge badge--md badge--brand\",\"children\":[null,\"GIAC GCDA\"]}]\n8e:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to