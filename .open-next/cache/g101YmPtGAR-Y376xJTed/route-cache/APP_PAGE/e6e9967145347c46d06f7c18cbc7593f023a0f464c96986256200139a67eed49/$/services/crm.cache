{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/services/layout,_N_T_/services/[slug]/layout,_N_T_/services/[slug]/page,_N_T_/services/crm"},"routeCache":{"key":"/route-cache/APP_PAGE/e6e9967145347c46d06f7c18cbc7593f023a0f464c96986256200139a67eed49/$/services/crm","owner":{"kind":"APP_PAGE","sourceRoute":"/services/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c03e25c6a7b6c11d.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-services envenox-section envenox-reveal-group envenox-card envenox-service-diagrams envenox-badge envenox-avatar-placeholder envenox-marquee envenox-faq envenox-story\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ---------- page-level type ---------- */\n.sv-h1 {\n  font-size: clamp(2rem, 6.4vw, 3.75rem);\n  margin: 0;\n  max-width: 20ch;\n}\n.sv-h1--long { max-width: 24ch; font-size: clamp(1.875rem, 5.6vw, 3rem); }\n.sv-sub {\n  margin: var(--s4) 0 0;\n  font-size: var(--text-lg);\n  color: var(--muted-strong);\n  max-width: 54ch;\n}\n.sv-lede {\n  margin: var(--s6) 0 0;\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n.sv-h2 {\n  font-size: clamp(1.5rem, 3.6vw, 2.25rem);\n  margin: 0;\n  max-width: 24ch;\n}\n.sv-h3 {\n  font-size: var(--text-xl);\n  margin: 0;\n}\n.sv-note {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-sm);\n  color: var(--muted);\n  max-width: 68ch;\n}\n\n/* ---------- section head ---------- */\n.sv-head { margin-bottom: var(--s12); }\n.sv-head__rule { height: 1px; background-color: var(--border); margin-bottom: var(--s6); }\n.sv-head__eyebrow { margin: 0 0 var(--s3); }\n.sv-head__lede { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 68ch; }\n\n/* ---------- hero ---------- */\n.sv-hero__eyebrow { margin: 0 0 var(--s4); }\n.sv-hero__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s3);\n  margin-top: var(--s8);\n}\n.sv-hero__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s2) var(--s6);\n  margin: var(--s6) 0 0;\n  padding: 0;\n  list-style: none;\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n/* ---------- credibility stat (first paragraph, PART 8.3) ---------- */\n.sv-cred {\n  margin: var(--s8) 0 0;\n  padding: var(--s6);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  max-width: 68ch;\n}\n.sv-cred__figure {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.sv-cred__context { display: block; margin-top: var(--s2); color: var(--muted-strong); }\n\n/* ---------- grids ---------- */\n.sv-grid { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 680px) { .sv-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-grid > li { min-width: 0; }\n\n/* Two columns of prose: the heading rail and the body. */\n.sv-rail { display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .sv-rail { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s16); }\n}\n.sv-rail__aside { min-width: 0; }\n.sv-rail__body { min-width: 0; }\n\n/* ---------- jump nav ---------- */\n.sv-jump {\n  position: sticky;\n  top: var(--nav-h);\n  z-index: 20;\n  background-color: color-mix(in oklab, var(--bg) 94%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--border);\n}\n.sv-jump__inner {\n  display: flex;\n  gap: var(--s1);\n  overflow-x: auto;\n  scrollbar-width: thin;\n  padding-block: var(--s2);\n  -webkit-overflow-scrolling: touch;\n}\n.sv-jump__link {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  min-height: 40px;\n  padding-inline: var(--s3);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-jump__link:hover { color: var(--fg); background-color: var(--surface); }\n\n/* ---------- service card ---------- */\n.sv-card { display: flex; flex-direction: column; height: 100%; gap: var(--s4); }\n.sv-card__top { display: flex; align-items: flex-start; gap: var(--s3); }\n.sv-card__icon { flex: none; color: var(--accent); margin-top: 2px; }\n.sv-card__name { font-size: var(--text-lg); margin: 0; }\n.sv-card__line { margin: 0; color: var(--muted-strong); }\n.sv-card__list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  display: grid;\n  gap: var(--s2);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n.sv-card__list li { display: flex; gap: var(--s2); }\n.sv-card__tick { flex: none; margin-top: 3px; color: var(--accent); }\n.sv-card__cta {\n  margin: auto 0 0;\n  padding-top: var(--s4);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n}\n\n/* ---------- plain link list ---------- */\n.sv-links { display: grid; gap: 0; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }\n.sv-links > li { border-bottom: 1px solid var(--border); }\n.sv-links__a {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: baseline;\n  gap: var(--s4);\n  padding: var(--s4) 0;\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-links__a:hover { color: var(--accent); }\n.sv-links__label { font-weight: 500; }\n.sv-links__blurb { display: block; margin-top: var(--s1); font-size: var(--text-sm); color: var(--muted); font-weight: 400; }\n.sv-links__arrow { flex: none; color: var(--muted); align-self: center; }\n\n/* ---------- numbered methodology ---------- */\n.sv-phases { list-style: none; margin: 0; padding: 0; counter-reset: none; }\n.sv-phase {\n  display: grid;\n  gap: var(--s2);\n  padding: var(--s6) 0;\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 760px) {\n  .sv-phase { grid-template-columns: 3.5rem minmax(0, 14rem) minmax(0, 1fr); gap: var(--s6); align-items: start; }\n}\n.sv-phase__n { font-size: var(--text-sm); color: var(--muted); }\n.sv-phase__name { font-size: var(--text-lg); margin: 0; font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif; font-weight: 500; }\n.sv-phase__when { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-phase__body { margin: 0; color: var(--muted-strong); }\n\n/* ---------- console exhibits ----------\n   One stacked band per placement. The gap is large on purpose: two dense\n   consoles with 24px between them read as one confused screenshot. */\n.sv-consoles { display: grid; gap: var(--s24); }\n\n/* ---------- phase card stack ----------\n   The stack primitive manages the sticky behaviour; this only sets the rhythm\n   above it and the two type roles inside a card. */\n.sv-phaseStack { margin-top: var(--s16); }\n.sv-phaseWhen {\n  margin: 0 0 var(--s3);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.sv-phaseBody { margin: 0; color: var(--muted-strong); line-height: var(--leading-normal); }\n\n/* The artefact stack sits under the deliverables heading in the rail aside.\n   Capped so it never outgrows a 7fr column on a wide viewport. */\n.sv-deliverableArt { margin-top: var(--s8); max-width: 30rem; }\n\n/* ---------- deliverables / outcomes ---------- */\n.sv-ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n.sv-ticks > li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s3); color: var(--muted-strong); }\n.sv-ticks__mark { flex: none; margin-top: 4px; color: var(--accent); }\n\n/* ---------- chips (frameworks, stack, certifications) ---------- */\n.sv-chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n/*\n * Local override, not an edit to Badge.tsx. Badge sets white-space: nowrap,\n * which is right for a severity word (\"Critical\") and wrong for \"AWS\n * Well-Architected Security Pillar\" inside a 288px content box: a nowrap item\n * cannot shrink, so flex-wrap does not save it and the layout blows out at\n * 320px. Measured in headless Chromium at 320px, which is how the two real\n * offenders on this tree were found.\n *\n * Scoped to the five containers in which these routes render a Badge, so it\n * can never reach a severity badge elsewhere on the site — those live in the\n * product UI and must stay on one line.\n */\n.sv-chips .badge,\n.sv-card .badge,\n.sv-note .badge,\n.sv-seam__cta .badge,\n.sv-hero__meta .badge { white-space: normal; text-align: left; }\n\n/* ---------- accreditation strip ---------- */\n.sv-accred { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-accred { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-accred { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-accred__item {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: var(--s3);\n  padding: var(--s4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  min-width: 0;\n}\n.sv-accred__icon { flex: none; margin-top: 2px; color: var(--accent); }\n.sv-accred__label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); overflow-wrap: anywhere; }\n.sv-accred__issuer { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------- expert ---------- */\n.sv-expert { display: grid; gap: var(--s6); }\n@media (min-width: 760px) { .sv-expert { grid-template-columns: auto minmax(0, 1fr); gap: var(--s8); } }\n.sv-expert__name { margin: 0; font-size: var(--text-xl); }\n.sv-expert__role { margin: var(--s1) 0 0; color: var(--accent); font-size: var(--text-sm); }\n.sv-expert__bio { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 60ch; }\n.sv-expert__certs-label { margin: var(--s6) 0 var(--s2); }\n\n/* ---------- case study ---------- */\n.sv-metrics { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-metric__value {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  overflow-wrap: anywhere;\n}\n.sv-metric__label { display: block; margin-top: var(--s2); color: var(--muted-strong); font-size: var(--text-sm); }\n.sv-metric__note { display: block; margin-top: var(--s1); color: var(--muted); font-size: var(--text-xs); }\n\n.sv-quote { margin: 0; }\n.sv-quote__text {\n  margin: 0;\n  font-size: var(--text-lg);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n  max-width: 52ch;\n}\n.sv-quote__by { display: block; margin-top: var(--s4); font-size: var(--text-sm); color: var(--muted); font-style: normal; }\n.sv-quote__mark { color: var(--muted); margin-bottom: var(--s3); }\n\n/* ---------- definition grid (timeline / team / engagement) ---------- */\n.sv-defs { margin: 0; display: grid; gap: 0; }\n.sv-def { padding: var(--s6) 0; border-top: 1px solid var(--border); display: grid; gap: var(--s2); }\n@media (min-width: 760px) { .sv-def { grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: var(--s6); } }\n.sv-def__term { font-size: var(--text-sm); color: var(--muted); margin: 0; letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-def__desc { margin: 0; color: var(--muted-strong); }\n\n/* ---------- the seam ---------- */\n.sv-seam { display: grid; gap: var(--s6); align-items: stretch; }\n@media (min-width: 980px) {\n  .sv-seam { grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, 1fr); gap: var(--s4); align-items: stretch; }\n}\n.sv-seam__col { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.sv-seam__centre { border-color: var(--accent); }\n.sv-seam__kicker { margin: 0 0 var(--s3); }\n.sv-seam__name { margin: 0; font-size: var(--text-xl); }\n.sv-seam__line { margin: var(--s3) 0 0; color: var(--muted-strong); }\n.sv-seam__body { margin: var(--s4) 0 0; color: var(--muted); font-size: var(--text-sm); }\n.sv-seam__cta { margin: auto 0 0; padding-top: var(--s6); }\n\n/* ---------- contrast pair (engagement models) ---------- */\n.sv-contrast { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-contrast { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-contrast__head { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s4); }\n.sv-contrast__icon { flex: none; color: var(--accent); }\n.sv-contrast__h { margin: 0; font-size: var(--text-lg); }\n.sv-contrast__rows { margin: 0; display: grid; }\n.sv-contrast__row { padding: var(--s4) 0; border-top: 1px solid var(--border); }\n.sv-contrast__term { margin: 0; font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }\n.sv-contrast__desc { margin: var(--s2) 0 0; color: var(--muted-strong); }\n\n/* ---------- form ---------- */\n.sv-form { display: grid; gap: var(--s6); max-width: 44rem; }\n.sv-field { display: grid; gap: var(--s2); min-width: 0; }\n.sv-field--check { grid-template-columns: auto minmax(0, 1fr); align-items: start; column-gap: var(--s3); }\n.sv-label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.sv-req { color: var(--accent); margin-left: 2px; }\n.sv-help { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.sv-input,\n.sv-select,\n.sv-textarea {\n  width: 100%;\n  min-width: 0;\n  min-height: 44px;\n  padding: var(--s3) var(--s4);\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  font: inherit;\n  font-size: var(--text-base);\n  transition: border-color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-textarea { min-height: 7.5rem; resize: vertical; line-height: var(--leading-normal); }\n.sv-input:hover, .sv-select:hover, .sv-textarea:hover { border-color: var(--fg); }\n.sv-input::placeholder, .sv-textarea::placeholder { color: var(--muted); }\n.sv-check { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--accent); flex: none; }\n.sv-form__actions { display: flex; flex-wrap: wrap; gap: var(--s4); align-items: center; }\n.sv-form__sla { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n/*\n * VALIDATION SUMMARY — revealed by :target, so it needs neither JavaScript nor\n * a searchParams read on the page.\n *\n * Reading ?enquiry= would have been the obvious way to show this, and it was\n * the first implementation. It is wrong: a page that reads searchParams opts\n * out of static generation, which would have made all sixteen service pages\n * dynamically rendered to display a message a visitor almost never sees. The\n * server action redirects to #enquiry-incomplete or #enquiry-email instead;\n * the browser scrolls to the matching block and :target reveals it. Static\n * generation survives, and so does the message.\n *\n * The common case never reaches here at all: the \"required\" attribute is\n * native constraint validation, which browsers enforce with scripting off.\n * The server check exists for a crafted POST, not a forgotten field.\n *\n * No --signal-* colour: Badge.tsx states severity colour is the one place in\n * the codebase those tokens appear, and a form error is not a severity rating.\n */\n.sv-form__error {\n  display: none;\n  padding: var(--s4);\n  border: 1px solid var(--border-strong);\n  border-left: 2px solid var(--fg);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  scroll-margin-top: calc(var(--nav-h) + var(--s8));\n}\n.sv-form__error:target { display: block; }\n.sv-form__error p { margin: 0; color: var(--fg); font-size: var(--text-sm); }\n\n/*\n * A box that declares its own palette inside a band of another palette.\n * <Card> sets `color: inherit`, so a bare theme-* class on it would re-colour\n * the surface and leave the text behind; this sets both. Used on\n * /services/engagement-models, where the security retainer and the delivery\n * retainer sit side by side in the palette of their own act — the commercial\n * contrast made visible rather than described.\n */\n.sv-theme-box {\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  min-width: 0;\n}\n\n/* ---------- misc ---------- */\n.sv-cta-band { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-cta-band { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s12); } }\n.sv-cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--s3); }\n\n.sv-hotline {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n}\n.sv-hotline__num {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: clamp(1.375rem, 4.5vw, 1.75rem);\n  font-weight: 500;\n  color: var(--fg);\n  text-decoration: none;\n  overflow-wrap: anywhere;\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-hotline__num:hover { color: var(--accent); }\n\n.sv-stub {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n  max-width: 44rem;\n}\n.sv-prose-measure { max-width: 68ch; }\n.sv-sr {\n  position: absolute;\n  width: 1px; height: 1px;\n  padding: 0; margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n.reveal-group > * { --reveal-delay: calc(var(--reveal-base, 0ms) + 0ms); }\n.reveal-group > *:nth-child(2) { --reveal-delay: calc(var(--reveal-base, 0ms) + 60ms); }\n.reveal-group > *:nth-child(3) { --reveal-delay: calc(var(--reveal-base, 0ms) + 120ms); }\n.reveal-group > *:nth-child(4) { --reveal-delay: calc(var(--reveal-base, 0ms) + 180ms); }\n.reveal-group > *:nth-child(n + 5) { --reveal-delay: calc(var(--reveal-base, 0ms) + 240ms); }\n\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\n\n.dg {\n  /* POSITIONED ON PURPOSE. .dg-ganttText is clipped and absolutely positioned\n     at wide widths; an absolutely positioned element is only clipped by an\n     ancestor in its containing-block chain. Without this the clipped schedule\n     escapes and widens the page. */\n  position: relative;\n  margin: 0;\n  min-width: 0;\n}\n\n/* ---------------- the drawn schedule ---------------- */\n.dg-gantt { display: none; width: 100%; height: auto; overflow: visible; }\n@media (min-width: 860px) {\n  .dg-gantt { display: block; }\n}\n\n.dg-axisUnit,\n.dg-colHead {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  fill: var(--muted);\n}\n.dg-tick {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n.dg-grid { stroke: var(--border-strong); stroke-width: 1; }\n.dg-zero { stroke: var(--accent); stroke-width: 1.5; }\n.dg-zeroLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  fill: var(--accent);\n}\n\n.dg-rowNum {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  fill: var(--muted);\n}\n.dg-rowName { font-size: 13px; fill: var(--fg); }\n\n/* Three stages, three SHAPES as well as three fills: a filled bar, a hollow\n   dashed bar and a half-height bar. The information survives greyscale. */\n.dg-bar { fill: var(--accent); stroke: none; }\n.dg-bar--before { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 3; }\n.dg-bar--after { fill: var(--muted-strong); }\n.dg-bar--unstated { opacity: 0.55; }\n.dg-openTip { fill: var(--accent); }\n.dg-standing { stroke: var(--border-strong); stroke-width: 2; stroke-dasharray: 2 4; }\n\n.dg-barLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n/* Printed on top of a filled bar: the bar's fill is --accent or\n   --muted-strong, both of which are LIGHT in the dark palettes and DARK in the\n   light one, so the text takes the ground colour rather than a fixed one. */\n.dg-barLabel--in { fill: var(--bg); }\n.dg-leader { stroke: var(--border-strong); stroke-width: 1; }\n.dg-artMark { fill: var(--accent); }\n.dg-art { font-size: 12px; fill: var(--muted-strong); }\n/* \"nothing drops out of this phase\" is information, not furniture, so the\n   dash takes a text neutral. --border-strong is a hairline value and renders\n   as an almost-invisible mark in .theme-dark. */\n.dg-artNone { font-size: 12px; fill: var(--muted); }\n\n/* ---------------- the schedule as DOM text ---------------- */\n.dg-sched { list-style: none; margin: 0; padding: 0; display: grid; }\n.dg-schedRow {\n  display: grid;\n  gap: var(--s1);\n  padding: var(--s4) 0;\n  border-top: 1px solid var(--border);\n  min-width: 0;\n}\n@media (min-width: 560px) {\n  .dg-schedRow {\n    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);\n    column-gap: var(--s6);\n    align-items: baseline;\n  }\n  .dg-schedHead { grid-row: span 3; }\n}\n.dg-schedHead { display: flex; gap: var(--s3); align-items: baseline; margin: 0; min-width: 0; }\n.dg-schedNum { font-size: var(--text-xs); color: var(--accent); flex: none; }\n.dg-schedName { font-weight: 500; color: var(--fg); }\n.dg-schedWhen { margin: 0; font-size: var(--text-xs); color: var(--muted-strong); }\n.dg-schedStage { margin: 0; font-size: var(--text-xs); color: var(--muted); }\n.dg-schedArt { margin: 0; font-size: var(--text-sm); color: var(--muted-strong); }\n.dg-schedArtKey {\n  display: inline-block;\n  margin-right: var(--s2);\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n@media (min-width: 860px) {\n  .dg-ganttText {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip-path: inset(50%);\n    white-space: nowrap;\n    border: 0;\n  }\n}\n\n/* ---------------- caption and legend ---------------- */\n.dg-cap { margin-top: var(--s6); }\n.dg-legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s3) var(--s6);\n  list-style: none;\n  margin: 0 0 var(--s4);\n  padding: 0;\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n.dg-legendItem { display: inline-flex; align-items: center; gap: var(--s2); }\n.dg-legendMark { width: 18px; height: 8px; border-radius: 2px; background-color: var(--accent); flex: none; }\n.dg-legendItem[data-stage='before'] .dg-legendMark {\n  background-color: transparent;\n  border: 1px dashed var(--muted);\n}\n.dg-legendItem[data-stage='after'] .dg-legendMark { height: 4px; background-color: var(--muted-strong); }\n.dg-legendItem[data-stage='standing'] .dg-legendMark {\n  height: 2px;\n  background-color: transparent;\n  border-top: 2px dotted var(--border-strong);\n}\n.dg-capNote {\n  margin: 0;\n  font-size: var(--text-xs);\n  color: var(--muted);\n  max-width: 74ch;\n  line-height: 1.6;\n}\n\n/* ---------------- deliverables stack ---------------- */\n.dg-stackFig { display: grid; gap: var(--s4); }\n.dg-stack { width: 100%; height: auto; max-width: 34rem; }\n.dg-sheet { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1; }\n.dg-sheetSpine { fill: var(--accent); }\n.dg-sheetNum { font-size: 11px; letter-spacing: 0.1em; fill: var(--muted); }\n.dg-sheetTag {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  fill: var(--muted);\n}\n.dg-sheetTitle { font-size: 15px; font-weight: 500; fill: var(--fg); }\n.dg-sheetRule { stroke: var(--border-strong); stroke-width: 1; }\n.dg-stackCap { max-width: 34rem; }\n\n/* ---------------- scope boundary ---------------- */\n.dg-scope { display: grid; gap: var(--s6); }\n@media (min-width: 1000px) {\n  .dg-scope { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: var(--s8); align-items: start; }\n}\n.dg-scopeIn {\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  min-width: 0;\n}\n@media (min-width: 768px) { .dg-scopeIn { padding: var(--s8); } }\n.dg-scopeTag {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: var(--s3);\n  margin: 0 0 var(--s6);\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.dg-scopeCount { color: var(--muted); letter-spacing: 0.08em; }\n.dg-scopeGrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n@media (min-width: 640px) { .dg-scopeGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.dg-scopeCell {\n  min-width: 0;\n  padding: var(--s4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n}\n.dg-scopeNum { display: block; font-size: var(--text-xs); color: var(--accent); margin-bottom: var(--s2); }\n.dg-scopeName { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--fg); }\n.dg-scopeBody { margin: var(--s2) 0 0; font-size: var(--text-sm); color: var(--muted); line-height: 1.55; }\n.dg-scopeOut {\n  border: 1px dashed var(--border-strong);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  min-width: 0;\n}\n.dg-scopeTag--out { color: var(--muted); }\n.dg-scopeOutQ { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--muted-strong); }\n.dg-scopeOutA { margin: var(--s3) 0 0; font-size: var(--text-sm); color: var(--muted); line-height: 1.6; }\n\n/* ---------------- console frame ---------------- */\n.dg-console { display: grid; gap: var(--s8); align-items: start; }\n@media (min-width: 1000px) {\n  .dg-console { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s12); }\n}\n.dg-consoleSay { min-width: 0; }\n.dg-consoleTitle { margin: var(--s3) 0 0; font-size: var(--text-xl); }\n.dg-consoleBody { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 46ch; }\n.dg-consoleArt { min-width: 0; }\n\n@media print {\n  .dg-gantt { display: none; }\n  .dg-ganttText { position: static; width: auto; height: auto; margin: 0; clip-path: none; white-space: normal; }\n}\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n\n.avatar-ph {\n  display: grid;\n  place-items: center;\n  flex: none;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border);\n  color: var(--paper-50);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  line-height: 1;\n  user-select: none;\n  overflow: hidden;\n}\n.avatar-ph--round { border-radius: 50%; }\n\n/* Zero the trailing padding so the globals keyframe lands exactly. */\n.marquee__track.mq-track { padding-right: 0; list-style: none; margin: 0; padding-left: 0; }\n\n.mq__item {\n  display: flex;\n  align-items: center;\n  gap: var(--s3);\n  flex: none;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s3) var(--s4);\n  min-height: 56px;\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.mq__item:hover { border-color: var(--border-strong); }\n\n.mq__logo { display: inline-flex; flex: none; color: var(--muted-strong); }\n\n.mq__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.mq__label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1.2;\n  color: var(--fg);\n  white-space: nowrap;\n}\n.mq__meta {\n  font-size: var(--text-xs);\n  line-height: 1.2;\n  color: var(--muted);\n  white-space: nowrap;\n}\n.mq__link { color: inherit; text-decoration: none; }\n.mq__link:hover .mq__label { color: var(--fg); }\n.mq__item-inner { display: flex; align-items: center; gap: var(--s3); min-width: 0; }\n\n/* Reduced motion turns the rail into a scroller — give it breathing room. */\n@media (prefers-reduced-motion: reduce) {\n  .marquee__track.mq-track { padding-right: var(--gap); }\n}\n\n.faq { border-top: 1px solid var(--border); }\n.faq__item { border-bottom: 1px solid var(--border); }\n.faq__header { margin: 0; }\n\n.faq__trigger {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--s6);\n  width: 100%;\n  min-height: 44px;\n  padding: var(--s6) 0;\n  appearance: none;\n  background: none;\n  border: 0;\n  text-align: left;\n  cursor: pointer;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  letter-spacing: var(--tracking-tight);\n  color: var(--fg);\n  /* Colour only. The row must not move under the pointer. */\n  transition: color var(--dur-base) var(--ease-out);\n}\n.faq__trigger:hover { color: var(--muted-strong); }\n.faq__trigger:focus-visible { outline-offset: -2px; }\n\n.faq__chevron {\n  flex: none;\n  margin-top: 2px;\n  color: var(--muted);\n  transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);\n}\n.faq__trigger[data-state='open'] .faq__chevron { transform: rotate(180deg); color: var(--fg); }\n\n/* .acc-content carries the collapseDown / collapseUp animations from globals. */\n.faq__content { overflow: hidden; }\n.faq__answer {\n  padding-bottom: var(--s6);\n  color: var(--muted-strong);\n  max-width: 68ch;\n  margin: 0;\n}\n\n/* The no-JS mirror. display:none also keeps it out of the a11y tree when\n   scripting is available, so nothing is announced twice. */\n.faq__nojs { display: none; border-top: 1px solid var(--border); }\n.no-js .faq__nojs { display: block; }\n.no-js .faq__accordion { display: none; }\n.faq__nojs dt {\n  padding-top: var(--s6);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 500;\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.faq__nojs dd {\n  margin: var(--s2) 0 0;\n  padding-bottom: var(--s6);\n  border-bottom: 1px solid var(--border);\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n\n/* ---- Chapter ------------------------------------------------------------\n   A numbered chapter with a heading that HOLDS while its body scrolls under\n   it. The number is not decoration: it tells a reader where they are in a long\n   page, which is the thing a long page actually owes them. */\n.ch {\n  position: relative;\n  display: grid;\n  gap: var(--s8);\n}\n@media (min-width: 1024px) {\n  .ch {\n    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\n    gap: var(--s16);\n    align-items: start;\n  }\n}\n\n.ch__head {\n  position: relative;\n}\n@media (min-width: 1024px) {\n  .ch__head {\n    position: sticky;\n    /* Clears the fixed 72px nav plus breathing room. */\n    top: calc(var(--nav-h) + var(--s8));\n  }\n}\n\n.ch__num {\n  display: block;\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.18em;\n  color: var(--accent);\n  margin-bottom: var(--s3);\n}\n\n.ch__title {\n  margin: 0;\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\n  letter-spacing: var(--tracking-tight);\n  text-wrap: balance;\n}\n\n.ch__lede {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  font-size: var(--text-base);\n  line-height: 1.6;\n  max-width: 34ch;\n}\n\n.ch__rule {\n  margin-top: var(--s6);\n  height: 1px;\n  background: linear-gradient(90deg, var(--accent), transparent);\n}\n\n.ch__body {\n  min-width: 0;\n  display: grid;\n  gap: var(--s12);\n}\n\n/* ---- Sticky card stack --------------------------------------------------\n   Every card is sticky at the SAME offset, so each comes to rest on the one\n   before it and the stack assembles itself as you scroll. The entire effect is\n   the equal `top` value — there is no JavaScript here at all.\n\n   Each card needs its own opaque background or the stack reads as a smear;\n   that is the one thing people get wrong when copying this. */\n.stack {\n  display: grid;\n  gap: var(--s8);\n}\n.stack__card {\n  position: sticky;\n  top: calc(var(--nav-h) + var(--s8));\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  /* A hairline of the ground above each card so stacked edges stay readable. */\n  box-shadow: 0 -1px 0 0 var(--bg);\n}\n@media (min-width: 768px) {\n  .stack__card {\n    padding: var(--s12);\n  }\n}\n\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\n   which is what it already is semantically, so nothing is lost. */\n@media (prefers-reduced-motion: reduce) {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n/* Sticky needs a real scroll context; without JS the layout is identical, so\n   no .no-js override is required here. */\n\n.stack__index {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.16em;\n  color: var(--accent);\n}\n.stack__title {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-2xl);\n  letter-spacing: var(--tracking-tight);\n}\n.stack__body {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  line-height: 1.65;\n  max-width: 62ch;\n}\n\n@media print {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/3557-949eff4fc2fd241a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4553-42d73557a9dc5e67.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/services/%5Bslug%5D/page-8b2a457ab8db9360.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>CRM · Envenox</title><meta name=\"description\" content=\"A pipeline your sales team updates because it helps them, not because it is mandated. 91% weekly active use among licensed sellers at 90 days, against an industry benchmark nearer 55%.\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com/services/crm\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"CRM · Envenox\"/><meta property=\"og:description\" content=\"A pipeline your sales team updates because it helps them, not because it is mandated. 91% weekly active use among licensed sellers at 90 days, against an industry benchmark nearer 55%.\"/><meta property=\"og:url\" content=\"https://envenox.com/services/crm\"/><meta property=\"og:site_name\" content=\"Envenox\"/><meta property=\"og:locale\" content=\"en_GB\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"CRM · Envenox\"/><meta name=\"twitter:description\" content=\"A pipeline your sales team updates because it helps them, not because it is mandated. 91% weekly active use among licensed sellers at 90 days, against an industry benchmark nearer 55%.\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav theme-dark transition-theme no-print\" data-scrolled=\"false\" data-nav-theme=\"dark\"><div class=\"nav__bar u-container\"><a class=\"nav__brand\" href=\"/\">Envenox</a><nav aria-label=\"Primary\" data-orientation=\"horizontal\" dir=\"ltr\" class=\"nav__desktop\"><div style=\"position:relative\"><ul data-orientation=\"horizontal\" class=\"nav__list\" dir=\"ltr\"><li><button id=\"radix-_R_klb_-trigger-Services\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Services\" class=\"nav__trigger\" data-radix-collection-item=\"\">Services<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Services\" aria-labelledby=\"radix-_R_klb_-trigger-Services\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/services/devsecops\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Secure SDLC</span><span class=\"nav__featured-blurb\">The page that explains why one firm does both. Start here.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/cybersecurity\"><span class=\"nav__link-label\">Cybersecurity</span><span class=\"nav__link-blurb\">Testing, assurance, detection and response</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/software-development\"><span class=\"nav__link-label\">Software Development</span><span class=\"nav__link-blurb\">Product build, platform and modernisation</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/penetration-testing\"><span class=\"nav__link-label\">Penetration Testing</span><span class=\"nav__link-blurb\">Web, mobile, network, cloud, API</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/application-security\"><span class=\"nav__link-label\">Application Security</span><span class=\"nav__link-blurb\">Secure code review and SDLC uplift</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/managed-detection-response\"><span class=\"nav__link-label\">Managed Detection &amp; Response</span><span class=\"nav__link-blurb\">24/7 SOC on your telemetry</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/grc-compliance\"><span class=\"nav__link-label\">GRC &amp; Compliance</span><span class=\"nav__link-blurb\">SOC 2, ISO 27001, PCI DSS, DORA, NIS2</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/custom-software\"><span class=\"nav__link-label\">Custom Software</span><span class=\"nav__link-blurb\">Systems built to survive an audit</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/engagement-models\"><span class=\"nav__link-label\">Engagement Models</span><span class=\"nav__link-blurb\">How retainers and projects actually run</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/services\">All <!-- -->services<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Industries\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Industries\" class=\"nav__trigger\" data-radix-collection-item=\"\">Industries<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Industries\" aria-labelledby=\"radix-_R_klb_-trigger-Industries\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/financial-services\"><span class=\"nav__link-label\">Financial Services</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/healthcare\"><span class=\"nav__link-label\">Healthcare</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/saas\"><span class=\"nav__link-label\">SaaS &amp; Technology</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/logistics\"><span class=\"nav__link-label\">Logistics</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/public-sector\"><span class=\"nav__link-label\">Public Sector</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/industries/retail\"><span class=\"nav__link-label\">Retail &amp; Payments</span></a></li></ul></div><div class=\"nav__panel-foot\"><a class=\"nav__panel-all\" data-radix-collection-item=\"\" href=\"/industries\">All <!-- -->industries<!-- --> →</a></div></div></li><li><button id=\"radix-_R_klb_-trigger-Proof\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Proof\" class=\"nav__trigger\" data-radix-collection-item=\"\">Proof<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Proof\" aria-labelledby=\"radix-_R_klb_-trigger-Proof\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/sample-report\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Anatomy of a report</span><span class=\"nav__featured-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/case-studies\"><span class=\"nav__link-label\">Case Studies</span><span class=\"nav__link-blurb\">24 stories, filterable</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/customers\"><span class=\"nav__link-label\">Customers</span><span class=\"nav__link-blurb\">Who we work with, and what they say</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/certifications\"><span class=\"nav__link-label\">Certifications</span><span class=\"nav__link-blurb\">Ours, with certificate numbers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/trust\"><span class=\"nav__link-label\">Trust Centre</span><span class=\"nav__link-blurb\">Our own security posture, published</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Resources\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Resources\" class=\"nav__trigger\" data-radix-collection-item=\"\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Resources\" aria-labelledby=\"radix-_R_klb_-trigger-Resources\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/resources\"><span class=\"nav__link-label\">All resources</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/blog\"><span class=\"nav__link-label\">Insights</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/research\"><span class=\"nav__link-label\">Research &amp; Labs</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/tools\"><span class=\"nav__link-label\">Open-source tools</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/methodologies\"><span class=\"nav__link-label\">Methodologies</span></a></li></ul></div></div></li><li><button id=\"radix-_R_klb_-trigger-Company\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Company\" class=\"nav__trigger\" data-radix-collection-item=\"\">Company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Company\" aria-labelledby=\"radix-_R_klb_-trigger-Company\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about\"><span class=\"nav__link-label\">About</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/about/leadership\"><span class=\"nav__link-label\">Leadership</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/approach\"><span class=\"nav__link-label\">The Adversary Loop</span><span class=\"nav__link-blurb\">How we actually work</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/careers\"><span class=\"nav__link-label\">Careers</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/newsroom\"><span class=\"nav__link-label\">Newsroom</span></a></li></ul></div></div></li></ul></div></nav><div class=\"nav__actions\"><a class=\"nav__hotline\" href=\"tel:+442045259100\" data-ir-hotline=\"nav\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone nav__hotline-icon\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span class=\"nav__hotline-text\"><span class=\"nav__hotline-kicker\">Breach? 24/7</span><span class=\"nav__hotline-number\">+44 20 4525 9100</span></span></a><a class=\"btn btn--primary btn--sm nav__cta\" href=\"/contact\"><span>Start a conversation</span></a><details class=\"nav__mobile\"><summary class=\"nav__burger\" aria-label=\"Navigation menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu nav__burger-open\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x nav__burger-close\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></summary><nav class=\"nav__sheet\" aria-label=\"All pages\"><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Services</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/services/devsecops\">Secure SDLC<span class=\"nav__sheet-blurb\">The page that explains why one firm does both. Start here.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/services/cybersecurity\">Cybersecurity</a></li><li><a class=\"nav__sheet-link\" href=\"/services/software-development\">Software Development</a></li><li><a class=\"nav__sheet-link\" href=\"/services/penetration-testing\">Penetration Testing</a></li><li><a class=\"nav__sheet-link\" href=\"/services/application-security\">Application Security</a></li><li><a class=\"nav__sheet-link\" href=\"/services/managed-detection-response\">Managed Detection &amp; Response</a></li><li><a class=\"nav__sheet-link\" href=\"/services/grc-compliance\">GRC &amp; Compliance</a></li><li><a class=\"nav__sheet-link\" href=\"/services/custom-software\">Custom Software</a></li><li><a class=\"nav__sheet-link\" href=\"/services/engagement-models\">Engagement Models</a></li><li><a class=\"nav__sheet-link\" href=\"/services\">All <!-- -->services</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Industries</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/industries/financial-services\">Financial Services</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/healthcare\">Healthcare</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/saas\">SaaS &amp; Technology</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/logistics\">Logistics</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/public-sector\">Public Sector</a></li><li><a class=\"nav__sheet-link\" href=\"/industries/retail\">Retail &amp; Payments</a></li><li><a class=\"nav__sheet-link\" href=\"/industries\">All <!-- -->industries</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Proof</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/sample-report\">Anatomy of a report<span class=\"nav__sheet-blurb\">Walk a real deliverable, redacted. See what actually lands in your inbox.</span></a></li><li><a class=\"nav__sheet-link\" href=\"/case-studies\">Case Studies</a></li><li><a class=\"nav__sheet-link\" href=\"/customers\">Customers</a></li><li><a class=\"nav__sheet-link\" href=\"/certifications\">Certifications</a></li><li><a class=\"nav__sheet-link\" href=\"/trust\">Trust Centre</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Resources</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/resources\">All resources</a></li><li><a class=\"nav__sheet-link\" href=\"/blog\">Insights</a></li><li><a class=\"nav__sheet-link\" href=\"/research\">Research &amp; Labs</a></li><li><a class=\"nav__sheet-link\" href=\"/tools\">Open-source tools</a></li><li><a class=\"nav__sheet-link\" href=\"/methodologies\">Methodologies</a></li></ul></div><div class=\"nav__sheet-group\"><p class=\"nav__sheet-heading\">Company</p><ul class=\"nav__sheet-list\"><li><a class=\"nav__sheet-link\" href=\"/about\">About</a></li><li><a class=\"nav__sheet-link\" href=\"/about/leadership\">Leadership</a></li><li><a class=\"nav__sheet-link\" href=\"/approach\">The Adversary Loop</a></li><li><a class=\"nav__sheet-link\" href=\"/careers\">Careers</a></li><li><a class=\"nav__sheet-link\" href=\"/newsroom\">Newsroom</a></li></ul></div><div class=\"nav__sheet-cta\"><a class=\"btn btn--primary btn--md btn--full\" href=\"/contact\"><span>Start a conversation</span></a><a class=\"nav__sheet-hotline\" href=\"tel:+442045259100\">Incident response, 24/7 — <!-- -->+44 20 4525 9100</a></div></nav></details></div></div></header><main id=\"main\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://envenox.com/services/crm#service\",\"name\":\"CRM\",\"serviceType\":\"CRM\",\"description\":\"A pipeline your sales team updates because it helps them, not because it is mandated.\",\"disambiguatingDescription\":\"Pipeline, activity and forecasting designed so sellers get something back from every field.\",\"url\":\"https://envenox.com/services/crm\",\"provider\":{\"@id\":\"https://envenox.com/#organization\"},\"areaServed\":[{\"@type\":\"Country\",\"name\":\"United Kingdom\"},{\"@type\":\"Country\",\"name\":\"Bangladesh\"}],\"audience\":{\"@type\":\"BusinessAudience\",\"name\":\"Regulated organisations\"},\"category\":\"Software Development\",\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"CRM — what is included\",\"itemListElement\":[{\"@type\":\"OfferCatalogItem\",\"position\":1,\"name\":\"Pipeline and stages\",\"description\":\"Stages defined by buyer behaviour with explicit exit criteria, not by internal optimism. A stage you cannot evidence is not a stage.\"},{\"@type\":\"OfferCatalogItem\",\"position\":2,\"name\":\"Activity capture\",\"description\":\"Email, calendar and call logging captured automatically. Manual activity entry is a tax sellers will not pay.\"},{\"@type\":\"OfferCatalogItem\",\"position\":3,\"name\":\"Forecasting\",\"description\":\"Weighted and committed forecasts built from real stage movement and velocity, with the assumptions visible rather than embedded in a spreadsheet.\"},{\"@type\":\"OfferCatalogItem\",\"position\":4,\"name\":\"Quote and proposal\",\"description\":\"Configure-price-quote with approval thresholds, versioned proposals, and e-signature.\"},{\"@type\":\"OfferCatalogItem\",\"position\":5,\"name\":\"Integration\",\"description\":\"Marketing automation, support, billing and the ERP. Sellers should not need to open four systems to answer one customer question.\"},{\"@type\":\"OfferCatalogItem\",\"position\":6,\"name\":\"Reporting\",\"description\":\"Cohort retention, win and loss reasons, velocity by segment, and the activity-to-outcome ratios that tell a manager where coaching is needed.\"}]},\"termsOfService\":\"https://envenox.com/legal/terms\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Envenox\",\"item\":\"https://envenox.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://envenox.com/services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Software Development\",\"item\":\"https://envenox.com/services/software-development\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"CRM\",\"item\":\"https://envenox.com/services/crm\"}]}</script><section class=\"sec theme-light transition-theme u-section grain\" data-theme-section=\"light\" style=\"padding-top:calc(var(--nav-h) + var(--s16))\" aria-labelledby=\"service-h1\"><div class=\"u-container\"><p class=\"u-eyebrow sv-hero__eyebrow\"><a class=\"u-link\" href=\"/services\">Services</a> · <a class=\"u-link\" href=\"/services/software-development\">Software Development</a></p><h1 id=\"service-h1\" class=\"sv-h1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users\" aria-hidden=\"true\" style=\"display:inline-block;vertical-align:-4px;margin-right:var(--s3);color:var(--accent)\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg>CRM</h1><p class=\"sv-sub\">A pipeline your sales team updates because it helps them, not because it is mandated.</p><p class=\"sv-cred\"><strong class=\"sv-cred__figure\">91% weekly active use</strong><span class=\"sv-cred__context\">among licensed sellers at 90 days, against an industry benchmark nearer 55%</span></p><div class=\"sv-hero__actions\"><a class=\"btn btn--primary btn--lg\" href=\"/contact\"><span>Start a conversation</span></a><a href=\"#enquiry-form\" class=\"btn btn--secondary btn--lg\"><span>Send an enquiry</span></a></div><ul class=\"sv-hero__meta\"><li>5–7 months, pilot team live by week 6.</li><li>Phased delivery with a pilot-first rollout.</li></ul></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"problem\"><div class=\"u-container\"><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><div class=\"sv-head__rule\" aria-hidden=\"true\" style=\"margin-bottom:var(--s6)\"></div><p class=\"u-eyebrow\">The problem</p><h2 id=\"problem\" class=\"sv-h2\" style=\"margin-top:var(--s3)\">A pipeline your sales team updates because it helps them, not because it is mandated.</h2></div><div class=\"sv-rail__body\"><p class=\"sv-prose-measure\" style=\"margin:0;font-size:var(--text-lg);color:var(--muted-strong)\">The defining failure of CRM is not technical. It is that salespeople do not update it, because updating it costs them twenty minutes and gives them nothing, while the report it feeds is for someone else. Every subsequent problem — stale pipeline, invented forecasts, a management dashboard that contradicts the sales floor — follows from that. We design the other way round: the seller gets something back from every field they fill, data that can be captured automatically is never typed, and the forecast is assembled from activity that happens anyway. Then the pipeline stays current without anyone being chased, and the report is a by-product rather than an obligation.</p></div></div></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"included\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Scope</p><h2 id=\"included\" class=\"sv-h2\">What is included</h2></div><ul class=\"reveal-group sv-grid sv-grid--3\"><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Pipeline and stages</h3><p class=\"sv-card__line\">Stages defined by buyer behaviour with explicit exit criteria, not by internal optimism. A stage you cannot evidence is not a stage.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Activity capture</h3><p class=\"sv-card__line\">Email, calendar and call logging captured automatically. Manual activity entry is a tax sellers will not pay.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Forecasting</h3><p class=\"sv-card__line\">Weighted and committed forecasts built from real stage movement and velocity, with the assumptions visible rather than embedded in a spreadsheet.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Quote and proposal</h3><p class=\"sv-card__line\">Configure-price-quote with approval thresholds, versioned proposals, and e-signature.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Integration</h3><p class=\"sv-card__line\">Marketing automation, support, billing and the ERP. Sellers should not need to open four systems to answer one customer question.</p></div></li><li data-reveal=\"\"><div class=\"card card--pad-lg sv-card\"><h3 class=\"sv-h3\">Reporting</h3><p class=\"sv-card__line\">Cohort retention, win and loss reasons, velocity by segment, and the activity-to-outcome ratios that tell a manager where coaching is needed.</p></div></li></ul></div></section><section class=\"sec theme-dark transition-theme u-section grain\" data-theme-section=\"dark\" aria-labelledby=\"security-by-default\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">The differentiator</p><h2 id=\"security-by-default\" class=\"sv-h2\">Security by default</h2><p class=\"sv-head__lede\">Our engineers work next to a security practice that will attack what they build. That changes how authorisation, audit logging and secrets get designed — before the first commit rather than after the first report.</p></div><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\" style=\"color:var(--accent)\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><p class=\"sv-lede\" style=\"margin-top:var(--s4)\">We build it and we break it. The findings land in our own sprint backlog.</p><p class=\"sv-cred\"><strong class=\"sv-cred__figure\">9 days median</strong><span class=\"sv-cred__context\">from a security finding being confirmed to the fix being in production, on joint engagements</span></p><p style=\"margin-top:var(--s6)\"><a class=\"btn btn--primary btn--md\" href=\"/services/devsecops\"><span>Read Secure SDLC</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></p></div><div class=\"sv-rail__body\"><ul class=\"reveal-group sv-ticks\" aria-label=\"What security by default means on a build\"><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Threat model at design time — Before the first sprint. The cheapest security finding is an architecture decision, and the most expensive one is the same decision discovered in week forty.</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Secure design review at each decision — Our testers review architectural decision records as they are written, not the finished system.</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Security in the pipeline — SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Continuous testing during the build — Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Pre-release penetration test — A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Monitoring and retest — Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.</span></li></ul></div></div></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"methodology\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">The Adversary Loop</p><h2 id=\"methodology\" class=\"sv-h2\">How the engagement runs</h2><p class=\"sv-head__lede\">Threat models shape the build. The build gets attacked. The attack rewrites the threat model.</p></div><figure class=\"dg\" id=\"engagement-shape\"><svg class=\"dg-gantt\" viewBox=\"0 0 1000 252\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Engagement shape for CRM: 6 phases. Phase 1, Sales process discovery, Weeks 1–4, inside the engagement window. Phase 2, Model, Weeks 3–6, inside the engagement window, producing the configured crm with the agreed data model and stage definitions. Phase 3, Build, Weeks 5–18, inside the engagement window. Phase 4, Migrate, Weeks 14–20, inside the engagement window. Phase 5, Roll out, Weeks 18–24, inside the engagement window. Phase 6, Tune, Ongoing, no fixed window.\"><text class=\"dg-axisUnit\" x=\"0\" y=\"16\">weeks from kick-off</text><g><line class=\"dg-grid\" x1=\"236\" y1=\"30\" x2=\"236\" y2=\"226\"></line><text class=\"dg-tick\" x=\"236\" y=\"24\" text-anchor=\"middle\">0</text></g><g><line class=\"dg-grid\" x1=\"340.58333333333337\" y1=\"30\" x2=\"340.58333333333337\" y2=\"226\"></line><text class=\"dg-tick\" x=\"340.58333333333337\" y=\"24\" text-anchor=\"middle\">5</text></g><g><line class=\"dg-grid\" x1=\"445.1666666666667\" y1=\"30\" x2=\"445.1666666666667\" y2=\"226\"></line><text class=\"dg-tick\" x=\"445.1666666666667\" y=\"24\" text-anchor=\"middle\">10</text></g><g><line class=\"dg-grid\" x1=\"549.75\" y1=\"30\" x2=\"549.75\" y2=\"226\"></line><text class=\"dg-tick\" x=\"549.75\" y=\"24\" text-anchor=\"middle\">15</text></g><g><line class=\"dg-grid\" x1=\"654.3333333333334\" y1=\"30\" x2=\"654.3333333333334\" y2=\"226\"></line><text class=\"dg-tick\" x=\"654.3333333333334\" y=\"24\" text-anchor=\"middle\">20</text></g><line class=\"dg-zero\" x1=\"236\" y1=\"30\" x2=\"236\" y2=\"232\"></line><text class=\"dg-zeroLabel\" x=\"236\" y=\"245\" text-anchor=\"middle\">kick-off</text><text class=\"dg-colHead\" x=\"762\" y=\"16\">Drops out</text><g><text class=\"dg-rowNum\" x=\"0\" y=\"65\">01</text><text class=\"dg-rowName\" x=\"34\" y=\"65\">Sales process discovery</text><rect class=\"dg-bar dg-bar--window\" x=\"236\" y=\"53.5\" width=\"83.66666666666663\" height=\"15\" rx=\"2\"></rect><text class=\"dg-barLabel\" x=\"327.66666666666663\" y=\"64\">Weeks 1–4</text><text class=\"dg-artNone\" x=\"771\" y=\"64\">—</text></g><g><text class=\"dg-rowNum\" x=\"0\" y=\"95\">02</text><text class=\"dg-rowName\" x=\"34\" y=\"95\">Model</text><rect class=\"dg-bar dg-bar--window\" x=\"277.8333333333333\" y=\"83.5\" width=\"83.66666666666669\" height=\"15\" rx=\"2\"></rect><text class=\"dg-barLabel\" x=\"369.5\" y=\"94\">Weeks 3–6</text><line class=\"dg-leader\" x1=\"748\" y1=\"91\" x2=\"757\" y2=\"91\"></line><rect class=\"dg-artMark\" x=\"757\" y=\"87\" width=\"8\" height=\"8\" rx=\"1\"></rect><text class=\"dg-art\" x=\"771\" y=\"94\">Configured CRM with the agree…</text></g><g><text class=\"dg-rowNum\" x=\"0\" y=\"125\">03</text><text class=\"dg-rowName\" x=\"34\" y=\"125\">Build</text><rect class=\"dg-bar dg-bar--window\" x=\"319.66666666666663\" y=\"113.5\" width=\"292.83333333333337\" height=\"15\" rx=\"2\"></rect><text class=\"dg-barLabel\" x=\"620.5\" y=\"124\">Weeks 5–18</text><text class=\"dg-artNone\" x=\"771\" y=\"124\">—</text></g><g><text class=\"dg-rowNum\" x=\"0\" y=\"155\">04</text><text class=\"dg-rowName\" x=\"34\" y=\"155\">Migrate</text><rect class=\"dg-bar dg-bar--window\" x=\"507.91666666666663\" y=\"143.5\" width=\"146.41666666666674\" height=\"15\" rx=\"2\"></rect><text class=\"dg-barLabel\" x=\"662.3333333333334\" y=\"154\">Weeks 14–20</text><text class=\"dg-artNone\" x=\"771\" y=\"154\">—</text></g><g><text class=\"dg-rowNum\" x=\"0\" y=\"185\">05</text><text class=\"dg-rowName\" x=\"34\" y=\"185\">Roll out</text><rect class=\"dg-bar dg-bar--window\" x=\"591.5833333333334\" y=\"173.5\" width=\"146.41666666666663\" height=\"15\" rx=\"2\"></rect><text class=\"dg-barLabel\" x=\"583.5833333333334\" y=\"184\" text-anchor=\"end\">Weeks 18–24</text><text class=\"dg-artNone\" x=\"771\" y=\"184\">—</text></g><g><text class=\"dg-rowNum\" x=\"0\" y=\"215\">06</text><text class=\"dg-rowName\" x=\"34\" y=\"215\">Tune</text><line class=\"dg-standing\" x1=\"236\" y1=\"211\" x2=\"738\" y2=\"211\"></line><text class=\"dg-barLabel\" x=\"242\" y=\"205\">Ongoing</text><text class=\"dg-artNone\" x=\"771\" y=\"214\">—</text></g></svg><div class=\"dg-ganttText\"><ol class=\"dg-sched\"><li class=\"dg-schedRow\" data-stage=\"window\"><p class=\"dg-schedHead\"><span class=\"u-mono dg-schedNum\">01</span><span class=\"dg-schedName\">Sales process discovery</span></p><p class=\"dg-schedWhen u-mono\">Weeks 1–4</p><p class=\"dg-schedStage\">Inside the engagement window</p><p class=\"dg-schedArt\"><span class=\"dg-schedArtKey\">Drops out</span>Nothing the service lists separately</p></li><li class=\"dg-schedRow\" data-stage=\"window\"><p class=\"dg-schedHead\"><span class=\"u-mono dg-schedNum\">02</span><span class=\"dg-schedName\">Model</span></p><p class=\"dg-schedWhen u-mono\">Weeks 3–6</p><p class=\"dg-schedStage\">Inside the engagement window</p><p class=\"dg-schedArt\"><span class=\"dg-schedArtKey\">Drops out</span>Configured CRM with the agreed data model and stage definitions</p></li><li class=\"dg-schedRow\" data-stage=\"window\"><p class=\"dg-schedHead\"><span class=\"u-mono dg-schedNum\">03</span><span class=\"dg-schedName\">Build</span></p><p class=\"dg-schedWhen u-mono\">Weeks 5–18</p><p class=\"dg-schedStage\">Inside the engagement window</p><p class=\"dg-schedArt\"><span class=\"dg-schedArtKey\">Drops out</span>Nothing the service lists separately</p></li><li class=\"dg-schedRow\" data-stage=\"window\"><p class=\"dg-schedHead\"><span class=\"u-mono dg-schedNum\">04</span><span class=\"dg-schedName\">Migrate</span></p><p class=\"dg-schedWhen u-mono\">Weeks 14–20</p><p class=\"dg-schedStage\">Inside the engagement window</p><p class=\"dg-schedArt\"><span class=\"dg-schedArtKey\">Drops out</span>Nothing the service lists separately</p></li><li class=\"dg-schedRow\" data-stage=\"window\"><p class=\"dg-schedHead\"><span class=\"u-mono dg-schedNum\">05</span><span class=\"dg-schedName\">Roll out</span></p><p class=\"dg-schedWhen u-mono\">Weeks 18–24</p><p class=\"dg-schedStage\">Inside the engagement window</p><p class=\"dg-schedArt\"><span class=\"dg-schedArtKey\">Drops out</span>Nothing the service lists separately</p></li><li class=\"dg-schedRow\" data-stage=\"standing\"><p class=\"dg-schedHead\"><span class=\"u-mono dg-schedNum\">06</span><span class=\"dg-schedName\">Tune</span></p><p class=\"dg-schedWhen u-mono\">Ongoing</p><p class=\"dg-schedStage\">Runs throughout — no fixed window</p><p class=\"dg-schedArt\"><span class=\"dg-schedArtKey\">Drops out</span>Nothing the service lists separately</p></li></ol></div><figcaption class=\"dg-cap\"><ul class=\"dg-legend\"><li class=\"dg-legendItem\" data-stage=\"before\"><span class=\"dg-legendMark\" aria-hidden=\"true\"></span>Before the window opens</li><li class=\"dg-legendItem\" data-stage=\"window\"><span class=\"dg-legendMark\" aria-hidden=\"true\"></span>Inside the engagement window</li><li class=\"dg-legendItem\" data-stage=\"after\"><span class=\"dg-legendMark\" aria-hidden=\"true\"></span>After the report — a commitment, not an upsell</li><li class=\"dg-legendItem\" data-stage=\"standing\"><span class=\"dg-legendMark\" aria-hidden=\"true\"></span>Standing work with no fixed window</li></ul><p class=\"dg-capNote\">Every bar is positioned and sized from that phase’s own stated schedule, converted to a single week axis and drawn to one scale. <!-- -->Nothing is rounded to make the picture tidier, and a phase whose schedule the service does not state — standing work, a quarterly cadence, anything open-ended — is drawn as a dotted row carrying its own words rather than handed a plausible-looking bar it never had.</p></figcaption></figure><div class=\"sv-phaseStack\"><div class=\"stack\"><article class=\"stack__card\"><span class=\"stack__index\">01 / 06</span><h3 class=\"stack__title\">Sales process discovery</h3><div class=\"stack__body\"><p class=\"sv-phaseWhen u-mono\">Weeks 1–4</p><p class=\"sv-phaseBody\">Shadow actual sales calls. The documented process and the practised one always differ, and the practised one is the requirement.</p></div></article><article class=\"stack__card\"><span class=\"stack__index\">02 / 06</span><h3 class=\"stack__title\">Model</h3><div class=\"stack__body\"><p class=\"sv-phaseWhen u-mono\">Weeks 3–6</p><p class=\"sv-phaseBody\">Account, contact, opportunity and activity model, plus the stage definitions with exit criteria. Agreed with the sellers who will live in it.</p></div></article><article class=\"stack__card\"><span class=\"stack__index\">03 / 06</span><h3 class=\"stack__title\">Build</h3><div class=\"stack__body\"><p class=\"sv-phaseWhen u-mono\">Weeks 5–18</p><p class=\"sv-phaseBody\">Core pipeline first, in the hands of a pilot team within six weeks. Feedback from real use beats any amount of workshop.</p></div></article><article class=\"stack__card\"><span class=\"stack__index\">04 / 06</span><h3 class=\"stack__title\">Migrate</h3><div class=\"stack__body\"><p class=\"sv-phaseWhen u-mono\">Weeks 14–20</p><p class=\"sv-phaseBody\">Deduplicate and migrate accounts, contacts and history. Historical opportunity data gets mapped to the new stage model with the mapping documented.</p></div></article><article class=\"stack__card\"><span class=\"stack__index\">05 / 06</span><h3 class=\"stack__title\">Roll out</h3><div class=\"stack__body\"><p class=\"sv-phaseWhen u-mono\">Weeks 18–24</p><p class=\"sv-phaseBody\">Team by team, with training by role and a two-week adoption watch per team. Adoption is measured, not assumed.</p></div></article><article class=\"stack__card\"><span class=\"stack__index\">06 / 06</span><h3 class=\"stack__title\">Tune</h3><div class=\"stack__body\"><p class=\"sv-phaseWhen u-mono\">Ongoing</p><p class=\"sv-phaseBody\">Quarterly review of stage conversion, forecast accuracy and field usage. Fields nobody uses get deleted rather than mandated.</p></div></article></div></div><p class=\"sv-note\" style=\"margin-top:var(--s8)\"><a class=\"btn btn--secondary btn--md\" href=\"/methodologies\"><span>Read the methodology — How we run an engagement</span><span class=\"btn__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></p></div></section><section class=\"sec theme-light transition-theme u-section-tight\" data-theme-section=\"light\" aria-labelledby=\"stack\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Technology</p><h2 id=\"stack\" class=\"sv-h2\">The stack</h2></div><div style=\"display:flex;gap:var(--s4);align-items:flex-start\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-boxes\" aria-hidden=\"true\" style=\"color:var(--accent);flex:none\"><path d=\"M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z\"></path><path d=\"m7 16.5-4.74-2.85\"></path><path d=\"m7 16.5 5-3\"></path><path d=\"M7 16.5v5.17\"></path><path d=\"M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z\"></path><path d=\"m17 16.5-5-3\"></path><path d=\"m17 16.5 4.74-2.85\"></path><path d=\"M17 16.5v5.17\"></path><path d=\"M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z\"></path><path d=\"M12 8 7.26 5.15\"></path><path d=\"m12 8 4.74-2.85\"></path><path d=\"M12 13.5V8\"></path></svg><ul class=\"sv-chips\" aria-label=\"Technology stack\"><li><span class=\"badge badge--md badge--neutral\">TypeScript</span></li><li><span class=\"badge badge--md badge--neutral\">Next.js</span></li><li><span class=\"badge badge--md badge--neutral\">PostgreSQL</span></li><li><span class=\"badge badge--md badge--neutral\">Redis</span></li><li><span class=\"badge badge--md badge--neutral\">Elasticsearch</span></li></ul></div></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"deliverables\"><div class=\"u-container\"><div class=\"sv-rail\"><div class=\"sv-rail__aside\"><div class=\"sv-head__rule\" aria-hidden=\"true\" style=\"margin-bottom:var(--s6)\"></div><p class=\"u-eyebrow\">Deliverables</p><h2 id=\"deliverables\" class=\"sv-h2\" style=\"margin-top:var(--s3)\">Exactly what lands in your inbox</h2><p class=\"sv-note\"><a class=\"u-link\" href=\"/sample-report\">Walk a redacted sample before you buy one</a></p><div class=\"sv-deliverableArt\"><figure class=\"dg dg-stackFig\"><svg class=\"dg-stack\" viewBox=\"0 0 531 358\" preserveAspectRatio=\"xMidYMin meet\" role=\"img\" aria-label=\"What lands in your inbox on a CRM engagement: 6 deliverables. 1, Configured CRM with the agreed data model and stage definitions, written document. 2, Automatic activity capture from email, calendar and telephony, written document. 3, Forecast model with visible assumptions, written document. 4, Deduplicated, migrated history with a documented mapping, written document. 5, Role-based training and a manager coaching guide, written document. 6, Adoption dashboard tracked for the first two quarters, live register.\"><g><rect class=\"dg-sheet\" x=\"18\" y=\"18\" width=\"470\" height=\"92\" rx=\"6\"></rect><rect class=\"dg-sheetSpine\" x=\"18\" y=\"18\" width=\"3\" height=\"92\"></rect><text class=\"dg-sheetNum u-mono\" x=\"36\" y=\"38\">01</text><text class=\"dg-sheetTag\" x=\"472\" y=\"38\" text-anchor=\"end\">Written document</text><text class=\"dg-sheetTitle\" x=\"36\" y=\"56\">Configured CRM with the agreed data model…</text><line class=\"dg-sheetRule\" x1=\"36\" y1=\"62\" x2=\"472\" y2=\"62\"></line></g><g><rect class=\"dg-sheet\" x=\"23\" y=\"64\" width=\"470\" height=\"92\" rx=\"6\"></rect><rect class=\"dg-sheetSpine\" x=\"23\" y=\"64\" width=\"3\" height=\"92\"></rect><text class=\"dg-sheetNum u-mono\" x=\"41\" y=\"84\">02</text><text class=\"dg-sheetTag\" x=\"477\" y=\"84\" text-anchor=\"end\">Written document</text><text class=\"dg-sheetTitle\" x=\"41\" y=\"102\">Automatic activity capture from email, ca…</text><line class=\"dg-sheetRule\" x1=\"41\" y1=\"108\" x2=\"477\" y2=\"108\"></line></g><g><rect class=\"dg-sheet\" x=\"28\" y=\"110\" width=\"470\" height=\"92\" rx=\"6\"></rect><rect class=\"dg-sheetSpine\" x=\"28\" y=\"110\" width=\"3\" height=\"92\"></rect><text class=\"dg-sheetNum u-mono\" x=\"46\" y=\"130\">03</text><text class=\"dg-sheetTag\" x=\"482\" y=\"130\" text-anchor=\"end\">Written document</text><text class=\"dg-sheetTitle\" x=\"46\" y=\"148\">Forecast model with visible assumptions</text><line class=\"dg-sheetRule\" x1=\"46\" y1=\"154\" x2=\"482\" y2=\"154\"></line></g><g><rect class=\"dg-sheet\" x=\"33\" y=\"156\" width=\"470\" height=\"92\" rx=\"6\"></rect><rect class=\"dg-sheetSpine\" x=\"33\" y=\"156\" width=\"3\" height=\"92\"></rect><text class=\"dg-sheetNum u-mono\" x=\"51\" y=\"176\">04</text><text class=\"dg-sheetTag\" x=\"487\" y=\"176\" text-anchor=\"end\">Written document</text><text class=\"dg-sheetTitle\" x=\"51\" y=\"194\">Deduplicated, migrated history with a doc…</text><line class=\"dg-sheetRule\" x1=\"51\" y1=\"200\" x2=\"487\" y2=\"200\"></line></g><g><rect class=\"dg-sheet\" x=\"38\" y=\"202\" width=\"470\" height=\"92\" rx=\"6\"></rect><rect class=\"dg-sheetSpine\" x=\"38\" y=\"202\" width=\"3\" height=\"92\"></rect><text class=\"dg-sheetNum u-mono\" x=\"56\" y=\"222\">05</text><text class=\"dg-sheetTag\" x=\"492\" y=\"222\" text-anchor=\"end\">Written document</text><text class=\"dg-sheetTitle\" x=\"56\" y=\"240\">Role-based training and a manager coachin…</text><line class=\"dg-sheetRule\" x1=\"56\" y1=\"246\" x2=\"492\" y2=\"246\"></line></g><g><rect class=\"dg-sheet\" x=\"43\" y=\"248\" width=\"470\" height=\"92\" rx=\"6\"></rect><rect class=\"dg-sheetSpine\" x=\"43\" y=\"248\" width=\"3\" height=\"92\"></rect><text class=\"dg-sheetNum u-mono\" x=\"61\" y=\"268\">06</text><text class=\"dg-sheetTag\" x=\"497\" y=\"268\" text-anchor=\"end\">Live register</text><text class=\"dg-sheetTitle\" x=\"61\" y=\"286\">Adoption dashboard tracked for the first…</text><line class=\"dg-sheetRule\" x1=\"61\" y1=\"292\" x2=\"497\" y2=\"292\"></line></g></svg><figcaption class=\"dg-capNote dg-stackCap\">All 6 artefacts of a CRM engagement, drawn in the order they arrive. Each is listed in full beside this.</figcaption></figure></div></div><div class=\"sv-rail__body\"><ul class=\"reveal-group sv-ticks\" aria-label=\"Deliverables\"><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Configured CRM with the agreed data model and stage definitions</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Automatic activity capture from email, calendar and telephony</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Forecast model with visible assumptions</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Deduplicated, migrated history with a documented mapping</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Role-based training and a manager coaching guide</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Adoption dashboard tracked for the first two quarters</span></li></ul></div></div></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"outcomes\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Outcomes</p><h2 id=\"outcomes\" class=\"sv-h2\">What changes afterwards</h2></div><ul class=\"reveal-group sv-ticks\" aria-label=\"Outcomes\"><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>A pipeline that is current without anybody being chased</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>A forecast that survives contact with the end of quarter</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Sellers who open it because it is useful, not because it is mandated</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Win and loss reasons captured consistently enough to analyse</span></li><li data-reveal=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check sv-ticks__mark\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>One customer view shared by sales, support and finance</span></li></ul></div></section><section class=\"sec theme-light transition-theme u-section\" data-theme-section=\"light\" aria-labelledby=\"team\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Who does the work</p><h2 id=\"team\" class=\"sv-h2\">The team on your engagement</h2><p class=\"sv-head__lede\">A delivery lead, a solution architect, two or three engineers, and a revenue operations analyst.</p></div><div class=\"sv-expert\"><div role=\"img\" aria-label=\"Placeholder portrait for Priya Raman\" class=\"avatar-ph\" style=\"width:96px;height:96px;font-size:33px;background-image:linear-gradient(135deg, hsl(324 18% 22%), hsl(324 22% 14%))\"><span aria-hidden=\"true\">PR</span></div><div><h3 class=\"sv-expert__name\">Priya Raman</h3><p class=\"sv-expert__role\">Principal Architect</p><p class=\"sv-expert__bio\">Architects the business systems work — ERP, CRM and the platform engagements. Spent six years in manufacturing operations before writing software for it, which is why she asks to see the spreadsheets in week one.</p><p class=\"u-eyebrow sv-expert__certs-label\" id=\"certs-priya-raman\">Certifications</p><ul class=\"sv-chips\" aria-labelledby=\"certs-priya-raman\"><li><span class=\"badge badge--md badge--brand\">AWS Solutions Architect Professional</span></li><li><span class=\"badge badge--md badge--brand\">CKA</span></li></ul><p class=\"sv-note\"><a class=\"u-link\" href=\"/about/leadership/priya-raman\">More about Priya Raman</a></p></div></div></div></section><section class=\"sec theme-light transition-theme u-section-tight\" data-theme-section=\"light\" aria-labelledby=\"reviews\"><div class=\"u-container\"><div class=\"sv-head\"><div class=\"sv-head__rule\" aria-hidden=\"true\"></div><p class=\"u-eyebrow sv-head__eyebrow\">Third-party reviews</p><h2 id=\"reviews\" class=\"sv-h2\">Where we are reviewed</h2></div><ul class=\"sv-accred\" aria-label=\"Third-party reviews\"><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">Clutch — 4.9 from 31 reviews</span><span class=\"sv-accred__issuer\"><a class=\"u-link\" href=\"https://clutch.co/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Read the reviews on Clutch</a></span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">G2 — 4.7 from 44 reviews</span><span class=\"sv-accred__issuer\"><a class=\"u-link\" href=\"https://www.g2.com/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Read the reviews on G2</a></span></span></li></ul><div style=\"margin-top:var(--s12)\"><p class=\"u-eyebrow\" style=\"margin-bottom:var(--s4)\">Accreditation</p><ul class=\"sv-accred\"><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">ISO/IEC 27001:2022 — Information Security Management</span><span class=\"sv-accred__issuer\">UKAS-accredited certification body</span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">ISO 9001:2015 — Quality Management</span><span class=\"sv-accred__issuer\">UKAS-accredited certification body</span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">SOC 2 Type II — Security, Availability, Confidentiality</span><span class=\"sv-accred__issuer\">Independent CPA firm</span></span></li><li class=\"sv-accred__item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check sv-accred__icon\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span><span class=\"sv-accred__label\">Cyber Essentials Plus — audited technical controls</span><span class=\"sv-accred__issuer\">IASME, on behalf of the NCSC</span></span></li></ul><p class=\"sv-note\"><a class=\"u-link\" href=\"/certifications\">Every certificate number and expiry date is published</a> · <a class=\"u-link\" href=\"/trust\">Our own security posture</a></p></div></div></section><section class=\"sec theme-light transition-theme u-section-tight\" data-theme-section=\"light\" aria-labelledby=\"clients\"><div class=\"u-container\"><h2 id=\"clients\" class=\"u-eyebrow\" style=\"margin-bottom:var(--s6)\">Selected clients</h2><div class=\"marquee\" style=\"--gap:var(--s12);--marquee-dur:52s\" tabindex=\"0\" role=\"group\" aria-label=\"Selected clients\"><ul class=\"marquee__track mq-track\" aria-label=\"Selected clients\"><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Northgate Freight</span><span class=\"mq__meta\">Logistics</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Lumen Clinical</span><span class=\"mq__meta\">Healthcare</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Verity Payments</span><span class=\"mq__meta\">Financial Services</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Aldercross Group</span><span class=\"mq__meta\">Manufacturing</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Mereway Housing</span><span class=\"mq__meta\">Public Sector</span></span></li><li class=\"mq__item\"><span class=\"mq__text\"><span class=\"mq__label\">Hallstead Retail</span><span class=\"m