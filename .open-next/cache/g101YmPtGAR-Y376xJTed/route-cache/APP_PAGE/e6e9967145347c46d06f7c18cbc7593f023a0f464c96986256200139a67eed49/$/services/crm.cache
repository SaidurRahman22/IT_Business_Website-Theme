\"name\\\":\\\"Bangladesh\\\"}],\\\"audience\\\":{\\\"@type\\\":\\\"BusinessAudience\\\",\\\"name\\\":\\\"Regulated organisations\\\"},\\\"category\\\":\\\"Software Development\\\",\\\"hasOfferCatalog\\\":{\\\"@type\\\":\\\"OfferCatalog\\\",\\\"name\\\":\\\"CRM — what is included\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Pipeline and stages\\\",\\\"description\\\":\\\"Stages defined by buyer behaviour with explicit exit criteria, not by internal optimism. A stage you cannot evidence is not a stage.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Activity capture\\\",\\\"description\\\":\\\"Email, calendar and call logging captured automatically. Manual activity entry is a tax sellers will not pay.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Forecasting\\\",\\\"description\\\":\\\"Weighted and committed forecasts built from real stage movement and velocity, with the assumptions visible rather than embedded in a spreadsheet.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":4,\\\"name\\\":\\\"Quote and proposal\\\",\\\"description\\\":\\\"Configure-price-quote with approval thresholds, versioned proposals, and e-signature.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":5,\\\"name\\\":\\\"Integration\\\",\\\"description\\\":\\\"Marketing automation, support, billing and the ERP. Sellers should not need to open four systems to answer one customer question.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":6,\\\"name\\\":\\\"Reporting\\\",\\\"description\\\":\\\"Cohort retention, win and loss reasons, velocity by segment, and the activity-to-outcome ratios that tell a manager where coaching is needed.\\\"}]},\\\"termsOfService\\\":\\\"https://envenox.com/legal/terms\\\"}\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerous