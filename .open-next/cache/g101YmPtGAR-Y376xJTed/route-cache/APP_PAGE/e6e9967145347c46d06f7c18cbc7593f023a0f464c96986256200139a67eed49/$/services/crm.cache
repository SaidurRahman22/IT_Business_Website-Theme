sName\":\"sv-card__line\",\"children\":\"Finance, inventory and procurement modelled on your exceptions, with history reconciled.\"}],null]}]]}],[\"$\",\"$L3e\",\"custom-software\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$72\"}],\"$L73\"]}],\"$L74\",\"$L75\"]}],\"$L76\"]]}]}]]\n34:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"engagement\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Commercials\"}],[\"$\",\"h2\",null,{\"id\":\"engagement\",\"className\":\"sv-h2\",\"children\":\"Shape, timeline and scoping\"}],null]}],[\"$\",\"dl\",null,{\"className\":\"sv-defs\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Timeline\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"5–7 months, pilot team live by week 6.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Team shape\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"A delivery lead, a solution architect, two or three engineers, and a revenue operations analyst.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Engagement\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Phased delivery with a pilot-first rollout.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Scoping\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":[\"A named engineer replies within one business day. Scoping call within three.\",\" \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services/engagement-models\",\"children\":\"How the four engagement models differ\"}],\".\"]}]]}]]}]]}]}]]\n35:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"Frequently asked\"}],null]}],[\"$\",\"$L77\",null,{\"items\":[{\"q\":\"Why not Salesforce or HubSpot?\",\"a\":\"For most companies, use one of them. Build when your sales motion is genuinely unusual, when per-seat licensing at your headcount exceeds a build, or when you have already built so many integrations around a package that you are maintaining both anyway. We will say which case you are in during discovery.\"},{\"q\":\"How do you get sellers to adopt it?\",\"a\":\"By making every field give something back and by never asking them to type what can be captured. Adoption is a design outcome, not a training outcome — if a seller has to enter data purely so a manager can run a report, no amount of training will fix it, and mandating it produces fiction rather than data.\"},{\"q\":\"What about data quality in the migration?\",\"a\":\"Deduplication, normalisation and enrichment with a report of what we could not reconcile. We would rather hand you 12,000 clean accounts and a list of 400 ambiguous ones than 14,000 records you cannot trust.\"},{\"q\":\"Can managers still get their reports?\",\"a\":\"Yes, and they get better ones, because the underlying data is current. The difference is that the report is assembled from activity that happens anyway rather than from a weekly update ritual.\"},{\"q\":\"Does it integrate with the ERP?\",\"a\":\"Yes — accounts, contracts, invoices and payment status, so a seller can answer a billing question without leaving the CRM. If you are buying both from us, the integration is designed once rather than bolted on twice.\"}],\"headingLevel\":3}]]}]}]]\n78:{\"id\":\"403c44504416ed33d4af4350092b655f174641e336\",\"bound\":null}\n36:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section grain\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-3px\",\"marginRight\":\"var(--s2)\"},\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"A delivery lead, a solution architect, two or three engineers, and a revenue operations analyst.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"form\",null,{\"action\":\"$h78\",\"className\":\"sv-form\",\"id\":\"enquiry-form\",\"children\":[[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"returnTo\",\"value\":\"/services/crm\"}],[[\"$\",\"div\",\"enquiry-incomplete\",{\"id\":\"enquiry-incomplete\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"Some required fields came through empty. They are marked below — fill them in an