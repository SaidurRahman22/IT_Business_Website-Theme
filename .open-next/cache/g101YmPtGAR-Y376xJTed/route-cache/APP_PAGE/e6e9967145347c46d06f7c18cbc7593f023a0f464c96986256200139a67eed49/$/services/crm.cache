ix(in oklab, var(--accent) 38%, transparent);\\n}\\n\\n/* --- the only --signal-* usage in the codebase --- */\\n.badge--severity {\\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\\n  --badge-fg: var(--sig);\\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"58:[\\\"$\\\",\\\"li\\\",\\\"CKA\\\",{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-badge\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$9d\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"badge badge--md badge--brand\\\",\\\"children\\\":[null,\\\"CKA\\\"]}]]}]\\n59:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-note\\\",\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"className\\\":\\\"u-link\\\",\\\"href\\\":\\\"/about/leadership/priya-raman\\\",\\\"children\\\":\\\"More about Priya Raman\\\"}]}]\\n5a:[\\\"$\\\",\\\"path\\\",\\\"3c2336\\\",{\\\"d\\\":\\\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\\\"}]\\n5b:[\\\"$\\\",\\\"path\\\",\\\"dzmm74\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\"}]\\n5c:[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-accred__label\\\",\\\"children\\\":\\\"ISO 9001:2015 — Quality Management\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-accred__issuer\\\",\\\"children\\\":\\\"UKAS-accredited certification body\\\"}]]}]\\n\"])</script><script>self.__next_f