$39\\\"}],\\\"$L3a\\\"],\\\"$L3b\\\"]}],\\\"$L3c\\\"]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"29:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-light transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"light\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"problem\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s6)\\\"}}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The problem\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"problem\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s3)\\\"},\\\"children\\\":\\\"A pipeline your sales team updates because it helps them, not because it is mandated.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__body\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-prose-measure\\\",\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"var(--text-lg)\\\",\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"The defining failure of CRM is not technical. It is that salespeople do not update it, because updating it costs them twenty minutes and gives them nothing, while the report it feeds is for someone else. Every subsequent problem — stale pipeline, invented forecasts, a management dashboard that contradicts the sales floor — follows from that. We design the other way round: the seller gets something back from every field they fill, data that can be captured automatically is never typed, and the forecast is assembled from activity that happens anyway. Then the pipeline stays current without anyone being chased, and the report is a by-product rather than an obligation.\\\"}],null]}]]}]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"3f:T43d,\"])</script><script>self.__next_f.push([1,\"\\n.card {\\n  position: relative;\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  color: inherit;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out);\\n}\\n.card--pad { padding: var(--s6); }\\n.card--pad-lg { padding: var(--s8); }\\n.card--flush { background-color: transparent; }\\n\\n/* Hover: colour only. Anything that moves the card is a spec violation. */\\n.card[data-interactive='true']:hover,\\n.card:has(.card__link):hover,\\n.card:has(.card__link:focus-visible) {\\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\\n  border-color: var(--border-strong);\\n}\\n\\n/* The stretched link. The anchor's own text stays the accessible name. */\\n.card__link {\\n  color: inherit;\\n  text-decoration: none;\\n  outline-offset: 4px;\\n}\\n.card__link::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  border-radius: inherit;\\n  z-index: 1;\\n}\\n/* Anything that must stay clickable inside a stretched-link card. */\\n.card__above { position: relative; z-index: 2; }\\n\"])</script><script>self.__next_f.push([1,\"40:T43d,\"])</script><script>self.__next_f.push([1,\"\\n.card {\\n  position: relative;\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  color: inherit;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out);\\n}\\n.card--pad { padding: var(--s6); }\\n.card--pad-lg { padding: var(--s8); }\\n.card--flush { background-color: transparent; }\\n\\n/* Hover: colour only. Anything that moves the card is a spec violation. */\\n.card[data-interactive='true']:hover,\\n.card:has(.card__link):hover,\\n.card:has(.card__link:focus-visible) {\\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\\n  border-color: var(--border-strong);\\n}\\n\\n/* The stretched link. The anchor's own text stays the accessible name. */\\n.card__link {\\n  color: inherit;\\n  text-decoration: none;\\n  outline-offset: 4px;\\n}\\n.card__link::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  border-radius: inherit;\\n  z-index: 1;\\n}\\n/* Anything that must stay clickable inside a stretched-link card. */\\n.card__above { position: relative; z-index: 2; }\\n\"])</script><script>self.__next_f.push([1,\"2a:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-light transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"light\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"included\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Scope\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"included\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"What is included\\\"}],null]}],[\\\"$\\\",\\\"$L3d\\\",null,{\\\"as\\\":\\\"ul\\\",\\\"className\\\":\\\"sv-grid sv-grid--3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L3e\\\",\\\"Pipeline and stages\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-card\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$3f\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"card card--pad-lg sv-card\\\",\\\"data-interactive\\\":\\\"$undefined\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"sv-h3\\\",\\\"children\\\":\\\"Pipeline and stages\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-card__line\\\",\\\"children\\\":\\\"Stages defined by buyer behaviour with explicit exit criteria, not by internal optimism. A stage you cannot evidence is not a stage.\\\"}]]}]]}],[\\\"$\\\",\\\"$L3e\\\",\\\"Activity capture\\\",{\\\"as\\\":\\\"li\\\",\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-card\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$40\\\"}],\\\"$L41\\\"]}],\\\"$L42\\\",\\\"$L43\\\",\\\"$L44\\\",\\\"$L45\\\"]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"46:Tdb3,\"])</script><script>self.__next_f.push([1,\"\\n.btn {\\n  --btn-bg: transparent;\\n  --btn-bg-hover: transparent;\\n  --btn-fg: var(--fg);\\n  --btn-border: transparent;\\n  --btn-border-hover: transparent;\\n\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--btn-border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--btn-bg);\\n  color: var(--btn-fg);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 500;\\n  letter-spacing: -0.01em;\\n  line-height: 1;\\n  text-align: center;\\n  text-decoration: none;\\n  cursor: pointer;\\n  /* ONLY colour transitions. A transform here would break the house rule. */\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.btn:hover {\\n  background-color: var(--btn-bg-hover);\\n  border-color: var(--btn-border-hover);\\n  /* Falls back to the resting label colour, so no existing variant changes.\\n     A variant whose hover fill moves far in lightness needs to move its label\\n     too, or the hover state quietly fails contrast while the resting state\\n     passes — which is the kind of thing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"2b:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"security-by-default\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"The differentiator\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"security-by-default\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Security by default\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-head__lede\\\",\\\"children\\\":\\\"Our engineers work next to a security practice that will attack what they build. That changes how authorisation, audit logging and secrets get designed — before the first commit rather than after the first report.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":1.5,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-shield-check\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--accent)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"oel41y\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\"}],[\\\"$\\\",\\\"path\\\",\\\"dzmm74\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-lede\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s4)\\\"},\\\"children\\\":\\\"We build it and we break it. The findings land in our own sprint backlog.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-cred\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"sv-cred__figure\\\",\\\"children\\\":\\\"9 days median\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-cred__context\\\",\\\"children\\\":\\\"from a security finding being confirmed to the fix being in production, on joint engagements\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s6)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$46\\\"}],\\\"$L47\\\"]}]]}],\\\"$L48\\\"]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"49:T1fac,\"])</script><script>self.__next_f.push([1,\"\\n.dg {\\n  /* POSITIONED ON PURPOSE. .dg-ganttText is clipped and absolutely positioned\\n     at wide widths; an absolutely positioned element is only clipped by an\\n     ancestor in its containing-block chain. Without this the clipped schedule\\n     escapes and widens the page. */\\n  position: relative;\\n  margin: 0;\\n  min-width: 0;\\n}\\n\\n/* ---------------- the drawn schedule ---------------- */\\n.dg-gantt { display: none; width: 100%; height: auto; overflow: visible; }\\n@media (min-width: 860px) {\\n  .dg-gantt { display: block; }\\n}\\n\\n.dg-axisUnit,\\n.dg-colHead {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 11px;\\n  letter-spacing: 0.1em;\\n  text-transform: uppercase;\\n  fill: var(--muted);\\n}\\n.dg-tick {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  fill: var(--muted);\\n}\\n.dg-grid { stroke: var(--border-strong); stroke-width: 1; }\\n.dg-zero { stroke: var(--accent); stroke-width: 1.5; }\\n.dg-zeroLabel {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  letter-spacing: 0.08em;\\n  fill: var(--accent);\\n}\\n\\n.dg-rowNum {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 11px;\\n  fill: var(--muted);\\n}\\n.dg-rowName { font-size: 13px; fill: var(--fg); }\\n\\n/* Three stages, three SHAPES as well as three fills: a filled bar, a hollow\\n   dashed bar and a half-height bar. The information survives greyscale. */\\n.dg-bar { fill: var(--accent); stroke: none; }\\n.dg-bar--before { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 3; }\\n.dg-bar--after { fill: var(--muted-strong); }\\n.dg-bar--unstated { opacity: 0.55; }\\n.dg-openTip { fill: var(--accent); }\\n.dg-standing { stroke: var(--border-strong); stroke-width: 2; stroke-dasharray: 2 4; }\\n\\n.dg-barLabel {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  fill: var(--muted);\\n}\\n/* Printed on top of a filled bar: the bar's fill is --accent or\\n   --muted-strong, both of which are LIGHT in the dark palettes and DARK in the\\n   light one, so the text takes the ground colour rather than a fixed one. */\\n.dg-barLabel--in { fill: var(--bg); }\\n.dg-leader { stroke: var(--border-strong); stroke-width: 1; }\\n.dg-artMark { fill: var(--accent); }\\n.dg-art { font-size: 12px; fill: var(--muted-strong); }\\n/* \\\"nothing drops out of this phase\\\" is information, not furniture, so the\\n   dash takes a text neutral. --border-strong is a hairline value and renders\\n   as an almost-invisible mark in .theme-dark. */\\n.dg-artNone { font-size: 12px; fill: var(--muted); }\\n\\n/* ---------------- the schedule as DOM text ---------------- */\\n.dg-sched { list-style: none; margin: 0; padding: 0; display: grid; }\\n.dg-schedRow {\\n  display: grid;\\n  gap: var(--s1);\\n  padding: var(--s4) 0;\\n  border-top: 1px solid var(--border);\\n  min-width: 0;\\n}\\n@media (min-width: 560px) {\\n  .dg-schedRow {\\n    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);\\n    column-gap: var(--s6);\\n    align-items: baseline;\\n  }\\n  .dg-schedHead { grid-row: span 3; }\\n}\\n.dg-schedHead { display: flex; gap: var(--s3); align-items: baseline; margin: 0; min-width: 0; }\\n.dg-schedNum { font-size: var(--text-xs); color: var(--accent); flex: none; }\\n.dg-schedName { font-weight: 500; color: var(--fg); }\\n.dg-schedWhen { margin: 0; font-size: var(--text-xs); color: var(--muted-strong); }\\n.dg-schedStage { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.dg-schedArt { margin: 0; font-size: var(--text-sm); color: var(--muted-strong); }\\n.dg-schedArtKey {\\n  display: inline-block;\\n  margin-right: var(--s2);\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.1em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n\\n@media (min-width: 860px) {\\n  .dg-ganttText {\\n    position: absolute;\\n    width: 1px;\\n    height: 1px;\\n    margin: -1px;\\n    padding: 0;\\n    overflow: hidden;\\n    clip-path: inset(50%);\\n    white-space: nowrap;\\n    border: 0;\\n  }\\n}\\n\\n/* ---------------- caption and legend ---------------- */\\n.dg-cap { margin-top: var(--s6); }\\n.dg-legend {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: var(--s3) var(--s6);\\n  list-style: none;\\n  margin: 0 0 var(--s4);\\n  padding: 0;\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n}\\n.dg-legendItem { display: inline-flex; align-items: center; gap: var(--s2); }\\n.dg-legendMark { width: 18px; height: 8px; border-radius: 2px; background-color: var(--accent); flex: none; }\\n.dg-legendItem[data-stage='before'] .dg-legendMark {\\n  background-color: transparent;\\n  border: 1px dashed var(--muted);\\n}\\n.dg-legendItem[data-stage='after'] .dg-legendMark { height: 4px; background-color: var(--muted-strong); }\\n.dg-legendItem[data-stage='standing'] .dg-legendMark {\\n  height: 2px;\\n  background-color: transparent;\\n  border-top: 2px dotted var(--border-strong);\\n}\\n.dg-capNote {\\n  margin: 0;\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  max-width: 74ch;\\n  line-height: 1.6;\\n}\\n\\n/* ---------------- deliverables stack ---------------- */\\n.dg-stackFig { display: grid; gap: var(--s4); }\\n.dg-stack { width: 100%; height: auto; max-width: 34rem; }\\n.dg-sheet { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1; }\\n.dg-sheetSpine { fill: var(--accent); }\\n.dg-sheetNum { font-size: 11px; letter-spacing: 0.1em; fill: var(--muted); }\\n.dg-sheetTag {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  fill: var(--muted);\\n}\\n.dg-sheetTitle { font-size: 15px; font-weight: 500; fill: var(--fg); }\\n.dg-sheetRule { stroke: var(--border-strong); stroke-width: 1; }\\n.dg-stackCap { max-width: 34rem; }\\n\\n/* ---------------- scope boundary ---------------- */\\n.dg-scope { display: grid; gap: var(--s6); }\\n@media (min-width: 1000px) {\\n  .dg-scope { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: var(--s8); align-items: start; }\\n}\\n.dg-scopeIn {\\n  border: 1px solid var(--accent);\\n  border-radius: var(--radius-lg);\\n  padding: var(--s6);\\n  min-width: 0;\\n}\\n@media (min-width: 768px) { .dg-scopeIn { padding: var(--s8); } }\\n.dg-scopeTag {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: baseline;\\n  gap: var(--s3);\\n  margin: 0 0 var(--s6);\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.12em;\\n  text-transform: uppercase;\\n  color: var(--accent);\\n}\\n.dg-scopeCount { color: var(--muted); letter-spacing: 0.08em; }\\n.dg-scopeGrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\\n@media (min-width: 640px) { .dg-scopeGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\\n.dg-scopeCell {\\n  min-width: 0;\\n  padding: var(--s4);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--surface);\\n}\\n.dg-scopeNum { display: block; font-size: var(--text-xs); color: var(--accent); margin-bottom: var(-