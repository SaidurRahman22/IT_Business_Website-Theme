ine: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n88:[\"$\",\"div\",null,{\"className\":\"sv-form__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$b7\"}],\"$Lb8\"],\"$Lb9\"]}]\n8a:[\"$\",\"$Le\",null,{\"href\":\"/contact\",\"className\":\"btn btn--primary btn--lg\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Start a conversation\"}],null]}]\nba:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n8b:[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$ba\"}],\"$Lbb\"]\n8d:[\"$\",\"a\",null,{\"href\":\"#enquiry-form\",\"className\":\"btn btn--secondary btn--lg\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Send an enquiry\"}],null]}]\n92:[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}]\n93:[\"$\",\"span\",null,{\"children\":\"Monitoring and retest — Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.\"}]\n94:[\"$\",\"p\",null,{\"className\":\"dg-schedHead\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-schedNum\",\"children\":\"02\"}],[\"$\",\"span\",null,{\"className\":\"dg-schedName\",\"children\":\"Design\"}]]}]\n95:[\"$\",\"p\",null,{\"className\":\"dg-schedWhen u-mono\",\"children\":\"Weeks 3–6\"}]\n96:[\"$\",\"p\",null,{\"className\":\"dg-schedStage\",\"children\":\"Inside the engagement window\"}]\n97:[\"$\",\"p\",null,{\"className\":\"dg-schedArt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-schedArtKey\",\"children\":\"Drops out\"}],\"Nothing the service lists separately\"]}]\n98:[\"$\",\"li\",\"3\",{\"className\":\"dg-schedRow\",\"data-stage\":\"window\",\"children\":[[\"$\",\"p\",null,{\"className\":\"dg-schedHead\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-schedNum\",\"children\":\"03\"}],[\"$\",\"span\",null,{\"className\":\"dg-schedName\",\"children\":\"Build\"}]]}],[\"$\",\"p\",null,{\"className\":\"dg-schedWhen u-mono\",\"children\":\"Weeks 5–24\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedStage\",\"children\":\"Inside the engagement window\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedArt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-schedArtKey\",\"children\":\"Drops out\"}],\"Nothing the service lists separately\"]}]]}]\n99:[\"$\",\"li\",\"4\",{\"className\":\"dg-schedRow\",\"data-stage\":\"window\",\"children\":[[\"$\",\"p\",null,{\"className\":\"dg-schedHead\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-schedNum\",\"children\":\"04\"}],[\"$\",\"span\",null,{\"className\":\"dg-schedName\",\"children\":\"Test\"}]]}],[\"$\",\"p\",null,{\"className\":\"dg-schedWhen u-mono\",\"children\":\"Continuous, hardening in the last 4 weeks\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedStage\",\"children\":\"Inside the engagement window\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedArt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-schedArtKey\",\"children\":\"Drops out\"}],\"Threat model and a clean penetration test report at go-live\"]}]]}]\n9a:[\"$\",\"li\",\"5\",{\"className\":\"dg-schedRow\",\"data-stage\":\"standing\",\"children\":[[\"$\",\"p\",null,{\"className\":\"dg-schedHead\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-schedNum\",\"children\":\"05\"}],[\"$\",\"span\",null,{\"className\":\"dg-schedName\",\"children\":\"Deploy\"}]]}],[\"$\",\"p\",null,{\"className\":\"dg-schedWhen u-mono\",\"children\":\"Launch window\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedStage\",\"children\":\"Runs throughout — no fixed window\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedArt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-schedArtKey\",\"children\":\"Drops out\"}],\"Nothing the service lists separately\"]}]]}]\n9b:[\"$\",\"li\",\"6\",{\"className\":\"dg-schedRow\",\"data-stage\":\"standing\",\"children\":[[\"$\",\"p\",null,{\"className\":\"dg-schedHead\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-schedNum\",\"children\":\"06\"}],[\"$\",\"span\",null,{\"className\":\"dg-schedName\",\"children\":\"Operate or hand over\"}]]}],[\"$\",\"p\",null,{\"className\":\"dg-schedWhen u-mono\",\"children\":\"Ongoing\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedStage\",\"children\":\"Runs throughout — no fixed window\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedArt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-schedArtKey\",\"children\":\"Drops out\"}],\"Nothing the service lists separately\"]}]]}]\n9c:[\"$\",\"figcaption\",null,{\"className\":\"dg-cap\",\"children\":[[\"$\",\"ul\",null,{\"className\":\"dg-legend\",\"children\":[[\"$\",\"li\",null,{\"className\":\"dg-legendItem\",\"data-stage\":\"before\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-legendMark\",\"aria-hidden\":\"true\"}],\"Before the window opens\"]}],[\"$\",\"li\",null,{\"className\":\"dg-legendItem\",\"data-stage\":\"window\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-legendMark\",\"aria-hidden\":\"true\"}],\"Inside the engagement window\"]}],[\"$\",\"li\",null,{\"className\":\"dg-legendItem\",\"data-stage\":\"after\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-legendMark\",\"aria-hidden\":\"true\"}],\"After the report — a commitment, not an upsell\"]}],[\"$\",\"li\",null,{\"className\":\"dg-legendItem\",\"data-stage\":\"standing\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-legendMark\",\"aria-hidden\":\"true\"}],\"Standing work with no fixed window\"]}]]}],[\"$\",\"p\",null,{\"className\":\"dg-capNote\",\"children\":[\"Every bar is positioned and sized from that phase’s own stated schedule, converted to a single week axis and drawn to one scale. \",\"Nothing is rounded to make the picture tidier, and a phase whose schedule the service does not state — standing work, a quarterly cadence, anything open-ended — is drawn as a dotted row carrying its own words rather than handed a plausible-looking bar it never had.\"]}]]}]\n9e:[\"$\",\"article\",\"1\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"01 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Discovery\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Weeks 1–4\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Users, constraints, obligations and non-goals. Output is a decision record, a threat model, a costed plan, and a walking skeleton deployed and authenticating.\"}]]}]]}]\n9f:[\"$\",\"article\",\"2\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"02 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Design\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Weeks 3–6\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Interface design against real content and real edge cases. Secure design review on the architecture. Empty states, error states and the permission matrix, all designed rather than discovered.\"}]]}]]}]\na0:[\"$\",\"article\",\"3\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"03 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Build\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Weeks 5–24\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Two-week sprints. Planning Monday, demo and retro Friday of week two, backlog refinement mid-sprint. Trunk-based, feature-flagged, deployed to staging continuously.\"}]]}]]}]\na1:[\"$\",\"article\",\"4\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"04 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Test\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Continuous, hardening in the last 4 weeks\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Unit and integration tests written with the code, end-to-end on critical journeys, accessibility audit, load test, and a penetration test by our security practice.\"}]]}]]}]\na2:[\"$\",\"article\",\"5\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"05 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Deploy\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Launch window\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Staged rollout behind flags, monitoring and alerting live before traffic, rehearsed rollback, and a hypercare period with the build team on call.\"}]]}]]}]\na3:[\"$\",\"article\",\"6\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"06 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Operate or hand over\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Ongoing\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Documented handover with paired work and a recorded architecture tour, or a support agreement with a response SLA and a named engineer.\"}]]}]]}]\na5:[\"$\",\"$Le\",null,{\"href\":\"/methodologies\",\"className\":\"btn btn--secondary btn--md\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Read the methodology — How we run an engagement\"}],[\"$\",\"span\",null,{\"className\":\"btn__icon\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]}]]}]\nb0:[\"$\",\"$Le\",null,{\"href\":\"/case-studies/manufacturing-erp-replacement\",\