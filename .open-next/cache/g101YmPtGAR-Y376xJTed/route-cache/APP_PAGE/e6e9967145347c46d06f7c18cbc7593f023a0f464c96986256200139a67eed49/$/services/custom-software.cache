nt is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n3e:[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$8c\"}],\"$L8d\"]\n3f:[\"$\",\"ul\",null,{\"className\":\"sv-hero__meta\",\"children\":[[\"$\",\"li\",null,{\"children\":\"4–8 months to first production release for a typical business system.\"}],[\"$\",\"li\",null,{\"children\":\"Fixed-scope phases with a time-and-materials build, or a dedicated squad on a quarterly commitment.\"}]]}]\n44:[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"sv-h3\",\"children\":\"Build\"}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"Two-week sprints, trunk-based development, continuous deployment to staging from day one, and a demo you can click every fortnight.\"}]]}]\n8e:T43d,\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n.card--flush { background-color: transparent; }\n\n/* Hover: colour only. Anything that moves the card is a spec violation. */\n.card[data-interactive='true']:hover,\n.card:has(.card__link):hover,\n.card:has(.card__link:focus-visible) {\n  background-color: color-mix(in oklab, var(--surface) 88%, var(--fg) 12%);\n  border-color: var(--border-strong);\n}\n\n/* The stretched link. The anchor's own text stays the accessible name. */\n.card__link {\n  color: inherit;\n  text-decoration: none;\n  outline-offset: 4px;\n}\n.card__link::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  z-index: 1;\n}\n/* Anything that must stay clickable inside a stretched-link card. */\n.card__above { position: relative; z-index: 2; }\n45:[\"$\",\"$L41\",\"Security by construction\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$8e\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"sv-h3\",\"children\":\"Security by construction\"}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"Threat model first, secure design review at each architectural decision, and a penetration test before go-live by our own testers against code they have read.\"}]]}]]}]\n8f:T43d,\n.card {\n  position: relative;\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  color: inherit;\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out);\n}\n.card--pad { padding: var(--s6); }\n.card--pad-lg { padding: var(--s8); }\n