w.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Threat model at design time — Before the first sprint. The cheapest security finding is an architecture decision, and the most expensive one is the same decision discovered in week forty.\"}]]}],[\"$\",\"$L41\",\"Secure design review at each decision — Our testers review architectural decision records as they are written, not the finished system.\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Secure design review at each decision — Our testers review architectural decision records as they are written, not the finished system.\"}]]}],[\"$\",\"$L41\",\"Security in the pipeline — SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Security in the pipeline — SAST, DAST, SCA and secret scanning tuned to a signal-to-noise ratio the delivery team accepts, with an agreed finding budget.\"}]]}],[\"$\",\"$L41\",\"Continuous testing during the build — Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Continuous testing during the build — Not one test at the end. Testers work against each major feature as it lands, while changing it is still cheap.\"}]]}],[\"$\",\"$L41\",\"Pre-release penetration test — A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Pre-release penetration test — A full test before go-live by a lead tester who did not write the code, with the report issued to you unedited.\"}]]}],[\"$\",\"$L41\",\"Monitoring and retest — Detections written for the system we built, and a retest cadence after launch. The loop does not stop at release.\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[\"$L92\",\"$undefined\"]}],\"$L93\"]}]]}]}]\n4d:[\"$\",\"figure\",null,{\"className\":\"dg\",\"id\":\"engagement-shape\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"dg-gantt\",\"viewBox\":\"0 0 1000 252\",\"preserveAspectRatio\":\"xMidYMid meet\",\"role\":\"img\",\"aria-label\":\"Engagement shape for Custom Software: 6 phases. Phase 1, Discovery, Weeks 1–4, inside the engagement window. Phase 2, Design, Weeks 3–6, inside the engagement window. Phase 3, Build, Weeks 5–24, inside the engagement window. Phase 4, Test, Continuous, hardening in the last 4 weeks, inside the engagement window, producing the threat model and a clean penetration test report at go-live. Phase 5, Deploy, Launch window, no fixed window. Phase 6, Operate or hand over, Ongoing, no fixed window.\",\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-axisUnit\",\"x\":0,\"y\":16,\"children\":\"weeks from kick-off\"}],[[\"$\",\"g\",\"0\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":236,\"y1\":30,\"x2\":236,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":236,\"y\":24,\"textAnchor\":\"middle\",\"children\":0}]]}],[\"$\",\"g\",\"10\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":415.2857142857143,\"y1\":30,\"x2\":415.2857142857143,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":415.2857142857143,\"y\":24,\"textAnchor\":\"middle\",\"children\":10}]]}],[\"$\",\"g\",\"20\",{\"children\":[[\"$\",\"line\",null,{\"className\":\"dg-grid\",\"x1\":594.5714285714286,\"y1\":30,\"x2\":594.5714285714286,\"y2\":226}],[\"$\",\"text\",null,{\"className\":\"dg-tick\",\"x\":594.5714285714286,\"y\":24,\"textAnchor\":\"middle\",\"children\":20}]]}]],[[\"$\",\"line\",null,{\"className\":\"dg-zero\",\"x1\":236,\"y1\":30,\"x2\":236,\"y2\":232}],[\"$\",\"text\",null,{\"className\":\"dg-zeroLabel\",\"x\":236,\"y\":245,\"textAnchor\":\"middle\",\"children\":\"kick-off\"}]],[\"$\",\"text\",null,{\"className\":\"dg-colHead\",\"x\":762,\"y\":16,\"children\":\"Drops out\"}],[[\"$\",\"g\",\"1\",{\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-rowNum\",\"x\":0,\"y\":65,\"children\":\"01\"}],[\"$\",\"text\",null,{\"className\":\"dg-rowName\",\"x\":34,\"y\":65,\"children\":\"Discovery\"}],[[\"$\",\"rect\",null,{\"className\":\"dg-bar dg-bar--window\",\"x\":236,\"y\":53.5,\"width\":71.71428571428572,\"height\":15,\"rx\":2}],null,[\"$\",\"text\",null,{\"className\":\"dg-barLabel\",\"x\":315.7142857142857,\"y\":64,\"children\":\"Weeks 1–4\"}]],[\"$\",\"text\",null,{\"className\":\"dg-artNone\",\"x\":771,\"y\":64,\"children\":\"—\"}]]}],[\"$\",\"g\",\"2\",{\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-rowNum\",\"x\":0,\"y\":95,\"children\":\"02\"}],[\"$\",\"text\",null,{\"className\":\"dg-rowName\",\"x\":34,\"y\":95,\"children\":\"Design\"}],[[\"$\",\"rect\",null,{\"className\":\"dg-bar dg-bar--window\",\"x\":271.85714285714283,\"y\":83.5,\"width\":71.71428571428572,\"height\":15,\"rx\":2}],null,[\"$\",\"text\",null,{\"className\":\"dg-barLabel\",\"x\":351.57142857142856,\"y\":94,\"children\":\"Weeks 3–6\"}]],[\"$\",\"text\",null,{\"className\":\"dg-artNone\",\"x\":771,\"y\":94,\"children\":\"—\"}]]}],[\"$\",\"g\",\"3\",{\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-rowNum\",\"x\":0,\"y\":125,\"children\":\"03\"}],[\"$\",\"text\",null,{\"className\":\"dg-rowName\",\"x\":34,\"y\":125,\"children\":\"Build\"}],[[\"$\",\"rect\",null,{\"className\":\"dg-bar dg-bar--window\",\"x\":307.7142857142857,\"y\":113.5,\"width\":358.5714285714285,\"height\":15,\"rx\":2}],null,[\"$\",\"text\",null,{\"className\":\"dg-barLabel\",\"x\":674.2857142857142,\"y\":124,\"children\":\"Weeks 5–24\"}]],[\"$\",\"text\",null,{\"className\":\"dg-artNone\",\"x\":771,\"y\":124,\"children\":\"—\"}]]}],[\"$\",\"g\",\"4\",{\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-rowNum\",\"x\":0,\"y\":155,\"children\":\"04\"}],[\"$\",\"text\",null,{\"className\":\"dg-rowName\",\"x\":34,\"y\":155,\"children\":\"Test\"}],[[\"$\",\"rect\",null,{\"className\":\"dg-bar dg-bar--window\",\"x\":666.2857142857142,\"y\":143.5,\"width\":71.71428571428578,\"height\":15,\"rx\":2}],null,[\"$\",\"text\",null,{\"className\":\"dg-barLabel\",\"x\":658.2857142857142,\"y\":154,\"textAnchor\":\"end\",\"children\":\"Continuous, hardening…\"}]],[[\"$\",\"line\",null,{\"className\":\"dg-leader\",\"x1\":748,\"y1\":151,\"x2\":757,\"y2\":151}],[\"$\",\"rect\",null,{\"className\":\"dg-artMark\",\"x\":757,\"y\":147,\"width\":8,\"height\":8,\"rx\":1}],[\"$\",\"text\",null,{\"className\":\"dg-art\",\"x\":771,\"y\":154,\"children\":\"Threat model and a clean pene…\"}]]]}],[\"$\",\"g\",\"5\",{\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-rowNum\",\"x\":0,\"y\":185,\"children\":\"05\"}],[\"$\",\"text\",null,{\"className\":\"dg-rowName\",\"x\":34,\"y\":185,\"children\":\"Deploy\"}],[[\"$\",\"line\",null,{\"className\":\"dg-standing\",\"x1\":236,\"y1\":181,\"x2\":738,\"y2\":181}],[\"$\",\"text\",null,{\"className\":\"dg-barLabel\",\"x\":242,\"y\":175,\"children\":\"Launch window\"}]],[\"$\",\"text\",null,{\"className\":\"dg-artNone\",\"x\":771,\"y\":184,\"children\":\"—\"}]]}],[\"$\",\"g\",\"6\",{\"children\":[[\"$\",\"text\",null,{\"className\":\"dg-rowNum\",\"x\":0,\"y\":215,\"children\":\"06\"}],[\"$\",\"text\",null,{\"className\":\"dg-rowName\",\"x\":34,\"y\":215,\"children\":\"Operate or hand over\"}],[[\"$\",\"line\",null,{\"className\":\"dg-standing\",\"x1\":236,\"y1\":211,\"x2\":738,\"y2\":211}],[\"$\",\"text\",null,{\"className\":\"dg-barLabel\",\"x\":242,\"y\":205,\"children\":\"Ongoing\"}]],[\"$\",\"text\",null,{\"className\":\"dg-artNone\",\"x\":771,\"y\":214,\"children\":\"—\"}]]}]]]}],[\"$\",\"div\",null,{\"className\":\"dg-ganttText\",\"children\":[\"$\",\"ol\",null,{\"className\":\"dg-sched\",\"children\":[[\"$\",\"li\",\"1\",{\"className\":\"dg-schedRow\",\"data-stage\":\"window\",\"children\":[[\"$\",\"p\",null,{\"className\":\"dg-schedHead\",\"children\":[[\"$\",\"span\",null,{\"className\":\"u-mono dg-schedNum\",\"children\":\"01\"}],[\"$\",\"span\",null,{\"className\":\"dg-schedName\",\"children\":\"Discovery\"}]]}],[\"$\",\"p\",null,{\"className\":\"dg-schedWhen u-mono\",\"children\":\"Weeks 1–4\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedStage\",\"children\":\"Inside the engagement window\"}],[\"$\",\"p\",null,{\"className\":\"dg-schedArt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dg-schedArtKey\",\"children\":\"Drops out\"}],\"Nothing the service lists separately\"]}]]}],[\"$\",\"li\",\"2\",{\"className\":\"dg-schedRow\",\"data-stage\":\"window\",\"children\":[\"$L94\",\"$L95\",\"$L96\",\"$L97\"]}],\"$L98\",\"$L99\",\"$L9a\",\"$L9b\"]}]}],\"$L9c\"]}]\n9d:Tc1d,\n/* ---- Chapter ------------------------------------------------------------\n   A numbered chapter with a heading that HOLDS while its body scrolls under\n   it. The number is not decoration: it tells a reader where they are in a long\n   page, which is the thing a long page actually owes them. */\n.ch {\n  position: relative;\n  display: grid;\n  gap: var(--s8);\n}\n@media (min-width: 1024px) {\n  .ch {\n    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\n    gap: var(--s16);\n    align-items: start;\n  }\n}\n\n.ch__head {\n  position: relative;\n}\n@media (min-width: 1024px) {\n  .ch__head {\n    position: sticky;\n    /* Clears the fixed 72px nav plus breathing room. */\n    top: calc(var(--nav-h) + var(--s8));\n  }\n}\n\n.ch__num {\n  display: block;\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.18em;\n  color: var(--accent);\n  margin-bottom: var(--s3);\n}\n\n.ch__title {\n  margin: 0;\n  font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));\n  letter-spacing: var(--tracking-tight);\n  text-wrap: balance;\n}\n\n.ch__lede {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  font-size: var(--text-base);\n  line-height: 1.6;\n  max-width: 34ch;\n}\n\n.ch__rule {\n  margin-top: var(--s6);\n  height: 1px;\n  background: linear-gradient(90deg, var(--accent), transparent);\n}\n\n.ch__body {\n  min-width: 0;\n  display: grid;\n  gap: var(--s12);\n}\n\n/* ---- Sticky card stack --------------------------------------------------\n   Every card is sticky at the SAME offset, so each comes to rest on the one\n   before it and the stack assembles itself as you scroll. The entire effect is\n   the equal `top` value — there is no JavaScript here at all.\n\n   Each card needs its own opaque background or the stack reads as a smear;\n   that is the one thing people get wrong when copying this. */\n.stack {\n  display: grid;\n  gap: var(--s8);\n}\n.stack__card {\n  position: sticky;\n  top: calc(var(--nav-h) + var(--s8));\n  background-color: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  /* A hairline of the ground above each card so stacked edges stay readable. */\n  box-shadow: 0 -1px 0 0 var(--bg);\n}\n@media (min-width: 768px) {\n  .stack__card {\n    padding: var(--s12);\n  }\n}\n\n/* The stack is a scroll effect. Under reduced motion it is simply a list —\n   which is what it already is semantically, so nothing is lost. */\n@media (prefers-reduced-motion: reduce) {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n/* Sticky needs a real scroll context; without JS the layout is identical, so\n   no .no-js override is required here. */\n\n.stack__index {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.16em;\n  color: var(--accent);\n}\n.stack__title {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-2xl);\n  letter-spacing: var(--tracking-tight);\n}\n.stack__body {\n  margin: var(--s4) 0 0;\n  color: var(--muted);\n  line-height: 1.65;\n  max-width: 62ch;\n}\n\n@media print {\n  .stack__card,\n  .ch__head {\n    position: static;\n  }\n}\n4e:[\"$\",\"div\",null,{\"className\":\"sv-phaseStack\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-story\",\"precedence\":\"default\",\"children\":\"$9d\"}],[\"$\",\"div\",null,{\"className\":\"stack\",\"children\":[\"$L9e\",\"$L9f\",\"$La0\",\"$La1\",\"$La2\",\"$La3\"]}]]}]\na4:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--b