dth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Integration suite with monitoring and failure handling\"}]]}],[\"$\",\"$L45\",\"Role-based training, delivered per role rather than as one long session\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Role-based training, delivered per role rather than as one long session\"}]]}],[\"$\",\"$L45\",\"Month-end close runbook\",{\"as\":\"li\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check sv-ticks__mark\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Month-end close runbook\"}]]}]]}]}]\n5f:[\"$\",\"span\",null,{\"className\":\"badge badge--md badge--brand\",\"children\":[null,\"AWS Solutions Architect Professional\"]}]\nb1:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n60:[\"$\",\"li\",\"CKA\",{\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$b1\"}],[\"$\",\"span\",null,{\"className\":\"badge badge--md badge--brand\",\"children\":[null,\"CKA\"]}]]}]\n61:[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/about/leadership/priya-raman\",\"children\":\"More about Priya Raman\"}]}]\n63:[\"$\",\"span\",null,{\"className\":\"badge badge--sm badge--neutral\",\"children\":[null,\"Under NDA\"]}]\nb2:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n64:[\"$\",\"p\",null,{\"style\":{\"marginTop\":\"var(--s6)\"},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$b2\"}],\"$Lb3\"]}]\n65:[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[[\"$\",\"ul\",null,{\"className\":\"sv-metrics\",\"children\":[[\"$\",\"li\",\"month-end close\",{\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-metric__value u-tnum\",\"children\":\"9 days → 2 days\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__label\",\"children\":\"month-end close\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__note\",\"children\":\"Measured across the three closes after cutover\"}]]}],[\"$\",\"li\",\"historical records migrated and reconciled\",{\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-metric__value u-tnum\",\"children\":\"340,112\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__label\",\"children\":\"historical records migrated and reconciled\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__note\",\"children\":\"Signed off by the Finance Director at each of three rehearsals\"}]]}],[\"$\",\"li\",\"unreconciled variance at cutover\",{\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-metric__value u-tnum\",\"children\":\"£0.00\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__label\",\"children\":\"unreconciled variance at cutover\"}],[\"$\",\"span\",null,{\"className\":\"sv-metric__note\",\"children\":\"Against a tolerance of £500 agreed in advance\"}]]}]]}],[\"$\",\"figure\",null,{\"className\":\"sv-quote\",\"style\":{\"marginTop\":\"var(--s12)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-quote sv-quote__mark\",