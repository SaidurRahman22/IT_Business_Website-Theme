 var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"29:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-light transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"light\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"problem\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s6)\\\"}}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The problem\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"problem\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s3)\\\"},\\\"children\\\":\\\"The processes you actually run, not the ones a vendor template assumes.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__body\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-prose-measure\\\",\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"var(--text-lg)\\\",\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"ERP projects fail at the data and at the exceptions. The demo covers the standard purchase-to-pay flow; your business has a supplier who invoices in two currencies, a product that is sometimes a service, and a month-end adjustment that one person does in a spreadsheet and nobody has written down. A vendor template forces you to change the process or to build around the template, and both are expensive in ways that only become visible in year two. We build the ERP around the processes you run, we model the exceptions as first-class cases rather than as workarounds, and we migrate the history with a reconciliation you can hand to your auditor.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s8)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s3)\\\"},\\\"id\\\":\\\"frameworks\\\",\\\"children\\\":\\\"Frameworks we work to\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"sv-chips\\\",\\\"aria-label\\\":\\\"Frameworks and standards\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"IFRS\\\",{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-badge\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$3f\\\"}],\\\"$L40\\\"]}],\\\"$L41\\\",\\\"$L42\\\",\\\"$L43\\\"]}]]}]]}]]}]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"46:T43d,\"])</script><script>self.__next_f.push([1,\"\\n.card {\\n  position: relative;\\n  background-color: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius-lg);\\n  color: inherit;\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out);\\n}\\n.card--pad { padding: var(--s6); }\\n.card--pad-lg 