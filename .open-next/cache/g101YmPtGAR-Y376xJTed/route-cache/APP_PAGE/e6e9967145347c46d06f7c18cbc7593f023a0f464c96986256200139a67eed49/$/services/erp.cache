d { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section-tight\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"topics\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Explainers\"}],[\"$\",\"h2\",null,{\"id\":\"topics\",\"className\":\"sv-h2\",\"children\":\"Questions about ERP\"}],null]}],[\"$\",\"ul\",null,{\"className\":\"sv-links\",\"aria-label\":\"Questions buyers ask about this service\",\"children\":[[\"$\",\"li\",\"/services/erp/build-or-buy-erpBuild or buy your ERP\",{\"children\":[\"$\",\"$Le\",null,{\"className\":\"sv-links__a\",\"href\":\"/services/erp/build-or-buy-erp\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-links__label\",\"children\":[\"Build or buy your ERP\",[\"$\",\"span\",null,{\"className\":\"sv-links__blurb\",\"children\":\"Three vendors say buy, you say it depends. On what?\"}]]}],[\"$\",\"svg\",null,{\"className\":\"sv-links__arrow\",\"width\":\"16\",\"height\":\"16\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.75\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":\"true\",\"focusable\":\"false\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M5 12h14\"}],[\"$\",\"path\",null,{\"d\":\"m12 5 7 7-7 7\"}]]}]]}]}]]}]]}]}]]\n37:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"Frequently asked\"}],null]}],[\"$\",\"$L83\",null,{\"items\":[{\"q\":\"Why build rather than buy SAP, NetSuite or Odoo?\",\"a\":\"Often you should buy. If your processes are standard and you are prepared to adapt to the package, a package is cheaper and faster, and we will tell you so during discovery rather than after you have paid us to build. Building is right when the process is your competitive advantage, when the package forces a change that costs more than the licence saves, or when you have already built so much around a package that you are maintaining both.\"},{\"q\":\"How long does migration really take?\",\"a\":\"About a third of the project. Extraction is quick; reconciliation is not, because historical data contains records that do not satisfy the constraints you want to enforce going forward. Deciding what to do with each class of exception is a finance decision, not an engineering one, and it cannot be rushed.\"},{\"q\":\"Can you integrate with our existing systems?\",\"a\":\"Yes, and we would usually rather integrate than replace. Payroll, banking, tax filing and e-commerce are generally better left where they are, with the ERP as the system of record that reconciles them.\"},{\"q\":\"What about the spreadsheets?\",\"a\":\"We want to see them in week one. Every undocumented spreadsheet is a process the business depends on, and the ones nobody mentions during discovery are the ones that break the first close. We model them in the system or we document them as a deliberate exception.\"},{\"q\":\"Do we really need a parallel run?\",\"a\":\"Yes. One full period in both systems, reconciled line by line. Every ERP go-live that has gone badly in our experience skipped or shortened it, and the first close is where structural gaps surface — at the worst possible moment if nobody has rehearsed.\"},{\"q\":\"How is access controlled?\",\"a\":\"Role-based, with segregation of duties enforced in the system rather than in a policy — the person who raises a purchase order cannot approve it or receive against it. Every state change is in an append-only audit log with the actor, the before value and the after value.\"}],\"headingLevel\":3}]]}]}]]\n84:{\"id\":\"403c44504416ed33d4af4350092b655f174641e336\",\"bound\":null}\n38:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section grain\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-3px\",\"marginRight\":\"var(--s2)\"},\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"A delivery lead, a solution architect, three to five engineers, a data migration specialist, and a finance process analyst.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"form\",null,{\"action\":\"$h84\",\"className\":\"sv-form\",\"id\":\"enquiry-form\",\"children\":[[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"returnTo\",\"value\":\"/services/erp\"}],[[\"$\",\"div\",\"enquiry-incomplete\",{\"id\":\"enquiry-incomplete\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"Some required fields came through empty. They are marked below — fill them in and send again.\"}]}],[\"$\",\"div\",\"enquiry-email\",{\"id\":\"enquiry-email\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"That email address did not look complete. Check it and send again.\"}]}]],[[\"$\",\"div\",\"name\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-name\",\"children\":[\"Your name\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-name\",\"name\":\"name\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"name\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"email\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-email\",\"children\":[\"Business email\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-email\",\"name\":\"email\",\"className\":\"sv-input\",\"type\":\"email\",\"required\":true,\"autoComplete\":\"email\",\"aria-describedby\":\"enq-email-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-email-help\",\"children\":\"We reply from a person, not a no-reply address.\"}]]}],[\"$\",\"div\",\"company\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-company\",\"children\":[\"Company\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-company\",\"name\":\"company\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"organization\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"country\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-country\",\"children\":[\"Country\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-country\",\"name\":\"country\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"country-name\",\"aria-describedby\":\"enq-country-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-country-help\",\"children\":\"Relevant for data residency and time zone.\"}]]}],\"$L85\",\"$L86\",\"$L87\"],\"$L88\",\"$L89\"]}]}]]}]}]}]]\n8a:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n39:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\