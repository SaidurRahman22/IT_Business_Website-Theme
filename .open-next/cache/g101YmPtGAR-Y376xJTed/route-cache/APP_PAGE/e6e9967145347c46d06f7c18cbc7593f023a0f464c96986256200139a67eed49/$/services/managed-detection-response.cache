/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></li></ul></div></div></footer><script src=\"/_next/static/chunks/webpack-750339dbcd53e266.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n3:I[4658,[\\\"2619\\\",\\\"static/chunks/2619-3c9e02e22d10480a.js\\\",\\\"4938\\\",\\\"static/chunks/4938-ec7db2048e7be43e.js\\\",\\\"9393\\\",\\\"static/chunks/9393-bd02566ba347fb8d.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-2f5ee25261e09e61.js\\\"],\\\"Nav\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[9567,[\\\"2619\\\",\\\"static/chunks/2619-3c9e02e22d10480a.js\\\",\\\"8039\\\",\\\"static/chunks/app/error-77708acc479f8cb3.js\\\"],\\\"default\\\"]\\nd:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/864ef3ae0e55d690.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/c03e25c6a7b6c11d.css\\\",\\\"style\\\"]\\n2:T9a6,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"Organization\\\",\\\"@id\\\":\\\"https://envenox.com/#organization\\\",\\\"name\\\":\\\"Envenox\\\",\\\"legalName\\\":\\\"Envenox Ltd\\\",\\\"url\\\":\\\"https://envenox.com\\\",\\\"description\\\":\\\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\\\",\\\"slogan\\\":\\\"We build the software. Then we try to break it.\\\",\\\"email\\\":\\\"hello@envenox.com\\\",\\\"telephone\\\":\\\"+44 20 4525 9101\\\",\\\"sameAs\\\":[\\\"https://www.linkedin.com/company/envenox\\\",\\\"https://github.com/envenox\\\",\\\"https://x.com/envenox\\\"],\\\"address\\\":[{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"1 Fore Street Avenue, London EC2Y 9DT\\\",\\\"addressLocality\\\":\\\"London\\\",\\\"addressCountry\\\":\\\"United Kingdom\\\"},{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\\\",\\\"addressLocality\\\":\\\"Dhaka\\\",\\\"addressCountry\\\":\\\"Bangladesh\\\"}],\\\"contactPoint\\\":[{\\\"@type\\\":\\\"ContactPoint\\\",\\\"contactType\\\":\\\"emergency\\\",\\\"name\\\":\\\"Incident response hotline\\\",\\\"telephone\\\":\\\"+44 20 4525 9100\\\",\\\"availableLanguage\\\":[\\\"en\\\"],\\\"hoursAvailable\\\":{\\\"@type\\\":\\\"OpeningHoursSpecification\\\",\\\"dayOfWeek\\\":[\\\"Monday\\\",\\\"Tuesday\\\",\\\"Wednesday\\\",\\\"Thursday\\\",\\\"Friday\\\",\\\"Saturday\\\",\\\"Sunday\\\"],\\\"opens\\\":\\\"00:00\\\",\\\"closes\\\":\\\"23:59\\\"}},{\\\"@type\\\":\\\"ContactPoint\\\",\\\"contactType\\\":\\\"sales\\\",\\\"email\\\":\\\"hello@envenox.com\\\",\\\"telephone\\\":\\\"+44 20 4525 9101\\\",\\\"availableLanguage\\\":[\\\"en\\\"]},{\\\"@type\\\":\\\"ContactPoint\\\",\\\"contactType\\\":\\\"security\\\",\\\"email\\\":\\\"security@envenox.com\\\",\\\"availableLanguage\\\":[\\\"en\\\"]}]},{\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://envenox.com/#website\\\",\\\"url\\\":\\\"https://envenox.com\\\",\\\"name\\\":\\\"Envenox\\\",\\\"description\\\":\\\"Envenox is a software development firm. We ship production systems — custom software, web applica