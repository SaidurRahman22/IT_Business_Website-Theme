ge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n7b:[\"$\",\"$L4a\",\"platform-engineering\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$b3\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-card__top\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-server sv-card__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"ngkwjq\",{\"width\":\"20\",\"height\":\"8\",\"x\":\"2\",\"y\":\"2\",\"rx\":\"2\",\"ry\":\"2\"}],[\"$\",\"rect\",\"iecqi9\",{\"width\":\"20\",\"height\":\"8\",\"x\":\"2\",\"y\":\"14\",\"rx\":\"2\",\"ry\":\"2\"}],[\"$\",\"line\",\"16zg32\",{\"x1\":\"6\",\"x2\":\"6.01\",\"y1\":\"6\",\"y2\":\"6\"}],[\"$\",\"line\",\"nzw8ys\",{\"x1\":\"6\",\"x2\":\"6.01\",\"y1\":\"18\",\"y2\":\"18\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"sv-card__name\",\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/services/platform-engineering\",\"className\":\"card__link\",\"children\":\"Platform & DevOps\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"Reproducible infrastructure, short-lived pipeline identity, and a rehearsed rollback.\"}],[\"$\",\"p\",null,{\"style\":{\"margin\":0},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\