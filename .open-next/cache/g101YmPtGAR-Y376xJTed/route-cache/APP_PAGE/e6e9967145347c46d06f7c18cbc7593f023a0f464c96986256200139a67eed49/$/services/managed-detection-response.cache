\"topics\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Explainers\"}],[\"$\",\"h2\",null,{\"id\":\"topics\",\"className\":\"sv-h2\",\"children\":\"Questions about MDR\"}],null]}],[\"$\",\"ul\",null,{\"className\":\"sv-links\",\"aria-label\":\"Questions buyers ask about this service\",\"children\":[[\"$\",\"li\",\"/services/managed-detection-response/mdr-service-levelsWhat an MDR service level should commit to\",{\"children\":[\"$\",\"$Lf\",null,{\"className\":\"sv-links__a\",\"href\":\"/services/managed-detection-response/mdr-service-levels\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-links__label\",\"children\":[\"What an MDR service level should commit to\",[\"$\",\"span\",null,{\"className\":\"sv-links__blurb\",\"children\":\"Every provider quotes 15 minutes. Fifteen minutes to what?\"}]]}],[\"$\",\"svg\",null,{\"className\":\"sv-links__arrow\",\"width\":\"16\",\"height\":\"16\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.75\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":\"true\",\"focusable\":\"false\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M5 12h14\"}],[\"$\",\"path\",null,{\"d\":\"m12 5 7 7-7 7\"}]]}]]}]}],[\"$\",\"li\",\"/services/managed-detection-response/build-or-buy-a-socBuild or buy a SOC\",{\"children\":[\"$\",\"$Lf\",null,{\"className\":\"sv-links__a\",\"href\":\"/services/managed-detection-response/build-or-buy-a-soc\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-links__label\",\"children\":[\"Build or buy a SOC\",[\"$\",\"span\",null,{\"className\":\"sv-links__blurb\",\"children\":\"At what size does running our own start to make sense?\"}]]}],[\"$\",\"svg\",null,{\"className\":\"sv-links__arrow\",\"width\":\"16\",\"height\":\"16\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.75\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":\"true\",\"focusable\":\"false\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M5 12h14\"}],[\"$\",\"path\",null,{\"d\":\"m12 5 7 7-7 7\"}]]}]]}]}]]}]]}]}]]\n38:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"Frequently asked\"}],null]}],[\"$\",\"$L7d\",null,{\"items\":[{\"q\":\"Do we have to move to your platform?\",\"a\":\"No. We would rather operate what you already have, and your data staying in your tenancy and your region is usually the right answer for both data residency and exit. If you have no platform we will deploy one in your account — not ours.\"},{\"q\":\"What does your SLA actually commit to?\",\"a\":\"Time to human contact, not time to alert forwarding. Fifteen minutes for critical, with a 2026 median of six. A service level measured on forwarding speed rewards the wrong behaviour and you should read every MDR contract for which one it buys.\"},{\"q\":\"Can you contain without asking us?\",\"a\":\"Only what you pre-authorise in the runbook, and we notify immediately. Most clients authorise host isolation and session revocation after a confirmed detection, and require a call before anything that affects production availability. The authority is reviewed quarterly.\"},{\"q\":\"How do you avoid drowning us in alerts?\",\"a\":\"Analysts investigate before escalating, so volume to you is conclusions rather than alerts — typically single digits per week for a mid-size estate. False-positive rate and tuning decisions are reported monthly with the reasoning, so you can challenge them.\"},{\"q\":\"What if we are breached right now?\",\"a\":\"Call the hotline. Do not wait for an onboarding call — incident response is available to non-clients and the number is in the navigation of every page on this site.\"},{\"q\":\"Do you cover cloud and identity, or only endpoints?\",\"a\":\"Cloud control plane, identity provider, SaaS audit logs, network and endpoint. Identity is where most real intrusions are now visible first, and an EDR-only service will miss a session-token replay entirely.\"},{\"q\":\"What happens to the detections if we leave?\",\"a\":\"They are yours. The repository is in your source control from day one, written in Sigma or your platform’s native language, with the test cases. Exit should cost you nothing but notice.\"}],\"headingLevel\":3}]]}]}]]\n7e:{\"id\":\"403c44504416ed33d4af4350092b655f174641e336\",\"bound\":null}\n39:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-3px\",\"marginRight\":\"var(--s2)\"},\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"A named service lead, a detection engineer, and a 24/7 analyst rota of nine.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"form\",null,{\"action\":\"$h7e\",\"className\":\"sv-form\",\"id\":\"enquiry-form\",\"children\":[[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"returnTo\",\"value\":\"/services/managed-detection-response\"}],[[\"$\",\"div\",\"enquiry-incomplete\",{\"id\":\"enquiry-incomplete\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"Some required fields came through empty. They are marked below — fill them in and send again.\"}]}],[\"$\",\"div\",\"enquiry-email\",{\"id\":\"enquiry-email\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"That email address did not look complete. Check it and send again.\"}]}]],[[\"$\",\"div\",\"name\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-name\",\"children\":[\"Your name\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-name\",\"name\":\"name\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"name\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"email\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-email\",\"children\":[\"Business email\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-email\",\"name\":\"email\",\"className\":\"sv-input\",\"type\":\"email\",\"required\":true,\"autoComplete\":\"email\",\"aria-describedby\":\"enq-email-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-email-help\",\"children\":\"We reply from a person, not a no-reply address.\"}]]}],[\"$\",\"div\",\"company\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-company\",\"children\":[\"Company\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-company\",\"name\":\"company\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"organization\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"country\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-country\",\"children\":[\"Country\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-country\",\"name\":\"country\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"country-name\",\"aria-describedby\":\"enq-country-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-country-help\",\"children\":\"Relevant for data residency and time zone.\"}]]}],\"$L7f\",\"$L80\",\"$L81\"],\"$L82\",\"$L83\"]}]}]]}]}]}]]\n84:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n3a:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section-tight\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-cta-band\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"sv-h2\",\"children\":\"Analysts who read your architecture before they read your alerts.\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"Annual retainer priced by log volume and endpoint count, with incident response hours included.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-cta-band__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$84\"}],\"$L85\"],\"$L86\"]}]]}]}]}]]\n3d:[\"$\",\"$Lf\",null,{\"href\":\"/contact\",\"className\":\"btn btn--primary btn--lg\",\"children\":[null,[\"$\",\"span\",null,{\"children\":\"Start a conversation\"}],null]}]\n87:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n3e:[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$87\"}],\"$L88\"]\n3f:[\"$\",\"ul\",null,{\"className\":\"sv-hero__meta\",\"children\":[[\"$\",\"li\",null,{\"children\":\"7 weeks to full monitoring. Purple-team validation at week 8.\"}],[\"$\",\"li\",null,{\"children\":\"Annual retainer priced by log volume and endpoint count, with incident response hours included.\"}]]}]\n41:[\"$\",\"span\",null,{\"className\":\"badge badge--md badge--neutral\",\"children\":[null,\"MITRE ATT&CK\"]}]\n89:T859,\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--badge-border, var(--border));\n  border-radius: var(--radius-sm);\n  background-color: var(--badge-bg, transparent);\n  color: var(--badge-fg, var(--muted-strong));\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  line-height: 1;\n  padding: var(--s1) var(--s2);\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n42:[\"$\",\"li\