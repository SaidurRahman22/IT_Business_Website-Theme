temListElement\\\":[{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Detection engineering\\\",\\\"description\\\":\\\"Detections written against your architecture and mapped to MITRE ATT\\u0026CK, version-controlled and reviewed like code. Detection-as-code, in a repository you can read.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"24/7 triage and investigation\\\",\\\"description\\\":\\\"Human analysts, not a forwarding service. Investigation happens before escalation, and the escalation carries a conclusion.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Containment\\\",\\\"description\\\":\\\"Pre-authorised actions executed inside your runbook — host isolation, session revocation, key disablement — with immediate notification.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":4,\\\"name\\\":\\\"Threat hunting\\\",\\\"description\\\":\\\"Hypothesis-driven hunts each month against your telemetry, informed by what we see across the client base and in our own research.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":5,\\\"name\\\":\\\"Platform operations\\\",\\\"description\\\":\\\"We operate your SIEM and EDR — Wazuh, Elastic, Microsoft Sentinel, CrowdStrike, SentinelOne — or run ours. Your data stays in your tenancy and your region.\\\"},{\\\"@type\\\":\\\"OfferCatalogItem\\\",\\\"position\\\":6,\\\"name\\\":\\\"Coverage reporting\\\",\\\"description\\\":\\\"Monthly ATT\\u0026CK coverage, detection changes, alert volume, false-positive rate and tuning decisions, with the reasoning.\\\"}]},\\\"termsOfService\\\":\\\"https://envenox.com/legal/terms\\\"}\"])</script><script>self.__next_f.push([1,\"28:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$3b\\\"}}]\\n29:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"BreadcrumbList\\\\\\\",\\\\\\\"itemListElement\\\\\\\":[{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":1,\\\\\\\"name\\\\\\\":\\\\\\\"Envenox\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":2,\\\\\\\"name\\\\\\\":\\\\\\\"Services\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/services\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":3,\\\\\\\"name\\\\\\\":\\\\\\\"Cybersecurity\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/services/cybersecurity\\\\\\\"},{\\\\\\\"@type\\\\\\\":\\\\\\\"ListItem\\\\\\\",\\\\\\\"position\\\\\\\":4,\\\\\\\"name\\\\\\\":\\\\\\\"Managed Detection \\u0026 Response\\\\\\\",\\\\\\\"item\\\\\\\":\\\\\\\"https://envenox.com/services/managed-detection-response\\\\\\\"}]}\\\"}}]\\n3c:Tdb3,\"])</script><script>self.__next_f.push([1,\"\\n.btn {\\n  --btn-bg: transparent;\\n  --btn-bg-hover: transparent;\\n  --btn-fg: var(--fg);\\n  --btn-border: transparent;\\n  --btn-border-hover: transparent;\\n\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--btn-border);\\n  border-radius: var(--radius-md);\\n  background-color: var(--btn-bg);\\n  color: var(--btn-fg);\\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\\n  font-weight: 500;\\n  letter-spacing: -0.01em;\\n  line-height: 1;\\n  text-align: center;\\n  text-decoration: none;\\n  cursor: pointer;\\n  /* ONLY colour transitions. A transform here would break the house rule. */\\n  transition:\\n    background-color var(--dur-base) var(--ease-out),\\n    border-color var(--dur-base) var(--ease-out),\\n    color var(--dur-base) var(--ease-out);\\n}\\n.btn:hover {\\n  background-color: var(--btn-bg-hover);\\n  border-color: var(--btn-border-hover);\\n  /* Falls back to the resting label colour, so no existing variant changes.\\n     A variant whose hover fill moves far in lightness needs to move its label\\n     too, or the hover state quietly fails contrast while the resting state\\n     passes — which is the kind of thing an audit on static screenshots misses. */\\n  color: var(--btn-fg-hover, var(--btn-fg));\\n}\\n.btn[aria-disabled='true'],\\n.btn:disabled {\\n  opacity: 0.45;\\n  cursor: not-allowed;\\n}\\n.btn[aria-disabled='true']:hover,\\n.btn:disabled:hover {\\n  background-color: var(--btn-bg);\\n  border-color: var(--btn-border);\\n}\\n\\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\\n\\n.btn--full { width: 100%; }\\n\\n/* ---- variants ---- */\\n.btn--primary {\\n  --btn-bg: var(--accent);\\n  --btn-fg: var(--accent-fg);\\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n  --btn-border: var(--accent);\\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\\n}\\n.theme-light .btn--primary {\\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\\n     brown, which is not what the brand is. A fill has a different contrast\\n     problem from text: the requirement is on the LABEL against the fill, and\\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\\n     the real brand copper and the label goes dark. Links and the focus ring\\n     keep --accent and stay legible. */\\n  --btn-bg: var(--accent-500);\\n  --btn-fg: var(--ink-900);\\n  --btn-bg-hover: var(--accent-600);\\n  --btn-fg-hover: var(--paper-50);\\n  --btn-border: var(--accent-500);\\n  --btn-border-hover: var(--accent-600);\\n}\\n.btn--secondary {\\n  --btn-fg: var(--fg);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--fg);\\n}\\n.btn--ghost {\\n  --btn-fg: var(--muted-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--border);\\n}\\n.btn--ghost:hover { color: var(--fg); }\\n.btn--danger-quiet {\\n  --btn-fg: var(--muted-strong);\\n  --btn-border: var(--border-strong);\\n  --btn-bg-hover: var(--surface);\\n  --btn-border-hover: var(--muted-strong);\\n}\\n.btn--danger-quiet:hover { color: var(--fg); }\\n\\n.btn__icon { display: inline-flex; flex: none; }\\n\"])</script><script>self.__next_f.push([1,\"2a:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-dark transition-theme u-section grain\\\",\\\"data-theme-section\\\":\\\"dark\\\",\\\"style\\\":{\\\"paddingTop\\\":\\\"calc(var(--nav-h) + var(--s16))\\\"},\\\"aria-labelledby\\\":\\\"service-h1\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-hero__eyebrow\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"className\\\":\\\"u-link\\\",\\\"href\\\":\\\"/services\\\",\\\"children\\\":\\\"Services\\\"}],\\\" · \\\",[\\\"$\\\",\\\"$Lf\\\",null,{\\\"className\\\":\\\"u-link\\\",\\\"href\\\":\\\"/services/cybersecurity\\\",\\\"children\\\":\\\"Cybersecurity\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"id\\\":\\\"service-h1\\\",\\\"className\\\":\\\"sv-h1\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":32,\\\"height\\\":32,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":1.5,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-radar\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\",\\\"verticalAlign\\\":\\\"-4px\\\",\\\"marginRight\\\":\\\"var(--s3)\\\",\\\"color\\\":\\\"var(--accent)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"z3du51\\\",{\\\"d\\\":\\\"M19.07 4.93A10 10 0 0 0 6.99 3.34\\\"}],[\\\"$\\\",\\\"path\\\",\\\"oypzma\\\",{\\\"d\\\":\\\"M4 6h.01\\\"}],[\\\"$\\\",\\\"path\\\",\\\"qzzz0\\\",{\\\"d\\\":\\\"M2.29 9.62A10 10 0 1 0 21.31 8.35\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1yjesh\\\",{\\\"d\\\":\\\"M16.24 7.76A6 6 0 1 0 8.23 16.67\\\"}],[\\\"$\\\",\\\"path\\\",\\\"mhygvu\\\",{\\\"d\\\":\\\"M12 18h.01\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1u2y91\\\",{\\\"d\\\":\\\"M17.99 11.66A6 6 0 0 1 15.77 16.67\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"1c9p78\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"mhq4k0\\\",{\\\"d\\\":\\\"m13.41 10.59 5.66-5.66\\\"}],\\\"$undefined\\\"]}],\\\"Managed Detection \\u0026 Response\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-sub\\\",\\\"children\\\":\\\"Analysts who read your architecture before they read your alerts.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-cred\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"sv-cred__figure\\\",\\\"children\\\":\\\"6 minutes median\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-cred__context\\\",\\\"children\\\":\\\"from detection to a human analyst making contact, measured across 2026 to date\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-hero__actions\\\",\\\"children\\\":[[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-button\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$3c\\\"}],\\\"$L3d\\\"],\\\"$L3e\\\"]}],\\\"$L3f\\\"]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"40:T859,\"])</script><script>self.__next_f.push([1,\"\\n.badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: var(--s2);\\n  border: 1px solid var(--badge-border, var(--border));\\n  border-radius: var(--radius-sm);\\n  background-color: var(--badge-bg, transparent);\\n  color: var(--badge-fg, var(--muted-strong));\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  letter-spacing: 0.04em;\\n  line-height: 1;\\n  padding: var(--s1) var(--s2);\\n  /* normal + balance, NOT nowrap. Three separate pages overflowed 320px because\\n     a badge held arbitrary data — \\\"3 weeks review, 14 weeks remediation\\\",\\n     \\\"AWS Solutions Architect Professional\\\", a credibility sentence — and an\\n     unbreakable chip wider than its card pushes the whole grid track past the\\n     viewport. A badge is a label primitive, but callers legitimately put\\n     variable-length data in one, and the component should survive that rather\\n     than require every caller to override it. Severity badges keep nowrap\\n     below: \\\"Critical\\\" is two syllables and must never break. */\\n  white-space: normal;\\n  text-wrap: balance;\\n}\\n.badge--severity {\\n  white-space: nowrap;\\n}\\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\\n.badge--md { padding: var(--s1) var(--s3); }\\n\\n.badge--neutral {\\n  --badge-bg: var(--surface);\\n  --badge-fg: var(--muted-strong);\\n  --badge-border: var(--border);\\n}\\n.badge--brand {\\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\\n  --badge-fg: var(--accent);\\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\\n}\\n\\n/* --- the only --signal-* usage in the codebase --- */\\n.badge--severity {\\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\\n  --badge-fg: var(--sig);\\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\\n  font-variant-numeric: tabular-nums;\\n}\\n.badge--severity .badge__dot {\\n  width: 6px;\\n  height: 6px;\\n  border-radius: 50%;\\n  background-color: var(--sig);\\n  flex: none;\\n}\\n.badge--critical { --sig: var(--signal-critical); }\\n.badge--high { --sig: var(--signal-high); }\\n.badge--medium { --sig: var(--signal-medium); }\\n.badge--low { --sig: var(--signal-low); }\\n.badge--info { --sig: var(--signal-info); }\\n\"])</script><script>self.__next_f.push([1,\"2b:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"problem\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__aside\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s6)\\\"}}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"children\\\":\\\"The problem\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"problem\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s3)\\\"},\\\"children\\\":\\\"Analysts who read your architecture before they read your alerts.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-rail__body\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"sv-prose-measure\\\",\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"var(--text-lg)\\\",\\\"color\\\":\\\"var(--muted-strong)\\\"},\\\"children\\\":\\\"Most managed detection is alert triage performed by people who have never seen your architecture diagram. They forward the alert, you do the investigation, and the service level is measured on how fast the forwarding happened. We run it differently. Onboarding starts with your architecture, your identity model and your crown-jewel systems, and the detections we write are specific to them — not a vendor rule pack with the noisy ones disabled. When something fires, an analyst investigates before you hear about it, and what reaches you is a conclusion with evidence and a recommended action, not a notification. Where you have authorised containment, we contain first and tell you immediately.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"var(--s8)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow\\\",\\\"style\\\":{\\\"marginBottom\\\":\\\"var(--s3)\\\"},\\\"id\\\":\\\"frameworks\\\",\\\"children\\\":\\\"Frameworks we work to\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"sv-chips\\\",\\\"aria-label\\\":\\\"Frameworks and standards\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"MITRE ATT\\u0026CK\\\",{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-badge\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"$40\\\"}],\\\"$L41\\\"]}],\\\"$L42\\\",\\\"$L43\\\",\\\"$L44\\\"]}]]}]]}]]}]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"45:T1fac,\"])</script><script>self.__next_f.push([1,\"\\n.dg {\\n  /* POSITIONED ON PURPOSE. .dg-ganttText is clipped and absolutely positioned\\n     at wide widths; an absolutely positioned element is only clipped by an\\n     ancestor in its containing-block chain. Without this the clipped schedule\\n     escapes and widens the page. */\\n  position: relative;\\n  margin: 0;\\n  min-width: 0;\\n}\\n\\n/* ---------------- the drawn schedule ---------------- */\\n.dg-gantt { display: none; width: 100%; height: auto; overflow: visible; }\\n@media (min-width: 860px) {\\n  .dg-gantt { display: block; }\\n}\\n\\n.dg-axisUnit,\\n.dg-colHead {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 11px;\\n  letter-spacing: 0.1em;\\n  text-transform: uppercase;\\n  fill: var(--muted);\\n}\\n.dg-tick {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  fill: var(--muted);\\n}\\n.dg-grid { stroke: var(--border-strong); stroke-width: 1; }\\n.dg-zero { stroke: var(--accent); stroke-width: 1.5; }\\n.dg-zeroLabel {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  letter-spacing: 0.08em;\\n  fill: var(--accent);\\n}\\n\\n.dg-rowNum {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 11px;\\n  fill: var(--muted);\\n}\\n.dg-rowName { font-size: 13px; fill: var(--fg); }\\n\\n/* Three stages, three SHAPES as well as three fills: a filled bar, a hollow\\n   dashed bar and a half-height bar. The information survives greyscale. */\\n.dg-bar { fill: var(--accent); stroke: none; }\\n.dg-bar--before { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 3; }\\n.dg-bar--after { fill: var(--muted-strong); }\\n.dg-bar--unstated { opacity: 0.55; }\\n.dg-openTip { fill: var(--accent); }\\n.dg-standing { stroke: var(--border-strong); stroke-width: 2; stroke-dasharray: 2 4; }\\n\\n.dg-barLabel {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  fill: var(--muted);\\n}\\n/* Printed on top of a filled bar: the bar's fill is --accent or\\n   --muted-strong, both of which are LIGHT in the dark palettes and DARK in the\\n   light one, so the text takes the ground colour rather than a fixed one. */\\n.dg-barLabel--in { fill: var(--bg); }\\n.dg-leader { stroke: var(--border-strong); stroke-width: 1; }\\n.dg-artMark { fill: var(--accent); }\\n.dg-art { font-size: 12px; fill: var(--muted-strong); }\\n/* \\\"nothing drops out of this phase\\\" is information, not furniture, so the\\n   dash takes a text neutral. --border-strong is a hairline value and renders\\n   as an almost-invisible mark in .theme-dark. */\\n.dg-artNone { font-size: 12px; fill: var(--muted); }\\n\\n/* ---------------- the schedule as DOM text ---------------- */\\n.dg-sched { list-style: none; margin: 0; padding: 0; display: grid; }\\n.dg-schedRow {\\n  display: grid;\\n  gap: var(--s1);\\n  padding: var(--s4) 0;\\n  border-top: 1px solid var(--border);\\n  min-width: 0;\\n}\\n@media (min-width: 560px) {\\n  .dg-schedRow {\\n    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);\\n    column-gap: var(--s6);\\n    align-items: baseline;\\n  }\\n  .dg-schedHead { grid-row: span 3; }\\n}\\n.dg-schedHead { display: flex; gap: var(--s3); align-items: baseline; margin: 0; min-width: 0; }\\n.dg-schedNum { font-size: var(--text-xs); color: var(--accent); flex: none; }\\n.dg-schedName { font-weight: 500; color: var(--fg); }\\n.dg-schedWhen { margin: 0; font-size: var(--text-xs); color: var(--muted-strong); }\\n.dg-schedStage { margin: 0; font-size: var(--text-xs); color: var(--muted); }\\n.dg-schedArt { margin: 0; font-size: var(--text-sm); color: var(--muted-strong); }\\n.dg-schedArtKey {\\n  display: inline-block;\\n  margin-right: var(--s2);\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: var(--text-xs);\\n  letter-spacing: 0.1em;\\n  text-transform: uppercase;\\n  color: var(--muted);\\n}\\n\\n@media (min-width: 860px) {\\n  .dg-ganttText {\\n    position: absolute;\\n    width: 1px;\\n    height: 1px;\\n    margin: -1px;\\n    padding: 0;\\n    overflow: hidden;\\n    clip-path: inset(50%);\\n    white-space: nowrap;\\n    border: 0;\\n  }\\n}\\n\\n/* ---------------- caption and legend ---------------- */\\n.dg-cap { margin-top: var(--s6); }\\n.dg-legend {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: var(--s3) var(--s6);\\n  list-style: none;\\n  margin: 0 0 var(--s4);\\n  padding: 0;\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n}\\n.dg-legendItem { display: inline-flex; align-items: center; gap: var(--s2); }\\n.dg-legendMark { width: 18px; height: 8px; border-radius: 2px; background-color: var(--accent); flex: none; }\\n.dg-legendItem[data-stage='before'] .dg-legendMark {\\n  background-color: transparent;\\n  border: 1px dashed var(--muted);\\n}\\n.dg-legendItem[data-stage='after'] .dg-legendMark { height: 4px; background-color: var(--muted-strong); }\\n.dg-legendItem[data-stage='standing'] .dg-legendMark {\\n  height: 2px;\\n  background-color: transparent;\\n  border-top: 2px dotted var(--border-strong);\\n}\\n.dg-capNote {\\n  margin: 0;\\n  font-size: var(--text-xs);\\n  color: var(--muted);\\n  max-width: 74ch;\\n  line-height: 1.6;\\n}\\n\\n/* ---------------- deliverables stack ---------------- */\\n.dg-stackFig { display: grid; gap: var(--s4); }\\n.dg-stack { width: 100%; height: auto; max-width: 34rem; }\\n.dg-sheet { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1; }\\n.dg-sheetSpine { fill: var(--accent); }\\n.dg-sheetNum { font-size: 11px; letter-spacing: 0.1em; fill: var(--muted); }\\n.dg-sheetTag {\\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\\n  font-size: 10px;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  fill: var(--muted);\\n}\\n.dg-sheetTitle { font-size: 15px; font-weight: 500; fill: var(--fg); }\\n.dg-sheetRule { stroke: var(--border-strong); stroke-width: 1; }\\n.dg-stackCap { max-width: 34rem; }\\n\\n/* ---------------- scope boundary ---------------- */\\n.dg-scope { display: gr