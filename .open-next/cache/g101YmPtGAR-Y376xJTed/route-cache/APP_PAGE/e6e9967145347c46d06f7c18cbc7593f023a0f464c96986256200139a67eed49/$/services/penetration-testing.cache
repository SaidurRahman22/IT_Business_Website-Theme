elopment\",{\"value\":\"web-application-development\",\"disabled\":false,\"children\":\"Web application\"}],[\"$\",\"option\",\"platform-engineering\",{\"value\":\"platform-engineering\",\"disabled\":false,\"children\":\"Platform & DevOps\"}],[\"$\",\"option\",\"business-systems\",{\"value\":\"business-systems\",\"disabled\":false,\"children\":\"ERP / CRM / HRM / LMS\"}],[\"$\",\"option\",\"devsecops\",{\"value\":\"devsecops\",\"disabled\":false,\"children\":\"Secure SDLC — build and test together\"}],[\"$\",\"option\",\"not-sure\",{\"value\":\"not-sure\",\"disabled\":false,\"children\":\"Not sure yet — help me work it out\"}]]}],null]}]\n7a:[\"$\",\"div\",\"message\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-message\",\"children\":[\"What are you trying to achieve, and what is the deadline\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"textarea\",null,{\"id\":\"enq-message\",\"name\":\"message\",\"className\":\"sv-textarea\",\"rows\":5,\"required\":true,\"aria-describedby\":\"enq-message-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-message-help\",\"children\":\"Two or three sentences is plenty. The constraint is usually more useful than the requirement.\"}]]}]\n7b:[\"$\",\"div\",\"consent\",{\"className\":\"sv-field sv-field--check\",\"children\":[[\"$\",\"input\",null,{\"id\":\"enq-consent\",\"name\":\"consent\",\"type\":\"checkbox\",\"className\":\"sv-check\",\"required\":true,\"aria-describedby\":\"enq-consent-help\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-consent\",\"children\":[\"I agree to Envenox contacting me about this enquiry.\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-consent-help\",\"children\":\"We keep enquiry details for 24 mon