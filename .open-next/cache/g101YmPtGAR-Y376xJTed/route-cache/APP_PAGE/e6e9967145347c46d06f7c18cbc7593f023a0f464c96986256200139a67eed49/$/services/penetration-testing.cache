ebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n75:[\"$\",\"$L55\",\"web-application-development\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$af\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-card__top\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-globe sv-card__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"13o1zl\",{\"d\":\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"}],[\"$\",\"path\",\"9i4pu4\",{\"d\":\"M2 12h20\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"sv-card__name\",\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/web-application-development\",\"className\":\"card__link\",\"children\":\"Web Application Development\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"Server-rendered, budget-enforced front ends that work before JavaScript arrives.\"}],[\"$\",\"p\",null,{\"style\":{\"margin\":0},\"children\":[[\"$\",\"style\",null,{