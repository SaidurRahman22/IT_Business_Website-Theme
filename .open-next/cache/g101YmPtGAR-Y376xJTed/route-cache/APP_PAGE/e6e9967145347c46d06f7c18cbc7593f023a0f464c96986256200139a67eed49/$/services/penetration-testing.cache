"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Commercials\"}],[\"$\",\"h2\",null,{\"id\":\"engagement\",\"className\":\"sv-h2\",\"children\":\"Shape, timeline and scoping\"}],null]}],[\"$\",\"dl\",null,{\"className\":\"sv-defs\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Timeline\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"5–15 testing days depending on scope. Report 3 days after testing ends.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Team shape\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"One lead tester plus one or two testers, with a technical reviewer who signs the report.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Engagement\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Fixed-scope project, or an annual retainer with a reserved window each quarter.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Scoping\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":[\"A named engineer replies within one business day. Scoping call within three.\",\" \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services/engagement-models\",\"children\":\"How the four engagement models differ\"}],\".\"]}]]}]]}]]}]}]]\n36:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section-tight\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"topics\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Explainers\"}],[\"$\",\"h2\",null,{\"id\":\"topics\",\"className\":\"sv-h2\",\"children\":\"Questions about Penetration Testing\"}],null]}],[\"$\",\"ul\",null,{\"className\":\"sv-links\",\"aria-label\":\"Questions buyers ask about this service\",\"children\":[[\"$\",\"li\",\"/services/penetration-testing/how-much-does-a-pen-test-costHow penetration testing is priced\",{\"children\":[\"$\",\"$Le\",null,{\"className\":\"sv-links__a\",\"href\":\"/services/penetration-testing/how-much-does-a-pen-test-cost\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-links__label\",\"children\":[\"How penetration testing is priced\",[\"$\",\"span\",null,{\"className\":\"sv-links__blurb\",\"children\":\"Why is one quote twice the other for what looks like the same scope?\"}]]}],[\"$\",\"svg\",null,{\"className\":\"sv-links__arrow\",\"width\":\"16\",\"height\":\"16\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.75\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":\"true\",\"focusable\":\"false\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M5 12h14\"}],[\"$\",\"path\",null,{\"d\":\"m12 5 7 7-7 7\"}]]}]]}]}],[\"$\",\"li\",\"/services/penetration-testing/production-or-stagingShould you test production or staging?\",{\"children\":[\"$\",\"$Le\",null,{\"className\":\"sv-links__a\",\"href\":\"/services/penetration-testing/production-or-staging\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-links__label\",\"children\":[\"Should you test production or staging?\",[\"$\",\"span\",null,{\"className\":\"sv-links__blurb\",\"children\":\"Our policy says no production testing. What are we giving up?\"}]]}],[\"$\",\"svg\",null,{\"className\":\"sv-links__arrow\",\"width\":\"16\",\"height\":\"16\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.75\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":\"true\",\"focusable\":\"false\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M5 12h14\"}],[\"$\",\"path\",null,{\"d\":\"m12 5 7 7-7 7\"}]]}]]}]}],[\"$\",\"li\",\"/services/penetration-testing/scanner-vs-manual-testingHow to tell a penetration test from a scanner export\",{\"children\":[\"$\",\"$Le\",null,{\"className\":\"sv-links__a\",\"href\":\"/services/penetration-testing/scanner-vs-manual-testing\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sv-links__label\",\"children\":[\"How to tell a penetration test from a scanner export\",[\"$\",\"span\",null,{\"className\":\"sv-links__blurb\",\"children\":\"How do we check we are not paying testing rates for automated output?\"}]]}],[\"$\",\"svg\",null,{\"className\":\"sv-links__arrow\",\"width\":\"16\",\"height\":\"16\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.75\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"aria-hidden\":\"true\",\"focusable\":\"false\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M5 12h14\"}],[\"$\",\"path\",null,{\"d\":\"m12 5 7 7-7 7\"}]]}]]}]}]]}]]}]}]]\n37:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"Frequently asked\"}],null]}],[\"$\",\"$L77\",null,{\"items\":[{\"q\":\"How do you price a test?\",\"a\":\"By tester-days, derived from the scope call. A single-role web application with 40 endpoints is usually 5 days; a multi-tenant platform with an admin console, a public API and three user roles is usually 10 to 12. We send the day count and what it buys before you commit, and we do not pad the scope to hit a number.\"},{\"q\":\"Will you test production?\",\"a\":\"Usually yes, and it is usually the right answer, because a staging environment with synthetic data and a relaxed WAF does not tell you much. We agree rate limits, a stop-word for immediate halt, and an out-of-hours window for anything destructive. Where production testing genuinely is not viable, we test a staging environment and say so plainly in the report rather than implying coverage we did not have.\"},{\"q\":\"What happens if you find something critical at 2am?\",\"a\":\"We call. The escalation path and the phone number are agreed in scoping, and a confirmed critical is a phone call and a written reproduction within the hour, whatever time it is. You do not learn about a pre-auth remote code execution from page 41 of a PDF eleven days later.\"},{\"q\":\"Do you use automated scanners?\",\"a\":\"For coverage, yes — they are good at breadth. Everything a scanner raises is confirmed by hand before it reaches your report, which is why our measured false-positive rate at retest is 1.4%. A report that is a lightly edited scanner export is not a penetration test and you should not pay testing rates for one.\"},{\"q\":\"Can you work under our NDA?\",\"a\":\"Yes, and we will sign yours rather than insisting on ours. Every tester is background-checked before they touch client systems; the policy is published at /trust rather than described on request.\"},{\"q\":\"How do you handle our data?\",\"a\":\"Evidence is stored in a per-engagement encrypted workspace in the region you specify, access is limited to the engagement team, and everything is destroyed 90 days after the retest unless you ask us to hold it for an audit. Data residency and sub-processors are listed at /trust.\"},{\"q\":\"Do you give us the raw tooling output?\",\"a\":\"On request, yes — attached as an appendix, clearly labelled as unverified. We do not put it in the body of the report, because mixing confirmed findings with scanner noise is how a severity model loses its meaning.\"},{\"q\":\"What is not included?\",\"a\":\"Denial-of-service testing, physical intrusion, and social engineering of your staff are out of scope unless separately agreed — the first because it proves little and risks much, the other two because they belong in a red team engagement with different rules. Remediation work is also separate: we will tell you exactly what to change, and our engineering practice can do it, but a tester who fixes their own findings cannot retest them impartially.\"},{\"q\":\"Can we share the report with customers?\",\"a\":\"Yes. The attestation letter exists for exactly that, and the executive summary is written to be shareable. If a customer wants the full technical report, we will help you decide what to redact.\"},{\"q\":\"How soon can you start?\",\"a\":\"Typically two to four weeks for a new scope, and inside a week for retainer clients with a reserved window. For an active incident, do not book a test — call the hotline.\"}],\"headingLevel\":3}]]}]}]]\n78:{\"id\":\"403c44504416ed33d4af4350092b655f174641e336\",\"bound\":null}\n38:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-3px\",\"marginRight\":\"var(--s2)\"},\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"One lead tester plus one or two testers, with a technical reviewer who signs the report.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"form\",null,{\"action\":\"$h78\",\"className\":\"sv-form\",\"id\":\"enquiry-form\",\"children\":[[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"returnTo\",\"value\":\"/services/penetration-testing\"}],[[\"$\",\"div\",\"enquiry-incomplete\",{\"id\":\"enquiry-incomplete\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"Some required fields came through empty. They are marked below — fill them in and send again.\"}]}],[\"$\",\"div\",\"enquiry-email\",{\"id\":\"enquiry-email\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"That email address did not look complete. Check it and send again.\"}]}]],[[\"$\",\"div\",\"name\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-name\",\"children\":[\"Your name\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-name\",\"name\":\"name\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"name\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"email\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-email\",\"children\":[\"Business email\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-email\",\"name\":\"email\",\"className\":\"sv-input\",\"type\":\"email\",\"required\":true,\"autoComplete\":\"email\",\"aria-describedby\":\"enq-email-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-email-help\",\"children\":\"We reply from a person, not a no-reply address.\"}]]}],[\"$\",\"div\",\"c