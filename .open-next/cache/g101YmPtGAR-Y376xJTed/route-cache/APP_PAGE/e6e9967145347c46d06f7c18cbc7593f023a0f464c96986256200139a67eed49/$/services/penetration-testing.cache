"className\\\":\\\"dg-scopeCell\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono dg-scopeNum\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"05\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"dg-scopeName\\\",\\\"children\\\":\\\"Cloud configuration review\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"dg-scopeBody\\\",\\\"children\\\":\\\"AWS, Azure and GCP. IAM trust-policy analysis, exposed storage, metadata-service access from compute, and the cross-account roles your CI uses.\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"Retest as standard\\\",{\\\"className\\\":\\\"dg-scopeCell\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"u-mono dg-scopeNum\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"06\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"dg-scopeName\\\",\\\"children\\\":\\\"Retest as standard\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"dg-scopeBody\\\",\\\"children\\\":\\\"A full retest of every finding within 30 days of the report, included. Fixes get verified or they get reopened with evidence.\\\"}]]}]]}]]}],[\\\"$\\\",\\\"aside\\\",null,{\\\"className\\\":\\\"dg-scopeOut\\\",\\\"aria-label\\\":\\\"Outside the boundary\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"dg-scopeTag dg-scopeTag--out u-mono\\\",\\\"children\\\":\\\"Outside the boundary\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"dg-scopeOutQ\\\",\\\"children\\\":\\\"What is not included?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"dg-scopeOutA\\\",\\\"children\\\":\\\"Denial-of-service testing, physical intrusion, and social engineering of your staff are out of scope unless separately agreed — the first because it proves little and risks much, the other two because they belong in a red team engagement with different rules. Remediation work is also separate: we will tell you exactly what to change, and our engineering practice can do it, but a tester who fixes their own findings cannot retest them impartially.\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"4b:[\\\"$\\\",\\\"figure\\\",null,{\\\"className\\\":\\\"dg\\\",\\\"id\\\":\\\"engagement-shape\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"dg-gantt\\\",\\\"viewBox\\\":\\\"0 0 1000 252\\\",\\\"preserveAspectRatio\\\":\\\"xMidYMid meet\\\",\\\"role\\\":\\\"img\\\",\\\"aria-label\\\":\\\"Engagement shape for Penetration Testing: 6 phases. Phase 1, Scoping, 3–5 days before start, before the window opens. Phase 2, Reconnaissance and mapping, Day 1, inside the engagement window. Phase 3, Manual testing, Days 2–8, inside the engagement window. Phase 4, Reporting, Days 9–11, inside the engagement window, producing the technical report. Phase 5, Debrief, Within 5 days of the report, after the report, producing the 90-minute debrief with the testers. Phase 6, Retest, Within 30 days, after the report, producing the retest report within 30 days with a per-finding verified status.\\\",\\\"children\\\":[[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-axisUnit\\\",\\\"x\\\":0,\\\"y\\\":16,\\\"children\\\":\\\"weeks from kick-off\\\"}],[[\\\"$\\\",\\\"g\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"line\\\",null,{\\\"className\\\":\\\"dg-grid\\\",\\\"x1\\\":290.5652173913044,\\\"y1\\\":30,\\\"x2\\\":290.5652173913044,\\\"y2\\\":226}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-tick\\\",\\\"x\\\":290.5652173913044,\\\"y\\\":24,\\\"textAnchor\\\":\\\"middle\\\",\\\"children\\\":\\\"$-0\\\"}]]}],[\\\"$\\\",\\\"g\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"line\\\",null,{\\\"className\\\":\\\"dg-grid\\\",\\\"x1\\\":443.3478260869565,\\\"y1\\\":30,\\\"x2\\\":443.3478260869565,\\\"y2\\\":226}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-tick\\\",\\\"x\\\":443.3478260869565,\\\"y\\\":24,\\\"textAnchor\\\":\\\"middle\\\",\\\"children\\\":2}]]}],[\\\"$\\\",\\\"g\\\",\\\"4\\\",{\\\"children\\\":[[\\\"$\\\",\\\"line\\\",null,{\\\"className\\\":\\\"dg-grid\\\",\\\"x1\\\":596.1304347826087,\\\"y1\\\":30,\\\"x2\\\":596.1304347826087,\\\"y2\\\":226}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-tick\\\",\\\"x\\\":596.1304347826087,\\\"y\\\":24,\\\"textAnchor\\\":\\\"middle\\\",\\\"children\\\":4}]]}]],[[\\\"$\\\",\\\"line\\\",null,{\\\"className\\\":\\\"dg-zero\\\",\\\"x1\\\":290.5652173913044,\\\"y1\\\":30,\\\"x2\\\":290.5652173913044,\\\"y2\\\":232}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-zeroLabel\\\",\\\"x\\\":290.5652173913044,\\\"y\\\":245,\\\"textAnchor\\\":\\\"middle\\\",\\\"children\\\":\\\"kick-off\\\"}]],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-colHead\\\",\\\"x\\\":762,\\\"y\\\":16,\\\"children\\\":\\\"Drops out\\\"}],[[\\\"$\\\",\\\"g\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowNum\\\",\\\"x\\\":0,\\\"y\\\":65,\\\"children\\\":\\\"01\\\"}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowName\\\",\\\"x\\\":34,\\\"y\\\":65,\\\"children\\\":\\\"Scoping\\\"}],[[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"dg-bar dg-bar--before\\\",\\\"x\\\":236,\\\"y\\\":53.5,\\\"width\\\":54.56521739130437,\\\"height\\\":15,\\\"rx\\\":2}],null,[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-barLabel\\\",\\\"x\\\":298.5652173913044,\\\"y\\\":64,\\\"children\\\":\\\"3–5 days before start\\\"}]],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-artNone\\\",\\\"x\\\":771,\\\"y\\\":64,\\\"children\\\":\\\"—\\\"}]]}],[\\\"$\\\",\\\"g\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowNum\\\",\\\"x\\\":0,\\\"y\\\":95,\\\"children\\\":\\\"02\\\"}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowName\\\",\\\"x\\\":34,\\\"y\\\":95,\\\"children\\\":\\\"Reconnaissance and mapping\\\"}],[[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"dg-bar dg-bar--window\\\",\\\"x\\\":290.5652173913044,\\\"y\\\":83.5,\\\"width\\\":10.913043478260875,\\\"height\\\":15,\\\"rx\\\":2}],null,[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-barLabel\\\",\\\"x\\\":309.47826086956525,\\\"y\\\":94,\\\"children\\\":\\\"Day 1\\\"}]],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-artNone\\\",\\\"x\\\":771,\\\"y\\\":94,\\\"children\\\":\\\"—\\\"}]]}],[\\\"$\\\",\\\"g\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowNum\\\",\\\"x\\\":0,\\\"y\\\":125,\\\"children\\\":\\\"03\\\"}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowName\\\",\\\"x\\\":34,\\\"y\\\":125,\\\"children\\\":\\\"Manual testing\\\"}],[[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"dg-bar dg-bar--window\\\",\\\"x\\\":301.47826086956525,\\\"y\\\":113.5,\\\"width\\\":76.39130434782601,\\\"height\\\":15,\\\"rx\\\":2}],null,[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-barLabel\\\",\\\"x\\\":385.86956521739125,\\\"y\\\":124,\\\"children\\\":\\\"Days 2–8\\\"}]],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-artNone\\\",\\\"x\\\":771,\\\"y\\\":124,\\\"children\\\":\\\"—\\\"}]]}],[\\\"$\\\",\\\"g\\\",\\\"4\\\",{\\\"children\\\":[[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowNum\\\",\\\"x\\\":0,\\\"y\\\":155,\\\"children\\\":\\\"04\\\"}],[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-rowName\\\",\\\"x\\\":34,\\\"y\\\":155,\\\"children\\\":\\\"Reporting\\\"}],[[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"dg-bar dg-bar--window\\\",\\\"x\\\":377.86956521739125,\\\"y\\\":143.5,\\\"width\\\":32.73913043478262,\\\"height\\\":15,\\\"rx\\\":2}],null,[\\\"$\\\",\\\"text\\\",null,{\\\"className\\\":\\\"dg-barLabel\\\",\\\"x\\\":418.6086956521739,\\\"y\\\":154,\\\"children\\\":\\\"Days 9–11\\\"}]],[[\\\"$\\\",\\\"line\\\",null,{\\\"className\\\":\\\"dg-leader\\\",\\\"x1\\\":748,\\\"y1\\\":151,\\\"x2\\\":757,\\\"y2\\\":151}],[\\\"$\\\",\\\"rect\\\",null,{\\\"className\\\":\\\"dg-artMark\\\",\\\"x\\\":757,\\\"y\\\":147,\\\"width\\\":8,\\\"height\\\":8,\\\