-sub {\n  margin: var(--s4) 0 0;\n  font-size: var(--text-lg);\n  color: var(--muted-strong);\n  max-width: 54ch;\n}\n.sv-lede {\n  margin: var(--s6) 0 0;\n  color: var(--muted-strong);\n  max-width: 68ch;\n}\n.sv-h2 {\n  font-size: clamp(1.5rem, 3.6vw, 2.25rem);\n  margin: 0;\n  max-width: 24ch;\n}\n.sv-h3 {\n  font-size: var(--text-xl);\n  margin: 0;\n}\n.sv-note {\n  margin: var(--s3) 0 0;\n  font-size: var(--text-sm);\n  color: var(--muted);\n  max-width: 68ch;\n}\n\n/* ---------- section head ---------- */\n.sv-head { margin-bottom: var(--s12); }\n.sv-head__rule { height: 1px; background-color: var(--border); margin-bottom: var(--s6); }\n.sv-head__eyebrow { margin: 0 0 var(--s3); }\n.sv-head__lede { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 68ch; }\n\n/* ---------- hero ---------- */\n.sv-hero__eyebrow { margin: 0 0 var(--s4); }\n.sv-hero__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s3);\n  margin-top: var(--s8);\n}\n.sv-hero__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s2) var(--s6);\n  margin: var(--s6) 0 0;\n  padding: 0;\n  list-style: none;\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n\n/* ---------- credibility stat (first paragraph, PART 8.3) ---------- */\n.sv-cred {\n  margin: var(--s8) 0 0;\n  padding: var(--s6);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  max-width: 68ch;\n}\n.sv-cred__figure {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n}\n.sv-cred__context { display: block; margin-top: var(--s2); color: var(--muted-strong); }\n\n/* ---------- grids ---------- */\n.sv-grid { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 680px) { .sv-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-grid > li { min-width: 0; }\n\n/* Two columns of prose: the heading rail and the body. */\n.sv-rail { display: grid; gap: var(--s8); }\n@media (min-width: 900px) {\n  .sv-rail { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s16); }\n}\n.sv-rail__aside { min-width: 0; }\n.sv-rail__body { min-width: 0; }\n\n/* ---------- jump nav ---------- */\n.sv-jump {\n  position: sticky;\n  top: var(--nav-h);\n  z-index: 20;\n  background-color: color-mix(in oklab, var(--bg) 94%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--border);\n}\n.sv-jump__inner {\n  display: flex;\n  gap: var(--s1);\n  overflow-x: auto;\n  scrollbar-width: thin;\n  padding-block: var(--s2);\n  -webkit-overflow-scrolling: touch;\n}\n.sv-jump__link {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  min-height: 40px;\n  padding-inline: var(--s3);\n  border-radius: var(--radius-sm);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-jump__link:hover { color: var(--fg); background-color: var(--surface); }\n\n/* ---------- service card ---------- */\n.sv-card { display: flex; flex-direction: column; height: 100%; gap: var(--s4); }\n.sv-card__top { display: flex; align-items: flex-start; gap: var(--s3); }\n.sv-card__icon { flex: none; color: var(--accent); margin-top: 2px; }\n.sv-card__name { font-size: var(--text-lg); margin: 0; }\n.sv-card__line { margin: 0; color: var(--muted-strong); }\n.sv-card__list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  display: grid;\n  gap: var(--s2);\n  font-size: var(--text-sm);\n  color: var(--muted);\n}\n.sv-card__list li { display: flex; gap: var(--s2); }\n.sv-card__tick { flex: none; margin-top: 3px; color: var(--accent); }\n.sv-card__cta {\n  margin: auto 0 0;\n  padding-top: var(--s4);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n}\n\n/* ---------- plain link list ---------- */\n.sv-links { display: grid; gap: 0; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }\n.sv-links > li { border-bottom: 1px solid var(--border); }\n.sv-links__a {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: baseline;\n  gap: var(--s4);\n  padding: var(--s4) 0;\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-links__a:hover { color: var(--accent); }\n.sv-links__label { font-weight: 500; }\n.sv-links__blurb { display: block; margin-top: var(--s1); font-size: var(--text-sm); color: var(--muted); font-weight: 400; }\n.sv-links__arrow { flex: none; color: var(--muted); align-self: center; }\n\n/* ---------- numbered methodology ---------- */\n.sv-phases { list-style: none; margin: 0; padding: 0; counter-reset: none; }\n.sv-phase {\n  display: grid;\n  gap: var(--s2);\n  padding: var(--s6) 0;\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 760px) {\n  .sv-phase { grid-template-columns: 3.5rem minmax(0, 14rem) minmax(0, 1fr); gap: var(--s6); align-items: start; }\n}\n.sv-phase__n { font-size: var(--text-sm); color: var(--muted); }\n.sv-phase__name { font-size: var(--text-lg); margin: 0; font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif; font-weight: 500; }\n.sv-phase__when { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-phase__body { margin: 0; color: var(--muted-strong); }\n\n/* ---------- console exhibits ----------\n   One stacked band per placement. The gap is large on purpose: two dense\n   consoles with 24px between them read as one confused screenshot. */\n.sv-consoles { display: grid; gap: var(--s24); }\n\n/* ---------- phase card stack ----------\n   The stack primitive manages the sticky behaviour; this only sets the rhythm\n   above it and the two type roles inside a card. */\n.sv-phaseStack { margin-top: var(--s16); }\n.sv-phaseWhen {\n  margin: 0 0 var(--s3);\n  font-size: var(--text-xs);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.sv-phaseBody { margin: 0; color: var(--muted-strong); line-height: var(--leading-normal); }\n\n/* The artefact stack sits under the deliverables heading in the rail aside.\n   Capped so it never outgrows a 7fr column on a wide viewport. */\n.sv-deliverableArt { margin-top: var(--s8); max-width: 30rem; }\n\n/* ---------- deliverables / outcomes ---------- */\n.sv-ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n.sv-ticks > li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s3); color: var(--muted-strong); }\n.sv-ticks__mark { flex: none; margin-top: 4px; color: var(--accent); }\n\n/* ---------- chips (frameworks, stack, certifications) ---------- */\n.sv-chips { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n/*\n * Local override, not an edit to Badge.tsx. Badge sets white-space: nowrap,\n * which is right for a severity word (\"Critical\") and wrong for \"AWS\n * Well-Architected Security Pillar\" inside a 288px content box: a nowrap item\n * cannot shrink, so flex-wrap does not save it and the layout blows out at\n * 320px. Measured in headless Chromium at 320px, which is how the two real\n * offenders on this tree were found.\n *\n * Scoped to the five containers in which these routes render a Badge, so it\n * can never reach a severity badge elsewhere on the site — those live in the\n * product UI and must stay on one line.\n */\n.sv-chips .badge,\n.sv-card .badge,\n.sv-note .badge,\n.sv-seam__cta .badge,\n.sv-hero__meta .badge { white-space: normal; text-align: left; }\n\n/* ---------- accreditation strip ---------- */\n.sv-accred { display: grid; gap: var(--s4); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-accred { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (min-width: 1000px) { .sv-accred { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sv-accred__item {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: var(--s3);\n  padding: var(--s4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  min-width: 0;\n}\n.sv-accred__icon { flex: none; margin-top: 2px; color: var(--accent); }\n.sv-accred__label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); overflow-wrap: anywhere; }\n.sv-accred__issuer { display: block; margin-top: var(--s1); font-size: var(--text-xs); color: var(--muted); }\n\n/* ---------- expert ---------- */\n.sv-expert { display: grid; gap: var(--s6); }\n@media (min-width: 760px) { .sv-expert { grid-template-columns: auto minmax(0, 1fr); gap: var(--s8); } }\n.sv-expert__name { margin: 0; font-size: var(--text-xl); }\n.sv-expert__role { margin: var(--s1) 0 0; color: var(--accent); font-size: var(--text-sm); }\n.sv-expert__bio { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 60ch; }\n.sv-expert__certs-label { margin: var(--s6) 0 var(--s2); }\n\n/* ---------- case study ---------- */\n.sv-metrics { display: grid; gap: var(--s6); list-style: none; margin: 0; padding: 0; }\n@media (min-width: 680px) { .sv-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-metric__value {\n  display: block;\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: var(--leading-snug);\n  overflow-wrap: anywhere;\n}\n.sv-metric__label { display: block; margin-top: var(--s2); color: var(--muted-strong); font-size: var(--text-sm); }\n.sv-metric__note { display: block; margin-top: var(--s1); color: var(--muted); font-size: var(--text-xs); }\n\n.sv-quote { margin: 0; }\n.sv-quote__text {\n  margin: 0;\n  font-size: var(--text-lg);\n  line-height: var(--leading-snug);\n  color: var(--fg);\n  max-width: 52ch;\n}\n.sv-quote__by { display: block; margin-top: var(--s4); font-size: var(--text-sm); color: var(--muted); font-style: normal; }\n.sv-quote__mark { color: var(--muted); margin-bottom: var(--s3); }\n\n/* ---------- definition grid (timeline / team / engagement) ---------- */\n.sv-defs { margin: 0; display: grid; gap: 0; }\n.sv-def { padding: var(--s6) 0; border-top: 1px solid var(--border); display: grid; gap: var(--s2); }\n@media (min-width: 760px) { .sv-def { grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: var(--s6); } }\n.sv-def__term { font-size: var(--text-sm); color: var(--muted); margin: 0; letter-spacing: 0.04em; text-transform: uppercase; }\n.sv-def__desc { margin: 0; color: var(--muted-strong); }\n\n/* ---------- the seam ---------- */\n.sv-seam { display: grid; gap: var(--s6); align-items: stretch; }\n@media (min-width: 980px) {\n  .sv-seam { grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, 1fr); gap: var(--s4); align-items: stretch; }\n}\n.sv-seam__col { display: flex; flex-direction: column; gap: var(--s4); height: 100%; }\n.sv-seam__centre { border-color: var(--accent); }\n.sv-seam__kicker { margin: 0 0 var(--s3); }\n.sv-seam__name { margin: 0; font-size: var(--text-xl); }\n.sv-seam__line { margin: var(--s3) 0 0; color: var(--muted-strong); }\n.sv-seam__body { margin: var(--s4) 0 0; color: var(--muted); font-size: var(--text-sm); }\n.sv-seam__cta { margin: auto 0 0; padding-top: var(--s6); }\n\n/* ---------- contrast pair (engagement models) ---------- */\n.sv-contrast { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-contrast { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s8); } }\n.sv-contrast__head { display: flex; align-items: center; gap: var(--s3); margin-bottom: var(--s4); }\n.sv-contrast__icon { flex: none; color: var(--accent); }\n.sv-contrast__h { margin: 0; font-size: var(--text-lg); }\n.sv-contrast__rows { margin: 0; display: grid; }\n.sv-contrast__row { padding: var(--s4) 0; border-top: 1px solid var(--border); }\n.sv-contrast__term { margin: 0; font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }\n.sv-contrast__desc { margin: var(--s2) 0 0; color: var(--muted-strong); }\n\n/* ---------- form ---------- */\n.sv-form { display: grid; gap: var(--s6); max-width: 44rem; }\n.sv-field { display: grid; gap: var(--s2); min-width: 0; }\n.sv-field--check { grid-template-columns: auto minmax(0, 1fr); align-items: start; column-gap: var(--s3); }\n.sv-label { font-size: var(--text-sm); font-weight: 500; color: var(--fg); }\n.sv-req { color: var(--accent); margin-left: 2px; }\n.sv-help { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.sv-input,\n.sv-select,\n.sv-textarea {\n  width: 100%;\n  min-width: 0;\n  min-height: 44px;\n  padding: var(--s3) var(--s4);\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  font: inherit;\n  font-size: var(--text-base);\n  transition: border-color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);\n}\n.sv-textarea { min-height: 7.5rem; resize: vertical; line-height: var(--leading-normal); }\n.sv-input:hover, .sv-select:hover, .sv-textarea:hover { border-color: var(--fg); }\n.sv-input::placeholder, .sv-textarea::placeholder { color: var(--muted); }\n.sv-check { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--accent); flex: none; }\n.sv-form__actions { display: flex; flex-wrap: wrap; gap: var(--s4); align-items: center; }\n.sv-form__sla { margin: 0; font-size: var(--text-sm); color: var(--muted); }\n/*\n * VALIDATION SUMMARY — revealed by :target, so it needs neither JavaScript nor\n * a searchParams read on the page.\n *\n * Reading ?enquiry= would have been the obvious way to show this, and it was\n * the first implementation. It is wrong: a page that reads searchParams opts\n * out of static generation, which would have made all sixteen service pages\n * dynamically rendered to display a message a visitor almost never sees. The\n * server action redirects to #enquiry-incomplete or #enquiry-email instead;\n * the browser scrolls to the matching block and :target reveals it. Static\n * generation survives, and so does the message.\n *\n * The common case never reaches here at all: the \"required\" attribute is\n * native constraint validation, which browsers enforce with scripting off.\n * The server check exists for a crafted POST, not a forgotten field.\n *\n * No --signal-* colour: Badge.tsx states severity colour is the one place in\n * the codebase those tokens appear, and a form error is not a severity rating.\n */\n.sv-form__error {\n  display: none;\n  padding: var(--s4);\n  border: 1px solid var(--border-strong);\n  border-left: 2px solid var(--fg);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  scroll-margin-top: calc(var(--nav-h) + var(--s8));\n}\n.sv-form__error:target { display: block; }\n.sv-form__error p { margin: 0; color: var(--fg); font-size: var(--text-sm); }\n\n/*\n * A box that declares its own palette inside a band of another palette.\n * <Card> sets `color: inherit`, so a bare theme-* class on it would re-colour\n * the surface and leave the text behind; this sets both. Used on\n * /services/engagement-models, where the security retainer and the delivery\n * retainer sit side by side in the palette of their own act — the commercial\n * contrast made visible rather than described.\n */\n.sv-theme-box {\n  background-color: var(--bg);\n  color: var(--fg);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  padding: var(--s8);\n  min-width: 0;\n}\n\n/* ---------- misc ---------- */\n.sv-cta-band { display: grid; gap: var(--s6); }\n@media (min-width: 900px) { .sv-cta-band { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s12); } }\n.sv-cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--s3); }\n\n.sv-hotline {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n}\n.sv-hotline__num {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: clamp(1.375rem, 4.5vw, 1.75rem);\n  font-weight: 500;\n  color: var(--fg);\n  text-decoration: none;\n  overflow-wrap: anywhere;\n  transition: color var(--dur-micro) var(--ease-out);\n}\n.sv-hotline__num:hover { color: var(--accent); }\n\n.sv-stub {\n  display: grid;\n  gap: var(--s4);\n  padding: var(--s8);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--surface);\n  max-width: 44rem;\n}\n.sv-prose-measure { max-width: 68ch; }\n.sv-sr {\n  position: absolute;\n  width: 1px; height: 1px;\n  padding: 0; margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n14:[[\"$\",\"style\",null,{\"href\":\"envenox-services\",\"precedence\":\"default\",\"children\":\"$26\"}],\"$L27\",\"$L28\",\"$L29\",null,\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",null,\"$L31\",\"$L32\",null,\"$L33\",\"$L34\",\"$L35\",\"$L36\",null,\"$L37\",\"$L38\",\"$L39\"]\n42:I[7664,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"3557\",\"static/chunks/3557-949eff4fc2fd241a.js\",\"4553\",\"static/chunks/4553-42d73557a9dc5e67.js\",\"9805\",\"static/chunks/app/services/%5Bslug%5D/page-8b2a457ab8db9360.js\"],\"RevealGroup\"]\n43:I[7664,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"3557\",\"static/chunks/3557-949eff4fc2fd241a.js\",\"4553\",\"static/chunks/4553-42d73557a9dc5e67.js\",\"9805\",\"static/chunks/app/services/%5Bslug%5D/page-8b2a457ab8db9360.js\"],\"Reveal\"]\n83:I[4349,[\"2619\",\"static/chunks/2619-3c9e02e22d10480a.js\",\"4938\",\"static/chunks/4938-ec7db2048e7be43e.js\",\"3557\",\"static/chunks/3557-949eff4fc2fd241a.js\",\"4553\",\"static/chunks/4553-42d73557a9dc5e67.js\",\"9805\",\"static/chunks/app/services/%5Bslug%5D/page-8b2a457ab8db9360.js\"],\"Faq\"]\n3a:T8e3,{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://envenox.com/services/platform-engineering#service\",\"name\":\"Platform & DevOps\",\"serviceType\":\"Platform & DevOps\",\"description\":\"Deployment that is boring, and a rollback somebody has actually rehearsed.\",\"disambiguatingDescription\":\"Reproducible infrastructure, short-lived pipeline identity, and a rehearsed rollback.\",\"url\":\"https://envenox.com/services/platform-engineering\",\"provider\":{\"@id\":\"https://envenox.com/#organization\"},\"areaServed\":[{\"@type\":\"Country\",\"name\":\"United Kingdom\"},{\"@type\":\"Country\",\"name\":\"Bangladesh\"}],\"audience\":{\"@type\":\"BusinessAudience\",\"name\":\"Regulated organisations\"},\"category\":\"Software Development\",\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Platform & DevOps — what is included\",\"itemListElement\":[{\"@type\":\"OfferCatalogItem\",\"position\":1,\"name\":\"Infrastructure as code\",\"description\":\"Terraform or equivalent, reproducible from an empty account, with environments that differ by variables rather than by history.\"},{\"@type\":\"OfferCatalogItem\",\"position\":2,\"name\":\"CI/CD\",\"description\":\"Build once, promote the artefact. Short-lived OIDC identity for deployment rather than static keys. Progressive delivery with automated rollback on signal.\"},{\"@type\":\"OfferCatalogItem\",\"position\":3,\"name\":\"Kubernetes and runtime\",\"description\":\"Cluster design, workload identity, admission control, autoscaling and cost shaping. Or a deliberate decision not to use Kubernetes, which is often correct.\"},{\"@type\":\"OfferCatalogItem\",\"position\":4,\"name\":\"Observability\",\"description\":\"Structured logs, metrics, traces and alerts that page a human only for things a human must do. Service level objectives with an error budget that has consequences.\"},{\"@type\":\"OfferCatalogItem\",\"position\":5,\"name\":\"Secrets and identity\",\"description\":\"Vault or cloud-native secret management, automated rotation, and no long-lived credentials in CI. This is the most common finding in our own cloud reviews.\"},{\"@type\":\"OfferCatalogItem\",\"position\":6,\"name\":\"Developer experience\",\"description\":\"One-command local environment, preview environments per pull request, and a path to production an engineer can follow on their first week.\"}]},\"termsOfService\":\"https://envenox.com/legal/terms\"}27:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$3a\"}}]\n28:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Envenox\\\",\\\"item\\\":\\\"https://envenox.com/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Services\\\",\\\"item\\\":\\\"https://envenox.com/services\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Software Development\\\",\\\"item\\\":\\\"https://envenox.com/services/software-development\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":4,\\\"name\\\":\\\"Platform & DevOps\\\",\\\"item\\\":\\\"https://envenox.com/services/platform-engineering\\\"}]}\"}}]\n3b:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n29:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section grain\",\"data-theme-section\":\"light\",\"style\":{\"paddingTop\":\"calc(var(--nav-h) + var(--s16))\"},\"aria-labelledby\":\"service-h1\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-hero__eyebrow\",\"children\":[[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services\",\"children\":\"Services\"}],\" · \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services/software-development\",\"children\":\"Software Development\"}]]}],[\"$\",\"h1\",null,{\"id\":\"service-h1\",\"className\":\"sv-h1\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":32,\"height\":32,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-server\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-4px\",\"marginRight\":\"var(--s3)\",\"color\":\"var(--accent)\"},\"children\":[[\"$\",\"rect\",\"ngkwjq\",{\"width\":\"20\",\"height\":\"8\",\"x\":\"2\",\"y\":\"2\",\"rx\":\"2\",\"ry\":\"2\"}],[\"$\",\"rect\",\"iecqi9\",{\"width\":\"20\",\"height\":\"8\",\"x\":\"2\",\"y\":\"14\",\"rx\":\"2\",\"ry\":\"2\"}],[\"$\",\"line\",\"16zg32\",{\"x1\":\"6\",\"x2\":\"6.01\",\"y1\":\"6\",\"y2\":\"6\"}],[\"$\",\"line\",\"nzw8ys\",{\"x1\":\"6\",\"x2\":\"6.01\",\"y1\":\"18\",\"y2\":\"18\"}],\"$undefined\"]}],\"Platform & DevOps\"]}],[\"$\",\"p\",null,{\"className\":\"sv-sub\",\"children\":\"Deployment that is boring, and a rollback somebody has actually rehearsed.\"}],[\"$\",\"p\",null,{\"className\":\"sv-cred\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"sv-cred__figure\",\"children\":\"From 11 days to 40 minutes\"}],[\"$\",\"span\",null,{\"className\":\"sv-cred__context\",\"children\":\"median lead time for change on our longest-running platform engagement, over 14 months\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-hero__actions\",\"children\":[[[\"$\",\"style\",null,{\"href\":\"envenox-button\",\"precedence\":\"default\",\"children\":\"$3b\"}],\"$L3c\"],\"$L3d\"]}],\"$L3e\"]}]}]]\n2a:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"problem\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\",\"style\":{\"marginBottom\":\"var(--s6)\"}}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"The problem\"}],[\"$\",\"h2\",null,{\"id\":\"problem\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Deployment that is boring, and a rollback somebody has actually rehearsed.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-prose-measure\",\"style\":{\"margin\":0,\"fontSize\":\"var(--text-lg)\",\"color\":\"var(--muted-strong)\"},\"children\":\"You can tell how healthy a platform is from one question: what happens when the person who set up the pipeline is on holiday and a release has to go out? If the answer involves a specific laptop, an undocumented step or a shared credential in a chat thread, the platform is a person, and that person is a single point of failure for your release process. We build platforms that are reproducible from an empty cloud account, where deploying is a merge, where rolling back has been rehearsed rather than documented, and where the identity your pipeline uses is short-lived and scoped rather than a long-lived key in an environment variable.\"}],null]}]]}]}]}]]\n3f:T1fac,\n.dg {\n  /* POSITIONED ON PURPOSE. .dg-ganttText is clipped and absolutely positioned\n     at wide widths; an absolutely positioned element is only clipped by an\n     ancestor in its containing-block chain. Without this the clipped schedule\n     escapes and widens the page. */\n  position: relative;\n  margin: 0;\n  min-width: 0;\n}\n\n/* ---------------- the drawn schedule ---------------- */\n.dg-gantt { display: none; width: 100%; height: auto; overflow: visible; }\n@media (min-width: 860px) {\n  .dg-gantt { display: block; }\n}\n\n.dg-axisUnit,\n.dg-colHead {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  fill: var(--muted);\n}\n.dg-tick {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n.dg-grid { stroke: var(--border-strong); stroke-width: 1; }\n.dg-zero { stroke: var(--accent); stroke-width: 1.5; }\n.dg-zeroLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  fill: var(--accent);\n}\n\n.dg-rowNum {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 11px;\n  fill: var(--muted);\n}\n.dg-rowName { font-size: 13px; fill: var(--fg); }\n\n/* Three stages, three SHAPES as well as three fills: a filled bar, a hollow\n   dashed bar and a half-height bar. The information survives greyscale. */\n.dg-bar { fill: var(--accent); stroke: none; }\n.dg-bar--before { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 3; }\n.dg-bar--after { fill: var(--muted-strong); }\n.dg-bar--unstated { opacity: 0.55; }\n.dg-openTip { fill: var(--accent); }\n.dg-standing { stroke: var(--border-strong); stroke-width: 2; stroke-dasharray: 2 4; }\n\n.dg-barLabel {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  fill: var(--muted);\n}\n/* Printed on top of a filled bar: the bar's fill is --accent or\n   --muted-strong, both of which are LIGHT in the dark palettes and DARK in the\n   light one, so the text takes the ground colour rather than a fixed one. */\n.dg-barLabel--in { fill: var(--bg); }\n.dg-leader { stroke: var(--border-strong); stroke-width: 1; }\n.dg-artMark { fill: var(--accent); }\n.dg-art { font-size: 12px; fill: var(--muted-strong); }\n/* \"nothing drops out of this phase\" is information, not furniture, so the\n   dash takes a text neutral. --border-strong is a hairline value and renders\n   as an almost-invisible mark in .theme-dark. */\n.dg-artNone { font-size: 12px; fill: var(--muted); }\n\n/* ---------------- the schedule as DOM text ---------------- */\n.dg-sched { list-style: none; margin: 0; padding: 0; display: grid; }\n.dg-schedRow {\n  display: grid;\n  gap: var(--s1);\n  padding: var(--s4) 0;\n  border-top: 1px solid var(--border);\n  min-width: 0;\n}\n@media (min-width: 560px) {\n  .dg-schedRow {\n    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);\n    column-gap: var(--s6);\n    align-items: baseline;\n  }\n  .dg-schedHead { grid-row: span 3; }\n}\n.dg-schedHead { display: flex; gap: var(--s3); align-items: baseline; margin: 0; min-width: 0; }\n.dg-schedNum { font-size: var(--text-xs); color: var(--accent); flex: none; }\n.dg-schedName { font-weight: 500; color: var(--fg); }\n.dg-schedWhen { margin: 0; font-size: var(--text-xs); color: var(--muted-strong); }\n.dg-schedStage { margin: 0; font-size: var(--text-xs); color: var(--muted); }\n.dg-schedArt { margin: 0; font-size: var(--text-sm); color: var(--muted-strong); }\n.dg-schedArtKey {\n  display: inline-block;\n  margin-right: var(--s2);\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: var(--text-xs);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n@media (min-width: 860px) {\n  .dg-ganttText {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip-path: inset(50%);\n    white-space: nowrap;\n    border: 0;\n  }\n}\n\n/* ---------------- caption and legend ---------------- */\n.dg-cap { margin-top: var(--s6); }\n.dg-legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--s3) var(--s6);\n  list-style: none;\n  margin: 0 0 var(--s4);\n  padding: 0;\n  font-size: var(--text-xs);\n  color: var(--muted);\n}\n.dg-legendItem { display: inline-flex; align-items: center; gap: var(--s2); }\n.dg-legendMark { width: 18px; height: 8px; border-radius: 2px; background-color: var(--accent); flex: none; }\n.dg-legendItem[data-stage='before'] .dg-legendMark {\n  background-color: transparent;\n  border: 1px dashed var(--muted);\n}\n.dg-legendItem[data-stage='after'] .dg-legendMark { height: 4px; background-color: var(--muted-strong); }\n.dg-legendItem[data-stage='standing'] .dg-legendMark {\n  height: 2px;\n  background-color: transparent;\n  border-top: 2px dotted var(--border-strong);\n}\n.dg-capNote {\n  margin: 0;\n  font-size: var(--text-xs);\n  color: var(--muted);\n  max-width: 74ch;\n  line-height: 1.6;\n}\n\n/* ---------------- deliverables stack ---------------- */\n.dg-stackFig { display: grid; gap: var(--s4); }\n.dg-stack { width: 100%; height: auto; max-width: 34rem; }\n.dg-sheet { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1; }\n.dg-sheetSpine { fill: var(--accent); }\n.dg-sheetNum { font-size: 11px; letter-spacing: 0.1em; fill: var(--muted); }\n.dg-sheetTag {\n  font-family: var(--font-jetbrains-mono), ui-monospace, monospace;\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  fill: var(--muted);\n}\n.dg-sheetTitle { font-size: 15px; font-weight: 500; fill: var(--fg); }\n.dg-sheetRule { stroke: var(--border-strong); stroke-width: 1; }\n.dg-stackCap { max-width: 34rem; }\n\n/* ---------------- scope boundary ---------------- */\n.dg-scope { display: grid; gap: var(--s6); }\n@media (min-width: 1000px) {\n  .dg-scope { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: var(--s8); align-items: start; }\n}\n.dg-scopeIn {\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  min-width: 0;\n}\n@media (min-width: 768px) { .dg-scopeIn { padding: var(--s8); } }\n.dg-scopeTag {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: var(--s3);\n  margin: 0 0 var(--s6);\n  font-size: var(--text-xs);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n.dg-scopeCount { color: var(--muted); letter-spacing: 0.08em; }\n.dg-scopeGrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }\n@media (min-width: 640px) { .dg-scopeGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.dg-scopeCell {\n  min-width: 0;\n  padding: var(--s4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n}\n.dg-scopeNum { display: block; font-size: var(--text-xs); color: var(--accent); margin-bottom: var(--s2); }\n.dg-scopeName { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--fg); }\n.dg-scopeBody { margin: var(--s2) 0 0; font-size: var(--text-sm); color: var(--muted); line-height: 1.55; }\n.dg-scopeOut {\n  border: 1px dashed var(--border-strong);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  min-width: 0;\n}\n.dg-scopeTag--out { color: var(--muted); }\n.dg-scopeOutQ { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--muted-strong); }\n.dg-scopeOutA { margin: var(--s3) 0 0; font-size: var(--text-sm); color: var(--muted); line-height: 1.6; }\n\n/* ---------------- console frame ---------------- */\n.dg-console { display: grid; gap: var(--s8); align-items: start; }\n@media (min-width: 1000px) {\n  .dg-console { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s12); }\n}\n.dg-consoleSay { min-width: 0; }\n.dg-consoleTitle { margin: var(--s3) 0 0; font-size: var(--text-xl); }\n.dg-consoleBody { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 46ch; }\n.dg-consoleArt { min-width: 0; }\n\n@media print {\n  .dg-gantt { display: none; }\n  .dg-ganttText { position: static; width: auto; height: auto; margin: 0; clip-path: none; white-space: normal; }\n}\n2b:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"consoles\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"The working surface\"}],[\"$\",\"h2\",null,{\"id\":\"consoles\",\"className\":\"sv-h2\",\"children\":\"What this looks like in operation\"}],[\"$\",\"p\",null,{\"className\":\"sv-head__lede\",\"children\":\"Drawn, not screenshotted. These stand in for platforms we operate and do not own, so the data is illustrative — but the density, the columns 