ate pages overflowed 320px because\n     a badge held arbitrary data — \"3 weeks review, 14 weeks remediation\",\n     \"AWS Solutions Architect Professional\", a credibility sentence — and an\n     unbreakable chip wider than its card pushes the whole grid track past the\n     viewport. A badge is a label primitive, but callers legitimately put\n     variable-length data in one, and the component should survive that rather\n     than require every caller to override it. Severity badges keep nowrap\n     below: \"Critical\" is two syllables and must never break. */\n  white-space: normal;\n  text-wrap: balance;\n}\n.badge--severity {\n  white-space: nowrap;\n}\n.badge--sm { font-size: var(--text-xs); padding: 2px var(--s2); }\n.badge--md { padding: var(--s1) var(--s3); }\n\n.badge--neutral {\n  --badge-bg: var(--surface);\n  --badge-fg: var(--muted-strong);\n  --badge-border: var(--border);\n}\n.badge--brand {\n  --badge-bg: color-mix(in oklab, var(--accent) 12%, transparent);\n  --badge-fg: var(--accent);\n  --badge-border: color-mix(in oklab, var(--accent) 38%, transparent);\n}\n\n/* --- the only --signal-* usage in the codebase --- */\n.badge--severity {\n  --badge-bg: color-mix(in oklab, var(--sig) 14%, transparent);\n  --badge-fg: var(--sig);\n  --badge-border: color-mix(in oklab, var(--sig) 42%, transparent);\n  font-variant-numeric: tabular-nums;\n}\n.badge--severity .badge__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: var(--sig);\n  flex: none;\n}\n.badge--critical { --sig: var(--signal-critical); }\n.badge--high { --sig: var(--signal-high); }\n.badge--medium { --sig: var(--signal-medium); }\n.badge--low { --sig: var(--signal-low); }\n.badge--info { --sig: var(--signal-info); }\n35:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"related\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Related\"}],[\"$\",\"h2\",null,{\"id\":\"related\",\"className\":\"sv-h2\",\"children\":\"What usually goes with this\"}],null]}],[[\"$\",\"$L42\",null,{\"as\":\"ul\",\"className\":\"sv-grid sv-grid--2\",\"children\":[[\"$\",\"$L43\",\"cloud-security\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$7c\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-card__top\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-cloud sv-card__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"p7xjir\",{\"d\":\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"sv-card__name\",\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/cloud-security\",\"className\":\"card__link\",\"children\":\"Cloud Security\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"Identity-path analysis across AWS, Azure and GCP, not a CSPM findings dump.\"}],[\"$\",\"p\",null,{\"style\":{\"margin\":0},\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-badge\",\"precedence\":\"default\",\"children\":\"$7d\"}],\"$L7e\"]}]]}]]}],\"$L7f\",\"$L80\",\"$L81\"]}],\"$L82\"]]}]}]]\n36:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"engagement\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Commercials\"}],[\"$\",\"h2\",null,{\"id\":\"engagement\",\"className\":\"sv-h2\",\"children\":\"Shape, timeline and scoping\"}],null]}],[\"$\",\"dl\",null,{\"className\":\"sv-defs\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Timeline\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"12–16 weeks for a platform uplift, then advisory.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Team shape\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"A platform lead and one or two engineers, with a cloud security reviewer at the identity and secrets gates.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Engagement\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Project engagement with handover, or an embedded platform engineer.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Scoping\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":[\"A named engineer replies within one business day. Scoping call within three.\",\" \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services/engagement-models\",\"children\":\"How the four engagement models differ\"}],\".\"]}]]}]]}]]}]}]]\n37:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"Frequently asked\"}],null]}],[\"$\",\"$L83\",null,{\"items\":[{\"q\":\"Do we need Kubernetes?\",\"a\":\"Probably not. Kubernetes is the right answer for many services, many teams and genuine multi-tenancy. For a handful of services and one team, a managed container runtime costs a fraction of the operational burden. We will tell you which case you are in during the assessment, and \\\"we already decided on Kubernetes\\\" is a fine answer too — we will just make it boring.\"},{\"q\":\"How do you measure improvement?\",\"a\":\"The four delivery metrics — lead time for change, deployment frequency, change failure rate, time to restore — baselined in week one. They are the only honest way to tell a platform improvement from a platform migration.\"},{\"q\":\"Can you do this without a platform freeze?\",\"a\":\"Yes, and we prefer to. The new pipeline runs in parallel, one service migrates, then the rest follow once it has survived a fortnight. A big-bang platform migration is the shape of engagement most likely to be abandoned halfway with two platforms to maintain.\"},{\"q\":\"What about cost?\",\"a\":\"Cost shaping is part of the work: rightsizing, spot and savings commitments, storage lifecycle, and egress — which is the line item that surprises people. We report the saving against the baseline rather than claiming a percentage.\"},{\"q\":\"Who is on call after you leave?\",\"a\":\"Your team, with a rota we helped design and runbooks written from real incidents rather than from imagination. We can hold a secondary escalation during the first quarter if you want a safety net.\"},{\"q\":\"Will your security practice review it?\",\"a\":\"Yes, at the identity and secrets gates, and a cloud security review at the end. The pipeline identity is where we most often find a path from a repository contributor to production.\"}],\"headingLevel\":3}]]}]}]]\n84:{\"id\":\"403c44504416ed33d4af4350092b655f174641e336\",\"bound\":null}\n38:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-light transition-theme u-section grain\",\"data-theme-section\":\"light\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-3px\",\"marginRight\":\"var(--s2)\"},\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"A platform lead and one or two engineers, with a cloud security reviewer at the identity and secrets gates.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"form\",null,{\"action\":\"$h84\",\"className\":\"sv-form\",\"id\":\"enquiry-form\",\"children\":[[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"returnTo\",\"value\":\"/services/platform-engineering\"}],[[\"$\",\"div\",\"enquiry-incomplete\",{\"id\":\"enquiry-incomplete\",\"className\":\"sv-form__erro