ion\\\":\\\"dark\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"topics\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Explainers\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"topics\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Questions about Red Teaming\\\"}],null]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"sv-links\\\",\\\"aria-label\\\":\\\"Questions buyers ask about this service\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/services/red-teaming/red-teaming-vs-penetration-testingRed teaming vs penetration testing\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"className\\\":\\\"sv-links__a\\\",\\\"href\\\":\\\"/services/red-teaming/red-teaming-vs-penetration-testing\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-links__label\\\",\\\"children\\\":[\\\"Red teaming vs penetration testing\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-links__blurb\\\",\\\"children\\\":\\\"We have been quoted for both. What is the actual difference and which do we need first?\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"sv-links__arrow\\\",\\\"width\\\":\\\"16\\\",\\\"height\\\":\\\"16\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1.75\\\",\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"focusable\\\":\\\"false\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M5 12h14\\\"}],[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"m12 5 7 7-7 7\\\"}]]}]]}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/red-teaming/what-is-a-purple-teamWhat is a purple team?\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"className\\\":\\\"sv-links__a\\\",\\\"href\\\":\\\"/services/red-teaming/what-is-a-purple-team\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-links__label\\\",\\\"children\\\":[\\\"What is a purple team?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-links__blurb\\\",\\\"children\\\":\\\"Our provider offered a purple team debrief. Is that a real thing or a rebrand?\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"sv-links__arrow\\\",\\\"width\\\":\\\"16\\\",\\\"height\\\":\\\"16\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1.75\\\",\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"focusable\\\":\\\"false\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M5 12h14\\\"}],[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"m12 5 7 7-7 7\\\"}]]}]]}]}],[\\\"$\\\",\\\"li\\\",\\\"/services/red-teaming/are-we-ready-for-a-red-teamAre we ready for a red team?\\\",{\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"className\\\":\\\"sv-links__a\\\",\\\"href\\\":\\\"/services/red-teaming/are-we-ready-for-a-red-team\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-links__label\\\",\\\"children\\\":[\\\"Are we ready for a red team?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"sv-links__blurb\\\",\\\"children\\\":\\\"How do we know whether we would waste the money?\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"sv-links__arrow\\\",\\\"width\\\":\\\"16\\\",\\\"height\\\":\\\"16\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1.75\\\",\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"focusable\\\":\\\"false\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M5 12h14\\\"}],[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"m12 5 7 7-7 7\\\"}]]}]]}]}]]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"35:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"faq\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Questions\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"faq\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Frequently asked\\\"}],null]}],[\\\"$\\\",\\\"$L6e\\\",null,{\\\"items\\\":[{\\\"q\\\":\\\"How is this different from a penetration test?\\\",\\\"a\\\":\\\"A test measures a system; a red team measures your organisation. Do not buy one before the other — a red team against an untested estate finds the obvious vulnerability a test would have found at a lower rate, and you learn nothing about your detection because the engagement ended at the first open door.\\\"},{\\\"q\\\":\\\"Will you phish our staff?\\\",\\\"a\\\":\\\"Only if authorised, and the framing matters. Results are reported as an organisational control outcome, never as a league table of who clicked. A phishing exercise that produces blame makes the next real report arrive later, which is a net loss to your security posture.\\\"},{\\\"q\\\":\\\"Who knows the exercise is running?\\\",\\\"a\\\":\\\"A control group of two to four people, plus a white cell contact reachable at any hour for deconfliction. The blue team does not know, because that is the entire point. We will stand down immediately on a control group instruction.\\\"},{\\\"q\\\":\\\"What if you cause an outage?\\\",\\\"a\\\":\\\"Rules of engagement prohibit destructive actions, we hold a stop-word that halts everything, and the white cell contact can reach an operator at any hour. In nine engagements we have had no client-impacting outage, and we will tell you if that changes.\\\"},{\\\"q\\\":\\\"Does this satisfy DORA threat-led penetration testing?\\\",\\\"a\\\":\\\"The methodology aligns with TIBER-EU and DORA TLPT. Formal TLPT requires a threat intelligence provider and a tester that meet regulator independence criteria, and in some engagements that means we act as one and not the other. We will tell you which during scoping rather than after.\\\"},{\\\"q\\\":\\\"Is the purple team optional?\\\",\\\"a\\\":\\\"Technically, but declining it is leaving most of the value on the table. A red team report tells you what happened; the purple session is where your defenders learn to see it, and where the detections actually get written.\\\"}],\\\"headingLevel\\\":3}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"6f:{\\\"id\\\":\\\"403c44504416ed33d4af4350092b655f174641e336\\\",\\\"bound\\\":null}\\n\"])</script><script>self.__next_f.push([1,\"36:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-co