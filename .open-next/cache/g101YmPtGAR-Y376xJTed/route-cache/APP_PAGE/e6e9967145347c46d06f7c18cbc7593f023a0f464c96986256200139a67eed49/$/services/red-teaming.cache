{\"className\":\"sv-phaseBody\",\"children\":\"Control group formed, objectives agreed, rules of engagement written, legal authorisation signed, and a deconfliction process established.\"}]]}]]}]\n87:[\"$\",\"article\",\"2\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"02 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Reconnaissance\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Weeks 2–3\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Open-source intelligence on infrastructure, people and suppliers. Most clients find this phase alone worth the engagement.\"}]]}]]}]\n88:[\"$\",\"article\",\"3\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"03 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Initial access\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Weeks 3–5\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Attempt entry through the authorised vectors, with every action logged for later replay against your telemetry.\"}]]}]]}]\n89:[\"$\",\"article\",\"4\",{\"className\":\"stack__card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"stack__index\",\"children\":\"04 / 06\"}],[\"$\",\"h3\",null,{\"className\":\"stack__title\",\"children\":\"Objective pursuit\"}],[\"$\",\"div\",null,{\"className\":\"stack__body\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sv-phaseWhen u-mono\",\"children\":\"Weeks 5–8\"}],[\"$\",\"p\",null,{\"className\":\"sv-phaseBody\",\"children\":\"Escalate, move laterally and pursue the objectives. If detected, we note it precisely and, where agreed, continue from a new position.\"}]]}]]}]\n8a:[\"$\",\"article\",\"5\",{\"clas