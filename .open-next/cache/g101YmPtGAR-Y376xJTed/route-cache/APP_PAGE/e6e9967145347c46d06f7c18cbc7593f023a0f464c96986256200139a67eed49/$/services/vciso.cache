ted); }\n.dg-scopeOutQ { margin: 0; font-size: var(--text-base); font-weight: 500; color: var(--muted-strong); }\n.dg-scopeOutA { margin: var(--s3) 0 0; font-size: var(--text-sm); color: var(--muted); line-height: 1.6; }\n\n/* ---------------- console frame ---------------- */\n.dg-console { display: grid; gap: var(--s8); align-items: start; }\n@media (min-width: 1000px) {\n  .dg-console { grid-template-columns: minmax(0, 7fr) minmax(0, 12fr); gap: var(--s12); }\n}\n.dg-consoleSay { min-width: 0; }\n.dg-consoleTitle { margin: var(--s3) 0 0; font-size: var(--text-xl); }\n.dg-consoleBody { margin: var(--s4) 0 0; color: var(--muted-strong); max-width: 46ch; }\n.dg-consoleArt { min-width: 0; }\n\n@media print {\n  .dg-gantt { display: none; }\n  .dg-ganttText { position: static; width: auto; height: auto; margin: 0; clip-path: none; white-space: normal; }\n}\n2c:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"methodology\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"The Adversary Loop\"}],[\"$\",\"h2\",null,{\"id\":\"methodology\",\"className\":\"sv-h2\",\"children\":\"How the engagement runs\"}],[\"$\",\"p\",null,{\"className\":\"sv-head__lede\",\"children\":\"Threat models shape the build. The build gets attacked. The attack rewrites the threat model.\"}]