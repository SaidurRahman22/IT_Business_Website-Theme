\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"engagement\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Commercials\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"engagement\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Shape, timeline and scoping\\\"}],null]}],[\\\"$\\\",\\\"dl\\\",null,{\\\"className\\\":\\\"sv-defs\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-def\\\",\\\"children\\\":[[\\\"$\\\",\\\"dt\\\",null,{\\\"className\\\":\\\"sv-def__term\\\",\\\"children\\\":\\\"Timeline\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"className\\\":\\\"sv-def__desc\\\",\\\"children\\\":\\\"Two to four days a month, minimum six-month term.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-def\\\",\\\"children\\\":[[\\\"$\\\",\\\"dt\\\",null,{\\\"className\\\":\\\"sv-def__term\\\",\\\"children\\\":\\\"Team shape\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"className\\\":\\\"sv-def__desc\\\",\\\"children\\\":\\\"A named vCISO with GRC and incident support drawn from the wider practice as needed.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-def\\\",\\\"children\\\":[[\\\"$\\\",\\\"dt\\\",null,{\\\"className\\\":\\\"sv-def__term\\\",\\\"children\\\":\\\"Engagement\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"className\\\":\\\"sv-def__desc\\\",\\\"children\\\":\\\"Monthly retainer by day allocation. Escalation to full-time cover during an incident.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-def\\\",\\\"children\\\":[[\\\"$\\\",\\\"dt\\\",null,{\\\"className\\\":\\\"sv-def__term\\\",\\\"children\\\":\\\"Scoping\\\"}],[\\\"$\\\",\\\"dd\\\",null,{\\\"className\\\":\\\"sv-def__desc\\\",\\\"children\\\":[\\\"A named engineer replies within one business day. Scoping call within three.\\\",\\\" \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"className\\\":\\\"u-link\\\",\\\"href\\\":\\\"/services/engagement-models\\\",\\\"children\\\":\\\"How the four engagement models differ\\\"}],\\\".\\\"]}]]}]]}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"34:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\\\\n}\\\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\\\n.sec \\u003e .u-container,\\\\n.sec \\u003e .sec__bleed { position: relative; z-index: 2; }\\\\n\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"sec theme-deep transition-theme u-section\\\",\\\"data-theme-section\\\":\\\"deep\\\",\\\"style\\\":\\\"$undefined\\\",\\\"aria-labelledby\\\":\\\"faq\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"u-container\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"sv-head__rule\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"u-eyebrow sv-head__eyebrow\\\",\\\"children\\\":\\\"Questions\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"faq\\\",\\\"className\\\":\\\"sv-h2\\\",\\\"children\\\":\\\"Frequently asked\\\"}],null]}],[\\\"$\\\",\\\"$L70\\\",null,{\\\"items\\\":[{\\\"q\\\":\\\"How many days do we need?\\\",\\\"a\\\":\\\"Two days a month suits a 50 to 150 person company with a straightforward obligation set. Three to four suits a regulated firm or one going through certification. More than five and you should be hiring, and we will say so rather than selling you days.\\\"},{\\\"q\\\":\\\"Will the same person stay with us?\\\",\\\"a\\\":\\\"Yes. A named vCISO with a named deputy for continuity. Rotating fractional leadership is the failure mode of this model — the value is institutional knowledge, and a new face each quarter has none.\\\"},{\\\"q\\\":\\\"Can a vCISO sign off on things?\\\",\\\"a\\\":\\\"They can own decisions within a delegated authority you define, and they can carry the accountability for the security programme. They cannot be your statutory accountable person where regulation requires an employee, and we will tell you where that line sits for your regime.\\\"},{\\\"q\\\":\\\"Does this conflict with buying testing from you?\\\",\\\"a\\\":\\\"It is a fair question and the answer is in the structure: the vCISO sets the testing requirement and reviews the results, but does not manage the testing team or sign their reports. If you would rather the testing came from a third party, we will help you select one and review their work.\\\"},{\\\"q\\\":\\\"What happens during an incident?\\\",\\\"a\\\":\\\"The vCISO steps up to full-time incident leadership and our response team deploys. That is covered by the retainer’s escalation clause, agreed before you need it rather than negotiated during it.\\\"},{\\\"q\\\":\\\"How do we know it is working?\\\",\\\"a\\\":\\\"Quarterly movement on an agreed set: risks closed, testing cadence held, mean time to remediate, questionnaire turnaround, and incident rehearsal completion. Activity reports are easy to produce and tell you nothing.\\\"}],\\\"headingLevel\\\":3}]]}]}]]\\n\"])</script><script>self.__next_f.push([1,\"71:{\\\"id\\\":\\\"403c44504416ed33d4af4350092b655f174641e336\\\",\\\"bound\\\":null}\\n\"])</script><script>self.__next_f.push([1,\"35:[[\\\"$\\\",\\\"style\\\",null,{\\\"href\\\":\\\"envenox-section\\\",\\\"precedence\\\":\\\"default\\\",\\\"children\\\":\\\"\\\\n.sec {\\\\n  position: relative;\\\\n  background-color: var(--bg);\\\\n  color: var(--fg);\