ad__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Related\"}],[\"$\",\"h2\",null,{\"id\":\"related\",\"className\":\"sv-h2\",\"children\":\"What usually goes with this\"}],null]}],[[\"$\",\"$L40\",null,{\"as\":\"ul\",\"className\":\"sv-grid sv-grid--2\",\"children\":[[\"$\",\"$L41\",\"grc-compliance\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$6a\"}],[\"$\",\"div\",null,{\"className\":\"card card--pad-lg sv-card\",\"data-interactive\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-card__top\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":20,\"height\":20,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-scroll-text sv-card__icon\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"r7krc0\",{\"d\":\"M15 12h-5\"}],[\"$\",\"path\",\"1khuty\",{\"d\":\"M15 8h-5\"}],[\"$\",\"path\",\"zz82l3\",{\"d\":\"M19 17V5a2 2 0 0 0-2-2H4\"}],[\"$\",\"path\",\"1ph1d7\",{\"d\":\"M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"sv-card__name\",\"children\":[\"$\",\"$Le\",null,{\"href\":\"/services/grc-compliance\",\"className\":\"card__link\",\"children\":\"GRC & Compliance\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"sv-card__line\",\"children\":\"SOC 2, ISO 27001, PCI DSS, DORA and NIS2, evidenced from systems you already run.\"}],null]}]]}],[\"$\",\"$L41\",\"incident-response\",{\"as\":\"li\",\"children\":[[\"$\",\"style\",null,{\"href\":\"envenox-card\",\"precedence\":\"default\",\"children\":\"$6b\"}],\"$L6c\"]}],\"$L6d\",\"$L6e\"]}],\"$L6f\"]]}]}]]\n33:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"engagement\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Commercials\"}],[\"$\",\"h2\",null,{\"id\":\"engagement\",\"className\":\"sv-h2\",\"children\":\"Shape, timeline and scoping\"}],null]}],[\"$\",\"dl\",null,{\"className\":\"sv-defs\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Timeline\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Two to four days a month, minimum six-month term.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Team shape\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"A named vCISO with GRC and incident support drawn from the wider practice as needed.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Engagement\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":\"Monthly retainer by day allocation. Escalation to full-time cover during an incident.\"}]]}],[\"$\",\"div\",null,{\"className\":\"sv-def\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"sv-def__term\",\"children\":\"Scoping\"}],[\"$\",\"dd\",null,{\"className\":\"sv-def__desc\",\"children\":[\"A named engineer replies within one business day. Scoping call within three.\",\" \",[\"$\",\"$Le\",null,{\"className\":\"u-link\",\"href\":\"/services/engagement-models\",\"children\":\"How the four engagement models differ\"}],\".\"]}]]}]]}]]}]}]]\n34:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-deep transition-theme u-section\",\"data-theme-section\":\"deep\",\"style\":\"$undefined\",\"aria-labelledby\":\"faq\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-head__rule\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"u-eyebrow sv-head__eyebrow\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"sv-h2\",\"children\":\"Frequently asked\"}],null]}],[\"$\",\"$L70\",null,{\"items\":[{\"q\":\"How many days do we need?\",\"a\":\"Two days a month suits a 50 to 150 person company with a straightforward obligation set. Three to four suits a regulated firm or one going through certification. More than five and you should be hiring, and we will say so rather than selling you days.\"},{\"q\":\"Will the same person stay with us?\",\"a\":\"Yes. A named vCISO with a named deputy for continuity. Rotating fractional leadership is the failure mode of this model — the value is institutional knowledge, and a new face each quarter has none.\"},{\"q\":\"Can a vCISO sign off on things?\",\"a\":\"They can own decisions within a delegated authority you define, and they can carry the accountability for the security programme. They cannot be your statutory accountable person where regulation requires an employee, and we will tell you where that line sits for your regime.\"},{\"q\":\"Does this conflict with buying testing from you?\",\"a\":\"It is a fair question and the answer is in the structure: the vCISO sets the testing requirement and reviews the results, but does not manage the testing team or sign their reports. If you would rather the testing came from a third party, we will help you select one and review their work.\"},{\"q\":\"What happens during an incident?\",\"a\":\"The vCISO steps up to full-time incident leadership and our response team deploys. That is covered by the retainer’s escalation clause, agreed before you need it rather than negotiated during it.\"},{\"q\":\"How do we know it is working?\",\"a\":\"Quarterly movement on an agreed set: risks closed, testing cadence held, mean time to remediate, questionnaire turnaround, and incident rehearsal completion. Activity reports are easy to produce and tell you nothing.\"}],\"headingLevel\":3}]]}]}]]\n71:{\"id\":\"403c44504416ed33d4af4350092b655f174641e336\",\"bound\":null}\n35:[[\"$\",\"style\",null,{\"href\":\"envenox-section\",\"precedence\":\"default\",\"children\":\"\\n.sec {\\n  position: relative;\\n  background-color: var(--bg);\\n  color: var(--fg);\\n}\\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\\n.sec > .u-container,\\n.sec > .sec__bleed { position: relative; z-index: 2; }\\n\"}],[\"$\",\"section\",null,{\"className\":\"sec theme-dark transition-theme u-section grain\",\"data-theme-section\":\"dark\",\"style\":\"$undefined\",\"aria-labelledby\":\"enquiry-h2\",\"children\":[\"$\",\"div\",null,{\"className\":\"u-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"sv-rail\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sv-rail__aside\",\"children\":[[\"$\",\"p\",null,{\"className\":\"u-eyebrow\",\"children\":\"Get started\"}],[\"$\",\"h2\",null,{\"id\":\"enquiry-h2\",\"className\":\"sv-h2\",\"style\":{\"marginTop\":\"var(--s3)\"},\"children\":\"Book a 60-minute scoping call\"}],[\"$\",\"p\",null,{\"className\":\"sv-lede\",\"children\":\"A technical conversation with the person who would lead the work — not a qualification script, not a discovery deck. You come away with a written scope, the exclusions stated in the body rather than in an appendix, and a day count that we have not padded.\"}],[\"$\",\"p\",null,{\"className\":\"sv-note\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":1.75,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users\",\"aria-hidden\":\"true\",\"style\":{\"display\":\"inline-block\",\"verticalAlign\":\"-3px\",\"marginRight\":\"var(--s2)\"},\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"A named vCISO with GRC and incident support drawn from the wider practice as needed.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"sv-rail__body\",\"children\":[\"$\",\"form\",null,{\"action\":\"$h71\",\"className\":\"sv-form\",\"id\":\"enquiry-form\",\"children\":[[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"returnTo\",\"value\":\"/services/vciso\"}],[[\"$\",\"div\",\"enquiry-incomplete\",{\"id\":\"enquiry-incomplete\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"Some required fields came through empty. They are marked below — fill them in and send again.\"}]}],[\"$\",\"div\",\"enquiry-email\",{\"id\":\"enquiry-email\",\"className\":\"sv-form__error\",\"role\":\"alert\",\"children\":[\"$\",\"p\",null,{\"children\":\"That email address did not look complete. Check it and send again.\"}]}]],[[\"$\",\"div\",\"name\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-name\",\"children\":[\"Your name\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-name\",\"name\":\"name\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"name\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"email\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-email\",\"children\":[\"Business email\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-email\",\"name\":\"email\",\"className\":\"sv-input\",\"type\":\"email\",\"required\":true,\"autoComplete\":\"email\",\"aria-describedby\":\"enq-email-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-email-help\",\"children\":\"We reply from a person, not a no-reply address.\"}]]}],[\"$\",\"div\",\"company\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-company\",\"children\":[\"Company\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-company\",\"name\":\"company\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"organization\",\"aria-describedby\":\"$undefined\"}],null]}],[\"$\",\"div\",\"country\",{\"className\":\"sv-field\",\"children\":[[\"$\",\"label\",null,{\"className\":\"sv-label\",\"htmlFor\":\"enq-country\",\"children\":[\"Country\",[\"$\",\"span\",null,{\"className\":\"sv-req\",\"aria-hidden\":\"true\",\"children\":\"*\"}]]}],[\"$\",\"input\",null,{\"id\":\"enq-country\",\"name\":\"country\",\"className\":\"sv-input\",\"type\":\"text\",\"required\":true,\"autoComplete\":\"country-name\",\"aria-describedby\":\"enq-country-help\"}],[\"$\",\"p\",null,{\"className\":\"sv-help\",\"id\":\"enq-country-help\",\"children\":\"Relevant for data residency and time zone.\"}]]}],[\"$\",\"div\",\"interest\",{\"className\":\"sv-field\",\"children\":[\"$L72\",\"$L73\",null]}],\"$L74\",\"$L75\"],\"$L76\",\"$L77\"]}]}]]}]}]}]]\n78:Tdb3,\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: 