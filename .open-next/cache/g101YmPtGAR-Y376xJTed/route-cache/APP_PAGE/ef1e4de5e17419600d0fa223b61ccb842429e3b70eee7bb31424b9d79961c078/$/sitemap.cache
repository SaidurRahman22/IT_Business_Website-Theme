{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/sitemap/layout,_N_T_/sitemap/page,_N_T_/sitemap"},"routeCache":{"key":"/route-cache/APP_PAGE/ef1e4de5e17419600d0fa223b61ccb842429e3b70eee7bb31424b9d79961c078/$/sitemap","owner":{"kind":"APP_PAGE","sourceRoute":"/sitemap/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--g101YmPtGAR_Y376xJTed--><html lang=\"en\" class=\"no-js theme-dark __variable_12fc7c __variable_d46058 __variable_ae301a __variable_a3cc63\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/><link rel=\"stylesheet\" href=\"/_next/static/css/864ef3ae0e55d690.css\" data-precedence=\"next\"/><style data-precedence=\"default\" data-href=\"envenox-nav envenox-button envenox-footer envenox-sitemap envenox-section envenox-crumbs\">\n.nav {\n  position: fixed;\n  inset-inline: 0;\n  top: 0;\n  z-index: 50;\n  height: var(--nav-h);\n  color: var(--fg);\n  background-color: transparent;\n  border-bottom: 1px solid transparent;\n  transition:\n    background-color var(--dur-scene) var(--ease-theme),\n    border-color var(--dur-scene) var(--ease-theme),\n    color var(--dur-scene) var(--ease-theme),\n    backdrop-filter var(--dur-scene) var(--ease-theme);\n}\n/* Scrolled: the spec's var(--bg) + blur(10px). Held at 92% so the blur does\n   real work — an opaque fill would make backdrop-filter a no-op. */\n.nav[data-scrolled='true'] {\n  background-color: color-mix(in oklab, var(--bg) 92%, transparent);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-bottom-color: var(--border);\n}\n\n.nav__bar {\n  position: relative;\n  height: var(--nav-h);\n  display: flex;\n  align-items: center;\n  gap: var(--s6);\n}\n\n.nav__brand {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n  flex: none;\n}\n\n/* ---- desktop menu ---- */\n.nav__desktop { display: none; }\n@media (min-width: 1024px) {\n  .nav__desktop { display: block; flex: 1 1 auto; }\n}\n.no-js .nav__desktop { display: none; }\n\n.nav__list { display: flex; align-items: center; gap: var(--s1); list-style: none; margin: 0; padding: 0; }\n\n.nav__trigger,\n.nav__toplink {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s1);\n  appearance: none;\n  background: none;\n  border: 0;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  min-height: 36px;\n  font-family: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  line-height: 1;\n  color: var(--muted-strong);\n  text-decoration: none;\n  cursor: pointer;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.nav__trigger:hover,\n.nav__toplink:hover { color: var(--fg); background-color: var(--surface); }\n.nav__trigger[data-state='open'] { color: var(--fg); }\n.nav__trigger-chevron { transition: transform var(--dur-base) var(--ease-out); }\n.nav__trigger[data-state='open'] .nav__trigger-chevron { transform: rotate(180deg); }\n\n/* ---- the panel. forceMount keeps the links in the HTML. ----\n   640px is not arbitrary: scaleIn/scaleOut animate scale(0.9) from a\n   \"top center\" origin, so each horizontal edge travels width * 0.1 / 2. At\n   640px that is exactly 32px — the ceiling. A wider panel would animate\n   further than the vocabulary allows, so the panel is capped, and the featured\n   cell leads as a full-width row rather than a left column. */\n.nav__panel {\n  position: absolute;\n  top: calc(var(--nav-h) - var(--s2));\n  left: 0;\n  width: min(640px, calc(100vw - var(--gutter) * 2));\n  transform-origin: top center;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  background-color: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: var(--s6);\n  box-shadow: 0 1px 0 0 var(--border);\n}\n.nav__panel[data-state='open'] {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  animation: scaleIn var(--dur-base) var(--ease-out);\n}\n.nav__panel[data-state='closed'] { animation: scaleOut var(--dur-base) var(--ease-out); }\n\n.nav__panel-grid { display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }\n\n.nav__featured {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  background-color: var(--surface);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__featured:hover { background-color: color-mix(in oklab, var(--surface) 86%, var(--fg) 14%); border-color: var(--border-strong); }\n.nav__featured-label {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-lg);\n  font-weight: 600;\n  letter-spacing: var(--tracking-tight);\n  line-height: 1.2;\n}\n.nav__featured-blurb { font-size: var(--text-sm); color: var(--muted); line-height: 1.45; }\n\n.nav__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; list-style: none; margin: 0; padding: 0; }\n.nav__links--single { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.nav__link {\n  display: block;\n  border-radius: var(--radius-sm);\n  padding: var(--s2) var(--s3);\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out);\n}\n.nav__link:hover { background-color: var(--surface); }\n.nav__link-label { display: block; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; }\n.nav__link-blurb { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 2px; }\n\n.nav__panel-foot { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }\n.nav__panel-all { font-size: var(--text-sm); color: var(--muted-strong); text-decoration: none; }\n.nav__panel-all:hover { color: var(--fg); }\n\n/* ---- actions ---- */\n.nav__actions { display: flex; align-items: center; gap: var(--s3); margin-left: auto; flex: none; }\n\n.nav__hotline {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s1) var(--s3);\n  min-height: 44px;\n  text-decoration: none;\n  color: var(--fg);\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__hotline-icon { flex: none; color: var(--muted-strong); }\n.nav__hotline-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.1; }\n.nav__hotline-kicker {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.nav__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n@media (min-width: 480px) {\n  .nav__hotline-number { font-size: var(--text-sm); }\n}\n\n/* ---- narrow-viewport fit ----\n   At 320px the bar has 288px of usable width, and brand + --s6 gap + hotline\n   + burger measured well past it. The overflow was INVISIBLE: .nav is fixed and\n   body is overflow-x: clip, so no scroll test catches it — the right-hand\n   actions, including the IR hotline, were simply clipped off the edge.\n\n   What gets sacrificed, in order: the bar gap, then the hotline's own padding,\n   then its icon. The NUMBER is the last thing to go and it never does. Someone\n   reaching for this link is mid-breach and needs the digits, not the glyph —\n   and the kicker stays too, because a bare number with no label is a worse\n   affordance than a slightly cramped one. */\n@media (max-width: 639px) {\n  .nav__bar { gap: var(--s3); }\n  .nav__actions { gap: var(--s2); min-width: 0; }\n  .nav__hotline { padding: var(--s1) var(--s2); gap: var(--s1); }\n}\n@media (max-width: 479px) {\n  .nav__hotline-icon { display: none; }\n  .nav__brand { font-size: var(--text-base); }\n}\n\n.nav__cta { display: none; }\n@media (min-width: 1024px) { .nav__cta { display: inline-flex; } }\n\n/* ---- mobile <details> menu: the real no-JS path ---- */\n.nav__mobile { position: static; }\n@media (min-width: 1024px) { .nav__mobile { display: none; } }\n.no-js .nav__mobile { display: block; }\n\n.nav__burger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  color: var(--fg);\n  cursor: pointer;\n  list-style: none;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.nav__burger::-webkit-details-marker { display: none; }\n.nav__burger:hover { background-color: var(--surface); border-color: var(--fg); }\n.nav__burger-close { display: none; }\n.nav__mobile[open] .nav__burger-open { display: none; }\n.nav__mobile[open] .nav__burger-close { display: inline-flex; }\n\n.nav__sheet {\n  position: absolute;\n  top: var(--nav-h);\n  left: 0;\n  right: 0;\n  max-height: calc(100dvh - var(--nav-h));\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  background-color: var(--bg);\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: var(--s6) var(--gutter) var(--s8);\n}\n.nav__sheet-group + .nav__sheet-group { margin-top: var(--s6); padding-top: var(--s6); border-top: 1px solid var(--border); }\n.nav__sheet-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.nav__sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }\n.nav__sheet-link {\n  display: block;\n  padding: var(--s3) 0;\n  min-height: 44px;\n  font-size: var(--text-base);\n  color: var(--fg);\n  text-decoration: none;\n}\n.nav__sheet-link:hover { color: var(--muted-strong); }\n.nav__sheet-blurb { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }\n.nav__sheet-cta { margin-top: var(--s8); display: grid; gap: var(--s3); }\n.nav__sheet-hotline {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-sm);\n  color: var(--fg);\n  text-decoration: none;\n  display: block;\n  padding: var(--s3) 0;\n}\n\n.btn {\n  --btn-bg: transparent;\n  --btn-bg-hover: transparent;\n  --btn-fg: var(--fg);\n  --btn-border: transparent;\n  --btn-border-hover: transparent;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--s2);\n  border: 1px solid var(--btn-border);\n  border-radius: var(--radius-md);\n  background-color: var(--btn-bg);\n  color: var(--btn-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-weight: 500;\n  letter-spacing: -0.01em;\n  line-height: 1;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  /* ONLY colour transitions. A transform here would break the house rule. */\n  transition:\n    background-color var(--dur-base) var(--ease-out),\n    border-color var(--dur-base) var(--ease-out),\n    color var(--dur-base) var(--ease-out);\n}\n.btn:hover {\n  background-color: var(--btn-bg-hover);\n  border-color: var(--btn-border-hover);\n  /* Falls back to the resting label colour, so no existing variant changes.\n     A variant whose hover fill moves far in lightness needs to move its label\n     too, or the hover state quietly fails contrast while the resting state\n     passes — which is the kind of thing an audit on static screenshots misses. */\n  color: var(--btn-fg-hover, var(--btn-fg));\n}\n.btn[aria-disabled='true'],\n.btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.btn[aria-disabled='true']:hover,\n.btn:disabled:hover {\n  background-color: var(--btn-bg);\n  border-color: var(--btn-border);\n}\n\n/* ---- sizes. md and lg clear the 44x44 touch target. ---- */\n.btn--sm { min-height: 32px; padding-inline: var(--s3); font-size: var(--text-sm); }\n.btn--md { min-height: 44px; min-width: 44px; padding-inline: var(--s4); font-size: var(--text-sm); }\n.btn--lg { min-height: 52px; min-width: 52px; padding-inline: var(--s6); font-size: var(--text-base); }\n\n.btn--full { width: 100%; }\n\n/* ---- variants ---- */\n.btn--primary {\n  --btn-bg: var(--accent);\n  --btn-fg: var(--accent-fg);\n  --btn-bg-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  --btn-border: var(--accent);\n  --btn-border-hover: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n.theme-light .btn--primary {\n  /* On paper, --accent is the DARK copper (#A04F1A) because it has to pass\n     4.5:1 as link TEXT. As a large filled surface that same value reads muddy\n     brown, which is not what the brand is. A fill has a different contrast\n     problem from text: the requirement is on the LABEL against the fill, and\n     ink on vibrant copper measures 6.9:1 — comfortably clear. So the fill gets\n     the real brand copper and the label goes dark. Links and the focus ring\n     keep --accent and stay legible. */\n  --btn-bg: var(--accent-500);\n  --btn-fg: var(--ink-900);\n  --btn-bg-hover: var(--accent-600);\n  --btn-fg-hover: var(--paper-50);\n  --btn-border: var(--accent-500);\n  --btn-border-hover: var(--accent-600);\n}\n.btn--secondary {\n  --btn-fg: var(--fg);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--fg);\n}\n.btn--ghost {\n  --btn-fg: var(--muted-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--border);\n}\n.btn--ghost:hover { color: var(--fg); }\n.btn--danger-quiet {\n  --btn-fg: var(--muted-strong);\n  --btn-border: var(--border-strong);\n  --btn-bg-hover: var(--surface);\n  --btn-border-hover: var(--muted-strong);\n}\n.btn--danger-quiet:hover { color: var(--fg); }\n\n.btn__icon { display: inline-flex; flex: none; }\n\n.foot { background-color: var(--bg); color: var(--fg); }\n.foot__top { display: grid; gap: var(--s12); padding-block: var(--s20) var(--s12); }\n@media (min-width: 1024px) {\n  .foot__top { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--s16); }\n}\n\n.foot__brand { display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }\n.foot__wordmark {\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-2xl);\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--fg);\n  text-decoration: none;\n}\n.foot__positioning { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; max-width: 46ch; margin: 0; }\n\n.foot__hotline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s1);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: var(--s4);\n  text-decoration: none;\n  color: var(--fg);\n  width: 100%;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__hotline:hover { background-color: var(--surface); border-color: var(--fg); }\n.foot__hotline-row { display: flex; align-items: center; gap: var(--s2); }\n.foot__hotline-number {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-lg);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.foot__hotline-note { color: var(--muted); font-size: var(--text-xs); line-height: 1.45; }\n\n.foot__cols { display: grid; gap: var(--s8); grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (min-width: 768px) { .foot__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6); } }\n.foot__col-heading {\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin: 0 0 var(--s3);\n}\n.foot__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s1); }\n.foot__link {\n  display: inline-block;\n  padding-block: var(--s1);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__link:hover { color: var(--fg); }\n\n.foot__mid {\n  display: grid;\n  gap: var(--s8);\n  padding-block: var(--s12);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 768px) { .foot__mid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s16); } }\n\n.foot__offices { display: grid; gap: var(--s6); }\n@media (min-width: 480px) { .foot__offices { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.foot__office-city {\n  display: flex;\n  align-items: center;\n  gap: var(--s2);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n  margin: 0 0 var(--s1);\n}\n.foot__office-line { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0; font-style: normal; }\n\n.foot__form { display: grid; gap: var(--s3); max-width: 44ch; }\n.foot__form-label {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--fg);\n}\n.foot__form-hint { font-size: var(--text-xs); color: var(--muted); margin: 0; }\n.foot__form-row { display: flex; gap: var(--s2); flex-wrap: wrap; }\n.foot__input {\n  flex: 1 1 14rem;\n  min-width: 0;\n  min-height: 44px;\n  background-color: var(--surface);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  padding: 0 var(--s3);\n  color: var(--fg);\n  font-family: inherit;\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);\n}\n.foot__input::placeholder { color: var(--muted); }\n.foot__input:hover { border-color: var(--fg); }\n.foot__submit {\n  min-height: 44px;\n  padding-inline: var(--s4);\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-md);\n  background-color: var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-inter-tight), var(--font-inter), ui-sans-serif, system-ui, sans-serif;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__submit:hover {\n  background-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n  border-color: color-mix(in oklab, var(--accent) 82%, var(--fg) 18%);\n}\n\n.foot__bottom {\n  display: flex;\n  flex-direction: column;\n  gap: var(--s6);\n  padding-block: var(--s8);\n  border-top: 1px solid var(--border);\n}\n@media (min-width: 1024px) {\n  .foot__bottom { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--s12); }\n}\n.foot__legal { display: grid; gap: var(--s2); }\n.foot__legal-line { font-size: var(--text-xs); color: var(--muted); margin: 0; line-height: 1.6; max-width: 62ch; }\n.foot__legal-nav { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); list-style: none; margin: 0; padding: 0; }\n.foot__legal-link {\n  font-size: var(--text-xs);\n  color: var(--muted);\n  text-decoration: none;\n  padding-block: var(--s1);\n  transition: color var(--dur-base) var(--ease-out);\n}\n.foot__legal-link:hover { color: var(--fg); }\n\n.foot__social { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.foot__social-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--s2);\n  min-height: 44px;\n  padding-inline: var(--s3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.foot__social-link:hover { color: var(--fg); background-color: var(--surface); border-color: var(--border-strong); }\n\n/* Announced, not shown — these links open in a new tab. */\n.foot__vh {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sm__jump { margin: var(--s8) 0 0; }\n.sm__jump ul { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }\n.sm__jump a {\n  display: inline-flex;\n  align-items: center;\n  min-height: 36px;\n  padding: var(--s2) var(--s4);\n  border: 1px solid var(--border-strong);\n  border-radius: var(--radius-md);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--muted-strong);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);\n}\n.sm__jump a:hover { color: var(--fg); background-color: var(--surface); border-color: var(--fg); }\n\n.sm__group + .sm__group { margin-top: var(--s16); }\n.sm__group-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s4); margin: 0; }\n.sm__group h2 { margin: 0; font-size: var(--text-2xl); scroll-margin-top: calc(var(--nav-h) + var(--s8)); }\n.sm__count {\n  font-family: var(--font-jetbrains-mono), ui-monospace, 'SF Mono', Menlo, monospace;\n  font-size: var(--text-xs);\n  color: var(--muted);\n  font-variant-numeric: tabular-nums;\n}\n.sm__blurb { margin: var(--s3) 0 0; color: var(--muted); font-size: var(--text-sm); max-width: 68ch; }\n\n.sm__set { margin-top: var(--s8); }\n.sm__set h3 {\n  margin: 0 0 var(--s4);\n  font-size: var(--text-xs);\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.sm__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }\n@media (min-width: 768px) { .sm__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s8); } }\n@media (min-width: 1200px) { .sm__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n.sm__list > li { min-width: 0; border-top: 1px solid var(--border); }\n.sm__list a {\n  display: block;\n  padding: var(--s3) 0;\n  color: var(--fg);\n  text-decoration: none;\n  transition: color var(--dur-base) var(--ease-out);\n}\n.sm__list a:hover { color: var(--accent); }\n.sm__label { display: block; font-size: var(--text-sm); font-weight: 500; }\n.sm__note {\n  display: -webkit-box;\n  margin-top: 2px;\n  font-size: var(--text-xs);\n  line-height: 1.45;\n  color: var(--muted);\n  overflow: hidden;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n}\n.sm__list svg { display: inline-block; vertical-align: -2px; margin-left: var(--s1); color: var(--muted); }\n\n.sec {\n  position: relative;\n  background-color: var(--bg);\n  color: var(--fg);\n}\n/* Grain sits at z-index 1 with pointer-events none; content rides above it. */\n.sec > .u-container,\n.sec > .sec__bleed { position: relative; z-index: 2; }\n\n.crumbs { font-size: var(--text-sm); color: var(--muted); }\n.crumbs ol {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--s2);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.crumbs li { display: flex; align-items: center; gap: var(--s2); min-width: 0; }\n.crumbs a { color: var(--muted); text-decoration: none; }\n.crumbs a:hover { color: var(--fg); }\n.crumbs__sep { color: var(--border-strong); }\n.crumbs [aria-current='page'] { color: var(--muted-strong); }\n</style><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-750339dbcd53e266.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-b84741b894bb9354.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-37618e55b880a2de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3c9e02e22d10480a.js\" async=\"\"></script><script src=\"/_next/static/chunks/4938-ec7db2048e7be43e.js\" async=\"\"></script><script src=\"/_next/static/chunks/9393-bd02566ba347fb8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f5ee25261e09e61.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/error-77708acc479f8cb3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/sitemap/page-fd3da6627a17aed7.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0a0d13\"/><title>Site map · Envenox</title><meta name=\"description\" content=\"Every page on envenox.com, grouped — services, industries, proof, resources, company and legal.\"/><meta name=\"application-name\" content=\"Envenox\"/><link rel=\"author\" href=\"https://envenox.com\"/><meta name=\"author\" content=\"Envenox Ltd\"/><meta name=\"keywords\" content=\"penetration testing,application security,managed detection and response,secure software development,custom software development,ISO 27001,SOC 2,DORA,NIS2\"/><meta name=\"referrer\" content=\"strict-origin-when-cross-origin\"/><meta name=\"creator\" content=\"Envenox Ltd\"/><meta name=\"publisher\" content=\"Envenox Ltd\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://envenox.com/sitemap\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"Envenox — We build the software. Then we try to break it.\"/><meta property=\"og:description\" content=\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"/><meta property=\"og:url\" content=\"https://envenox.com\"/><meta property=\"og:site_name\" content=\"Envenox\"/><meta property=\"og:locale\" content=\"en_GB\"/><meta property=\"og:image:alt\" content=\"Envenox — cybersecurity and software development\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image\" content=\"https://envenox.com/opengraph-image?be415c17a8510f02\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Envenox — We build the software. Then we try to break it.\"/><meta name=\"twitter:description\" content=\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\"/><meta name=\"twitter:image:alt\" content=\"Envenox — cybersecurity and software development\"/><meta name=\"twitter:image:type\" content=\"image/png\"/><meta name=\"twitter:image\" content=\"https://envenox.com/opengraph-image?be415c17a8510f02\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/icon.svg?0887ae5654435afa\" type=\"image/svg+xml\" sizes=\"any\"/><script>document.documentElement.classList.remove('no-js')</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://envenox.com/#organization\",\"name\":\"Envenox\",\"legalName\":\"Envenox Ltd\",\"url\":\"https://envenox.com\",\"description\":\"Envenox is a software development firm. We design, build and hand over the systems a business runs on — custom software, web applications, ERP, CRM, and the cloud platforms underneath them. What makes the work defensible is that we keep an offensive security practice on staff: our penetration testers read the code our engineers are writing and file findings into the same sprint backlog, so a system arrives already attacked rather than waiting for its first external test. That practice also works on its own, for clients who never buy a line of code from us. We work with regulated organisations across finance, healthcare, logistics and public sector, and we publish our own security posture at /trust.\",\"slogan\":\"We build the software. Then we try to break it.\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"sameAs\":[\"https://www.linkedin.com/company/envenox\",\"https://github.com/envenox\",\"https://x.com/envenox\"],\"address\":[{\"@type\":\"PostalAddress\",\"streetAddress\":\"1 Fore Street Avenue, London EC2Y 9DT\",\"addressLocality\":\"London\",\"addressCountry\":\"United Kingdom\"},{\"@type\":\"PostalAddress\",\"streetAddress\":\"Level 7, Bay’s Galleria, Gulshan 1, Dhaka 1212\",\"addressLocality\":\"Dhaka\",\"addressCountry\":\"Bangladesh\"}],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"emergency\",\"name\":\"Incident response hotline\",\"telephone\":\"+44 20 4525 9100\",\"availableLanguage\":[\"en\"],\"hoursAvailable\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"00:00\",\"closes\":\"23:59\"}},{\"@type\":\"ContactPoint\",\"contactType\":\"sales\",\"email\":\"hello@envenox.com\",\"telephone\":\"+44 20 4525 9101\",\"availableLanguage\":[\"en\"]},{\"@type\":\"ContactPoint\",\"contactType\":\"security\",\"email\":\"security@envenox.com\",\"availableLanguage\":[\"en\"]}]},{\"@type\":\"WebSite\",\"@id\":\"https://envenox.com/#website\",\"url\":\"https://envenox.com\",\"name\":\"Envenox\",\"description\":\"Envenox is a software development firm. We ship production systems — custom software, web applications, ERP and the platforms underneath them — and we keep an offensive security practice on staff that attacks what we build before anyone else gets the chance.\",\"inLanguage\":\"en-GB\",\"publisher\":{\"@id\":\"https://envenox.com/#organization\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"u-skip\" href=\"#main\">Skip to content</a><header class=\"nav theme-dark transition-theme no-print\" data-scrolled=\"false\" data-nav-theme=\"dark\"><div class=\"nav__bar u-container\"><a class=\"nav__brand\" href=\"/\">Envenox</a><nav aria-label=\"Primary\" data-orientation=\"horizontal\" dir=\"ltr\" class=\"nav__desktop\"><div style=\"position:relative\"><ul data-orientation=\"horizontal\" class=\"nav__list\" dir=\"ltr\"><li><button id=\"radix-_R_klb_-trigger-Services\" data-state=\"closed\" aria-expanded=\"false\" aria-controls=\"radix-_R_klb_-content-Services\" class=\"nav__trigger\" data-radix-collection-item=\"\">Services<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.625\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down nav__trigger-chevron\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div id=\"radix-_R_klb_-content-Services\" aria-labelledby=\"radix-_R_klb_-trigger-Services\" data-orientation=\"horizontal\" data-state=\"closed\" class=\"nav__panel\" style=\"pointer-events:none\" dir=\"ltr\"><div class=\"nav__panel-grid\"><a class=\"nav__featured\" data-radix-collection-item=\"\" href=\"/services/devsecops\"><span class=\"u-eyebrow\">Start here</span><span class=\"nav__featured-label\">Secure SDLC</span><span class=\"nav__featured-blurb\">The page that explains why one firm does both. Start here.</span></a><ul class=\"nav__links\"><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/cybersecurity\"><span class=\"nav__link-label\">Cybersecurity</span><span class=\"nav__link-blurb\">Testing, assurance, detection and response</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/software-development\"><span class=\"nav__link-label\">Software Development</span><span class=\"nav__link-blurb\">Product build, platform and modernisation</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/penetration-testing\"><span class=\"nav__link-label\">Penetration Testing</span><span class=\"nav__link-blurb\">Web, mobile, network, cloud, API</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/application-security\"><span class=\"nav__link-label\">Application Security</span><span class=\"nav__link-blurb\">Secure code review and SDLC uplift</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/managed-detection-response\"><span class=\"nav__link-label\">Managed Detection &amp; Response</span><span class=\"nav__link-blurb\">24/7 SOC on your telemetry</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/grc-compliance\"><span class=\"nav__link-label\">GRC &amp; Compliance</span><span class=\"nav__link-blurb\">SOC 2, ISO 27001, PCI DSS, DORA, NIS2</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\"\" href=\"/services/custom-software\"><span class=\"nav__link-label\">Custom Software</span><span class=\"nav__link-blurb\">Systems built to survive an audit</span></a></li><li><a class=\"nav__link\" data-radix-collection-item=\