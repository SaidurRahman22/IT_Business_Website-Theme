{"type":"route","meta":{"status":200,"headers":{"cache-control":"public, immutable, no-transform, max-age=31536000","content-type":"image/svg+xml","x-next-cache-tags":"_N_T_/layout,_N_T_/icon.svg/layout,_N_T_/icon.svg/route,_N_T_/icon.svg"},"routeCache":{"key":"/route-cache/APP_ROUTE/46324d98b8e71cdc62410a339bc8cac206ca0a652c8fd0a60955b78d02081b73/$/icon.svg","owner":{"kind":"APP_ROUTE","sourceRoute":"/icon.svg/route"},"isFallback":false}},"body":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" role=\"img\" aria-label=\"Envenox\">\n  <!--\n    The Attestation mark: three plates seated into one closed form.\n    Derived from the hero's metaphor — the pieces fit, the seams close.\n\n    Deliberately NOT a padlock, a shield or a keyhole. Every leading security\n    site studied avoids all three, and a padlock favicon would undo the work the\n    rest of the identity does.\n\n    Drawn as flat fills at 32px rather than strokes: a 1px stroke at favicon\n    scale renders as grey mush on a non-integer device pixel ratio.\n  -->\n  <rect width=\"32\" height=\"32\" rx=\"7\" fill=\"#0A0D13\"/>\n  <g transform=\"translate(16 16)\">\n    <!-- upper plate — the lit face -->\n    <path d=\"M0 -9 L7.8 -4.5 L0 0 L-7.8 -4.5 Z\" fill=\"#9AA5FF\"/>\n    <!-- lower-right plate -->\n    <path d=\"M7.8 -4.5 L7.8 4.5 L0 9 L0 0 Z\" fill=\"#5B6CFF\"/>\n    <!-- lower-left plate, held back so the three read as distinct facets -->\n    <path d=\"M-7.8 -4.5 L0 0 L0 9 L-7.8 4.5 Z\" fill=\"#3B46A8\"/>\n  </g>\n</svg>\n"}