{
  "name": "envenox-web",
  "version": "1.0.0",
  "private": true,
  "description": "Envenox — cybersecurity services and custom software engineering.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check && next build",
    "build:unchecked": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:icons && npm run check:motion && npm run check:placeholders && npm run typecheck",
    "check:icons": "node scripts/check-icons.mjs --suggest",
    "check:motion": "node scripts/check-motion.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "assets:noise": "node scripts/make-noise.mjs",
    "assets:hero": "node scripts/render-hero-fallback.mjs",
    "check:placeholders:strict": "node scripts/check-placeholders.mjs --strict",
    "check:deploy": "npm run check:icons && npm run check:motion && npm run check:placeholders:strict && npm run typecheck",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run check:deploy && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-tabs": "1.1.13",
    "lucide-react": "0.544.0",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "simple-icons": "15.15.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.187.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
